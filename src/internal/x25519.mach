# secret-state x25519 montgomery ladder

use crypto.contracts;
use crypto.internal.word;
use std.crypto.ct;
use std.types.size.usize;

val LIMB_BITS: usize = 51;
val LIMB_MASK: u64   = 2251799813685247;
val PRIME_LOW: u64   = 2251799813685229;
val A24:       u64   = 121665;

pub rec Field {
    limb: [5]^u64;
}

pub fun destroy(value: *Field) {
    if (value == nil) { ret; }
    ct.zeroize((?value.limb[0]):~*^u8, 40);
}

#[oblivious]
#[inline]
fun times_19(value: ^u64) ^u64 {
    ret value + (value << 1) + (value << 4);
}

# one carry pass over the limbs, written to output
#[oblivious]
#[inline]
fun store_carried(output: *Field, s0: ^u64, s1: ^u64, s2: ^u64, s3: ^u64, s4: ^u64) {
    val t1: ^u64 = s1 + (s0 >> LIMB_BITS);
    val t2: ^u64 = s2 + (t1 >> LIMB_BITS);
    val t3: ^u64 = s3 + (t2 >> LIMB_BITS);
    val t4: ^u64 = s4 + (t3 >> LIMB_BITS);
    output.limb[0] = (s0 & LIMB_MASK) + times_19(t4 >> LIMB_BITS);
    output.limb[1] = t1 & LIMB_MASK;
    output.limb[2] = t2 & LIMB_MASK;
    output.limb[3] = t3 & LIMB_MASK;
    output.limb[4] = t4 & LIMB_MASK;
}

#[oblivious]
#[inline]
fun normalize(value: *Field) {
    store_carried(value, value.limb[0], value.limb[1], value.limb[2], value.limb[3],
        value.limb[4]);
}

#[oblivious]
pub fun canonicalize(value: *Field) {
    normalize(value);
    normalize(value);
    normalize(value);
    var reduced:    Field;
    var difference: ^u64 = value.limb[0] - PRIME_LOW;
    var borrow:     ^u64 = difference >> 63;
    reduced.limb[0] = difference + (borrow << LIMB_BITS);
    var i: usize = 1;
    for (i < 5) {
        difference      = value.limb[i] - LIMB_MASK - borrow;
        borrow          = difference >> 63;
        reduced.limb[i] = difference + (borrow << LIMB_BITS);
        i               = i + 1;
    }
    val original_mask: ^u64 = 0 - borrow;
    val reduced_mask:  ^u64 = ~original_mask;
    i = 0;
    for (i < 5) {
        value.limb[i] = (value.limb[i] & original_mask) |
            (reduced.limb[i] & reduced_mask);
        i = i + 1;
    }
    difference = 0;
    borrow     = 0;
    destroy(?reduced);
}

#[oblivious]
pub fun copy(output: *Field, input: *Field) {
    var i: usize = 0;
    for (i < 5) {
        output.limb[i] = input.limb[i];
        i              = i + 1;
    }
}

#[oblivious]
pub fun set_small(output: *Field, value: u64) {
    output.limb[0] = value;
    var i: usize = 1;
    for (i < 5) {
        output.limb[i] = 0;
        i              = i + 1;
    }
}

# the limb contract: every field operation accepts limbs below 2^54 and leaves
# limbs below 2^52. one carry pass takes any element below 2^54 there, since
# the top carry is at most 7 and wraps as at most 133 into limb 0
#[oblivious]
pub fun add(output: *Field, left: *Field, right: *Field) {
    store_carried(output,
        left.limb[0] + right.limb[0],
        left.limb[1] + right.limb[1],
        left.limb[2] + right.limb[2],
        left.limb[3] + right.limb[3],
        left.limb[4] + right.limb[4]);
}

# left + 4p - right, which cannot borrow while right is below 2^53
#[oblivious]
pub fun subtract(output: *Field, left: *Field, right: *Field) {
    store_carried(output,
        left.limb[0] + 9007199254740916 - right.limb[0],
        left.limb[1] + 9007199254740988 - right.limb[1],
        left.limb[2] + 9007199254740988 - right.limb[2],
        left.limb[3] + 9007199254740988 - right.limb[3],
        left.limb[4] + 9007199254740988 - right.limb[4]);
}

# double a field element whose limbs are at most 2^51 + 38, keeping that bound
#[oblivious]
#[inline]
fun double_in_place(value: *Field) {
    val carry0: ^u64 = value.limb[0] >> 50;
    val carry1: ^u64 = value.limb[1] >> 50;
    val carry2: ^u64 = value.limb[2] >> 50;
    val carry3: ^u64 = value.limb[3] >> 50;
    val carry4: ^u64 = value.limb[4] >> 50;
    value.limb[0] = ((value.limb[0] << 1) & LIMB_MASK) + times_19(carry4);
    value.limb[1] = ((value.limb[1] << 1) & LIMB_MASK) + carry0;
    value.limb[2] = ((value.limb[2] << 1) & LIMB_MASK) + carry1;
    value.limb[3] = ((value.limb[3] << 1) & LIMB_MASK) + carry2;
    value.limb[4] = ((value.limb[4] << 1) & LIMB_MASK) + carry3;
}

# the field product, lazily reduced
#
# every field operation leaves limbs below 2^52 and accepts limbs below 2^52,
# and both operands are read before the first write, so output may alias
# either. encode canonicalizes before any byte leaves the field. the product is
# 25 hardware word products where the target admits them and the bit-serial
# reference elsewhere (#83)
#[oblivious]
#[inline]
pub fun multiply(output: *Field, left: *Field, right: *Field) {
    $if (word.HARDWARE_WIDE == 1) {
        multiply_wide(output, left, right);
    }
    $or {
        serial_multiply(output, left, right);
    }
}

#[oblivious]
#[inline]
pub fun square(output: *Field, input: *Field) {
    $if (word.HARDWARE_WIDE == 1) {
        square_wide(output, input);
    }
    $or {
        serial_multiply(output, input, input);
    }
}

# schoolbook over radix 2^51 with the wrap folded in: limb i of the product
# collects f_j * g_(i-j) and 19 * f_j * g_(5+i-j). limbs below 2^52 keep every
# accumulator below 2^112 and every carry below 2^61, so the chain that follows
# leaves r0, r1, r3 and r4 below 2^51 and r2 below 2^51 + 2
#[oblivious]
fun multiply_wide(output: *Field, left: *Field, right: *Field) {
    val f0:    ^u64  = left.limb[0];
    val f1:    ^u64  = left.limb[1];
    val f2:    ^u64  = left.limb[2];
    val f3:    ^u64  = left.limb[3];
    val f4:    ^u64  = left.limb[4];
    val g0:    ^u64  = right.limb[0];
    val g1:    ^u64  = right.limb[1];
    val g2:    ^u64  = right.limb[2];
    val g3:    ^u64  = right.limb[3];
    val g4:    ^u64  = right.limb[4];
    val g1_19: ^u64  = times_19(g1);
    val g2_19: ^u64  = times_19(g2);
    val g3_19: ^u64  = times_19(g3);
    val g4_19: ^u64  = times_19(g4);
    var t0:    ^u128 = word.multiply_wide(f0, g0) + word.multiply_wide(f1, g4_19) +
        word.multiply_wide(f2, g3_19) + word.multiply_wide(f3, g2_19) +
        word.multiply_wide(f4, g1_19);
    var t1: ^u128 = word.multiply_wide(f0, g1) + word.multiply_wide(f1, g0) +
        word.multiply_wide(f2, g4_19) + word.multiply_wide(f3, g3_19) +
        word.multiply_wide(f4, g2_19);
    var t2: ^u128 = word.multiply_wide(f0, g2) + word.multiply_wide(f1, g1) +
        word.multiply_wide(f2, g0) + word.multiply_wide(f3, g4_19) +
        word.multiply_wide(f4, g3_19);
    var t3: ^u128 = word.multiply_wide(f0, g3) + word.multiply_wide(f1, g2) +
        word.multiply_wide(f2, g1) + word.multiply_wide(f3, g0) +
        word.multiply_wide(f4, g4_19);
    var t4: ^u128 = word.multiply_wide(f0, g4) + word.multiply_wide(f1, g3) +
        word.multiply_wide(f2, g2) + word.multiply_wide(f3, g1) +
        word.multiply_wide(f4, g0);
    carry_wide(output, ?t0, ?t1, ?t2, ?t3, ?t4);
}

# the square is the product with the 10 symmetric terms formed once and doubled
#[oblivious]
fun square_wide(output: *Field, input: *Field) {
    val f0:    ^u64  = input.limb[0];
    val f1:    ^u64  = input.limb[1];
    val f2:    ^u64  = input.limb[2];
    val f3:    ^u64  = input.limb[3];
    val f4:    ^u64  = input.limb[4];
    val d0:    ^u64  = f0 << 1;
    val d1:    ^u64  = f1 << 1;
    val d2:    ^u64  = f2 << 1;
    val d3:    ^u64  = f3 << 1;
    val f3_19: ^u64  = times_19(f3);
    val f4_19: ^u64  = times_19(f4);
    var t0:    ^u128 = word.multiply_wide(f0, f0) + word.multiply_wide(d1, f4_19) +
        word.multiply_wide(d2, f3_19);
    var t1: ^u128 = word.multiply_wide(d0, f1) + word.multiply_wide(d2, f4_19) +
        word.multiply_wide(f3, f3_19);
    var t2: ^u128 = word.multiply_wide(d0, f2) + word.multiply_wide(f1, f1) +
        word.multiply_wide(d3, f4_19);
    var t3: ^u128 = word.multiply_wide(d0, f3) + word.multiply_wide(d1, f2) +
        word.multiply_wide(f4, f4_19);
    var t4: ^u128 = word.multiply_wide(d0, f4) + word.multiply_wide(d1, f3) +
        word.multiply_wide(f2, f2);
    carry_wide(output, ?t0, ?t1, ?t2, ?t3, ?t4);
}

# one carry pass over the wide accumulators, the wrap of the top carry into
# limb 0, and two more single-limb carries to settle it. the accumulators are
# wiped on the way out
#[oblivious]
#[inline]
fun carry_wide(output: *Field, t0: *^u128, t1: *^u128, t2: *^u128, t3: *^u128,
    t4: *^u128) {
    @t1 = @t1 + (@t0 >> LIMB_BITS);
    var r0: ^u64 = (@t0)::^u64 & LIMB_MASK;
    @t2 = @t2 + (@t1 >> LIMB_BITS);
    var r1: ^u64 = (@t1)::^u64 & LIMB_MASK;
    @t3 = @t3 + (@t2 >> LIMB_BITS);
    var r2: ^u64 = (@t2)::^u64 & LIMB_MASK;
    @t4 = @t4 + (@t3 >> LIMB_BITS);
    val r3: ^u64 = (@t3)::^u64 & LIMB_MASK;
    val r4: ^u64 = (@t4)::^u64 & LIMB_MASK;
    r0             = r0 + times_19((@t4 >> LIMB_BITS)::^u64);
    r1             = r1 + (r0 >> LIMB_BITS);
    r0             = r0 & LIMB_MASK;
    r2             = r2 + (r1 >> LIMB_BITS);
    r1             = r1 & LIMB_MASK;
    output.limb[0] = r0;
    output.limb[1] = r1;
    output.limb[2] = r2;
    output.limb[3] = r3;
    output.limb[4] = r4;
    @t0            = 0;
    @t1            = 0;
    @t2            = 0;
    @t3            = 0;
    @t4            = 0;
    r0             = 0;
    r1             = 0;
    r2             = 0;
}

# the bit-serial reference: walk the multiplier's bits once over a doubling
# multiplicand
#
# the product is a masked sum of left * 2^k mod p for every set bit k. the
# multiplicand keeps limbs at most 2^51 + 38 while it doubles. the product is
# left lazy: two carry passes bound its limbs by 2^51 + 18
#[oblivious]
pub fun serial_multiply(output: *Field, left: *Field, right: *Field) {
    var multiple: Field;
    var bits:     Field;
    copy(?multiple, left);
    normalize(?multiple);
    normalize(?multiple);
    copy(?bits, right);
    canonicalize(?bits);
    var m0:         ^u64  = multiple.limb[0];
    var m1:         ^u64  = multiple.limb[1];
    var m2:         ^u64  = multiple.limb[2];
    var m3:         ^u64  = multiple.limb[3];
    var m4:         ^u64  = multiple.limb[4];
    var p0:         ^u64  = 0;
    var p1:         ^u64  = 0;
    var p2:         ^u64  = 0;
    var p3:         ^u64  = 0;
    var p4:         ^u64  = 0;
    var limb_index: usize = 0;
    for (limb_index < 5) {
        var word: ^u64 = bits.limb[limb_index];
        var bit:  u64  = 0;
        for (bit < 51) {
            val mask: ^u64 = 0 - (word & 1);
            p0 = p0 + (m0 & mask);
            p1 = p1 + (m1 & mask);
            p2 = p2 + (m2 & mask);
            p3 = p3 + (m3 & mask);
            p4 = p4 + (m4 & mask);
            val c0: ^u64 = m0 >> 50;
            val c1: ^u64 = m1 >> 50;
            val c2: ^u64 = m2 >> 50;
            val c3: ^u64 = m3 >> 50;
            val c4: ^u64 = m4 >> 50;
            m0   = ((m0 << 1) & LIMB_MASK) + times_19(c4);
            m1   = ((m1 << 1) & LIMB_MASK) + c0;
            m2   = ((m2 << 1) & LIMB_MASK) + c1;
            m3   = ((m3 << 1) & LIMB_MASK) + c2;
            m4   = ((m4 << 1) & LIMB_MASK) + c3;
            word = word >> 1;
            bit  = bit + 1;
        }
        word       = 0;
        limb_index = limb_index + 1;
    }
    var product: Field;
    product.limb[0] = p0;
    product.limb[1] = p1;
    product.limb[2] = p2;
    product.limb[3] = p3;
    product.limb[4] = p4;
    normalize(?product);
    normalize(?product);
    copy(output, ?product);
    m0 = 0;
    m1 = 0;
    m2 = 0;
    m3 = 0;
    m4 = 0;
    p0 = 0;
    p1 = 0;
    p2 = 0;
    p3 = 0;
    p4 = 0;
    destroy(?multiple);
    destroy(?bits);
    destroy(?product);
}

# multiply by the public ladder constant (486662 - 2) / 4 = 121665
#[oblivious]
#[inline]
fun multiply_a24(output: *Field, input: *Field) {
    $if (word.HARDWARE_WIDE == 1) {
        var t0: ^u128 = word.multiply_wide(input.limb[0], A24);
        var t1: ^u128 = word.multiply_wide(input.limb[1], A24);
        var t2: ^u128 = word.multiply_wide(input.limb[2], A24);
        var t3: ^u128 = word.multiply_wide(input.limb[3], A24);
        var t4: ^u128 = word.multiply_wide(input.limb[4], A24);
        carry_wide(output, ?t0, ?t1, ?t2, ?t3, ?t4);
    }
    $or {
        serial_multiply_a24(output, input);
    }
}

#[oblivious]
fun serial_multiply_a24(output: *Field, input: *Field) {
    var multiple: Field;
    var product:  Field;
    copy(?multiple, input);
    normalize(?multiple);
    normalize(?multiple);
    set_small(?product, 0);
    var bit: u64 = 0;
    for (bit < 17) {
        if (((A24 >> bit) & 1) == 1) {
            var i: usize = 0;
            for (i < 5) {
                product.limb[i] = product.limb[i] + multiple.limb[i];
                i               = i + 1;
            }
        }
        double_in_place(?multiple);
        bit = bit + 1;
    }
    normalize(?product);
    normalize(?product);
    copy(output, ?product);
    destroy(?multiple);
    destroy(?product);
}

#[oblivious]
fun square_times(output: *Field, input: *Field, count: usize) {
    copy(output, input);
    var i: usize = 0;
    for (i < count) {
        square(output, output);
        i = i + 1;
    }
}

# raise to 2^250 - 1 and also return input^11, the shared head of both exponents
#[oblivious]
fun raise_chain(output: *Field, eleven: *Field, input: *Field) {
    var t0: Field;
    var t1: Field;
    var t2: Field;
    var t3: Field;
    square(?t0, input);
    square(?t1, ?t0);
    square(?t1, ?t1);
    multiply(?t1, input, ?t1);
    multiply(?t0, ?t0, ?t1);
    square(?t2, ?t0);
    multiply(?t1, ?t1, ?t2);
    square_times(?t2, ?t1, 5);
    multiply(?t1, ?t2, ?t1);
    square_times(?t2, ?t1, 10);
    multiply(?t2, ?t2, ?t1);
    square_times(?t3, ?t2, 20);
    multiply(?t2, ?t3, ?t2);
    square_times(?t2, ?t2, 10);
    multiply(?t1, ?t2, ?t1);
    square_times(?t2, ?t1, 50);
    multiply(?t2, ?t2, ?t1);
    square_times(?t3, ?t2, 100);
    multiply(?t2, ?t3, ?t2);
    square_times(?t2, ?t2, 50);
    multiply(output, ?t2, ?t1);
    copy(eleven, ?t0);
    destroy(?t0);
    destroy(?t1);
    destroy(?t2);
    destroy(?t3);
}

#[oblivious]
pub fun invert(output: *Field, input: *Field) {
    var chain:  Field;
    var eleven: Field;
    raise_chain(?chain, ?eleven, input);
    square_times(?chain, ?chain, 5);
    multiply(output, ?chain, ?eleven);
    destroy(?chain);
    destroy(?eleven);
}

# raise to (p + 3) / 8 = 2^252 - 2, the ed25519 square-root candidate exponent
#[oblivious]
pub fun raise_square_root(output: *Field, input: *Field) {
    var chain:  Field;
    var eleven: Field;
    raise_chain(?chain, ?eleven, input);
    square(?chain, ?chain);
    multiply(?chain, ?chain, input);
    square(output, ?chain);
    destroy(?chain);
    destroy(?eleven);
}

fun read_public_u64(input: *u8, offset: usize) u64 {
    ret input[offset]::u64 | (input[offset + 1]::u64 << 8) |
        (input[offset + 2]::u64 << 16) | (input[offset + 3]::u64 << 24) |
        (input[offset + 4]::u64 << 32) | (input[offset + 5]::u64 << 40) |
        (input[offset + 6]::u64 << 48) | (input[offset + 7]::u64 << 56);
}

#[oblivious]
pub fun decode(output: *Field, input: *u8) {
    output.limb[0] = read_public_u64(input, 0) & LIMB_MASK;
    output.limb[1] = (read_public_u64(input, 6) >> 3) & LIMB_MASK;
    output.limb[2] = (read_public_u64(input, 12) >> 6) & LIMB_MASK;
    output.limb[3] = (read_public_u64(input, 19) >> 1) & LIMB_MASK;
    output.limb[4] = (read_public_u64(input, 24) >> 12) & LIMB_MASK;
    canonicalize(output);
}

#[oblivious]
pub fun encode(output: *^u8, input: *Field) {
    canonicalize(input);
    ct.zeroize(output, 32);
    var position:   usize = 0;
    var limb_index: usize = 0;
    for (limb_index < 5) {
        var limb_bit: usize = 0;
        for (limb_bit < LIMB_BITS) {
            val byte_index: usize = position >> 3;
            val byte_bit:   usize = position & 7;
            val bit:        ^u8   = ((input.limb[limb_index] >> limb_bit) & 1)::^u8;
            output[byte_index] = output[byte_index] | (bit << byte_bit);
            position           = position + 1;
            limb_bit           = limb_bit + 1;
        }
        limb_index = limb_index + 1;
    }
}

#[oblivious]
#[inline]
fun conditional_swap(swap: ^u8, left: *Field, right: *Field) {
    val mask: ^u64 = 0 - swap::^u64;
    val d0:   ^u64 = (left.limb[0] ^ right.limb[0]) & mask;
    val d1:   ^u64 = (left.limb[1] ^ right.limb[1]) & mask;
    val d2:   ^u64 = (left.limb[2] ^ right.limb[2]) & mask;
    val d3:   ^u64 = (left.limb[3] ^ right.limb[3]) & mask;
    val d4:   ^u64 = (left.limb[4] ^ right.limb[4]) & mask;
    left.limb[0]  = left.limb[0] ^ d0;
    left.limb[1]  = left.limb[1] ^ d1;
    left.limb[2]  = left.limb[2] ^ d2;
    left.limb[3]  = left.limb[3] ^ d3;
    left.limb[4]  = left.limb[4] ^ d4;
    right.limb[0] = right.limb[0] ^ d0;
    right.limb[1] = right.limb[1] ^ d1;
    right.limb[2] = right.limb[2] ^ d2;
    right.limb[3] = right.limb[3] ^ d3;
    right.limb[4] = right.limb[4] ^ d4;
}

#[oblivious]
pub fun scalar_multiply(private_key: contracts.SecretBytes, coordinate: *u8,
    output: *^u8) {
    var scalar: [32]^u8;
    var i:      usize = 0;
    for (i < 32) {
        scalar[i] = private_key.data[i];
        i         = i + 1;
    }
    scalar[0]  = scalar[0] & 248;
    scalar[31] = (scalar[31] & 127) | 64;

    var x1: Field;
    var x2: Field;
    var z2: Field;
    var x3: Field;
    var z3: Field;
    decode(?x1, coordinate);
    set_small(?x2, 1);
    set_small(?z2, 0);
    copy(?x3, ?x1);
    set_small(?z3, 1);
    var swap:      ^u8   = 0;
    var position:  usize = 255;
    var a:         Field;
    var aa:        Field;
    var b:         Field;
    var bb:        Field;
    var e:         Field;
    var c:         Field;
    var d:         Field;
    var da:        Field;
    var cb:        Field;
    var temporary: Field;
    for (position > 0) {
        position = position - 1;
        val scalar_byte:  usize = position >> 3;
        val scalar_shift: usize = position & 7;
        val bit:          ^u8   = (scalar[scalar_byte] >> scalar_shift) & 1;
        swap = swap ^ bit;
        conditional_swap(swap, ?x2, ?x3);
        conditional_swap(swap, ?z2, ?z3);
        swap = bit;

        add(?a, ?x2, ?z2);
        square(?aa, ?a);
        subtract(?b, ?x2, ?z2);
        square(?bb, ?b);
        subtract(?e, ?aa, ?bb);
        add(?c, ?x3, ?z3);
        subtract(?d, ?x3, ?z3);
        multiply(?da, ?d, ?a);
        multiply(?cb, ?c, ?b);
        add(?temporary, ?da, ?cb);
        square(?x3, ?temporary);
        subtract(?temporary, ?da, ?cb);
        square(?temporary, ?temporary);
        multiply(?z3, ?x1, ?temporary);
        multiply(?x2, ?aa, ?bb);
        multiply_a24(?temporary, ?e);
        add(?temporary, ?aa, ?temporary);
        multiply(?z2, ?e, ?temporary);
    }
    destroy(?a);
    destroy(?aa);
    destroy(?b);
    destroy(?bb);
    destroy(?e);
    destroy(?c);
    destroy(?d);
    destroy(?da);
    destroy(?cb);
    destroy(?temporary);
    conditional_swap(swap, ?x2, ?x3);
    conditional_swap(swap, ?z2, ?z3);
    swap = 0;
    var inverse_z: Field;
    var result:    Field;
    invert(?inverse_z, ?z2);
    multiply(?result, ?x2, ?inverse_z);
    encode(output, ?result);

    ct.zeroize(?scalar[0], 32);
    destroy(?x1);
    destroy(?x2);
    destroy(?z2);
    destroy(?x3);
    destroy(?z3);
    destroy(?inverse_z);
    destroy(?result);
}

# the field differential: the selected product against the bit-serial reference
# on edge elements up to the 2^54 limb bound and a deterministic sweep, compared
# canonically. on a target
# without the hardware cell both sides are the serial path and the test still runs
test "x25519 field: the selected multiply agrees with the serial reference" {
    val edges: [6]u64 = [6]u64{
        0, 1, 2251799813685229, 2251799813685247, 4503599627370495, 18014398509481983
    };
    var state: u64   = 0x9E3779B97F4A7C15;
    var round: usize = 0;
    for (round < 512) {
        var left:  Field;
        var right: Field;
        var i:     usize = 0;
        for (i < 5) {
            state = state * 6364136223846793005 + 1442695040888963407;
            if (round < 36) {
                left.limb[i]  = edges[round / 6];
                right.limb[i] = edges[round % 6];
            }
            or {
                val left_limb: u64 = state & 18014398509481983;
                state = state * 6364136223846793005 + 1442695040888963407;
                val right_limb: u64 = state & 18014398509481983;
                left.limb[i]  = left_limb;
                right.limb[i] = right_limb;
            }
            i = i + 1;
        }
        var selected:  Field;
        var reference: Field;
        var squared:   Field;
        multiply(?selected, ?left, ?right);
        serial_multiply(?reference, ?left, ?right);
        canonicalize(?selected);
        canonicalize(?reference);
        i = 0;
        for (i < 5) {
            if (selected.limb[i]:>u64 != reference.limb[i]:>u64) { ret 1; }
            i = i + 1;
        }
        square(?squared, ?left);
        serial_multiply(?reference, ?left, ?left);
        canonicalize(?squared);
        canonicalize(?reference);
        i = 0;
        for (i < 5) {
            if (squared.limb[i]:>u64 != reference.limb[i]:>u64) { ret 2; }
            i = i + 1;
        }
        multiply_a24(?selected, ?left);
        serial_multiply_a24(?reference, ?left);
        canonicalize(?selected);
        canonicalize(?reference);
        i = 0;
        for (i < 5) {
            if (selected.limb[i]:>u64 != reference.limb[i]:>u64) { ret 3; }
            i = i + 1;
        }
        round = round + 1;
    }
    ret 0;
}

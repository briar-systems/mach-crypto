# constant-shape secp384r1 arithmetic

use crypto.contracts;
use crypto.internal.lift;
use crypto.internal.mont;
use std.crypto.ct;
use std.crypto.hash.sha512;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

val PUBLIC_KEY_SIZE:    usize = 97;
val SIGNATURE_MIN_SIZE: usize = 8;
val SIGNATURE_MAX_SIZE: usize = 104;

# the field and the scalar ring are montgomery rings over six 64-bit limbs
# (crypto.internal.mont). field elements inside a point are in montgomery
# form, times 2^384 mod p; scalars stay in the ordinary domain
val LIMBS: usize = 6;

val PRIME: [6]u64 = [6]u64{
    0x00000000FFFFFFFF, 0xFFFFFFFF00000000, 0xFFFFFFFFFFFFFFFE, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF
};

val ORDER: [6]u64 = [6]u64{
    0xECEC196ACCC52973, 0x581A0DB248B0A77A, 0xC7634D81F4372DDF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF
};

val PRIME_R2: [6]u64 = [6]u64{
    0xFFFFFFFE00000001, 0x0000000200000000, 0xFFFFFFFE00000000, 0x0000000200000000, 0x0000000000000001, 0x0000000000000000
};

val ORDER_R2: [6]u64 = [6]u64{
    0x2D319B2419B409A9, 0xFF3D81E5DF1AA419, 0xBC3E483AFCB82947, 0xD40D49174AAB1CC5, 0x3FB05B7A28266895, 0x0C84EE012B39BF21
};

val PRIME_FACTOR: u64 = 0x0000000100000001;

val ORDER_FACTOR: u64 = 0x6ED46089E88FDC45;

val PRIME_MINUS_TWO: [6]u64 = [6]u64{
    0x00000000FFFFFFFD, 0xFFFFFFFF00000000, 0xFFFFFFFFFFFFFFFE, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF
};

val ORDER_MINUS_TWO: [6]u64 = [6]u64{
    0xECEC196ACCC52971, 0x581A0DB248B0A77A, 0xC7634D81F4372DDF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF
};

val FIELD_ONE: [6]u64 = [6]u64{
    0xFFFFFFFF00000001, 0x00000000FFFFFFFF, 0x0000000000000001, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000
};

val SCALAR_ONE: [6]u64 = [6]u64{
    0x1313E695333AD68D, 0xA7E5F24DB74F5885, 0x389CB27E0BC8D220, 0x0000000000000000, 0x0000000000000000, 0x0000000000000000
};

val CURVE_B: [6]u64 = [6]u64{
    0x081188719D412DCC, 0xF729ADD87A4C32EC, 0x77F2209B1920022E, 0xE3374BEE94938AE2, 0xB62B21F41F022094, 0xCD08114B604FBFF9
};

val GENERATOR_X: [6]u64 = [6]u64{
    0x3DD0756649C0B528, 0x20E378E2A0D6CE38, 0x879C3AFC541B4D6E, 0x6454868459A30EFF, 0x812FF723614EDE2B, 0x4D3AADC2299E1513
};

val GENERATOR_Y: [6]u64 = [6]u64{
    0x23043DAD4B03A4FE, 0xA1BFA8BF7BB4A9AC, 0x8BADE7562E83B050, 0xC6C3521968F4FFD9, 0xDD8002263969A840, 0x2B78ABC25A15C5E9
};

rec UInt {
    limb: [6]^u64;
}

rec Point {
    x: UInt;
    y: UInt;
    z: UInt;
}

#[oblivious]
fun destroy_uint(value: *UInt) {
    if (value == nil) { ret; }
    ct.zeroize((?value.limb[0]):~*^u8, 48);
}

#[oblivious]
fun destroy_point(point: *Point) {
    if (point == nil) { ret; }
    destroy_uint(?point.x);
    destroy_uint(?point.y);
    destroy_uint(?point.z);
}

#[oblivious]
#[inline]
fun nonzero_bit(value: ^u64) ^u8 {
    ret ((value | (0 - value)) >> 63)::^u8;
}

#[oblivious]
fun is_zero(value: *UInt) ^u8 {
    var combined: ^u64  = 0;
    var i:        usize = 0;
    for (i < 6) {
        combined = combined | value.limb[i];
        i        = i + 1;
    }
    val result: ^u8 = 1 ^ nonzero_bit(combined);
    combined = 0;
    ret result;
}

#[oblivious]
fun equal(left: *UInt, right: *UInt) ^u8 {
    var difference: ^u64  = 0;
    var i:          usize = 0;
    for (i < 6) {
        difference = difference | (left.limb[i] ^ right.limb[i]);
        i          = i + 1;
    }
    val result: ^u8 = 1 ^ nonzero_bit(difference);
    difference = 0;
    ret result;
}

#[oblivious]
fun copy(output: *UInt, input: *UInt) {
    var i: usize = 0;
    for (i < 6) {
        output.limb[i] = input.limb[i];
        i              = i + 1;
    }
}

#[oblivious]
fun copy_constant(output: *UInt, input: *u64) {
    var i: usize = 0;
    for (i < 6) {
        output.limb[i] = input[i];
        i              = i + 1;
    }
}

#[oblivious]
fun set_small(output: *UInt, value: u64) {
    output.limb[0] = value;
    var i: usize = 1;
    for (i < 6) {
        output.limb[i] = 0;
        i              = i + 1;
    }
}

#[oblivious]
fun select(output: *UInt, left: *UInt, right: *UInt, choose_right: ^u8) {
    val mask: ^u64  = 0 - choose_right::^u64;
    var i:    usize = 0;
    for (i < 6) {
        output.limb[i] = (left.limb[i] & ~mask) | (right.limb[i] & mask);
        i              = i + 1;
    }
}

#[oblivious]
fun less_than_modulus(value: *UInt, modulus: *u64) ^u8 {
    ret mont.less_than(?value.limb[0], modulus, LIMBS);
}

# raise a montgomery-form value to a public exponent by square-and-multiply
#[oblivious]
fun power_montgomery(output: *UInt, input: *UInt, modulus: *u64,
    exponent: *u64, one: *u64, factor: u64) {
    var result: UInt;
    copy_constant(?result, one);
    var position: usize = 384;
    for (position > 0) {
        position = position - 1;
        mont.square(?result.limb[0], ?result.limb[0], modulus, factor, LIMBS);
        val limb_index: usize = position >> 6;
        val shift:      usize = position & 63;
        if (((exponent[limb_index] >> shift) & 1) == 1) {
            mont.multiply(?result.limb[0], ?result.limb[0], ?input.limb[0], modulus, factor,
                LIMBS);
        }
    }
    copy(output, ?result);
    destroy_uint(?result);
}

#[oblivious]
fun field_add(output: *UInt, left: *UInt, right: *UInt) {
    mont.add(?output.limb[0], ?left.limb[0], ?right.limb[0], ?PRIME[0], LIMBS);
}

#[oblivious]
fun field_subtract(output: *UInt, left: *UInt, right: *UInt) {
    mont.subtract(?output.limb[0], ?left.limb[0], ?right.limb[0], ?PRIME[0], LIMBS);
}

#[oblivious]
fun field_multiply(output: *UInt, left: *UInt, right: *UInt) {
    mont.multiply(?output.limb[0], ?left.limb[0], ?right.limb[0], ?PRIME[0], PRIME_FACTOR,
        LIMBS);
}

#[oblivious]
fun field_square(output: *UInt, input: *UInt) {
    mont.square(?output.limb[0], ?input.limb[0], ?PRIME[0], PRIME_FACTOR, LIMBS);
}

#[oblivious]
fun field_inverse(output: *UInt, input: *UInt) {
    power_montgomery(output, input, (?PRIME[0]):~*u64,
        (?PRIME_MINUS_TWO[0]):~*u64, (?FIELD_ONE[0]):~*u64,
        PRIME_FACTOR);
}

#[oblivious]
fun field_to_montgomery(output: *UInt, input: *UInt) {
    mont.to_montgomery(?output.limb[0], ?input.limb[0], ?PRIME[0], PRIME_FACTOR, ?PRIME_R2[0],
        LIMBS);
}

#[oblivious]
fun field_from_montgomery(output: *UInt, input: *UInt) {
    mont.from_montgomery(?output.limb[0], ?input.limb[0], ?PRIME[0], PRIME_FACTOR, LIMBS);
}

#[oblivious]
fun scalar_multiply_values(output: *UInt, left: *UInt, right: *UInt) {
    mont.multiply_values(?output.limb[0], ?left.limb[0], ?right.limb[0], ?ORDER[0],
        ORDER_FACTOR, ?ORDER_R2[0], LIMBS);
}

#[oblivious]
fun scalar_inverse(output: *UInt, input: *UInt) {
    var montgomery: UInt;
    var inverse:    UInt;
    mont.to_montgomery(?montgomery.limb[0], ?input.limb[0], ?ORDER[0], ORDER_FACTOR,
        ?ORDER_R2[0], LIMBS);
    power_montgomery(?inverse, ?montgomery, (?ORDER[0]):~*u64,
        (?ORDER_MINUS_TWO[0]):~*u64, (?SCALAR_ONE[0]):~*u64,
        ORDER_FACTOR);
    mont.from_montgomery(?output.limb[0], ?inverse.limb[0], ?ORDER[0], ORDER_FACTOR, LIMBS);
    destroy_uint(?montgomery);
    destroy_uint(?inverse);
}

#[oblivious]
fun reduce_scalar_once(value: *UInt) {
    var order: UInt;
    copy_constant(?order, (?ORDER[0]):~*u64);
    # value - n when that does not borrow, else value: the ring subtract adds
    # n back exactly when the subtraction borrows
    mont.subtract(?value.limb[0], ?value.limb[0], ?order.limb[0], ?ORDER[0], LIMBS);
    destroy_uint(?order);
}

#[oblivious]
fun decode_secret(output: *UInt, input: *^u8) {
    var limb: usize = 0;
    for (limb < 6) {
        val offset: usize = 40 - (limb << 3);
        output.limb[limb] = (input[offset]::^u64 << 56) | (input[offset + 1]::^u64 << 48) |
            (input[offset + 2]::^u64 << 40) | (input[offset + 3]::^u64 << 32) |
            (input[offset + 4]::^u64 << 24) | (input[offset + 5]::^u64 << 16) |
            (input[offset + 6]::^u64 << 8) | input[offset + 7]::^u64;
        limb = limb + 1;
    }
}

#[oblivious]
fun decode_public(output: *UInt, input: *u8, base: usize) {
    var limb: usize = 0;
    for (limb < 6) {
        val offset: usize = base + 40 - (limb << 3);
        output.limb[limb] = (input[offset]::u64 << 56) | (input[offset + 1]::u64 << 48) |
            (input[offset + 2]::u64 << 40) | (input[offset + 3]::u64 << 32) |
            (input[offset + 4]::u64 << 24) | (input[offset + 5]::u64 << 16) |
            (input[offset + 6]::u64 << 8) | input[offset + 7]::u64;
        limb = limb + 1;
    }
}

#[oblivious]
fun valid_scalar(value: *UInt) ^u8 {
    ret less_than_modulus(value, (?ORDER[0]):~*u64) & (is_zero(value) ^ 1);
}

#[oblivious]
fun point_copy(output: *Point, input: *Point) {
    copy(?output.x, ?input.x);
    copy(?output.y, ?input.y);
    copy(?output.z, ?input.z);
}

#[oblivious]
fun point_select(output: *Point, left: *Point, right: *Point, choose_right: ^u8) {
    select(?output.x, ?left.x, ?right.x, choose_right);
    select(?output.y, ?left.y, ?right.y, choose_right);
    select(?output.z, ?left.z, ?right.z, choose_right);
}

#[oblivious]
fun point_infinity(output: *Point) {
    set_small(?output.x, 0);
    copy_constant(?output.y, (?FIELD_ONE[0]):~*u64);
    set_small(?output.z, 0);
}

#[oblivious]
fun generator(output: *Point) {
    copy_constant(?output.x, (?GENERATOR_X[0]):~*u64);
    copy_constant(?output.y, (?GENERATOR_Y[0]):~*u64);
    copy_constant(?output.z, (?FIELD_ONE[0]):~*u64);
}

#[oblivious]
fun point_is_infinity(point: *Point) ^u8 {
    ret is_zero(?point.z);
}

#[oblivious]
fun point_double(output: *Point, input: *Point) {
    var delta:         UInt;
    var gamma:         UInt;
    var beta:          UInt;
    var alpha:         UInt;
    var first:         UInt;
    var second:        UInt;
    var temporary:     UInt;
    var gamma_squared: UInt;
    var result:        Point;

    field_square(?delta, ?input.z);
    field_square(?gamma, ?input.y);
    field_multiply(?beta, ?input.x, ?gamma);
    field_subtract(?first, ?input.x, ?delta);
    field_add(?second, ?input.x, ?delta);
    field_multiply(?alpha, ?first, ?second);
    field_add(?temporary, ?alpha, ?alpha);
    field_add(?alpha, ?temporary, ?alpha);

    field_square(?result.x, ?alpha);
    field_add(?temporary, ?beta, ?beta);
    field_add(?temporary, ?temporary, ?temporary);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?result.x, ?result.x, ?temporary);

    field_add(?temporary, ?input.y, ?input.z);
    field_square(?result.z, ?temporary);
    field_subtract(?result.z, ?result.z, ?gamma);
    field_subtract(?result.z, ?result.z, ?delta);

    field_add(?temporary, ?beta, ?beta);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?temporary, ?temporary, ?result.x);
    field_multiply(?result.y, ?alpha, ?temporary);
    field_square(?gamma_squared, ?gamma);
    field_add(?temporary, ?gamma_squared, ?gamma_squared);
    field_add(?temporary, ?temporary, ?temporary);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?result.y, ?result.y, ?temporary);

    point_copy(output, ?result);
    destroy_uint(?delta);
    destroy_uint(?gamma);
    destroy_uint(?beta);
    destroy_uint(?alpha);
    destroy_uint(?first);
    destroy_uint(?second);
    destroy_uint(?temporary);
    destroy_uint(?gamma_squared);
    destroy_point(?result);
}

#[oblivious]
fun point_add(output: *Point, left: *Point, right: *Point) {
    var left_saved:  Point;
    var right_saved: Point;
    point_copy(?left_saved, left);
    point_copy(?right_saved, right);
    val left_infinity:  ^u8 = point_is_infinity(?left_saved);
    val right_infinity: ^u8 = point_is_infinity(?right_saved);
    var z1z1:           UInt;
    var z2z2:           UInt;
    var u1:             UInt;
    var u2:             UInt;
    var s1:             UInt;
    var s2:             UInt;
    var h:              UInt;
    var i_value:        UInt;
    var j:              UInt;
    var r:              UInt;
    var v:              UInt;
    var temporary:      UInt;
    var generic:        Point;
    var doubled:        Point;

    field_square(?z1z1, ?left.z);
    field_square(?z2z2, ?right.z);
    field_multiply(?u1, ?left.x, ?z2z2);
    field_multiply(?u2, ?right.x, ?z1z1);
    field_multiply(?temporary, ?right.z, ?z2z2);
    field_multiply(?s1, ?left.y, ?temporary);
    field_multiply(?temporary, ?left.z, ?z1z1);
    field_multiply(?s2, ?right.y, ?temporary);
    field_subtract(?h, ?u2, ?u1);
    field_add(?temporary, ?h, ?h);
    field_square(?i_value, ?temporary);
    field_multiply(?j, ?h, ?i_value);
    field_subtract(?temporary, ?s2, ?s1);
    field_add(?r, ?temporary, ?temporary);
    field_multiply(?v, ?u1, ?i_value);

    field_square(?generic.x, ?r);
    field_subtract(?generic.x, ?generic.x, ?j);
    field_add(?temporary, ?v, ?v);
    field_subtract(?generic.x, ?generic.x, ?temporary);
    field_subtract(?temporary, ?v, ?generic.x);
    field_multiply(?generic.y, ?r, ?temporary);
    field_multiply(?temporary, ?s1, ?j);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?generic.y, ?generic.y, ?temporary);
    field_add(?temporary, ?left.z, ?right.z);
    field_square(?generic.z, ?temporary);
    field_subtract(?generic.z, ?generic.z, ?z1z1);
    field_subtract(?generic.z, ?generic.z, ?z2z2);
    field_multiply(?generic.z, ?generic.z, ?h);

    point_double(?doubled, left);
    point_copy(output, ?generic);
    val same: ^u8 = is_zero(?h) & is_zero(?r);
    point_select(output, output, ?doubled, same);
    point_select(output, output, ?right_saved, left_infinity);
    point_select(output, output, ?left_saved, right_infinity);

    destroy_point(?left_saved);
    destroy_point(?right_saved);
    destroy_uint(?z1z1);
    destroy_uint(?z2z2);
    destroy_uint(?u1);
    destroy_uint(?u2);
    destroy_uint(?s1);
    destroy_uint(?s2);
    destroy_uint(?h);
    destroy_uint(?i_value);
    destroy_uint(?j);
    destroy_uint(?r);
    destroy_uint(?v);
    destroy_uint(?temporary);
    destroy_point(?generic);
    destroy_point(?doubled);
}

#[oblivious]
fun double_scalar_multiply(output: *Point, first_scalar: *UInt,
    second_scalar: *UInt, point: *Point) {
    var result:    Point;
    var basepoint: Point;
    var combined:  Point;
    var selected:  Point;
    point_infinity(?result);
    generator(?basepoint);
    point_add(?combined, ?basepoint, point);
    var position: usize = 384;
    for (position > 0) {
        position = position - 1;
        point_double(?result, ?result);
        val limb_index: usize = position >> 6;
        val shift:      usize = position & 63;
        val take_first: ^u8   =
            ((first_scalar.limb[limb_index] >> shift) & 1)::^u8;
        val take_second: ^u8 =
            ((second_scalar.limb[limb_index] >> shift) & 1)::^u8;
        point_infinity(?selected);
        point_select(?selected, ?selected, ?basepoint,
            take_first & (take_second ^ 1));
        point_select(?selected, ?selected, point,
            take_second & (take_first ^ 1));
        point_select(?selected, ?selected, ?combined,
            take_first & take_second);
        point_add(?result, ?result, ?selected);
    }
    point_copy(output, ?result);
    destroy_point(?result);
    destroy_point(?basepoint);
    destroy_point(?combined);
    destroy_point(?selected);
}

#[oblivious]
fun to_affine(x: *UInt, y: *UInt, point: *Point) {
    var inverse:         UInt;
    var inverse_squared: UInt;
    var inverse_cubed:   UInt;
    field_inverse(?inverse, ?point.z);
    field_square(?inverse_squared, ?inverse);
    field_multiply(?inverse_cubed, ?inverse_squared, ?inverse);
    field_multiply(x, ?point.x, ?inverse_squared);
    field_multiply(y, ?point.y, ?inverse_cubed);
    destroy_uint(?inverse);
    destroy_uint(?inverse_squared);
    destroy_uint(?inverse_cubed);
}

#[oblivious]
fun parse_point(output: *Point, input: *u8) ^u8 {
    var x: UInt;
    var y: UInt;
    decode_public(?x, input, 1);
    decode_public(?y, input, 49);
    val x_canonical: ^u8 = less_than_modulus(?x, (?PRIME[0]):~*u64);
    val y_canonical: ^u8 = less_than_modulus(?y, (?PRIME[0]):~*u64);
    field_to_montgomery(?output.x, ?x);
    field_to_montgomery(?output.y, ?y);
    copy_constant(?output.z, (?FIELD_ONE[0]):~*u64);
    var left:      UInt;
    var right:     UInt;
    var temporary: UInt;
    field_square(?left, ?output.y);
    field_square(?right, ?output.x);
    field_multiply(?right, ?right, ?output.x);
    field_add(?temporary, ?output.x, ?output.x);
    field_add(?temporary, ?temporary, ?output.x);
    field_subtract(?right, ?right, ?temporary);
    copy_constant(?temporary, (?CURVE_B[0]):~*u64);
    field_add(?right, ?right, ?temporary);
    val on_curve: ^u8 = equal(?left, ?right);
    destroy_uint(?x);
    destroy_uint(?y);
    destroy_uint(?left);
    destroy_uint(?right);
    destroy_uint(?temporary);
    ret x_canonical & y_canonical & on_curve;
}

fun parse_der_integer(output: *UInt, input: *u8, offset: usize,
    length: usize) bool {
    if (length == 0 || length > 49)  { ret false; }
    if ((input[offset] & 0x80) != 0) { ret false; }
    if (length > 1 && input[offset] == 0 && (input[offset + 1] & 0x80) == 0) {
        ret false;
    }
    if (length == 49 && input[offset] != 0) { ret false; }
    var encoded: [48]u8;
    var i:       usize = 0;
    for (i < 48) {
        encoded[i] = 0;
        i          = i + 1;
    }
    var skip: usize = 0;
    if (length == 49) { skip = 1; }
    val significant: usize = length - skip;
    i = 0;
    for (i < significant) {
        encoded[48 - significant + i] = input[offset + skip + i];
        i                             = i + 1;
    }
    decode_public(output, ?encoded[0], 0);
    ret true;
}

fun parse_signature(r: *UInt, s: *UInt, signature: contracts.Bytes) bool {
    if (signature.len < SIGNATURE_MIN_SIZE || signature.len > SIGNATURE_MAX_SIZE) {
        ret false;
    }
    if (signature.data[0] != 0x30 || signature.data[1]::usize != signature.len - 2) {
        ret false;
    }
    if (signature.data[2] != 0x02) { ret false; }
    val r_length: usize = signature.data[3]::usize;
    if (r_length == 0 || r_length > 49) { ret false; }
    val s_tag: usize = 4 + r_length;
    if (s_tag + 2 > signature.len || signature.data[s_tag] != 0x02) { ret false; }
    val s_length: usize = signature.data[s_tag + 1]::usize;
    if (s_tag + 2 + s_length != signature.len)                      { ret false; }
    if (!parse_der_integer(r, signature.data, 4, r_length))         { ret false; }
    if (!parse_der_integer(s, signature.data, s_tag + 2, s_length)) { ret false; }
    ret true;
}

#[oblivious]
fun hash_message(message: contracts.Bytes, digest: *^u8) contracts.Error {
    var state: sha512.SecretState384;
    state = sha512.init_secret384();
    if (!lift.update384_public(?state, message.data, message.len)) {
        sha512.destroy_secret384(?state);
        ret contracts.INVALID_INPUT;
    }
    sha512.final_secret384(?state, digest);
    sha512.destroy_secret384(?state);
    ret contracts.OK;
}

#[oblivious]
pub fun valid_public_point(value: contracts.Bytes) bool {
    if (value.len != PUBLIC_KEY_SIZE || value.data == nil || value.data[0] != 4) {
        ret false;
    }
    var point: Point;
    val valid: ^u8 = parse_point(?point, value.data);
    destroy_point(?point);
    ret valid:>u8 == 1;
}

#[oblivious]
pub fun verify_sha384(public_key: contracts.Bytes, message: contracts.Bytes,
    signature: contracts.Bytes) contracts.Error {
    if (public_key.len != PUBLIC_KEY_SIZE)           { ret contracts.INVALID_KEY; }
    if (public_key.data == nil)                      { ret contracts.INVALID_INPUT; }
    if (public_key.data[0] != 0x04)                  { ret contracts.INVALID_KEY; }
    if (message.len != 0 && message.data == nil)     { ret contracts.INVALID_INPUT; }
    if (signature.len != 0 && signature.data == nil) { ret contracts.INVALID_INPUT; }

    ct.begin();
    var peer:        Point;
    val point_valid: ^u8 = parse_point(?peer, public_key.data);
    if (point_valid:>u8 != 1) {
        destroy_point(?peer);
        ct.end();
        ret contracts.INVALID_KEY;
    }
    var r: UInt;
    var s: UInt;
    if (!parse_signature(?r, ?s, signature)) {
        destroy_point(?peer);
        destroy_uint(?r);
        destroy_uint(?s);
        ct.end();
        ret contracts.AUTH_FAILED;
    }
    val r_valid: ^u8 = valid_scalar(?r);
    val s_valid: ^u8 = valid_scalar(?s);
    if ((r_valid & s_valid):>u8 != 1) {
        destroy_point(?peer);
        destroy_uint(?r);
        destroy_uint(?s);
        ct.end();
        ret contracts.AUTH_FAILED;
    }
    var digest:      [48]^u8;
    val hash_status: contracts.Error = hash_message(message, ?digest[0]);
    if (hash_status != contracts.OK) {
        destroy_point(?peer);
        destroy_uint(?r);
        destroy_uint(?s);
        ct.zeroize(?digest[0], 48);
        ct.end();
        ret hash_status;
    }
    var hash_scalar: UInt;
    var inverse:     UInt;
    var u1:          UInt;
    var u2:          UInt;
    var sum:         Point;
    var x:           UInt;
    var y:           UInt;
    decode_secret(?hash_scalar, ?digest[0]);
    reduce_scalar_once(?hash_scalar);
    ct.zeroize(?digest[0], 48);
    scalar_inverse(?inverse, ?s);
    scalar_multiply_values(?u1, ?hash_scalar, ?inverse);
    scalar_multiply_values(?u2, ?r, ?inverse);
    double_scalar_multiply(?sum, ?u1, ?u2, ?peer);
    val infinity: ^u8 = point_is_infinity(?sum);
    to_affine(?x, ?y, ?sum);
    field_from_montgomery(?x, ?x);
    reduce_scalar_once(?x);
    val matches: ^u8             = equal(?x, ?r) & (infinity ^ 1);
    var result:  contracts.Error = contracts.AUTH_FAILED;
    if (matches:>u8 == 1) { result = contracts.OK; }
    destroy_point(?peer);
    destroy_uint(?r);
    destroy_uint(?s);
    destroy_uint(?hash_scalar);
    destroy_uint(?inverse);
    destroy_uint(?u1);
    destroy_uint(?u2);
    destroy_point(?sum);
    destroy_uint(?x);
    destroy_uint(?y);
    ct.end();
    ret result;
}

test "p384 internal: constants are the montgomery forms of the nist values" {
    if (PRIME[0] != 0x00000000FFFFFFFF || ORDER[0] != 0xECEC196ACCC52973) { ret 1; }
    var x: UInt;
    var y: UInt;
    copy_constant(?x, (?GENERATOR_X[0]):~*u64);
    copy_constant(?y, (?GENERATOR_Y[0]):~*u64);
    field_from_montgomery(?x, ?x);
    field_from_montgomery(?y, ?y);
    if (x.limb[5]:>u64 != 0xAA87CA22BE8B0537 || x.limb[0]:>u64 != 0x3A545E3872760AB7) { ret 2; }
    if (y.limb[5]:>u64 != 0x3617DE4A96262C6F || y.limb[0]:>u64 != 0x7A431D7C90EA0E5F) { ret 3; }
    ret 0;
}

test "p384 internal: montgomery arithmetic matches small values" {
    var one:    UInt;
    var two:    UInt;
    var three:  UInt;
    var value:  UInt;
    var normal: UInt;
    set_small(?one, 1);
    set_small(?two, 2);
    set_small(?three, 3);
    field_to_montgomery(?value, ?one);
    field_from_montgomery(?normal, ?value);
    if (equal(?normal, ?one):>u8 != 1) { ret 1; }
    field_square(?value, ?value);
    field_from_montgomery(?normal, ?value);
    if (equal(?normal, ?one):>u8 != 1) { ret 5; }
    field_inverse(?value, ?value);
    field_from_montgomery(?normal, ?value);
    if (equal(?normal, ?one):>u8 != 1) { ret 6; }
    field_to_montgomery(?value, ?two);
    field_to_montgomery(?normal, ?three);
    field_multiply(?value, ?value, ?normal);
    field_from_montgomery(?normal, ?value);
    set_small(?one, 6);
    if (equal(?normal, ?one):>u8 != 1) { ret 2; }
    scalar_multiply_values(?value, ?two, ?three);
    if (equal(?value, ?one):>u8 != 1) { ret 3; }
    scalar_inverse(?value, ?two);
    scalar_multiply_values(?normal, ?value, ?two);
    set_small(?one, 1);
    if (equal(?normal, ?one):>u8 != 1) { ret 4; }
    destroy_uint(?one);
    destroy_uint(?two);
    destroy_uint(?three);
    destroy_uint(?value);
    destroy_uint(?normal);
    ret 0;
}

test "p384 internal: modular products match independent big integers" {
    val field_left: [6]u64 = [6]u64{
        0x8899AABBCCDDEEFF, 0x0011223344556677, 0x0123456789ABCDEF,
        0x899AABBCCDDEEFF0, 0x0112233445566778, 0x123456789ABCDEF0
    };
    val field_right: [6]u64 = [6]u64{
        0xEEFF001122334455, 0x66778899AABBCCDD, 0xEEFF001122334455,
        0x66778899AABBCCDD, 0xBABE001122334455, 0x0000DEADBEEFCAFE
    };
    val field_product: [6]u64 = [6]u64{
        0xD3FB93732F3D345C, 0x6A774C4A30EE1EA9, 0x893E1F40FB846D37,
        0xC1EB9FAE78FA63D1, 0x056E18722AF4DBEA, 0xA6FB845427CB99DD
    };
    val scalar_left: [6]u64 = [6]u64{
        0xDF91CC9B08568909, 0x21FE1E118779BD35, 0x6D2E3652184BF167,
        0xE303C4A5E24A2A02, 0x000018AD00E923A7, 0x0000000000000000
    };
    val scalar_right: [6]u64 = [6]u64{
        0xAA4D7AB15536FDA2, 0x2125109BC1F959DE, 0x33B467FE17B210BF,
        0xA33EBAB8E08A133C, 0x00001559D339C386, 0x0000000000000000
    };
    val scalar_product: [6]u64 = [6]u64{
        0x9582205D4ED17529, 0x01A08EC2D2B72176, 0xB6471C10E3E29D3A,
        0x2DD5CE0FC1C9A028, 0x07CBD376035A3E23, 0xEF82E201D7D35DA2
    };
    var left:     UInt;
    var right:    UInt;
    var expected: UInt;
    var result:   UInt;
    copy_constant(?left, (?field_left[0]):~*u64);
    copy_constant(?right, (?field_right[0]):~*u64);
    copy_constant(?expected, (?field_product[0]):~*u64);
    field_to_montgomery(?left, ?left);
    field_to_montgomery(?right, ?right);
    field_multiply(?result, ?left, ?right);
    field_from_montgomery(?result, ?result);
    if (equal(?result, ?expected):>u8 != 1) { ret 1; }
    copy_constant(?left, (?scalar_left[0]):~*u64);
    copy_constant(?right, (?scalar_right[0]):~*u64);
    copy_constant(?expected, (?scalar_product[0]):~*u64);
    scalar_multiply_values(?result, ?left, ?right);
    if (equal(?result, ?expected):>u8 != 1) { ret 2; }
    destroy_uint(?left);
    destroy_uint(?right);
    destroy_uint(?expected);
    destroy_uint(?result);
    ret 0;
}

test "p384 internal: interleaved multiplication preserves each input" {
    var zero:   UInt;
    var one:    UInt;
    var point:  Point;
    var result: Point;
    var x:      UInt;
    var y:      UInt;
    set_small(?zero, 0);
    set_small(?one, 1);
    generator(?point);
    field_from_montgomery(?x, ?point.x);
    if (x.limb[0]:>u64 != 0x3A545E3872760AB7 || x.limb[5]:>u64 != 0xAA87CA22BE8B0537) {
        ret 1;
    }
    field_multiply(?x, ?point.x, ?point.z);
    field_from_montgomery(?x, ?x);
    if (x.limb[0]:>u64 != 0x3A545E3872760AB7 || x.limb[5]:>u64 != 0xAA87CA22BE8B0537) {
        ret 2;
    }
    to_affine(?x, ?y, ?point);
    field_from_montgomery(?x, ?x);
    if (x.limb[0]:>u64 != 0x3A545E3872760AB7 || x.limb[5]:>u64 != 0xAA87CA22BE8B0537) {
        ret 3;
    }
    double_scalar_multiply(?result, ?one, ?zero, ?point);
    to_affine(?x, ?y, ?result);
    field_from_montgomery(?x, ?x);
    if (x.limb[0]:>u64 != 0x3A545E3872760AB7 || x.limb[5]:>u64 != 0xAA87CA22BE8B0537) {
        ret 4;
    }
    double_scalar_multiply(?result, ?zero, ?one, ?point);
    to_affine(?x, ?y, ?result);
    field_from_montgomery(?x, ?x);
    if (x.limb[0]:>u64 != 0x3A545E3872760AB7 || x.limb[5]:>u64 != 0xAA87CA22BE8B0537) {
        ret 5;
    }
    destroy_uint(?zero);
    destroy_uint(?one);
    destroy_point(?point);
    destroy_point(?result);
    destroy_uint(?x);
    destroy_uint(?y);
    ret 0;
}

# gcm's ghash behind one keyed context, over interchangeable backends
#
# the hash key is installed once per aead key and kept in Key. a message is
# hashed through a State the caller owns for one record. the member is chosen
# when the key is installed, independently of the aes member, since a host can
# carry aes without carry-less multiply.
#
# the contract every member holds:
# - its key is a case of Keys with secret-typed words, and it may hold any
#   precomputation of h (a hardware member keeps powers of h). the cases share
#   storage, since a key runs one member
# - `absorb` takes whole 16-byte blocks of public data, any number of them, so
#   a member may aggregate several blocks per reduction
# - the accumulator is the canonical field element, two big-endian 64-bit
#   words, so State never depends on the member
# - every operation is constant time: no branch or address depends on h or on
#   the accumulator
# - `wipe` zeroizes the whole key
# `destroy` wipes every member's key, which covers the whole storage whichever
# member held it.
#
# software is the portable member and runs everywhere. hardware is pclmulqdq
# on x86_64 and pmull on aarch64, available where crypto.internal.extensions
# says the host has them, and `preferred` picks it there.

use crypto.contracts;
use crypto.internal.ghash.hardware;
use crypto.internal.ghash.software;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val BLOCK_SIZE: usize = 16;

pub def Backend: u8;

pub val NONE:     Backend = 0;
pub val SOFTWARE: Backend = 1;
pub val HARDWARE: Backend = 2;

# the key of whichever member the hash runs
pub uni Keys {
    software: software.Key;
    hardware: hardware.Key;
}

pub rec Key {
    member:  Keys;
    backend: Backend;
}

# the running hash of one record
pub rec State {
    accumulator: [2]^u64;
}

# whether this host can run the backend
pub fun available(backend: Backend) bool {
    if (backend == SOFTWARE) { ret true; }
    if (backend == HARDWARE) { ret hardware.available(); }
    ret false;
}

# the fastest backend this host can run
pub fun preferred() Backend {
    if (hardware.available()) { ret HARDWARE; }
    ret SOFTWARE;
}

pub fun destroy(key: *Key) {
    software.wipe(?key.member.software);
    hardware.wipe(?key.member.hardware);
    key.backend = NONE;
}

# install the 16-byte hash subkey with a named backend
#[oblivious]
pub fun init(key: *Key, subkey: *^u8, backend: Backend) contracts.Error {
    destroy(key);
    if (!available(backend)) { ret contracts.UNSUPPORTED; }
    if (backend == HARDWARE) { hardware.expand(?key.member.hardware, subkey); }
    or                       { software.expand(?key.member.software, subkey); }
    key.backend = backend;
    ret contracts.OK;
}

#[oblivious]
pub fun start(state: *State) {
    state.accumulator[0] = 0;
    state.accumulator[1] = 0;
}

#[oblivious]
fun absorb(key: *Key, state: *State, data: *u8, blocks: usize) {
    if (key.backend == HARDWARE) {
        hardware.absorb(?key.member.hardware, ?state.accumulator[0], data, blocks);
        ret;
    }
    software.absorb(?key.member.software, ?state.accumulator[0], data, blocks);
}

# hash public bytes, zero-padding a final partial block
pub fun update(key: *Key, state: *State, data: *u8, len: usize) {
    val whole: usize = len / BLOCK_SIZE;
    if (whole != 0) { absorb(key, state, data, whole); }
    val tail: usize = len - whole * BLOCK_SIZE;
    if (tail == 0) { ret; }
    var block: [16]u8;
    var i:     usize = 0;
    for (i < BLOCK_SIZE) {
        block[i] = 0;
        if (i < tail) { block[i] = data[whole * BLOCK_SIZE + i]; }
        i = i + 1;
    }
    absorb(key, state, ?block[0], 1);
}

# hash the closing block of aad and text bit lengths
pub fun lengths(key: *Key, state: *State, aad_len: usize, text_len: usize) {
    val aad_bits:  u64   = aad_len::u64 * 8;
    val text_bits: u64   = text_len::u64 * 8;
    var block:     [16]u8;
    var i:         usize = 0;
    for (i < 8) {
        block[i]     = (aad_bits >> ((7 - i) * 8)::u64)::u8;
        block[8 + i] = (text_bits >> ((7 - i) * 8)::u64)::u8;
        i            = i + 1;
    }
    absorb(key, state, ?block[0], 1);
}

# write the 16-byte hash
#[oblivious]
pub fun finish(state: *State, output: *^u8) {
    var i: usize = 0;
    for (i < 8) {
        output[i]     = (state.accumulator[0] >> ((7 - i) * 8)::u64)::^u8;
        output[8 + i] = (state.accumulator[1] >> ((7 - i) * 8)::u64)::^u8;
        i             = i + 1;
    }
}

pub fun wipe(state: *State) {
    ct.zeroize((?state.accumulator[0]):~*^u8, 16);
}

# splitmix64, a fixed stream so a failure reproduces
fun next_random(state: *u64) u64 {
    @state = @state + 0x9E3779B97F4A7C15;
    var z: u64 = @state;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    ret z ^ (z >> 31);
}

# hash `data` as aad and text split at `split`, the way aes-gcm feeds it
fun hash_record(key: *Key, data: *u8, len: usize, split: usize, output: *^u8) {
    var state: State;
    start(?state);
    update(key, ?state, data, split);
    update(key, ?state, ?data[split], len - split);
    lengths(key, ?state, split, len - split);
    finish(?state, output);
}

test "ghash: hardware and software members agree over random keys, splits and lengths" {
    if (!available(HARDWARE)) {
        # a member the host lacks is refused and leaves the key empty
        var subkey: [16]^u8;
        var key:    Key;
        if (init(?key, ?subkey[0], HARDWARE) != contracts.UNSUPPORTED) { ret 1; }
        if (key.backend != NONE)                                       { ret 2; }
        ret 0;
    }
    var state:    u64   = 128;
    var data:     [512]u8;
    var hardware: Key;
    var software: Key;
    var len:      usize = 0;
    for (len <= 512) {
        var subkey: [16]^u8;
        var i:      usize = 0;
        for (i < 16) {
            subkey[i] = next_random(?state)::u8;
            i         = i + 1;
        }
        # the zero and all-ones keys reach the reduction's edges
        if (len == 1) { ct.zeroize(?subkey[0], 16); }
        or (len == 2) {
            i = 0;
            for (i < 16) {
                subkey[i] = 0xFF;
                i         = i + 1;
            }
        }
        i = 0;
        for (i < len) {
            data[i] = next_random(?state)::u8;
            i       = i + 1;
        }
        var split: usize = 0;
        if (len != 0)                                              { split = (next_random(?state) % (len::u64 + 1))::usize; }
        if (init(?hardware, ?subkey[0], HARDWARE) != contracts.OK) { ret 3; }
        if (init(?software, ?subkey[0], SOFTWARE) != contracts.OK) { ret 4; }
        var left:  [16]^u8;
        var right: [16]^u8;
        hash_record(?hardware, ?data[0], len, split, ?left[0]);
        hash_record(?software, ?data[0], len, split, ?right[0]);
        i = 0;
        for (i < 16) {
            if (left[i]:>u8 != right[i]:>u8) { ret 5; }
            i = i + 1;
        }
        destroy(?hardware);
        destroy(?software);
        len = len + 1;
    }
    ret 0;
}

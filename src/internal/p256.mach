# constant-shape secp256r1 arithmetic

use std.crypto.ct;
use std.types.size.usize;

val WORD_MASK: u64 = 0xFFFFFFFF;

val PRIME: [8]u64 = [8]u64{
    0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x00000000,
    0x00000000, 0x00000000, 0x00000001, 0xFFFFFFFF
};

val ORDER: [8]u64 = [8]u64{
    0xFC632551, 0xF3B9CAC2, 0xA7179E84, 0xBCE6FAAD,
    0xFFFFFFFF, 0xFFFFFFFF, 0x00000000, 0xFFFFFFFF
};

val PRIME_MINUS_TWO: [8]u64 = [8]u64{
    0xFFFFFFFD, 0xFFFFFFFF, 0xFFFFFFFF, 0x00000000,
    0x00000000, 0x00000000, 0x00000001, 0xFFFFFFFF
};

val ORDER_R2: [8]u64 = [8]u64{
    0xBE79EEA2, 0x83244C95, 0x49BD6FA6, 0x4699799C,
    0x2B6BEC59, 0x2845B239, 0xF3D95620, 0x66E12D94
};

val SCALAR_ONE: [8]u64 = [8]u64{
    0x039CDAAF, 0x0C46353D, 0x58E8617B, 0x43190552,
    0x00000000, 0x00000000, 0xFFFFFFFF, 0x00000000
};

val ORDER_MONT_FACTOR: u64 = 0xEE00BC4F;

val ORDER_MINUS_TWO: [8]u64 = [8]u64{
    0xFC63254F, 0xF3B9CAC2, 0xA7179E84, 0xBCE6FAAD,
    0xFFFFFFFF, 0xFFFFFFFF, 0x00000000, 0xFFFFFFFF
};

val CURVE_B: [8]u64 = [8]u64{
    0x27D2604B, 0x3BCE3C3E, 0xCC53B0F6, 0x651D06B0,
    0x769886BC, 0xB3EBBD55, 0xAA3A93E7, 0x5AC635D8
};

val GENERATOR_X: [8]u64 = [8]u64{
    0xD898C296, 0xF4A13945, 0x2DEB33A0, 0x77037D81,
    0x63A440F2, 0xF8BCE6E5, 0xE12C4247, 0x6B17D1F2
};

val GENERATOR_Y: [8]u64 = [8]u64{
    0x37BF51F5, 0xCBB64068, 0x6B315ECE, 0x2BCE3357,
    0x7C0F9E16, 0x8EE7EB4A, 0xFE1A7F9B, 0x4FE342E2
};

pub rec UInt {
    limb: [8]^u64;
}

pub rec Point {
    x: UInt;
    y: UInt;
    z: UInt;
}

#[oblivious]
pub fun destroy_uint(value: *UInt) {
    if (value == nil) { ret; }
    ct.zeroize((?value.limb[0]):~*^u8, 64);
}

#[oblivious]
pub fun destroy_point(point: *Point) {
    if (point == nil) { ret; }
    destroy_uint(?point.x);
    destroy_uint(?point.y);
    destroy_uint(?point.z);
}

#[oblivious]
#[inline]
fun nonzero_bit(value: ^u64) ^u8 {
    ret ((value | (0 - value)) >> 63)::^u8;
}

#[oblivious]
pub fun is_zero(value: *UInt) ^u8 {
    var combined: ^u64  = 0;
    var i:        usize = 0;
    for (i < 8) {
        combined = combined | value.limb[i];
        i        = i + 1;
    }
    val result: ^u8 = 1 ^ nonzero_bit(combined);
    combined = 0;
    ret result;
}

#[oblivious]
pub fun equal(left: *UInt, right: *UInt) ^u8 {
    var difference: ^u64  = 0;
    var i:          usize = 0;
    for (i < 8) {
        difference = difference | (left.limb[i] ^ right.limb[i]);
        i          = i + 1;
    }
    val result: ^u8 = 1 ^ nonzero_bit(difference);
    difference = 0;
    ret result;
}

#[oblivious]
pub fun copy(output: *UInt, input: *UInt) {
    var i: usize = 0;
    for (i < 8) {
        output.limb[i] = input.limb[i];
        i              = i + 1;
    }
}

#[oblivious]
fun copy_constant(output: *UInt, input: *u64) {
    var i: usize = 0;
    for (i < 8) {
        output.limb[i] = input[i];
        i              = i + 1;
    }
}

#[oblivious]
pub fun set_small(output: *UInt, value: u64) {
    output.limb[0] = value;
    var i: usize = 1;
    for (i < 8) {
        output.limb[i] = 0;
        i              = i + 1;
    }
}

#[oblivious]
pub fun select(output: *UInt, left: *UInt, right: *UInt, choose_right: ^u8) {
    val mask: ^u64  = 0 - choose_right::^u64;
    var i:    usize = 0;
    for (i < 8) {
        output.limb[i] = (left.limb[i] & ~mask) | (right.limb[i] & mask);
        i              = i + 1;
    }
}

#[oblivious]
fun less_than_modulus(value: *UInt, modulus: *u64) ^u8 {
    var borrow: ^u64  = 0;
    var i:      usize = 0;
    for (i < 8) {
        val difference: ^u64 = value.limb[i] - modulus[i] - borrow;
        borrow = difference >> 63;
        i      = i + 1;
    }
    val result: ^u8 = borrow::^u8;
    borrow = 0;
    ret result;
}

#[oblivious]
fun add_mod(output: *UInt, left: *UInt, right: *UInt, modulus: *u64) {
    var sum:     UInt;
    var reduced: UInt;
    var carry:   ^u64  = 0;
    var i:       usize = 0;
    for (i < 8) {
        val word: ^u64 = left.limb[i] + right.limb[i] + carry;
        sum.limb[i] = word & WORD_MASK;
        carry       = word >> 32;
        i           = i + 1;
    }
    var borrow: ^u64 = 0;
    i = 0;
    for (i < 8) {
        val difference: ^u64 = sum.limb[i] - modulus[i] - borrow;
        reduced.limb[i] = difference & WORD_MASK;
        borrow          = difference >> 63;
        i               = i + 1;
    }
    val use_reduced: ^u8 = (carry | (borrow ^ 1))::^u8;
    select(output, ?sum, ?reduced, use_reduced);
    carry  = 0;
    borrow = 0;
    destroy_uint(?sum);
    destroy_uint(?reduced);
}

#[oblivious]
fun subtract_mod(output: *UInt, left: *UInt, right: *UInt, modulus: *u64) {
    var difference: UInt;
    var borrow:     ^u64  = 0;
    var i:          usize = 0;
    for (i < 8) {
        val word: ^u64 = left.limb[i] - right.limb[i] - borrow;
        difference.limb[i] = word & WORD_MASK;
        borrow             = word >> 63;
        i                  = i + 1;
    }
    val mask:  ^u64 = 0 - borrow;
    var carry: ^u64 = 0;
    i = 0;
    for (i < 8) {
        val word: ^u64 = difference.limb[i] + (modulus[i] & mask) + carry;
        output.limb[i] = word & WORD_MASK;
        carry          = word >> 32;
        i              = i + 1;
    }
    borrow = 0;
    carry  = 0;
    destroy_uint(?difference);
}

# multiply two 32-bit words without a native multiply, which is gated on secrets
#[oblivious]
#[inline]
fun multiply_words(left: ^u64, right: ^u64) ^u64 {
    var product:  ^u64 = 0;
    var position: u64  = 0;
    for (position < 32) {
        val bit: ^u64 = (right >> position) & 1;
        product  = product + ((left & (0 - bit)) << position);
        position = position + 1;
    }
    ret product;
}

#[oblivious]
#[inline]
fun accumulate(product: *^u64, index: usize, word: ^u64) {
    product[index]     = product[index] + (word & WORD_MASK);
    product[index + 1] = product[index + 1] + (word >> 32);
}

# reduce a 512-bit product of 32-bit words modulo p with the nist solinas identity
#
# the product words may carry lazily above 32 bits. every step is additions,
# subtractions and fixed shifts, so the reduction has one shape for every input.
#[oblivious]
fun reduce_field(output: *UInt, product: *^u64) {
    var c:     [16]^i64;
    var carry: ^u64  = 0;
    var i:     usize = 0;
    for (i < 16) {
        val word: ^u64 = product[i] + carry;
        c[i]  = (word & WORD_MASK)::^i64;
        carry = word >> 32;
        i     = i + 1;
    }

    var w: [8]^i64;
    w[0] = c[0] + c[8] + c[9] - c[11] - c[12] - c[13] - c[14];
    w[1] = c[1] + c[9] + c[10] - c[12] - c[13] - c[14] - c[15];
    w[2] = c[2] + c[10] + c[11] - c[13] - c[14] - c[15];
    w[3] = c[3] + (c[11] << 1) + (c[12] << 1) + c[13] - c[15] - c[8] - c[9];
    w[4] = c[4] + (c[12] << 1) + (c[13] << 1) + c[14] - c[9] - c[10];
    w[5] = c[5] + (c[13] << 1) + (c[14] << 1) + c[15] - c[10] - c[11];
    w[6] = c[6] + c[14] + (c[14] << 1) + (c[15] << 1) + c[13] - c[8] - c[9];
    w[7] = c[7] + c[15] + (c[15] << 1) + c[8] - c[10] - c[11] - c[12] - c[13];

    # fold the signed overflow through 2^256 = 2^224 - 2^192 - 2^96 + 1. the second
    # fold leaves a value in [0, 2^256), so the third pass only normalizes words
    var fold: usize = 0;
    for (fold < 3) {
        var signed_carry: ^i64 = 0;
        i = 0;
        for (i < 8) {
            val word: ^i64 = w[i] + signed_carry;
            w[i]         = word & 0xFFFFFFFF;
            signed_carry = word >> 32;
            i            = i + 1;
        }
        w[0]         = w[0] + signed_carry;
        w[3]         = w[3] - signed_carry;
        w[6]         = w[6] - signed_carry;
        w[7]         = w[7] + signed_carry;
        signed_carry = 0;
        fold         = fold + 1;
    }

    var value: UInt;
    i = 0;
    for (i < 8) {
        value.limb[i] = w[i]::^u64;
        i             = i + 1;
    }
    var reduced: UInt;
    var borrow:  ^u64 = 0;
    i = 0;
    for (i < 8) {
        val difference: ^u64 = value.limb[i] - PRIME[i] - borrow;
        reduced.limb[i] = difference & WORD_MASK;
        borrow          = difference >> 63;
        i               = i + 1;
    }
    select(output, ?value, ?reduced, (borrow ^ 1)::^u8);
    carry  = 0;
    borrow = 0;
    ct.zeroize((?c[0]):~*^u8, 128);
    ct.zeroize((?w[0]):~*^u8, 64);
    destroy_uint(?value);
    destroy_uint(?reduced);
}

#[oblivious]
fun montgomery_multiply(output: *UInt, left: *UInt, right: *UInt,
    modulus: *u64, factor: u64) {
    var temporary: [9]^u64;
    var i:         usize = 0;
    for (i < 9) {
        temporary[i] = 0;
        i            = i + 1;
    }
    i = 0;
    for (i < 8) {
        var carry: ^u64  = 0;
        var j:     usize = 0;
        for (j < 8) {
            val product: ^u64 = temporary[j] +
                multiply_words(left.limb[j], right.limb[i]) + carry;
            temporary[j] = product & WORD_MASK;
            carry        = product >> 32;
            j            = j + 1;
        }
        temporary[8] = temporary[8] + carry;

        val multiplier: ^u64 =
            multiply_words(temporary[0], factor) & WORD_MASK;
        carry = 0;
        j     = 0;
        for (j < 8) {
            val product: ^u64 = temporary[j] +
                multiply_words(multiplier, modulus[j]) + carry;
            if (j > 0) { temporary[j - 1] = product & WORD_MASK; }
            carry = product >> 32;
            j     = j + 1;
        }
        val high: ^u64 = temporary[8] + carry;
        temporary[7] = high & WORD_MASK;
        temporary[8] = high >> 32;
        carry        = 0;
        i            = i + 1;
    }

    var reduced: UInt;
    var borrow:  ^u64 = 0;
    i = 0;
    for (i < 8) {
        val difference: ^u64 = temporary[i] - modulus[i] - borrow;
        reduced.limb[i] = difference & WORD_MASK;
        borrow          = difference >> 63;
        i               = i + 1;
    }
    val use_reduced: ^u8 = (temporary[8] | (borrow ^ 1))::^u8;
    var unreduced:   UInt;
    i = 0;
    for (i < 8) {
        unreduced.limb[i] = temporary[i];
        i                 = i + 1;
    }
    select(output, ?unreduced, ?reduced, use_reduced);
    borrow = 0;
    ct.zeroize((?temporary[0]):~*^u8, 72);
    destroy_uint(?unreduced);
    destroy_uint(?reduced);
}

#[oblivious]
pub fun field_add(output: *UInt, left: *UInt, right: *UInt) {
    add_mod(output, left, right, (?PRIME[0]):~*u64);
}

#[oblivious]
pub fun field_subtract(output: *UInt, left: *UInt, right: *UInt) {
    subtract_mod(output, left, right, (?PRIME[0]):~*u64);
}

#[oblivious]
pub fun field_multiply(output: *UInt, left: *UInt, right: *UInt) {
    var product: [16]^u64;
    var i:       usize = 0;
    for (i < 8) {
        var j: usize = 0;
        for (j < 8) {
            accumulate(?product[0], i + j,
                multiply_words(left.limb[i], right.limb[j]));
            j = j + 1;
        }
        i = i + 1;
    }
    reduce_field(output, ?product[0]);
    ct.zeroize((?product[0]):~*^u8, 128);
}

#[oblivious]
pub fun field_square(output: *UInt, input: *UInt) {
    var product: [16]^u64;
    var i:       usize = 0;
    for (i < 8) {
        accumulate(?product[0], i + i,
            multiply_words(input.limb[i], input.limb[i]));
        var j: usize = i + 1;
        for (j < 8) {
            val cross: ^u64 = multiply_words(input.limb[i], input.limb[j]);
            accumulate(?product[0], i + j, cross);
            accumulate(?product[0], i + j, cross);
            j = j + 1;
        }
        i = i + 1;
    }
    reduce_field(output, ?product[0]);
    ct.zeroize((?product[0]):~*^u8, 128);
}

# invert by fermat's little theorem over the public exponent p - 2
#[oblivious]
pub fun field_inverse(output: *UInt, input: *UInt) {
    var result: UInt;
    set_small(?result, 1);
    var position: usize = 256;
    for (position > 0) {
        position = position - 1;
        field_square(?result, ?result);
        val limb_index: usize = position >> 5;
        val shift:      usize = position & 31;
        if (((PRIME_MINUS_TWO[limb_index] >> shift) & 1) == 1) {
            field_multiply(?result, ?result, input);
        }
    }
    copy(output, ?result);
    destroy_uint(?result);
}

#[oblivious]
pub fun scalar_add(output: *UInt, left: *UInt, right: *UInt) {
    add_mod(output, left, right, (?ORDER[0]):~*u64);
}

# multiply canonical scalars modulo n, in and out of the ordinary domain
#[oblivious]
pub fun scalar_multiply_values(output: *UInt, left: *UInt, right: *UInt) {
    var right_montgomery: UInt;
    var constant:         UInt;
    copy_constant(?constant, (?ORDER_R2[0]):~*u64);
    montgomery_multiply(?right_montgomery, right, ?constant,
        (?ORDER[0]):~*u64, ORDER_MONT_FACTOR);
    montgomery_multiply(output, left, ?right_montgomery, (?ORDER[0]):~*u64,
        ORDER_MONT_FACTOR);
    destroy_uint(?right_montgomery);
    destroy_uint(?constant);
}

#[oblivious]
pub fun scalar_inverse(output: *UInt, input: *UInt) {
    var montgomery: UInt;
    var result:     UInt;
    var constant:   UInt;
    copy_constant(?constant, (?ORDER_R2[0]):~*u64);
    montgomery_multiply(?montgomery, input, ?constant, (?ORDER[0]):~*u64,
        ORDER_MONT_FACTOR);
    copy_constant(?result, (?SCALAR_ONE[0]):~*u64);
    var position: usize = 256;
    for (position > 0) {
        position = position - 1;
        montgomery_multiply(?result, ?result, ?result, (?ORDER[0]):~*u64,
            ORDER_MONT_FACTOR);
        val limb_index: usize = position >> 5;
        val shift:      usize = position & 31;
        if (((ORDER_MINUS_TWO[limb_index] >> shift) & 1) == 1) {
            montgomery_multiply(?result, ?result, ?montgomery,
                (?ORDER[0]):~*u64, ORDER_MONT_FACTOR);
        }
    }
    set_small(?constant, 1);
    montgomery_multiply(output, ?result, ?constant, (?ORDER[0]):~*u64,
        ORDER_MONT_FACTOR);
    destroy_uint(?montgomery);
    destroy_uint(?result);
    destroy_uint(?constant);
}

#[oblivious]
pub fun reduce_scalar_once(value: *UInt) {
    var reduced: UInt;
    var borrow:  ^u64  = 0;
    var i:       usize = 0;
    for (i < 8) {
        val difference: ^u64 = value.limb[i] - ORDER[i] - borrow;
        reduced.limb[i] = difference & WORD_MASK;
        borrow          = difference >> 63;
        i               = i + 1;
    }
    select(value, ?reduced, value, borrow::^u8);
    borrow = 0;
    destroy_uint(?reduced);
}

#[oblivious]
pub fun decode_secret(output: *UInt, input: *^u8) {
    var word: usize = 0;
    for (word < 8) {
        val offset: usize = 28 - (word << 2);
        output.limb[word] = (input[offset]::^u64 << 24) |
            (input[offset + 1]::^u64 << 16) |
            (input[offset + 2]::^u64 << 8) | input[offset + 3]::^u64;
        word = word + 1;
    }
}

#[oblivious]
pub fun decode_public(output: *UInt, input: *u8, base: usize) {
    var word: usize = 0;
    for (word < 8) {
        val offset: usize = 28 - (word << 2);
        output.limb[word] = (input[base + offset]::u64 << 24) |
            (input[base + offset + 1]::u64 << 16) |
            (input[base + offset + 2]::u64 << 8) | input[base + offset + 3]::u64;
        word = word + 1;
    }
}

#[oblivious]
pub fun encode_secret(output: *^u8, input: *UInt) {
    var word: usize = 0;
    for (word < 8) {
        val offset: usize = 28 - (word << 2);
        val value:  ^u64  = input.limb[word];
        output[offset]     = (value >> 24)::^u8;
        output[offset + 1] = (value >> 16)::^u8;
        output[offset + 2] = (value >> 8)::^u8;
        output[offset + 3] = value::^u8;
        word               = word + 1;
    }
}

#[oblivious]
pub fun encode_public(output: *u8, base: usize, input: *UInt) {
    var word: usize = 0;
    for (word < 8) {
        val offset: usize = 28 - (word << 2);
        val value:  ^u64  = input.limb[word];
        output[base + offset]     = (value >> 24)::^u8:>u8;
        output[base + offset + 1] = (value >> 16)::^u8:>u8;
        output[base + offset + 2] = (value >> 8)::^u8:>u8;
        output[base + offset + 3] = value::^u8:>u8;
        word                      = word + 1;
    }
}

#[oblivious]
pub fun valid_scalar(value: *UInt) ^u8 {
    ret less_than_modulus(value, (?ORDER[0]):~*u64) & (is_zero(value) ^ 1);
}

#[oblivious]
fun point_copy(output: *Point, input: *Point) {
    copy(?output.x, ?input.x);
    copy(?output.y, ?input.y);
    copy(?output.z, ?input.z);
}

#[oblivious]
fun point_select(output: *Point, left: *Point, right: *Point, choose_right: ^u8) {
    select(?output.x, ?left.x, ?right.x, choose_right);
    select(?output.y, ?left.y, ?right.y, choose_right);
    select(?output.z, ?left.z, ?right.z, choose_right);
}

#[oblivious]
pub fun point_infinity(output: *Point) {
    set_small(?output.x, 0);
    set_small(?output.y, 1);
    set_small(?output.z, 0);
}

#[oblivious]
pub fun generator(output: *Point) {
    copy_constant(?output.x, (?GENERATOR_X[0]):~*u64);
    copy_constant(?output.y, (?GENERATOR_Y[0]):~*u64);
    set_small(?output.z, 1);
}

#[oblivious]
pub fun point_is_infinity(point: *Point) ^u8 {
    ret is_zero(?point.z);
}

#[oblivious]
fun point_double(output: *Point, input: *Point) {
    var delta:         UInt;
    var gamma:         UInt;
    var beta:          UInt;
    var alpha:         UInt;
    var first:         UInt;
    var second:        UInt;
    var temporary:     UInt;
    var gamma_squared: UInt;
    var result:        Point;

    field_square(?delta, ?input.z);
    field_square(?gamma, ?input.y);
    field_multiply(?beta, ?input.x, ?gamma);
    field_subtract(?first, ?input.x, ?delta);
    field_add(?second, ?input.x, ?delta);
    field_multiply(?alpha, ?first, ?second);
    field_add(?temporary, ?alpha, ?alpha);
    field_add(?alpha, ?temporary, ?alpha);

    field_square(?result.x, ?alpha);
    field_add(?temporary, ?beta, ?beta);
    field_add(?temporary, ?temporary, ?temporary);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?result.x, ?result.x, ?temporary);

    field_add(?temporary, ?input.y, ?input.z);
    field_square(?result.z, ?temporary);
    field_subtract(?result.z, ?result.z, ?gamma);
    field_subtract(?result.z, ?result.z, ?delta);

    field_add(?temporary, ?beta, ?beta);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?temporary, ?temporary, ?result.x);
    field_multiply(?result.y, ?alpha, ?temporary);
    field_square(?gamma_squared, ?gamma);
    field_add(?temporary, ?gamma_squared, ?gamma_squared);
    field_add(?temporary, ?temporary, ?temporary);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?result.y, ?result.y, ?temporary);

    point_copy(output, ?result);
    destroy_uint(?delta);
    destroy_uint(?gamma);
    destroy_uint(?beta);
    destroy_uint(?alpha);
    destroy_uint(?first);
    destroy_uint(?second);
    destroy_uint(?temporary);
    destroy_uint(?gamma_squared);
    destroy_point(?result);
}

# add two jacobian points whose affine values differ unless one is infinity
#
# equal finite inputs produce infinity instead of their double, so only callers
# that exclude them, like the fixed-window ladder, may use this directly.
#[oblivious]
fun point_add_distinct(output: *Point, left: *Point, right: *Point, same: *^u8) {
    var left_saved:  Point;
    var right_saved: Point;
    point_copy(?left_saved, left);
    point_copy(?right_saved, right);
    val left_infinity:  ^u8 = point_is_infinity(?left_saved);
    val right_infinity: ^u8 = point_is_infinity(?right_saved);
    var z1z1:           UInt;
    var z2z2:           UInt;
    var u1:             UInt;
    var u2:             UInt;
    var s1:             UInt;
    var s2:             UInt;
    var h:              UInt;
    var i_value:        UInt;
    var j:              UInt;
    var r:              UInt;
    var v:              UInt;
    var temporary:      UInt;
    var generic:        Point;

    field_square(?z1z1, ?left_saved.z);
    field_square(?z2z2, ?right_saved.z);
    field_multiply(?u1, ?left_saved.x, ?z2z2);
    field_multiply(?u2, ?right_saved.x, ?z1z1);
    field_multiply(?temporary, ?right_saved.z, ?z2z2);
    field_multiply(?s1, ?left_saved.y, ?temporary);
    field_multiply(?temporary, ?left_saved.z, ?z1z1);
    field_multiply(?s2, ?right_saved.y, ?temporary);
    field_subtract(?h, ?u2, ?u1);
    field_add(?temporary, ?h, ?h);
    field_square(?i_value, ?temporary);
    field_multiply(?j, ?h, ?i_value);
    field_subtract(?temporary, ?s2, ?s1);
    field_add(?r, ?temporary, ?temporary);
    field_multiply(?v, ?u1, ?i_value);

    field_square(?generic.x, ?r);
    field_subtract(?generic.x, ?generic.x, ?j);
    field_add(?temporary, ?v, ?v);
    field_subtract(?generic.x, ?generic.x, ?temporary);
    field_subtract(?temporary, ?v, ?generic.x);
    field_multiply(?generic.y, ?r, ?temporary);
    field_multiply(?temporary, ?s1, ?j);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?generic.y, ?generic.y, ?temporary);
    field_add(?temporary, ?left_saved.z, ?right_saved.z);
    field_square(?generic.z, ?temporary);
    field_subtract(?generic.z, ?generic.z, ?z1z1);
    field_subtract(?generic.z, ?generic.z, ?z2z2);
    field_multiply(?generic.z, ?generic.z, ?h);

    @same = is_zero(?h) & is_zero(?r) & (left_infinity ^ 1) & (right_infinity ^ 1);
    point_copy(output, ?generic);
    point_select(output, output, ?right_saved, left_infinity);
    point_select(output, output, ?left_saved, right_infinity);

    destroy_point(?left_saved);
    destroy_point(?right_saved);
    destroy_uint(?z1z1);
    destroy_uint(?z2z2);
    destroy_uint(?u1);
    destroy_uint(?u2);
    destroy_uint(?s1);
    destroy_uint(?s2);
    destroy_uint(?h);
    destroy_uint(?i_value);
    destroy_uint(?j);
    destroy_uint(?r);
    destroy_uint(?v);
    destroy_uint(?temporary);
    destroy_point(?generic);
}

# add any two jacobian points, including equal points and infinity
#[oblivious]
pub fun point_add(output: *Point, left: *Point, right: *Point) {
    var doubled: Point;
    var same:    ^u8 = 0;
    point_double(?doubled, left);
    point_add_distinct(output, left, right, ?same);
    point_select(output, output, ?doubled, same);
    same = 0;
    destroy_point(?doubled);
}

# multiply a point by a scalar with a fixed 4-bit window
#
# the scalar is reduced below n first. every finite point on p-256 has order n,
# so an accumulator 16 * k' never equals a table entry d with 0 < d < 16 and the
# ladder's additions never meet the equal-point case.
#[oblivious]
pub fun scalar_multiply(output: *Point, scalar: *UInt, point: *Point) {
    var table:    [16]Point;
    var result:   Point;
    var selected: Point;
    var reduced:  UInt;
    var same:     ^u8 = 0;
    copy(?reduced, scalar);
    reduce_scalar_once(?reduced);
    point_infinity(?table[0]);
    point_copy(?table[1], point);
    point_double(?table[2], point);
    var index: usize = 3;
    for (index < 16) {
        point_add_distinct(?table[index], ?table[index - 1], point, ?same);
        index = index + 1;
    }

    point_infinity(?result);
    var window: usize = 64;
    for (window > 0) {
        window = window - 1;
        point_double(?result, ?result);
        point_double(?result, ?result);
        point_double(?result, ?result);
        point_double(?result, ?result);
        val limb_index: usize = window >> 3;
        val shift:      u64   = ((window & 7) * 4)::u64;
        val digit:      ^u64  = (reduced.limb[limb_index] >> shift) & 15;
        point_infinity(?selected);
        index = 1;
        for (index < 16) {
            point_select(?selected, ?selected, ?table[index],
                ct.eq_u64(digit, index::u64));
            index = index + 1;
        }
        point_add_distinct(?result, ?result, ?selected, ?same);
    }
    point_copy(output, ?result);

    index = 0;
    for (index < 16) {
        destroy_point(?table[index]);
        index = index + 1;
    }
    same = 0;
    destroy_point(?result);
    destroy_point(?selected);
    destroy_uint(?reduced);
}

#[oblivious]
pub fun to_affine(x: *UInt, y: *UInt, point: *Point) {
    var inverse:         UInt;
    var inverse_squared: UInt;
    var inverse_cubed:   UInt;
    field_inverse(?inverse, ?point.z);
    field_square(?inverse_squared, ?inverse);
    field_multiply(?inverse_cubed, ?inverse_squared, ?inverse);
    field_multiply(x, ?point.x, ?inverse_squared);
    field_multiply(y, ?point.y, ?inverse_cubed);
    destroy_uint(?inverse);
    destroy_uint(?inverse_squared);
    destroy_uint(?inverse_cubed);
}

#[oblivious]
pub fun parse_point(output: *Point, input: *u8) ^u8 {
    decode_public(?output.x, input, 1);
    decode_public(?output.y, input, 33);
    set_small(?output.z, 1);
    val x_canonical: ^u8 = less_than_modulus(?output.x, (?PRIME[0]):~*u64);
    val y_canonical: ^u8 = less_than_modulus(?output.y, (?PRIME[0]):~*u64);
    var left:        UInt;
    var right:       UInt;
    var temporary:   UInt;
    field_square(?left, ?output.y);
    field_square(?right, ?output.x);
    field_multiply(?right, ?right, ?output.x);
    field_add(?temporary, ?output.x, ?output.x);
    field_add(?temporary, ?temporary, ?output.x);
    field_subtract(?right, ?right, ?temporary);
    copy_constant(?temporary, (?CURVE_B[0]):~*u64);
    field_add(?right, ?right, ?temporary);
    val on_curve: ^u8 = equal(?left, ?right);
    destroy_uint(?left);
    destroy_uint(?right);
    destroy_uint(?temporary);
    ret x_canonical & y_canonical & on_curve;
}

test "p256 internal: constants have canonical low words" {
    if (PRIME[0] != 0xFFFFFFFF || ORDER[0] != 0xFC632551)             { ret 1; }
    if (GENERATOR_X[7] != 0x6B17D1F2 || GENERATOR_Y[0] != 0x37BF51F5) { ret 2; }
    ret 0;
}

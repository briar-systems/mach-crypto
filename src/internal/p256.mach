# constant-shape secp256r1 arithmetic

use crypto.internal.p256_base;
use crypto.internal.word;
use std.crypto.ct;
use std.types.size.usize;

val WORD_MASK: u64 = 0xFFFFFFFF;

val PRIME: [8]u64 = [8]u64{
    0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x00000000,
    0x00000000, 0x00000000, 0x00000001, 0xFFFFFFFF
};

val ORDER: [8]u64 = [8]u64{
    0xFC632551, 0xF3B9CAC2, 0xA7179E84, 0xBCE6FAAD,
    0xFFFFFFFF, 0xFFFFFFFF, 0x00000000, 0xFFFFFFFF
};

val ORDER_R2: [8]u64 = [8]u64{
    0xBE79EEA2, 0x83244C95, 0x49BD6FA6, 0x4699799C,
    0x2B6BEC59, 0x2845B239, 0xF3D95620, 0x66E12D94
};

val ORDER_MONT_FACTOR: u64 = 0xEE00BC4F;

val CURVE_B: [8]u64 = [8]u64{
    0x27D2604B, 0x3BCE3C3E, 0xCC53B0F6, 0x651D06B0,
    0x769886BC, 0xB3EBBD55, 0xAA3A93E7, 0x5AC635D8
};

val GENERATOR_X: [8]u64 = [8]u64{
    0xD898C296, 0xF4A13945, 0x2DEB33A0, 0x77037D81,
    0x63A440F2, 0xF8BCE6E5, 0xE12C4247, 0x6B17D1F2
};

val GENERATOR_Y: [8]u64 = [8]u64{
    0x37BF51F5, 0xCBB64068, 0x6B315ECE, 0x2BCE3357,
    0x7C0F9E16, 0x8EE7EB4A, 0xFE1A7F9B, 0x4FE342E2
};

# one step of a public addition chain: reg[dst] = reg[src]^(2^squarings) * reg[factor]
#
# register 0 holds the input. the chains are fixed public data, so every
# inversion runs the same sequence of squarings and multiplications.
rec ChainStep {
    dst:       u8;
    src:       u8;
    squarings: u8;
    factor:    u8;
}

val NO_FACTOR: u8 = 255;

# p - 2 in 255 squarings and 12 multiplications (mmcloughlin/addchain)
val FIELD_REGISTERS: usize = 11;
val FIELD_RESULT:    usize = 10;
val FIELD_STEPS:     usize = 13;

val FIELD_CHAIN: [FIELD_STEPS]ChainStep = [FIELD_STEPS]ChainStep{
    ChainStep{dst: 1, src: 0, squarings: 1, factor: 0},
    ChainStep{dst: 2, src: 1, squarings: 1, factor: 0},
    ChainStep{dst: 3, src: 2, squarings: 3, factor: 2},
    ChainStep{dst: 4, src: 3, squarings: 6, factor: 3},
    ChainStep{dst: 5, src: 4, squarings: 3, factor: 2},
    ChainStep{dst: 6, src: 5, squarings: 1, factor: 0},
    ChainStep{dst: 7, src: 6, squarings: 16, factor: 6},
    ChainStep{dst: 8, src: 7, squarings: 15, factor: NO_FACTOR},
    ChainStep{dst: 9, src: 8, squarings: 0, factor: 5},
    ChainStep{dst: 10, src: 8, squarings: 17, factor: 0},
    ChainStep{dst: 10, src: 10, squarings: 143, factor: 9},
    ChainStep{dst: 10, src: 10, squarings: 47, factor: 9},
    ChainStep{dst: 10, src: 10, squarings: 2, factor: 0}
};

# n - 2 in 253 squarings and 39 multiplications: odd powers z^1..z^15 in
# registers 0..7, an x32 head for the all-ones top half, then 4-bit sliding windows
val SCALAR_REGISTERS: usize = 13;
val SCALAR_RESULT:    usize = 12;
val SCALAR_STEPS:     usize = 40;

val SCALAR_CHAIN: [SCALAR_STEPS]ChainStep = [SCALAR_STEPS]ChainStep{
    ChainStep{dst: 8, src: 0, squarings: 1, factor: NO_FACTOR},
    ChainStep{dst: 1, src: 0, squarings: 0, factor: 8},
    ChainStep{dst: 2, src: 1, squarings: 0, factor: 8},
    ChainStep{dst: 3, src: 2, squarings: 0, factor: 8},
    ChainStep{dst: 4, src: 3, squarings: 0, factor: 8},
    ChainStep{dst: 5, src: 4, squarings: 0, factor: 8},
    ChainStep{dst: 6, src: 5, squarings: 0, factor: 8},
    ChainStep{dst: 7, src: 6, squarings: 0, factor: 8},
    ChainStep{dst: 9, src: 7, squarings: 4, factor: 7},
    ChainStep{dst: 10, src: 9, squarings: 8, factor: 9},
    ChainStep{dst: 11, src: 10, squarings: 16, factor: 10},
    ChainStep{dst: 12, src: 11, squarings: 64, factor: 11},
    ChainStep{dst: 12, src: 12, squarings: 32, factor: 11},
    ChainStep{dst: 12, src: 12, squarings: 4, factor: 5},
    ChainStep{dst: 12, src: 12, squarings: 2, factor: 1},
    ChainStep{dst: 12, src: 12, squarings: 5, factor: 3},
    ChainStep{dst: 12, src: 12, squarings: 6, factor: 6},
    ChainStep{dst: 12, src: 12, squarings: 4, factor: 7},
    ChainStep{dst: 12, src: 12, squarings: 4, factor: 2},
    ChainStep{dst: 12, src: 12, squarings: 5, factor: 5},
    ChainStep{dst: 12, src: 12, squarings: 5, factor: 6},
    ChainStep{dst: 12, src: 12, squarings: 5, factor: 3},
    ChainStep{dst: 12, src: 12, squarings: 7, factor: 5},
    ChainStep{dst: 12, src: 12, squarings: 2, factor: 1},
    ChainStep{dst: 12, src: 12, squarings: 6, factor: 7},
    ChainStep{dst: 12, src: 12, squarings: 2, factor: 0},
    ChainStep{dst: 12, src: 12, squarings: 8, factor: 4},
    ChainStep{dst: 12, src: 12, squarings: 3, factor: 3},
    ChainStep{dst: 12, src: 12, squarings: 5, factor: 3},
    ChainStep{dst: 12, src: 12, squarings: 4, factor: 3},
    ChainStep{dst: 12, src: 12, squarings: 5, factor: 3},
    ChainStep{dst: 12, src: 12, squarings: 5, factor: 2},
    ChainStep{dst: 12, src: 12, squarings: 3, factor: 1},
    ChainStep{dst: 12, src: 12, squarings: 8, factor: 5},
    ChainStep{dst: 12, src: 12, squarings: 4, factor: 7},
    ChainStep{dst: 12, src: 12, squarings: 5, factor: 1},
    ChainStep{dst: 12, src: 12, squarings: 5, factor: 1},
    ChainStep{dst: 12, src: 12, squarings: 6, factor: 4},
    ChainStep{dst: 12, src: 12, squarings: 4, factor: 2},
    ChainStep{dst: 12, src: 12, squarings: 6, factor: 7}
};

pub rec UInt {
    limb: [8]^u64;
}

pub rec Point {
    x: UInt;
    y: UInt;
    z: UInt;
}

#[oblivious]
pub fun destroy_uint(value: *UInt) {
    if (value == nil) { ret; }
    ct.zeroize((?value.limb[0]):~*^u8, 64);
}

#[oblivious]
pub fun destroy_point(point: *Point) {
    if (point == nil) { ret; }
    destroy_uint(?point.x);
    destroy_uint(?point.y);
    destroy_uint(?point.z);
}

#[oblivious]
#[inline]
fun nonzero_bit(value: ^u64) ^u8 {
    ret ((value | (0 - value)) >> 63)::^u8;
}

#[oblivious]
pub fun is_zero(value: *UInt) ^u8 {
    var combined: ^u64  = 0;
    var i:        usize = 0;
    for (i < 8) {
        combined = combined | value.limb[i];
        i        = i + 1;
    }
    val result: ^u8 = 1 ^ nonzero_bit(combined);
    combined = 0;
    ret result;
}

#[oblivious]
pub fun equal(left: *UInt, right: *UInt) ^u8 {
    var difference: ^u64  = 0;
    var i:          usize = 0;
    for (i < 8) {
        difference = difference | (left.limb[i] ^ right.limb[i]);
        i          = i + 1;
    }
    val result: ^u8 = 1 ^ nonzero_bit(difference);
    difference = 0;
    ret result;
}

#[oblivious]
pub fun copy(output: *UInt, input: *UInt) {
    var i: usize = 0;
    for (i < 8) {
        output.limb[i] = input.limb[i];
        i              = i + 1;
    }
}

#[oblivious]
fun copy_constant(output: *UInt, input: *u64) {
    var i: usize = 0;
    for (i < 8) {
        output.limb[i] = input[i];
        i              = i + 1;
    }
}

#[oblivious]
pub fun set_small(output: *UInt, value: u64) {
    output.limb[0] = value;
    var i: usize = 1;
    for (i < 8) {
        output.limb[i] = 0;
        i              = i + 1;
    }
}

#[oblivious]
pub fun select(output: *UInt, left: *UInt, right: *UInt, choose_right: ^u8) {
    val mask: ^u64  = 0 - choose_right::^u64;
    var i:    usize = 0;
    for (i < 8) {
        output.limb[i] = (left.limb[i] & ~mask) | (right.limb[i] & mask);
        i              = i + 1;
    }
}

#[oblivious]
fun less_than_modulus(value: *UInt, modulus: *u64) ^u8 {
    var borrow: ^u64  = 0;
    var i:      usize = 0;
    for (i < 8) {
        val difference: ^u64 = value.limb[i] - modulus[i] - borrow;
        borrow = difference >> 63;
        i      = i + 1;
    }
    val result: ^u8 = borrow::^u8;
    borrow = 0;
    ret result;
}

#[oblivious]
fun add_mod(output: *UInt, left: *UInt, right: *UInt, modulus: *u64) {
    var sum:     UInt;
    var reduced: UInt;
    var carry:   ^u64  = 0;
    var i:       usize = 0;
    for (i < 8) {
        val word: ^u64 = left.limb[i] + right.limb[i] + carry;
        sum.limb[i] = word & WORD_MASK;
        carry       = word >> 32;
        i           = i + 1;
    }
    var borrow: ^u64 = 0;
    i = 0;
    for (i < 8) {
        val difference: ^u64 = sum.limb[i] - modulus[i] - borrow;
        reduced.limb[i] = difference & WORD_MASK;
        borrow          = difference >> 63;
        i               = i + 1;
    }
    val use_reduced: ^u8 = (carry | (borrow ^ 1))::^u8;
    select(output, ?sum, ?reduced, use_reduced);
    carry  = 0;
    borrow = 0;
    destroy_uint(?sum);
    destroy_uint(?reduced);
}

#[oblivious]
fun subtract_mod(output: *UInt, left: *UInt, right: *UInt, modulus: *u64) {
    var difference: UInt;
    var borrow:     ^u64  = 0;
    var i:          usize = 0;
    for (i < 8) {
        val word: ^u64 = left.limb[i] - right.limb[i] - borrow;
        difference.limb[i] = word & WORD_MASK;
        borrow             = word >> 63;
        i                  = i + 1;
    }
    val mask:  ^u64 = 0 - borrow;
    var carry: ^u64 = 0;
    i = 0;
    for (i < 8) {
        val word: ^u64 = difference.limb[i] + (modulus[i] & mask) + carry;
        output.limb[i] = word & WORD_MASK;
        carry          = word >> 32;
        i              = i + 1;
    }
    borrow = 0;
    carry  = 0;
    destroy_uint(?difference);
}

#[oblivious]
#[inline]
fun accumulate(product: *^u64, index: usize, word: ^u64) {
    product[index]     = product[index] + (word & WORD_MASK);
    product[index + 1] = product[index + 1] + (word >> 32);
}

# reduce a 512-bit product of 32-bit words modulo p with the nist solinas identity
#
# the product words may carry lazily above 32 bits. every step is additions,
# subtractions and fixed shifts, so the reduction has one shape for every input.
#[oblivious]
fun reduce_field(output: *UInt, product: *^u64) {
    var c:     [16]^i64;
    var carry: ^u64  = 0;
    var i:     usize = 0;
    for (i < 16) {
        val word: ^u64 = product[i] + carry;
        c[i]  = (word & WORD_MASK)::^i64;
        carry = word >> 32;
        i     = i + 1;
    }

    var w: [8]^i64;
    w[0] = c[0] + c[8] + c[9] - c[11] - c[12] - c[13] - c[14];
    w[1] = c[1] + c[9] + c[10] - c[12] - c[13] - c[14] - c[15];
    w[2] = c[2] + c[10] + c[11] - c[13] - c[14] - c[15];
    w[3] = c[3] + (c[11] << 1) + (c[12] << 1) + c[13] - c[15] - c[8] - c[9];
    w[4] = c[4] + (c[12] << 1) + (c[13] << 1) + c[14] - c[9] - c[10];
    w[5] = c[5] + (c[13] << 1) + (c[14] << 1) + c[15] - c[10] - c[11];
    w[6] = c[6] + c[14] + (c[14] << 1) + (c[15] << 1) + c[13] - c[8] - c[9];
    w[7] = c[7] + c[15] + (c[15] << 1) + c[8] - c[10] - c[11] - c[12] - c[13];

    # fold the signed overflow through 2^256 = 2^224 - 2^192 - 2^96 + 1. the second
    # fold leaves a value in [0, 2^256), so the third pass only normalizes words
    var fold: usize = 0;
    for (fold < 3) {
        var signed_carry: ^i64 = 0;
        i = 0;
        for (i < 8) {
            val word: ^i64 = w[i] + signed_carry;
            w[i]         = word & 0xFFFFFFFF;
            signed_carry = word >> 32;
            i            = i + 1;
        }
        w[0]         = w[0] + signed_carry;
        w[3]         = w[3] - signed_carry;
        w[6]         = w[6] - signed_carry;
        w[7]         = w[7] + signed_carry;
        signed_carry = 0;
        fold         = fold + 1;
    }

    var value: UInt;
    i = 0;
    for (i < 8) {
        value.limb[i] = w[i]::^u64;
        i             = i + 1;
    }
    var reduced: UInt;
    var borrow:  ^u64 = 0;
    i = 0;
    for (i < 8) {
        val difference: ^u64 = value.limb[i] - PRIME[i] - borrow;
        reduced.limb[i] = difference & WORD_MASK;
        borrow          = difference >> 63;
        i               = i + 1;
    }
    select(output, ?value, ?reduced, (borrow ^ 1)::^u8);
    carry  = 0;
    borrow = 0;
    ct.zeroize((?c[0]):~*^u8, 128);
    ct.zeroize((?w[0]):~*^u8, 64);
    destroy_uint(?value);
    destroy_uint(?reduced);
}

#[oblivious]
fun montgomery_multiply(output: *UInt, left: *UInt, right: *UInt,
    modulus: *u64, factor: u64) {
    var temporary: [9]^u64;
    var i:         usize = 0;
    for (i < 9) {
        temporary[i] = 0;
        i            = i + 1;
    }
    i = 0;
    for (i < 8) {
        var carry: ^u64  = 0;
        var j:     usize = 0;
        for (j < 8) {
            val product: ^u64 = temporary[j] +
                word.multiply(left.limb[j], right.limb[i], 32) + carry;
            temporary[j] = product & WORD_MASK;
            carry        = product >> 32;
            j            = j + 1;
        }
        temporary[8] = temporary[8] + carry;

        val multiplier: ^u64 =
            word.multiply(temporary[0], factor, 32) & WORD_MASK;
        carry = 0;
        j     = 0;
        for (j < 8) {
            val product: ^u64 = temporary[j] +
                word.multiply(multiplier, modulus[j], 32) + carry;
            if (j > 0) { temporary[j - 1] = product & WORD_MASK; }
            carry = product >> 32;
            j     = j + 1;
        }
        val high: ^u64 = temporary[8] + carry;
        temporary[7] = high & WORD_MASK;
        temporary[8] = high >> 32;
        carry        = 0;
        i            = i + 1;
    }

    var reduced: UInt;
    var borrow:  ^u64 = 0;
    i = 0;
    for (i < 8) {
        val difference: ^u64 = temporary[i] - modulus[i] - borrow;
        reduced.limb[i] = difference & WORD_MASK;
        borrow          = difference >> 63;
        i               = i + 1;
    }
    val use_reduced: ^u8 = (temporary[8] | (borrow ^ 1))::^u8;
    var unreduced:   UInt;
    i = 0;
    for (i < 8) {
        unreduced.limb[i] = temporary[i];
        i                 = i + 1;
    }
    select(output, ?unreduced, ?reduced, use_reduced);
    borrow = 0;
    ct.zeroize((?temporary[0]):~*^u8, 72);
    destroy_uint(?unreduced);
    destroy_uint(?reduced);
}

#[oblivious]
pub fun field_add(output: *UInt, left: *UInt, right: *UInt) {
    add_mod(output, left, right, (?PRIME[0]):~*u64);
}

#[oblivious]
pub fun field_subtract(output: *UInt, left: *UInt, right: *UInt) {
    subtract_mod(output, left, right, (?PRIME[0]):~*u64);
}

#[oblivious]
pub fun field_multiply(output: *UInt, left: *UInt, right: *UInt) {
    var product: [16]^u64;
    var i:       usize = 0;
    for (i < 8) {
        var j: usize = 0;
        for (j < 8) {
            accumulate(?product[0], i + j,
                word.multiply(left.limb[i], right.limb[j], 32));
            j = j + 1;
        }
        i = i + 1;
    }
    reduce_field(output, ?product[0]);
    ct.zeroize((?product[0]):~*^u8, 128);
}

#[oblivious]
pub fun field_square(output: *UInt, input: *UInt) {
    var product: [16]^u64;
    var i:       usize = 0;
    for (i < 8) {
        accumulate(?product[0], i + i,
            word.multiply(input.limb[i], input.limb[i], 32));
        var j: usize = i + 1;
        for (j < 8) {
            val cross: ^u64 = word.multiply(input.limb[i], input.limb[j], 32);
            accumulate(?product[0], i + j, cross);
            accumulate(?product[0], i + j, cross);
            j = j + 1;
        }
        i = i + 1;
    }
    reduce_field(output, ?product[0]);
    ct.zeroize((?product[0]):~*^u8, 128);
}

# invert by fermat's little theorem, raising to p - 2 along FIELD_CHAIN
#[oblivious]
pub fun field_inverse(output: *UInt, input: *UInt) {
    var registers: [FIELD_REGISTERS]UInt;
    copy(?registers[0], input);
    var step: usize = 0;
    for (step < FIELD_STEPS) {
        val current: ChainStep = FIELD_CHAIN[step];
        var value:   UInt;
        copy(?value, ?registers[current.src]);
        var count: u8 = 0;
        for (count < current.squarings) {
            field_square(?value, ?value);
            count = count + 1;
        }
        if (current.factor != NO_FACTOR) {
            field_multiply(?value, ?value, ?registers[current.factor]);
        }
        copy(?registers[current.dst], ?value);
        destroy_uint(?value);
        step = step + 1;
    }
    copy(output, ?registers[FIELD_RESULT]);
    var index: usize = 0;
    for (index < FIELD_REGISTERS) {
        destroy_uint(?registers[index]);
        index = index + 1;
    }
}

#[oblivious]
pub fun scalar_add(output: *UInt, left: *UInt, right: *UInt) {
    add_mod(output, left, right, (?ORDER[0]):~*u64);
}

# multiply canonical scalars modulo n, in and out of the ordinary domain
#[oblivious]
pub fun scalar_multiply_values(output: *UInt, left: *UInt, right: *UInt) {
    var right_montgomery: UInt;
    var constant:         UInt;
    copy_constant(?constant, (?ORDER_R2[0]):~*u64);
    montgomery_multiply(?right_montgomery, right, ?constant,
        (?ORDER[0]):~*u64, ORDER_MONT_FACTOR);
    montgomery_multiply(output, left, ?right_montgomery, (?ORDER[0]):~*u64,
        ORDER_MONT_FACTOR);
    destroy_uint(?right_montgomery);
    destroy_uint(?constant);
}

# invert modulo n in the montgomery domain, raising to n - 2 along SCALAR_CHAIN
#[oblivious]
pub fun scalar_inverse(output: *UInt, input: *UInt) {
    var registers: [SCALAR_REGISTERS]UInt;
    var constant:  UInt;
    copy_constant(?constant, (?ORDER_R2[0]):~*u64);
    montgomery_multiply(?registers[0], input, ?constant, (?ORDER[0]):~*u64,
        ORDER_MONT_FACTOR);
    var step: usize = 0;
    for (step < SCALAR_STEPS) {
        val current: ChainStep = SCALAR_CHAIN[step];
        var value:   UInt;
        copy(?value, ?registers[current.src]);
        var count: u8 = 0;
        for (count < current.squarings) {
            montgomery_multiply(?value, ?value, ?value, (?ORDER[0]):~*u64,
                ORDER_MONT_FACTOR);
            count = count + 1;
        }
        if (current.factor != NO_FACTOR) {
            montgomery_multiply(?value, ?value, ?registers[current.factor],
                (?ORDER[0]):~*u64, ORDER_MONT_FACTOR);
        }
        copy(?registers[current.dst], ?value);
        destroy_uint(?value);
        step = step + 1;
    }
    set_small(?constant, 1);
    montgomery_multiply(output, ?registers[SCALAR_RESULT], ?constant,
        (?ORDER[0]):~*u64, ORDER_MONT_FACTOR);
    destroy_uint(?constant);
    var index: usize = 0;
    for (index < SCALAR_REGISTERS) {
        destroy_uint(?registers[index]);
        index = index + 1;
    }
}

#[oblivious]
pub fun reduce_scalar_once(value: *UInt) {
    var reduced: UInt;
    var borrow:  ^u64  = 0;
    var i:       usize = 0;
    for (i < 8) {
        val difference: ^u64 = value.limb[i] - ORDER[i] - borrow;
        reduced.limb[i] = difference & WORD_MASK;
        borrow          = difference >> 63;
        i               = i + 1;
    }
    select(value, ?reduced, value, borrow::^u8);
    borrow = 0;
    destroy_uint(?reduced);
}

#[oblivious]
pub fun decode_secret(output: *UInt, input: *^u8) {
    var word: usize = 0;
    for (word < 8) {
        val offset: usize = 28 - (word << 2);
        output.limb[word] = (input[offset]::^u64 << 24) |
            (input[offset + 1]::^u64 << 16) |
            (input[offset + 2]::^u64 << 8) | input[offset + 3]::^u64;
        word = word + 1;
    }
}

#[oblivious]
pub fun decode_public(output: *UInt, input: *u8, base: usize) {
    var word: usize = 0;
    for (word < 8) {
        val offset: usize = 28 - (word << 2);
        output.limb[word] = (input[base + offset]::u64 << 24) |
            (input[base + offset + 1]::u64 << 16) |
            (input[base + offset + 2]::u64 << 8) | input[base + offset + 3]::u64;
        word = word + 1;
    }
}

#[oblivious]
pub fun encode_secret(output: *^u8, input: *UInt) {
    var word: usize = 0;
    for (word < 8) {
        val offset: usize = 28 - (word << 2);
        val value:  ^u64  = input.limb[word];
        output[offset]     = (value >> 24)::^u8;
        output[offset + 1] = (value >> 16)::^u8;
        output[offset + 2] = (value >> 8)::^u8;
        output[offset + 3] = value::^u8;
        word               = word + 1;
    }
}

#[oblivious]
pub fun encode_public(output: *u8, base: usize, input: *UInt) {
    var word: usize = 0;
    for (word < 8) {
        val offset: usize = 28 - (word << 2);
        val value:  ^u64  = input.limb[word];
        output[base + offset]     = (value >> 24)::^u8:>u8;
        output[base + offset + 1] = (value >> 16)::^u8:>u8;
        output[base + offset + 2] = (value >> 8)::^u8:>u8;
        output[base + offset + 3] = value::^u8:>u8;
        word                      = word + 1;
    }
}

#[oblivious]
pub fun valid_scalar(value: *UInt) ^u8 {
    ret less_than_modulus(value, (?ORDER[0]):~*u64) & (is_zero(value) ^ 1);
}

#[oblivious]
fun point_copy(output: *Point, input: *Point) {
    copy(?output.x, ?input.x);
    copy(?output.y, ?input.y);
    copy(?output.z, ?input.z);
}

#[oblivious]
fun point_select(output: *Point, left: *Point, right: *Point, choose_right: ^u8) {
    select(?output.x, ?left.x, ?right.x, choose_right);
    select(?output.y, ?left.y, ?right.y, choose_right);
    select(?output.z, ?left.z, ?right.z, choose_right);
}

#[oblivious]
pub fun point_infinity(output: *Point) {
    set_small(?output.x, 0);
    set_small(?output.y, 1);
    set_small(?output.z, 0);
}

#[oblivious]
pub fun generator(output: *Point) {
    copy_constant(?output.x, (?GENERATOR_X[0]):~*u64);
    copy_constant(?output.y, (?GENERATOR_Y[0]):~*u64);
    set_small(?output.z, 1);
}

#[oblivious]
pub fun point_is_infinity(point: *Point) ^u8 {
    ret is_zero(?point.z);
}

#[oblivious]
fun point_double(output: *Point, input: *Point) {
    var delta:         UInt;
    var gamma:         UInt;
    var beta:          UInt;
    var alpha:         UInt;
    var first:         UInt;
    var second:        UInt;
    var temporary:     UInt;
    var gamma_squared: UInt;
    var result:        Point;

    field_square(?delta, ?input.z);
    field_square(?gamma, ?input.y);
    field_multiply(?beta, ?input.x, ?gamma);
    field_subtract(?first, ?input.x, ?delta);
    field_add(?second, ?input.x, ?delta);
    field_multiply(?alpha, ?first, ?second);
    field_add(?temporary, ?alpha, ?alpha);
    field_add(?alpha, ?temporary, ?alpha);

    field_square(?result.x, ?alpha);
    field_add(?temporary, ?beta, ?beta);
    field_add(?temporary, ?temporary, ?temporary);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?result.x, ?result.x, ?temporary);

    field_add(?temporary, ?input.y, ?input.z);
    field_square(?result.z, ?temporary);
    field_subtract(?result.z, ?result.z, ?gamma);
    field_subtract(?result.z, ?result.z, ?delta);

    field_add(?temporary, ?beta, ?beta);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?temporary, ?temporary, ?result.x);
    field_multiply(?result.y, ?alpha, ?temporary);
    field_square(?gamma_squared, ?gamma);
    field_add(?temporary, ?gamma_squared, ?gamma_squared);
    field_add(?temporary, ?temporary, ?temporary);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?result.y, ?result.y, ?temporary);

    point_copy(output, ?result);
    destroy_uint(?delta);
    destroy_uint(?gamma);
    destroy_uint(?beta);
    destroy_uint(?alpha);
    destroy_uint(?first);
    destroy_uint(?second);
    destroy_uint(?temporary);
    destroy_uint(?gamma_squared);
    destroy_point(?result);
}

# add two jacobian points whose affine values differ unless one is infinity
#
# equal finite inputs produce infinity instead of their double, so only callers
# that exclude them, like the fixed-window ladder, may use this directly.
#[oblivious]
fun point_add_distinct(output: *Point, left: *Point, right: *Point, same: *^u8) {
    var left_saved:  Point;
    var right_saved: Point;
    point_copy(?left_saved, left);
    point_copy(?right_saved, right);
    val left_infinity:  ^u8 = point_is_infinity(?left_saved);
    val right_infinity: ^u8 = point_is_infinity(?right_saved);
    var z1z1:           UInt;
    var z2z2:           UInt;
    var u1:             UInt;
    var u2:             UInt;
    var s1:             UInt;
    var s2:             UInt;
    var h:              UInt;
    var i_value:        UInt;
    var j:              UInt;
    var r:              UInt;
    var v:              UInt;
    var temporary:      UInt;
    var generic:        Point;

    field_square(?z1z1, ?left_saved.z);
    field_square(?z2z2, ?right_saved.z);
    field_multiply(?u1, ?left_saved.x, ?z2z2);
    field_multiply(?u2, ?right_saved.x, ?z1z1);
    field_multiply(?temporary, ?right_saved.z, ?z2z2);
    field_multiply(?s1, ?left_saved.y, ?temporary);
    field_multiply(?temporary, ?left_saved.z, ?z1z1);
    field_multiply(?s2, ?right_saved.y, ?temporary);
    field_subtract(?h, ?u2, ?u1);
    field_add(?temporary, ?h, ?h);
    field_square(?i_value, ?temporary);
    field_multiply(?j, ?h, ?i_value);
    field_subtract(?temporary, ?s2, ?s1);
    field_add(?r, ?temporary, ?temporary);
    field_multiply(?v, ?u1, ?i_value);

    field_square(?generic.x, ?r);
    field_subtract(?generic.x, ?generic.x, ?j);
    field_add(?temporary, ?v, ?v);
    field_subtract(?generic.x, ?generic.x, ?temporary);
    field_subtract(?temporary, ?v, ?generic.x);
    field_multiply(?generic.y, ?r, ?temporary);
    field_multiply(?temporary, ?s1, ?j);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?generic.y, ?generic.y, ?temporary);
    field_add(?temporary, ?left_saved.z, ?right_saved.z);
    field_square(?generic.z, ?temporary);
    field_subtract(?generic.z, ?generic.z, ?z1z1);
    field_subtract(?generic.z, ?generic.z, ?z2z2);
    field_multiply(?generic.z, ?generic.z, ?h);

    @same = is_zero(?h) & is_zero(?r) & (left_infinity ^ 1) & (right_infinity ^ 1);
    point_copy(output, ?generic);
    point_select(output, output, ?right_saved, left_infinity);
    point_select(output, output, ?left_saved, right_infinity);

    destroy_point(?left_saved);
    destroy_point(?right_saved);
    destroy_uint(?z1z1);
    destroy_uint(?z2z2);
    destroy_uint(?u1);
    destroy_uint(?u2);
    destroy_uint(?s1);
    destroy_uint(?s2);
    destroy_uint(?h);
    destroy_uint(?i_value);
    destroy_uint(?j);
    destroy_uint(?r);
    destroy_uint(?v);
    destroy_uint(?temporary);
    destroy_point(?generic);
}

# add any two jacobian points, including equal points and infinity
#[oblivious]
pub fun point_add(output: *Point, left: *Point, right: *Point) {
    var doubled: Point;
    var same:    ^u8 = 0;
    point_double(?doubled, left);
    point_add_distinct(output, left, right, ?same);
    point_select(output, output, ?doubled, same);
    same = 0;
    destroy_point(?doubled);
}

# multiply a point by a scalar with a fixed 4-bit window
#
# the scalar is reduced below n first. every finite point on p-256 has order n,
# so an accumulator 16 * k' never equals a table entry d with 0 < d < 16 and the
# ladder's additions never meet the equal-point case.
#[oblivious]
pub fun scalar_multiply(output: *Point, scalar: *UInt, point: *Point) {
    var table:    [16]Point;
    var result:   Point;
    var selected: Point;
    var reduced:  UInt;
    var same:     ^u8 = 0;
    copy(?reduced, scalar);
    reduce_scalar_once(?reduced);
    point_infinity(?table[0]);
    point_copy(?table[1], point);
    point_double(?table[2], point);
    var index: usize = 3;
    for (index < 16) {
        point_add_distinct(?table[index], ?table[index - 1], point, ?same);
        index = index + 1;
    }

    point_infinity(?result);
    var window: usize = 64;
    for (window > 0) {
        window = window - 1;
        point_double(?result, ?result);
        point_double(?result, ?result);
        point_double(?result, ?result);
        point_double(?result, ?result);
        val limb_index: usize = window >> 3;
        val shift:      u64   = ((window & 7) * 4)::u64;
        val digit:      ^u64  = (reduced.limb[limb_index] >> shift) & 15;
        point_infinity(?selected);
        index = 1;
        for (index < 16) {
            point_select(?selected, ?selected, ?table[index],
                ct.eq[u64](digit, index::u64));
            index = index + 1;
        }
        point_add_distinct(?result, ?result, ?selected, ?same);
    }
    point_copy(output, ?result);

    index = 0;
    for (index < 16) {
        destroy_point(?table[index]);
        index = index + 1;
    }
    same = 0;
    destroy_point(?result);
    destroy_point(?selected);
    destroy_uint(?reduced);
}

# or the affine table entry for digit * 16^window * G into x and y under mask
#[oblivious]
fun accumulate_entry(x: *UInt, y: *UInt, window: u64, digit: u64, mask: ^u64) {
    val base: usize = ((window * p256_base.DIGITS + digit - 1) * 16)::usize;
    var i:    usize = 0;
    for (i < 8) {
        x.limb[i] = x.limb[i] | (p256_base.TABLE[base + i]::u64 & mask);
        y.limb[i] = y.limb[i] | (p256_base.TABLE[base + 8 + i]::u64 & mask);
        i         = i + 1;
    }
}

# add an affine point to a finite jacobian point that is not its equal or negation
#
# madd-2007-bl. an infinite left side or equal x coordinates produce garbage,
# so callers select around both.
#[oblivious]
fun point_add_mixed(output: *Point, left: *Point, x: *UInt, y: *UInt) {
    var z1z1:      UInt;
    var u2:        UInt;
    var s2:        UInt;
    var h:         UInt;
    var hh:        UInt;
    var i_value:   UInt;
    var j:         UInt;
    var r:         UInt;
    var v:         UInt;
    var temporary: UInt;
    var result:    Point;

    field_square(?z1z1, ?left.z);
    field_multiply(?u2, x, ?z1z1);
    field_multiply(?temporary, ?left.z, ?z1z1);
    field_multiply(?s2, y, ?temporary);
    field_subtract(?h, ?u2, ?left.x);
    field_square(?hh, ?h);
    field_add(?i_value, ?hh, ?hh);
    field_add(?i_value, ?i_value, ?i_value);
    field_multiply(?j, ?h, ?i_value);
    field_subtract(?temporary, ?s2, ?left.y);
    field_add(?r, ?temporary, ?temporary);
    field_multiply(?v, ?left.x, ?i_value);

    field_square(?result.x, ?r);
    field_subtract(?result.x, ?result.x, ?j);
    field_add(?temporary, ?v, ?v);
    field_subtract(?result.x, ?result.x, ?temporary);
    field_subtract(?temporary, ?v, ?result.x);
    field_multiply(?result.y, ?r, ?temporary);
    field_multiply(?temporary, ?left.y, ?j);
    field_add(?temporary, ?temporary, ?temporary);
    field_subtract(?result.y, ?result.y, ?temporary);
    field_add(?temporary, ?left.z, ?h);
    field_square(?result.z, ?temporary);
    field_subtract(?result.z, ?result.z, ?z1z1);
    field_subtract(?result.z, ?result.z, ?hh);

    point_copy(output, ?result);
    destroy_uint(?z1z1);
    destroy_uint(?u2);
    destroy_uint(?s2);
    destroy_uint(?h);
    destroy_uint(?hh);
    destroy_uint(?i_value);
    destroy_uint(?j);
    destroy_uint(?r);
    destroy_uint(?v);
    destroy_uint(?temporary);
    destroy_point(?result);
}

# multiply the generator by a scalar with the fixed-base comb table
#
# the scalar is reduced below n. after window i the accumulator is k' * G with
# k' < 16^i, and the added entry is d * 16^i * G with d * 16^i <= 15 * 2^252 < n,
# so the two are never equal. they are negations only when k' + d * 16^i = n,
# which would make the reduced scalar n. an infinite accumulator takes the lifted
# entry, and a zero digit keeps the accumulator, both by select.
#[oblivious]
pub fun scalar_multiply_base(output: *Point, scalar: *UInt) {
    var reduced: UInt;
    var result:  Point;
    var sum:     Point;
    var lifted:  Point;
    copy(?reduced, scalar);
    reduce_scalar_once(?reduced);
    point_infinity(?result);
    var window: u64 = 0;
    for (window < p256_base.WINDOWS) {
        val limb_index: usize = (window >> 3)::usize;
        val shift:      u64   = (window & 7) * 4;
        val digit:      ^u64  = (reduced.limb[limb_index] >> shift) & 15;
        set_small(?lifted.x, 0);
        set_small(?lifted.y, 0);
        set_small(?lifted.z, 1);
        var candidate: u64 = 1;
        for (candidate <= p256_base.DIGITS) {
            val mask: ^u64 = 0 - ct.eq[u64](digit, candidate)::^u64;
            accumulate_entry(?lifted.x, ?lifted.y, window, candidate, mask);
            candidate = candidate + 1;
        }
        val infinity: ^u8 = point_is_infinity(?result);
        val zero:     ^u8 = ct.eq[u64](digit, 0);
        point_add_mixed(?sum, ?result, ?lifted.x, ?lifted.y);
        point_select(?sum, ?sum, ?lifted, infinity);
        point_select(?result, ?sum, ?result, zero);
        window = window + 1;
    }
    point_copy(output, ?result);
    destroy_uint(?reduced);
    destroy_point(?result);
    destroy_point(?sum);
    destroy_point(?lifted);
}

#[oblivious]
pub fun to_affine(x: *UInt, y: *UInt, point: *Point) {
    var inverse:         UInt;
    var inverse_squared: UInt;
    var inverse_cubed:   UInt;
    field_inverse(?inverse, ?point.z);
    field_square(?inverse_squared, ?inverse);
    field_multiply(?inverse_cubed, ?inverse_squared, ?inverse);
    field_multiply(x, ?point.x, ?inverse_squared);
    field_multiply(y, ?point.y, ?inverse_cubed);
    destroy_uint(?inverse);
    destroy_uint(?inverse_squared);
    destroy_uint(?inverse_cubed);
}

#[oblivious]
pub fun parse_point(output: *Point, input: *u8) ^u8 {
    decode_public(?output.x, input, 1);
    decode_public(?output.y, input, 33);
    set_small(?output.z, 1);
    val x_canonical: ^u8 = less_than_modulus(?output.x, (?PRIME[0]):~*u64);
    val y_canonical: ^u8 = less_than_modulus(?output.y, (?PRIME[0]):~*u64);
    var left:        UInt;
    var right:       UInt;
    var temporary:   UInt;
    field_square(?left, ?output.y);
    field_square(?right, ?output.x);
    field_multiply(?right, ?right, ?output.x);
    field_add(?temporary, ?output.x, ?output.x);
    field_add(?temporary, ?temporary, ?output.x);
    field_subtract(?right, ?right, ?temporary);
    copy_constant(?temporary, (?CURVE_B[0]):~*u64);
    field_add(?right, ?right, ?temporary);
    val on_curve: ^u8 = equal(?left, ?right);
    destroy_uint(?left);
    destroy_uint(?right);
    destroy_uint(?temporary);
    ret x_canonical & y_canonical & on_curve;
}

test "p256 internal: constants have canonical low words" {
    if (PRIME[0] != 0xFFFFFFFF || ORDER[0] != 0xFC632551)             { ret 1; }
    if (GENERATOR_X[7] != 0x6B17D1F2 || GENERATOR_Y[0] != 0x37BF51F5) { ret 2; }
    ret 0;
}

# run a chain over exponents instead of field elements, as 32-bit words
fun chain_exponent(chain: *ChainStep, steps: usize, result: usize, output: *u64) {
    var exponents: [16][9]u64;
    exponents[0][0] = 1;
    var step: usize = 0;
    for (step < steps) {
        val current: ChainStep = chain[step];
        var value:   [9]u64    = exponents[current.src];
        var count:   u8        = 0;
        for (count < current.squarings) {
            var carry: u64   = 0;
            var i:     usize = 0;
            for (i < 9) {
                val shifted: u64 = (value[i] << 1) | carry;
                carry    = shifted >> 32;
                value[i] = shifted & WORD_MASK;
                i        = i + 1;
            }
            count = count + 1;
        }
        if (current.factor != NO_FACTOR) {
            var carry: u64   = 0;
            var i:     usize = 0;
            for (i < 9) {
                val sum: u64 = value[i] + exponents[current.factor][i] + carry;
                carry    = sum >> 32;
                value[i] = sum & WORD_MASK;
                i        = i + 1;
            }
        }
        exponents[current.dst] = value;
        step                   = step + 1;
    }
    var i: usize = 0;
    for (i < 9) {
        output[i] = exponents[result][i];
        i         = i + 1;
    }
}

# modulus - 2 as 32-bit words with a zero ninth word
fun minus_two(modulus: *u64, output: *u64) {
    output[0] = modulus[0] - 2;
    var i: usize = 1;
    for (i < 8) {
        output[i] = modulus[i];
        i         = i + 1;
    }
    output[8] = 0;
}

fun words_equal(left: *u64, right: *u64) u8 {
    var i: usize = 0;
    for (i < 9) {
        if (left[i] != right[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

test "p256 internal: inversion chains raise to p - 2 and n - 2" {
    var actual:   [9]u64;
    var expected: [9]u64;
    chain_exponent(?FIELD_CHAIN[0], FIELD_STEPS, FIELD_RESULT, ?actual[0]);
    minus_two((?PRIME[0]):~*u64, ?expected[0]);
    if (words_equal(?actual[0], ?expected[0]) != 1) { ret 1; }
    chain_exponent(?SCALAR_CHAIN[0], SCALAR_STEPS, SCALAR_RESULT, ?actual[0]);
    minus_two((?ORDER[0]):~*u64, ?expected[0]);
    if (words_equal(?actual[0], ?expected[0]) != 1) { ret 2; }
    ret 0;
}

test "p256 internal: every comb table entry is digit * 16^window * G" {
    var base: Point;
    generator(?base);
    var window: u64 = 0;
    for (window < p256_base.WINDOWS) {
        var multiple: Point;
        point_infinity(?multiple);
        var digit: u64 = 1;
        for (digit <= p256_base.DIGITS) {
            point_add(?multiple, ?multiple, ?base);
            var x:      UInt;
            var y:      UInt;
            var z2:     UInt;
            var z3:     UInt;
            var scaled: UInt;
            accumulate_entry(?x, ?y, window, digit, 0 - 1);
            field_square(?z2, ?multiple.z);
            field_multiply(?z3, ?z2, ?multiple.z);
            field_multiply(?scaled, ?x, ?z2);
            if (equal(?scaled, ?multiple.x):>u8 != 1) { ret 1; }
            field_multiply(?scaled, ?y, ?z3);
            if (equal(?scaled, ?multiple.y):>u8 != 1) { ret 2; }
            digit = digit + 1;
        }
        point_double(?base, ?base);
        point_double(?base, ?base);
        point_double(?base, ?base);
        point_double(?base, ?base);
        window = window + 1;
    }
    ret 0;
}

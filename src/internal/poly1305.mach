# secret-state poly1305 for aead message layouts

use crypto.contracts;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val KEY_SIZE: usize = 32;
pub val TAG_SIZE: usize = 16;

val LIMB_MASK: u64 = 0x3FFFFFF;
val FULL_BLOCK_BIT: u64 = 0x1000000;

pub rec Context {
    r:      [5]^u64;
    h:      [5]^u64;
    pad:    [4]^u32;
    active: bool;
}

#[oblivious] #[inline]
fun read_u32(input: *^u8, offset: usize) ^u32 {
    ret input[offset]::^u32 | (input[offset + 1]::^u32 << 8) |
        (input[offset + 2]::^u32 << 16) | (input[offset + 3]::^u32 << 24);
}

#[oblivious] #[inline]
fun write_u32(output: *^u8, offset: usize, value: ^u32) {
    output[offset] = value::^u8;
    output[offset + 1] = (value >> 8)::^u8;
    output[offset + 2] = (value >> 16)::^u8;
    output[offset + 3] = (value >> 24)::^u8;
}

#[oblivious] #[inline]
fun multiply29(left: ^u64, right: ^u64) ^u64 {
    var result: ^u64 = 0;
    var shifted: ^u64 = left;
    var multiplier: ^u64 = right;
    var i: usize = 0;
    for (i < 29) {
        val mask: ^u64 = 0 - (multiplier & 1);
        result = result + (shifted & mask);
        shifted = shifted << 1;
        multiplier = multiplier >> 1;
        i = i + 1;
    }
    shifted = 0;
    multiplier = 0;
    ret result;
}

pub fun destroy(context: *Context) {
    if (context == nil) { ret; }
    ct.zeroize((?context.r[0]):~*^u8, 40);
    ct.zeroize((?context.h[0]):~*^u8, 40);
    ct.zeroize((?context.pad[0]):~*^u8, 16);
    context.active = false;
}

#[oblivious]
pub fun init(context: *Context, key: contracts.SecretBytes) contracts.Error {
    if (context == nil) { ret contracts.INVALID_INPUT; }
    destroy(context);
    if (key.len != KEY_SIZE) { ret contracts.INVALID_KEY; }
    if (key.data == nil) { ret contracts.INVALID_INPUT; }
    context.r[0] = read_u32(key.data, 0)::^u64 & 0x3FFFFFF;
    context.r[1] = (read_u32(key.data, 3)::^u64 >> 2) & 0x3FFFF03;
    context.r[2] = (read_u32(key.data, 6)::^u64 >> 4) & 0x3FFC0FF;
    context.r[3] = (read_u32(key.data, 9)::^u64 >> 6) & 0x3F03FFF;
    context.r[4] = (read_u32(key.data, 12)::^u64 >> 8) & 0x00FFFFF;
    var i: usize = 0;
    for (i < 5) { context.h[i] = 0; i = i + 1; }
    i = 0;
    for (i < 4) {
        context.pad[i] = read_u32(key.data, 16 + i * 4);
        i = i + 1;
    }
    context.active = true;
    ret contracts.OK;
}

#[oblivious]
fun process_block(context: *Context, block: *^u8) {
    context.h[0] = context.h[0] + (read_u32(block, 0)::^u64 & LIMB_MASK);
    context.h[1] = context.h[1] + ((read_u32(block, 3)::^u64 >> 2) & LIMB_MASK);
    context.h[2] = context.h[2] + ((read_u32(block, 6)::^u64 >> 4) & LIMB_MASK);
    context.h[3] = context.h[3] + ((read_u32(block, 9)::^u64 >> 6) & LIMB_MASK);
    context.h[4] = context.h[4] + (read_u32(block, 12)::^u64 >> 8) + FULL_BLOCK_BIT;

    val r1x5: ^u64 = context.r[1] + (context.r[1] << 2);
    val r2x5: ^u64 = context.r[2] + (context.r[2] << 2);
    val r3x5: ^u64 = context.r[3] + (context.r[3] << 2);
    val r4x5: ^u64 = context.r[4] + (context.r[4] << 2);
    var product: [5]^u64;
    product[0] = multiply29(context.h[0], context.r[0]) + multiply29(context.h[1], r4x5) +
        multiply29(context.h[2], r3x5) + multiply29(context.h[3], r2x5) +
        multiply29(context.h[4], r1x5);
    product[1] = multiply29(context.h[0], context.r[1]) + multiply29(context.h[1], context.r[0]) +
        multiply29(context.h[2], r4x5) + multiply29(context.h[3], r3x5) +
        multiply29(context.h[4], r2x5);
    product[2] = multiply29(context.h[0], context.r[2]) + multiply29(context.h[1], context.r[1]) +
        multiply29(context.h[2], context.r[0]) + multiply29(context.h[3], r4x5) +
        multiply29(context.h[4], r3x5);
    product[3] = multiply29(context.h[0], context.r[3]) + multiply29(context.h[1], context.r[2]) +
        multiply29(context.h[2], context.r[1]) + multiply29(context.h[3], context.r[0]) +
        multiply29(context.h[4], r4x5);
    product[4] = multiply29(context.h[0], context.r[4]) + multiply29(context.h[1], context.r[3]) +
        multiply29(context.h[2], context.r[2]) + multiply29(context.h[3], context.r[1]) +
        multiply29(context.h[4], context.r[0]);

    var carry: ^u64 = product[0] >> 26;
    context.h[0] = product[0] & LIMB_MASK;
    product[1] = product[1] + carry;
    carry = product[1] >> 26;
    context.h[1] = product[1] & LIMB_MASK;
    product[2] = product[2] + carry;
    carry = product[2] >> 26;
    context.h[2] = product[2] & LIMB_MASK;
    product[3] = product[3] + carry;
    carry = product[3] >> 26;
    context.h[3] = product[3] & LIMB_MASK;
    product[4] = product[4] + carry;
    carry = product[4] >> 26;
    context.h[4] = product[4] & LIMB_MASK;
    context.h[0] = context.h[0] + carry + (carry << 2);
    carry = context.h[0] >> 26;
    context.h[0] = context.h[0] & LIMB_MASK;
    context.h[1] = context.h[1] + carry;
    carry = 0;
    ct.zeroize((?product[0]):~*^u8, 40);
}

pub fun update_padded(context: *Context, data: *u8, len: usize) {
    var block: [16]^u8;
    ct.zeroize(?block[0], 16);
    var offset: usize = 0;
    for (offset < len) {
        ct.zeroize(?block[0], 16);
        var take: usize = len - offset;
        if (take > 16) { take = 16; }
        var i: usize = 0;
        for (i < take) {
            block[i] = data[offset + i];
            i = i + 1;
        }
        process_block(context, ?block[0]);
        offset = offset + take;
    }
    ct.zeroize(?block[0], 16);
}

fun write_length(output: *^u8, offset: usize, value: u64) {
    output[offset] = value::u8;
    output[offset + 1] = (value >> 8)::u8;
    output[offset + 2] = (value >> 16)::u8;
    output[offset + 3] = (value >> 24)::u8;
    output[offset + 4] = (value >> 32)::u8;
    output[offset + 5] = (value >> 40)::u8;
    output[offset + 6] = (value >> 48)::u8;
    output[offset + 7] = (value >> 56)::u8;
}

pub fun update_lengths(context: *Context, aad_len: usize, text_len: usize) {
    var block: [16]^u8;
    ct.zeroize(?block[0], 16);
    write_length(?block[0], 0, aad_len::u64);
    write_length(?block[0], 8, text_len::u64);
    process_block(context, ?block[0]);
    ct.zeroize(?block[0], 16);
}

#[oblivious]
pub fun final(context: *Context, tag: *^u8) {
    var carry: ^u64 = context.h[1] >> 26;
    context.h[1] = context.h[1] & LIMB_MASK;
    context.h[2] = context.h[2] + carry;
    carry = context.h[2] >> 26;
    context.h[2] = context.h[2] & LIMB_MASK;
    context.h[3] = context.h[3] + carry;
    carry = context.h[3] >> 26;
    context.h[3] = context.h[3] & LIMB_MASK;
    context.h[4] = context.h[4] + carry;
    carry = context.h[4] >> 26;
    context.h[4] = context.h[4] & LIMB_MASK;
    context.h[0] = context.h[0] + carry + (carry << 2);
    carry = context.h[0] >> 26;
    context.h[0] = context.h[0] & LIMB_MASK;
    context.h[1] = context.h[1] + carry;

    var reduced: [5]^u64;
    reduced[0] = context.h[0] + 5;
    carry = reduced[0] >> 26;
    reduced[0] = reduced[0] & LIMB_MASK;
    reduced[1] = context.h[1] + carry;
    carry = reduced[1] >> 26;
    reduced[1] = reduced[1] & LIMB_MASK;
    reduced[2] = context.h[2] + carry;
    carry = reduced[2] >> 26;
    reduced[2] = reduced[2] & LIMB_MASK;
    reduced[3] = context.h[3] + carry;
    carry = reduced[3] >> 26;
    reduced[3] = reduced[3] & LIMB_MASK;
    reduced[4] = context.h[4] + carry - 0x4000000;
    val use_reduced: ^u64 = (reduced[4] >> 63) - 1;
    val use_original: ^u64 = ~use_reduced;
    var i: usize = 0;
    for (i < 5) {
        context.h[i] = (context.h[i] & use_original) | (reduced[i] & use_reduced);
        i = i + 1;
    }

    var words: [4]^u64;
    words[0] = ((context.h[0] | (context.h[1] << 26)) & 0xFFFFFFFF) + context.pad[0]::^u64;
    words[1] = (((context.h[1] >> 6) | (context.h[2] << 20)) & 0xFFFFFFFF) + context.pad[1]::^u64 +
        (words[0] >> 32);
    words[2] = (((context.h[2] >> 12) | (context.h[3] << 14)) & 0xFFFFFFFF) + context.pad[2]::^u64 +
        (words[1] >> 32);
    words[3] = (((context.h[3] >> 18) | (context.h[4] << 8)) & 0xFFFFFFFF) + context.pad[3]::^u64 +
        (words[2] >> 32);
    i = 0;
    for (i < 4) {
        write_u32(tag, i * 4, words[i]::^u32);
        i = i + 1;
    }
    carry = 0;
    ct.zeroize((?reduced[0]):~*^u8, 40);
    ct.zeroize((?words[0]):~*^u8, 32);
    destroy(context);
}

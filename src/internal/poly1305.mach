# secret-state poly1305 for aead message layouts
#
# the accumulator and key are three 44-bit limbs (44, 44 and 42 bits) so a
# block is nine wide word products from crypto.internal.word and one carry
# chain, the shape the 64 x 64 multiply gives; the target without the hardware
# cell runs the same nine products on the serial reference (#83)

use crypto.contracts;
use crypto.internal.word;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val KEY_SIZE: usize = 32;
pub val TAG_SIZE: usize = 16;

val MASK_44:        u64 = 0xFFFFFFFFFFF;
val MASK_42:        u64 = 0x3FFFFFFFFFF;
val FULL_BLOCK_BIT: u64 = 0x10000000000;

pub rec Context {
    r:      [3]^u64;
    h:      [3]^u64;
    pad:    [2]^u64;
    active: bool;
}

#[oblivious]
#[inline]
fun read_u64(input: *^u8, offset: usize) ^u64 {
    ret input[offset]::^u64 | (input[offset + 1]::^u64 << 8) |
        (input[offset + 2]::^u64 << 16) | (input[offset + 3]::^u64 << 24) |
        (input[offset + 4]::^u64 << 32) | (input[offset + 5]::^u64 << 40) |
        (input[offset + 6]::^u64 << 48) | (input[offset + 7]::^u64 << 56);
}

#[oblivious]
#[inline]
fun write_u64(output: *^u8, offset: usize, value: ^u64) {
    output[offset]     = value::^u8;
    output[offset + 1] = (value >> 8)::^u8;
    output[offset + 2] = (value >> 16)::^u8;
    output[offset + 3] = (value >> 24)::^u8;
    output[offset + 4] = (value >> 32)::^u8;
    output[offset + 5] = (value >> 40)::^u8;
    output[offset + 6] = (value >> 48)::^u8;
    output[offset + 7] = (value >> 56)::^u8;
}

# value * 20 = value * 5 * 4, the fold of 2^130 = 5 into the limb below
#[oblivious]
#[inline]
fun times_twenty(value: ^u64) ^u64 {
    ret (value << 4) + (value << 2);
}

pub fun destroy(context: *Context) {
    if (context == nil) { ret; }
    ct.zeroize((?context.r[0]):~*^u8, 24);
    ct.zeroize((?context.h[0]):~*^u8, 24);
    ct.zeroize((?context.pad[0]):~*^u8, 16);
    context.active = false;
}

#[oblivious]
pub fun init(context: *Context, key: contracts.SecretBytes) contracts.Error {
    if (context == nil) { ret contracts.INVALID_INPUT; }
    destroy(context);
    if (key.len != KEY_SIZE) { ret contracts.INVALID_KEY; }
    if (key.data == nil)     { ret contracts.INVALID_INPUT; }
    val low:  ^u64 = read_u64(key.data, 0);
    val high: ^u64 = read_u64(key.data, 8);
    context.r[0]   = low & 0xFFC0FFFFFFF;
    context.r[1]   = ((low >> 44) | (high << 20)) & 0xFFFFFC0FFFF;
    context.r[2]   = (high >> 24) & 0x00FFFFFFC0F;
    context.h[0]   = 0;
    context.h[1]   = 0;
    context.h[2]   = 0;
    context.pad[0] = read_u64(key.data, 16);
    context.pad[1] = read_u64(key.data, 24);
    context.active = true;
    ret contracts.OK;
}

#[oblivious]
fun process_block(context: *Context, block: *^u8) {
    val low:  ^u64 = read_u64(block, 0);
    val high: ^u64 = read_u64(block, 8);
    val h0:   ^u64 = context.h[0] + (low & MASK_44);
    val h1:   ^u64 = context.h[1] + (((low >> 44) | (high << 20)) & MASK_44);
    val h2:   ^u64 = context.h[2] + ((high >> 24) & MASK_42) + FULL_BLOCK_BIT;
    val r0:   ^u64 = context.r[0];
    val r1:   ^u64 = context.r[1];
    val r2:   ^u64 = context.r[2];
    val s1:   ^u64 = times_twenty(r1);
    val s2:   ^u64 = times_twenty(r2);

    var d0: ^u128 = word.multiply_wide(h0, r0) + word.multiply_wide(h1, s2) +
        word.multiply_wide(h2, s1);
    var d1: ^u128 = word.multiply_wide(h0, r1) + word.multiply_wide(h1, r0) +
        word.multiply_wide(h2, s2);
    var d2: ^u128 = word.multiply_wide(h0, r2) + word.multiply_wide(h1, r1) +
        word.multiply_wide(h2, r0);

    var carry: ^u64 = (d0 >> 44)::^u64;
    var n0:    ^u64 = d0::^u64 & MASK_44;
    d1    = d1 + carry::^u128;
    carry = (d1 >> 44)::^u64;
    var n1: ^u64 = d1::^u64 & MASK_44;
    d2    = d2 + carry::^u128;
    carry = (d2 >> 42)::^u64;
    val n2: ^u64 = d2::^u64 & MASK_42;
    n0           = n0 + carry + (carry << 2);
    carry        = n0 >> 44;
    n0           = n0 & MASK_44;
    n1           = n1 + carry;
    context.h[0] = n0;
    context.h[1] = n1;
    context.h[2] = n2;
    d0           = 0;
    d1           = 0;
    d2           = 0;
    carry        = 0;
}

pub fun update_padded(context: *Context, data: *u8, len: usize) {
    var block: [16]^u8;
    ct.zeroize(?block[0], 16);
    var offset: usize = 0;
    for (offset < len) {
        ct.zeroize(?block[0], 16);
        var take: usize = len - offset;
        if (take > 16) { take = 16; }
        var i: usize = 0;
        for (i < take) {
            block[i] = data[offset + i];
            i        = i + 1;
        }
        process_block(context, ?block[0]);
        offset = offset + take;
    }
    ct.zeroize(?block[0], 16);
}

fun write_length(output: *^u8, offset: usize, value: u64) {
    output[offset]     = value::u8;
    output[offset + 1] = (value >> 8)::u8;
    output[offset + 2] = (value >> 16)::u8;
    output[offset + 3] = (value >> 24)::u8;
    output[offset + 4] = (value >> 32)::u8;
    output[offset + 5] = (value >> 40)::u8;
    output[offset + 6] = (value >> 48)::u8;
    output[offset + 7] = (value >> 56)::u8;
}

pub fun update_lengths(context: *Context, aad_len: usize, text_len: usize) {
    var block: [16]^u8;
    ct.zeroize(?block[0], 16);
    write_length(?block[0], 0, aad_len::u64);
    write_length(?block[0], 8, text_len::u64);
    process_block(context, ?block[0]);
    ct.zeroize(?block[0], 16);
}

#[oblivious]
pub fun final(context: *Context, tag: *^u8) {
    var h0:    ^u64 = context.h[0];
    var h1:    ^u64 = context.h[1];
    var h2:    ^u64 = context.h[2];
    var carry: ^u64 = h1 >> 44;
    h1    = h1 & MASK_44;
    h2    = h2 + carry;
    carry = h2 >> 42;
    h2    = h2 & MASK_42;
    h0    = h0 + carry + (carry << 2);
    carry = h0 >> 44;
    h0    = h0 & MASK_44;
    h1    = h1 + carry;
    carry = h1 >> 44;
    h1    = h1 & MASK_44;
    h2    = h2 + carry;

    # h + 5 - 2^130 replaces h when it does not borrow, which is h >= p
    var g0: ^u64 = h0 + 5;
    carry = g0 >> 44;
    g0    = g0 & MASK_44;
    var g1: ^u64 = h1 + carry;
    carry = g1 >> 44;
    g1    = g1 & MASK_44;
    val g2:           ^u64 = h2 + carry - 0x40000000000;
    val use_reduced:  ^u64 = (g2 >> 63) - 1;
    val use_original: ^u64 = ~use_reduced;
    h0 = (h0 & use_original) | (g0 & use_reduced);
    h1 = (h1 & use_original) | (g1 & use_reduced);
    h2 = (h2 & use_original) | (g2 & use_reduced);

    # h mod 2^128 as two words, plus the pad with its carry
    val low:   ^u64 = h0 | (h1 << 44);
    val high:  ^u64 = (h1 >> 20) | (h2 << 24);
    val word0: ^u64 = low + context.pad[0];
    val word1: ^u64 = high + context.pad[1] + word.carry_of(low, context.pad[0], word0);
    write_u64(tag, 0, word0);
    write_u64(tag, 8, word1);
    h0    = 0;
    h1    = 0;
    h2    = 0;
    g0    = 0;
    g1    = 0;
    carry = 0;
    destroy(context);
}

# tag over the aead layout: padded aad, padded text, then the length block
fun tag_of(key: *u8, aad: *u8, aad_len: usize, text: *u8, text_len: usize, tag: *^u8) bool {
    var secret_key: [32]^u8;
    var i:          usize = 0;
    for (i < 32) {
        secret_key[i] = key[i];
        i             = i + 1;
    }
    var context: Context;
    if (init(?context, contracts.SecretBytes{data: ?secret_key[0], len: 32}) != contracts.OK) {
        ret false;
    }
    update_padded(?context, aad, aad_len);
    update_padded(?context, text, text_len);
    update_lengths(?context, aad_len, text_len);
    final(?context, tag);
    ct.zeroize(?secret_key[0], 32);
    ret true;
}

fun tag_equals(tag: *^u8, expected: *u8) bool {
    var i: usize = 0;
    for (i < 16) {
        if (tag[i]:>u8 != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the limb carries at their edges, against independent big-integer arithmetic
# over the same padded layout: a fully clamped r on all-ones blocks, r = 1
# with h crossing p at the final reduction, r = 2 with the pad addition
# carrying between the tag words, and aad with a partial final block
test "poly1305: carry edges match independent vectors over the padded layout" {
    val clamped_key: [32]u8 = [32]u8{
        0xff, 0xff, 0xff, 0x0f, 0xfc, 0xff, 0xff, 0x0f, 0xfc, 0xff, 0xff, 0x0f,
        0xfc, 0xff, 0xff, 0x0f, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff
    };
    var ones: [48]u8;
    var i:    usize = 0;
    for (i < 48) {
        ones[i] = 0xff;
        i       = i + 1;
    }
    val clamped_tag: [16]u8 = [16]u8{
        0xa4, 0x0e, 0xe3, 0xe7, 0xd5, 0x5e, 0xa8, 0x93, 0x91, 0xa8, 0xef, 0xe0,
        0x0b, 0xe3, 0x7e, 0xad
    };
    var tag: [16]^u8;
    if (!tag_of(?clamped_key[0], nil, 0, ?ones[0], 48, ?tag[0]) ||
        !tag_equals(?tag[0], ?clamped_tag[0])) { ret 1; }

    var one_key: [32]u8;
    i = 0;
    for (i < 32) {
        one_key[i] = 0;
        i          = i + 1;
    }
    one_key[0] = 1;
    val crossing: [32]u8 = [32]u8{
        0xfb, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe,
        0xfe, 0xfe, 0xfe, 0xfe, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    };
    val crossing_tag: [16]u8 = [16]u8{
        0xfc, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0x1e, 0xff, 0xfe, 0xfe,
        0xfe, 0xfe, 0xfe, 0xfe
    };
    if (!tag_of(?one_key[0], nil, 0, ?crossing[0], 32, ?tag[0]) ||
        !tag_equals(?tag[0], ?crossing_tag[0])) { ret 2; }

    var two_key: [32]u8;
    i = 0;
    for (i < 32) {
        two_key[i] = 0xff;
        i          = i + 1;
    }
    i = 0;
    for (i < 16) {
        two_key[i] = 0;
        i          = i + 1;
    }
    two_key[0] = 2;
    var two_block: [16]u8;
    i = 0;
    for (i < 16) {
        two_block[i] = 0;
        i            = i + 1;
    }
    two_block[0] = 2;
    val two_tag: [16]u8 = [16]u8{
        0x0c, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00
    };
    if (!tag_of(?two_key[0], nil, 0, ?two_block[0], 16, ?tag[0]) ||
        !tag_equals(?tag[0], ?two_tag[0])) { ret 3; }

    val mixed_key: [32]u8 = [32]u8{
        0x1c, 0x92, 0x40, 0xa5, 0xeb, 0x55, 0xd3, 0x8a, 0xf3, 0x33, 0x88, 0x86,
        0x04, 0xf6, 0xb5, 0xf0, 0x47, 0x39, 0x17, 0xc1, 0x40, 0x2b, 0x80, 0x09,
        0x9d, 0xca, 0x5c, 0xbc, 0x20, 0x70, 0x75, 0xc0
    };
    val aad: [12]u8 = [12]u8{
        0x50, 0x51, 0x52, 0x53, 0xc0, 0xc1, 0xc2, 0xc3, 0xc4, 0xc5, 0xc6, 0xc7
    };
    var text: [41]u8;
    i = 0;
    for (i < 41) {
        text[i] = (i + 1)::u8;
        i       = i + 1;
    }
    val mixed_tag: [16]u8 = [16]u8{
        0x9c, 0x80, 0x8e, 0x76, 0xa2, 0x65, 0x56, 0x7b, 0xb5, 0x71, 0xcf, 0x61,
        0x1a, 0xc1, 0xfe, 0x87
    };
    if (!tag_of(?mixed_key[0], ?aad[0], 12, ?text[0], 41, ?tag[0]) ||
        !tag_equals(?tag[0], ?mixed_tag[0])) { ret 4; }
    ret 0;
}

# the 256-bit montgomery ring every scalar ring shares
#
# values are four 64-bit limbs, little-endian, and every product is a word
# product from crypto.internal.word, so the target that admits the hardware
# cell computes one instruction per limb pair and every other target keeps the
# serial reference (#83). a ring is (modulus, factor, r2): the modulus below
# 2^256, factor = -modulus^-1 mod 2^64 and r2 = 2^512 mod modulus

use crypto.internal.word;
use std.crypto.ct;
use std.types.size.usize;

pub val LIMBS: usize = 4;

# 1 where the sum of two limbs would carry
#[oblivious]
#[inline]
fun carry_of(left: ^u64, right: ^u64, sum: ^u64) ^u64 {
    ret ((left & right) | ((left | right) & ~sum)) >> 63;
}

# 1 where left - right - borrow would borrow
#[oblivious]
#[inline]
fun borrow_of(left: ^u64, right: ^u64, difference: ^u64) ^u64 {
    ret ((~left & right) | ((~left | right) & difference)) >> 63;
}

# output = value - modulus where that does not borrow, else value. value is
# below 2 * modulus, so one pass reduces it
#[oblivious]
fun subtract_modulus(output: *^u64, value: *^u64, modulus: *u64, high: ^u64) {
    var reduced: [4]^u64;
    var borrow:  ^u64  = 0;
    var i:       usize = 0;
    for (i < 4) {
        val step:       ^u64 = value[i] - modulus[i];
        val difference: ^u64 = step - borrow;
        borrow     = borrow_of(value[i], modulus[i], step) | borrow_of(step, borrow, difference);
        reduced[i] = difference;
        i          = i + 1;
    }
    # the subtraction holds when the value's fifth limb covers the borrow
    val keep_mask: ^u64 = 0 - (borrow & ~high);
    i = 0;
    for (i < 4) {
        output[i] = (value[i] & keep_mask) | (reduced[i] & ~keep_mask);
        i         = i + 1;
    }
    borrow = 0;
    ct.zeroize((?reduced[0]):~*^u8, 32);
}

# output = left + right mod modulus, for both below the modulus
#[oblivious]
pub fun add(output: *^u64, left: *^u64, right: *^u64, modulus: *u64) {
    var sum:   [4]^u64;
    var carry: ^u64  = 0;
    var i:     usize = 0;
    for (i < 4) {
        val step:  ^u64 = left[i] + right[i];
        val total: ^u64 = step + carry;
        carry  = carry_of(left[i], right[i], step) | carry_of(step, carry, total);
        sum[i] = total;
        i      = i + 1;
    }
    subtract_modulus(output, ?sum[0], modulus, carry);
    carry = 0;
    ct.zeroize((?sum[0]):~*^u8, 32);
}

# 1 where value is below the modulus
#[oblivious]
pub fun less_than(value: *^u64, modulus: *u64) ^u8 {
    var borrow: ^u64  = 0;
    var i:      usize = 0;
    for (i < 4) {
        val step:       ^u64 = value[i] - modulus[i];
        val difference: ^u64 = step - borrow;
        borrow = borrow_of(value[i], modulus[i], step) | borrow_of(step, borrow, difference);
        i      = i + 1;
    }
    val result: ^u8 = borrow::^u8;
    borrow = 0;
    ret result;
}

# output = left * right * 2^-256 mod modulus, below the modulus, for left below
# 2^256 and right below the modulus
#[oblivious]
pub fun multiply(output: *^u64, left: *^u64, right: *^u64, modulus: *u64, factor: u64) {
    var product: [8]^u64;
    var carry:   ^u128 = 0;
    var i:       usize = 0;
    for (i < 8) {
        product[i] = 0;
        i          = i + 1;
    }
    i = 0;
    for (i < 4) {
        carry = 0;
        var j: usize = 0;
        for (j < 4) {
            val term: ^u128 = word.multiply_wide(left[j], right[i]) +
                product[i + j]::^u128 + carry;
            product[i + j] = term::^u64;
            carry          = term >> 64;
            j              = j + 1;
        }
        product[i + 4] = carry::^u64;
        i              = i + 1;
    }
    reduce(output, ?product[0], modulus, factor);
    carry = 0;
    ct.zeroize((?product[0]):~*^u8, 64);
}

# output = value * 2^-256 mod modulus, below the modulus, for a value below
# modulus * 2^256. a value below 2^512 that is not below that bound still
# reduces to a single-limb overflow, which the final subtraction absorbs only
# when the modulus is above 2^255, so callers reduce wider values in halves
#[oblivious]
pub fun reduce(output: *^u64, value: *^u64, modulus: *u64, factor: u64) {
    var t: [9]^u64;
    var i: usize = 0;
    for (i < 8) {
        t[i] = value[i];
        i    = i + 1;
    }
    t[8] = 0;
    i    = 0;
    for (i < 4) {
        val multiplier: ^u64  = word.multiply(t[i], factor, 64);
        var carry:      ^u128 = 0;
        var j:          usize = 0;
        for (j < 4) {
            val term: ^u128 = word.multiply_wide(multiplier, modulus[j]) +
                t[i + j]::^u128 + carry;
            t[i + j] = term::^u64;
            carry    = term >> 64;
            j        = j + 1;
        }
        j = i + 4;
        for (j < 9) {
            val term: ^u128 = t[j]::^u128 + carry;
            t[j]  = term::^u64;
            carry = term >> 64;
            j     = j + 1;
        }
        i = i + 1;
    }
    subtract_modulus(output, ?t[4], modulus, t[8]);
    ct.zeroize((?t[0]):~*^u8, 72);
}

# output = value mod modulus for a 512-bit value in eight limbs: the high half
# enters through r2 as high * 2^256, the low half is reduced through the ring
# and back, and the two are added
#[oblivious]
pub fun reduce_wide(output: *^u64, value: *^u64, modulus: *u64, factor: u64, r2: *u64) {
    var high: [4]^u64;
    var low:  [4]^u64;
    var one:  [4]^u64;
    var r2s:  [4]^u64;
    var i:    usize = 0;
    for (i < 4) {
        r2s[i] = r2[i];
        one[i] = 0;
        i      = i + 1;
    }
    one[0] = 1;
    multiply(?high[0], ?value[4], ?r2s[0], modulus, factor);
    multiply(?low[0], ?value[0], ?r2s[0], modulus, factor);
    multiply(?low[0], ?low[0], ?one[0], modulus, factor);
    add(output, ?high[0], ?low[0], modulus);
    ct.zeroize((?high[0]):~*^u8, 32);
    ct.zeroize((?low[0]):~*^u8, 32);
}

# output = left * right mod modulus, for left below 2^256 and right below the
# modulus
#[oblivious]
pub fun multiply_values(output: *^u64, left: *^u64, right: *^u64, modulus: *u64,
    factor: u64, r2: *u64) {
    var r2s: [4]^u64;
    var i:   usize = 0;
    for (i < 4) {
        r2s[i] = r2[i];
        i      = i + 1;
    }
    multiply(output, left, right, modulus, factor);
    multiply(output, output, ?r2s[0], modulus, factor);
}

val TEST_ORDER: [4]u64 = [4]u64{
    0x5812631A5CF5D3ED, 0x14DEF9DEA2F79CD6, 0x0000000000000000, 0x1000000000000000
};
val TEST_FACTOR: u64    = 0xD2B51DA312547E1B;
val TEST_R2:     [4]u64 = [4]u64{
    0xA40611E3449C0F01, 0xD00E1BA768859347, 0xCEEC73D217F5BE65, 0x0399411B7C309A3D
};

fun test_equal(value: *^u64, expected: *u64) u8 {
    var i: usize = 0;
    for (i < 4) {
        if (value[i]:>u64 != expected[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

test "mont: products and wide reductions match independent values mod the ed25519 order" {
    var left: [4]^u64 = [4]^u64{
        0xF2A74DE452E6B438, 0x6513270E269E0D37, 0x0C5C7FD0A6A3A450, 0x691F8412128B2F33
    };
    var right: [4]^u64 = [4]^u64{
        0x1818E811892F902B, 0x9531985D5D9DC9F8, 0xE8E25D940ED90475, 0x036F675C81E74EF5
    };
    val product: [4]u64 = [4]u64{
        0x313970EA5CC66E89, 0x5C08B1A9FDCE9E44, 0xE68CB005A2610AE1, 0x0D84678C305AB7A0
    };
    var output: [4]^u64;
    multiply_values(?output[0], ?left[0], ?right[0], ?TEST_ORDER[0], TEST_FACTOR, ?TEST_R2[0]);
    if (test_equal(?output[0], ?product[0]) == 0) { ret 1; }

    var wide: [8]^u64 = [8]^u64{
        0x1600A35A099950D8, 0x6B0D549B6F03675A, 0x3D9C172411E20B8F, 0x8D116ECE1738F7D9,
        0x0F21DDB66CAD4A26, 0x90C192CFD3AC94AF, 0xF28C105D1FB17C23, 0xA170B33839263059
    };
    val reduced: [4]u64 = [4]u64{
        0xB5AAC971E5C41A84, 0x2268957D8178F04D, 0xD08347048FD8AE62, 0x08A7EE0CF2BE4ED9
    };
    reduce_wide(?output[0], ?wide[0], ?TEST_ORDER[0], TEST_FACTOR, ?TEST_R2[0]);
    if (test_equal(?output[0], ?reduced[0]) == 0) { ret 2; }

    # one below the order plus one is zero, and the order itself is not below it
    var top: [4]^u64 = [4]^u64{
        0x5812631A5CF5D3EC, 0x14DEF9DEA2F79CD6, 0x0000000000000000, 0x1000000000000000
    };
    var one:  [4]^u64 = [4]^u64{1, 0, 0, 0};
    val zero: [4]u64  = [4]u64{0, 0, 0, 0};
    add(?output[0], ?top[0], ?one[0], ?TEST_ORDER[0]);
    if (test_equal(?output[0], ?zero[0]) == 0)       { ret 3; }
    if (less_than(?top[0], ?TEST_ORDER[0]):>u8 != 1) { ret 4; }
    var order: [4]^u64 = [4]^u64{
        0x5812631A5CF5D3ED, 0x14DEF9DEA2F79CD6, 0x0000000000000000, 0x1000000000000000
    };
    if (less_than(?order[0], ?TEST_ORDER[0]):>u8 != 0) { ret 5; }
    ret 0;
}

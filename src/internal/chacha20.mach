# secret-state chacha20 block function

use crypto.contracts;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val KEY_SIZE:   usize = 32;
pub val NONCE_SIZE: usize = 12;
pub val BLOCK_SIZE: usize = 64;

pub rec Context {
    key:    [8]^u32;
    nonce:  [3]^u32;
    active: bool;
}

#[oblivious]
#[inline]
fun rotate_left(value: ^u32, shift: u32) ^u32 {
    ret (value << shift) | (value >> (32 - shift));
}

#[oblivious]
#[inline]
fun read_secret(input: *^u8, offset: usize) ^u32 {
    ret input[offset]::^u32 | (input[offset + 1]::^u32 << 8) |
        (input[offset + 2]::^u32 << 16) | (input[offset + 3]::^u32 << 24);
}

fun read_public(input: *u8, offset: usize) u32 {
    ret input[offset]::u32 | (input[offset + 1]::u32 << 8) |
        (input[offset + 2]::u32 << 16) | (input[offset + 3]::u32 << 24);
}

#[oblivious]
#[inline]
fun write_secret(output: *^u8, offset: usize, value: ^u32) {
    output[offset]     = value::^u8;
    output[offset + 1] = (value >> 8)::^u8;
    output[offset + 2] = (value >> 16)::^u8;
    output[offset + 3] = (value >> 24)::^u8;
}

pub fun destroy(context: *Context) {
    if (context == nil) { ret; }
    ct.zeroize((?context.key[0]):~*^u8, 32);
    ct.zeroize((?context.nonce[0]):~*^u8, 12);
    context.active = false;
}

pub fun init(context: *Context, key: contracts.SecretBytes, nonce: contracts.Bytes) contracts.Error {
    if (context == nil) { ret contracts.INVALID_INPUT; }
    ct.zeroize((?context.key[0]):~*^u8, 32);
    ct.zeroize((?context.nonce[0]):~*^u8, 12);
    context.active = false;
    if (key.len != KEY_SIZE) { ret contracts.INVALID_KEY; }
    if (key.data == nil || nonce.len != NONCE_SIZE || nonce.data == nil) {
        ret contracts.INVALID_INPUT;
    }
    var i: usize = 0;
    for (i < 8) {
        context.key[i] = read_secret(key.data, i * 4);
        i              = i + 1;
    }
    i = 0;
    for (i < 3) {
        context.nonce[i] = read_public(nonce.data, i * 4);
        i                = i + 1;
    }
    context.active = true;
    ret contracts.OK;
}

#[oblivious]
#[inline]
fun quarter_round(state: *^u32, a: usize, b: usize, c: usize, d: usize) {
    state[a] = state[a] + state[b];
    state[d] = rotate_left(state[d] ^ state[a], 16);
    state[c] = state[c] + state[d];
    state[b] = rotate_left(state[b] ^ state[c], 12);
    state[a] = state[a] + state[b];
    state[d] = rotate_left(state[d] ^ state[a], 8);
    state[c] = state[c] + state[d];
    state[b] = rotate_left(state[b] ^ state[c], 7);
}

#[oblivious]
pub fun block(context: *Context, counter: u32, output: *^u8) {
    var initial: [16]^u32;
    var working: [16]^u32;
    initial[0] = 0x61707865;
    initial[1] = 0x3320646e;
    initial[2] = 0x79622d32;
    initial[3] = 0x6b206574;
    var i: usize = 0;
    for (i < 8) {
        initial[4 + i] = context.key[i];
        i              = i + 1;
    }
    initial[12] = counter;
    initial[13] = context.nonce[0];
    initial[14] = context.nonce[1];
    initial[15] = context.nonce[2];
    i           = 0;
    for (i < 16) {
        working[i] = initial[i];
        i          = i + 1;
    }

    var round: usize = 0;
    for (round < 10) {
        quarter_round(?working[0], 0, 4, 8, 12);
        quarter_round(?working[0], 1, 5, 9, 13);
        quarter_round(?working[0], 2, 6, 10, 14);
        quarter_round(?working[0], 3, 7, 11, 15);
        quarter_round(?working[0], 0, 5, 10, 15);
        quarter_round(?working[0], 1, 6, 11, 12);
        quarter_round(?working[0], 2, 7, 8, 13);
        quarter_round(?working[0], 3, 4, 9, 14);
        round = round + 1;
    }
    i = 0;
    for (i < 16) {
        working[i] = working[i] + initial[i];
        write_secret(output, i * 4, working[i]);
        i = i + 1;
    }
    ct.zeroize((?initial[0]):~*^u8, 64);
    ct.zeroize((?working[0]):~*^u8, 64);
}

test "chacha20: rfc 8439 block vector" {
    var key:   [32]^u8;
    var nonce: [12]u8 = [12]u8{
        0x00, 0x00, 0x00, 0x09, 0x00, 0x00, 0x00, 0x4a,
        0x00, 0x00, 0x00, 0x00
    };
    var i: usize = 0;
    for (i < 32) {
        key[i] = i::u8;
        i      = i + 1;
    }
    var context: Context;
    if (init(?context, contracts.SecretBytes{data: ?key[0], len: 32},
        contracts.Bytes{data: ?nonce[0], len: 12}) != contracts.OK) { ret 1; }
    var output: [64]^u8;
    block(?context, 1, ?output[0]);
    val expected: [64]u8 = [64]u8{
        0x10, 0xf1, 0xe7, 0xe4, 0xd1, 0x3b, 0x59, 0x15,
        0x50, 0x0f, 0xdd, 0x1f, 0xa3, 0x20, 0x71, 0xc4,
        0xc7, 0xd1, 0xf4, 0xc7, 0x33, 0xc0, 0x68, 0x03,
        0x04, 0x22, 0xaa, 0x9a, 0xc3, 0xd4, 0x6c, 0x4e,
        0xd2, 0x82, 0x64, 0x46, 0x07, 0x9f, 0xaa, 0x09,
        0x14, 0xc2, 0xd7, 0x05, 0xd9, 0x8b, 0x02, 0xa2,
        0xb5, 0x12, 0x9c, 0xd1, 0xde, 0x16, 0x4e, 0xb9,
        0xcb, 0xd0, 0x83, 0xe8, 0xa2, 0x50, 0x3c, 0x4e
    };
    i = 0;
    for (i < 64) {
        if (output[i]:>u8 != expected[i]) {
            destroy(?context);
            ret 2;
        }
        i = i + 1;
    }
    destroy(?context);
    ct.zeroize(?output[0], 64);
    ret 0;
}

# constant-shape ed25519 arithmetic

use crypto.internal.ed25519_base;
use crypto.internal.mont;
use field: crypto.internal.x25519;
use std.crypto.ct;
use std.types.size.usize;

# the group order l = 2^252 + 27742317777372353535851937790883648493 as the
# montgomery ring (l, -l^-1 mod 2^64, 2^512 mod l)
val ORDER: [4]u64 = [4]u64{
    0x5812631A5CF5D3ED, 0x14DEF9DEA2F79CD6, 0x0000000000000000, 0x1000000000000000
};
val ORDER_FACTOR: u64    = 0xD2B51DA312547E1B;
val ORDER_R2:     [4]u64 = [4]u64{
    0xA40611E3449C0F01, 0xD00E1BA768859347, 0xCEEC73D217F5BE65, 0x0399411B7C309A3D
};

val CURVE_D: [5]u64 = [5]u64{
    0x34DCA135978A3, 0x1A8283B156EBD, 0x5E7A26001C029,
    0x739C663A03CBB, 0x52036CEE2B6FF
};

val CURVE_2D: [5]u64 = [5]u64{
    0x69B9426B2F159, 0x35050762ADD7A, 0x3CF44C0038052,
    0x6738CC7407977, 0x2406D9DC56DFF
};

val SQRT_MINUS_ONE: [5]u64 = [5]u64{
    0x61B274A0EA0B0, 0x0D5A5FC8F189D, 0x7EF5E9CBD0C60,
    0x78595A6804C9E, 0x2B8324804FC1D
};

val BASE_X: [5]u64 = [5]u64{
    0x62D608F25D51A, 0x412A4B4F6592A, 0x75B7171A4B31D,
    0x1FF60527118FE, 0x216936D3CD6E5
};

val BASE_Y: [5]u64 = [5]u64{
    0x6666666666658, 0x4CCCCCCCCCCCC, 0x1999999999999,
    0x3333333333333, 0x6666666666666
};

# a scalar mod l in four 64-bit limbs, little-endian
pub rec Scalar {
    limb: [4]^u64;
}

pub rec Point {
    x: field.Field;
    y: field.Field;
    z: field.Field;
    t: field.Field;
}

#[oblivious]
pub fun destroy_scalar(value: *Scalar) {
    if (value == nil) { ret; }
    ct.zeroize((?value.limb[0]):~*^u8, 32);
}

#[oblivious]
pub fun destroy_point(point: *Point) {
    if (point == nil) { ret; }
    field.destroy(?point.x);
    field.destroy(?point.y);
    field.destroy(?point.z);
    field.destroy(?point.t);
}

#[oblivious]
#[inline]
fun nonzero_bit(value: ^u64) ^u8 {
    ret ((value | (0 - value)) >> 63)::^u8;
}

#[oblivious]
pub fun scalar_is_zero(value: *Scalar) ^u8 {
    var combined: ^u64 = value.limb[0] | value.limb[1] | value.limb[2] | value.limb[3];
    val result:   ^u8  = nonzero_bit(combined) ^ 1;
    combined = 0;
    ret result;
}

#[oblivious]
pub fun scalar_copy(output: *Scalar, input: *Scalar) {
    var i: usize = 0;
    for (i < 4) {
        output.limb[i] = input.limb[i];
        i              = i + 1;
    }
}

#[oblivious]
pub fun scalar_set_small(output: *Scalar, value: ^u64) {
    output.limb[0] = value;
    output.limb[1] = 0;
    output.limb[2] = 0;
    output.limb[3] = 0;
}

#[oblivious]
pub fun scalar_valid(value: *Scalar) ^u8 {
    ret mont.less_than(?value.limb[0], ?ORDER[0]);
}

#[oblivious]
pub fun scalar_add(output: *Scalar, left: *Scalar, right: *Scalar) {
    mont.add(?output.limb[0], ?left.limb[0], ?right.limb[0], ?ORDER[0]);
}

# left * right mod l, for left below 2^256 and right below l
#[oblivious]
pub fun scalar_multiply_values(output: *Scalar, left: *Scalar, right: *Scalar) {
    mont.multiply_values(?output.limb[0], ?left.limb[0], ?right.limb[0], ?ORDER[0],
        ORDER_FACTOR, ?ORDER_R2[0]);
}

#[oblivious]
pub fun scalar_decode_public(output: *Scalar, input: *u8, base: usize) {
    var word: usize = 0;
    for (word < 4) {
        val offset: usize = base + (word << 3);
        output.limb[word] = input[offset]::u64 |
            (input[offset + 1]::u64 << 8) |
            (input[offset + 2]::u64 << 16) |
            (input[offset + 3]::u64 << 24) |
            (input[offset + 4]::u64 << 32) |
            (input[offset + 5]::u64 << 40) |
            (input[offset + 6]::u64 << 48) |
            (input[offset + 7]::u64 << 56);
        word = word + 1;
    }
}

# read 32 little-endian secret bytes into scalar limbs without reducing them
#[oblivious]
pub fun scalar_decode_secret(output: *Scalar, input: *^u8) {
    var word: usize = 0;
    for (word < 4) {
        val offset: usize = word << 3;
        output.limb[word] = input[offset]::^u64 |
            (input[offset + 1]::^u64 << 8) |
            (input[offset + 2]::^u64 << 16) |
            (input[offset + 3]::^u64 << 24) |
            (input[offset + 4]::^u64 << 32) |
            (input[offset + 5]::^u64 << 40) |
            (input[offset + 6]::^u64 << 48) |
            (input[offset + 7]::^u64 << 56);
        word = word + 1;
    }
}

# reduce up to 64 little-endian secret bytes mod l
#[oblivious]
pub fun scalar_reduce_secret(output: *Scalar, input: *^u8, len: usize) {
    var wide: [8]^u64;
    var i:    usize = 0;
    for (i < 8) {
        wide[i] = 0;
        i       = i + 1;
    }
    i = 0;
    for (i < len) {
        wide[i >> 3] = wide[i >> 3] | (input[i]::^u64 << ((i & 7) << 3));
        i            = i + 1;
    }
    mont.reduce_wide(?output.limb[0], ?wide[0], ?ORDER[0], ORDER_FACTOR, ?ORDER_R2[0]);
    ct.zeroize((?wide[0]):~*^u8, 64);
}

#[oblivious]
pub fun scalar_encode_secret(output: *^u8, input: *Scalar) {
    var word: usize = 0;
    for (word < 4) {
        val offset: usize = word << 3;
        val value:  ^u64  = input.limb[word];
        output[offset]     = value::^u8;
        output[offset + 1] = (value >> 8)::^u8;
        output[offset + 2] = (value >> 16)::^u8;
        output[offset + 3] = (value >> 24)::^u8;
        output[offset + 4] = (value >> 32)::^u8;
        output[offset + 5] = (value >> 40)::^u8;
        output[offset + 6] = (value >> 48)::^u8;
        output[offset + 7] = (value >> 56)::^u8;
        word               = word + 1;
    }
}

#[oblivious]
fun field_constant(output: *field.Field, value: *u64) {
    var i: usize = 0;
    for (i < 5) {
        output.limb[i] = value[i];
        i              = i + 1;
    }
}

#[oblivious]
fun field_select(output: *field.Field, left: *field.Field, right: *field.Field,
    choose_right: ^u8) {
    val mask: ^u64  = 0 - choose_right::^u64;
    var i:    usize = 0;
    for (i < 5) {
        output.limb[i] = (left.limb[i] & ~mask) | (right.limb[i] & mask);
        i              = i + 1;
    }
}

#[oblivious]
fun field_equal(left: *field.Field, right: *field.Field) ^u8 {
    var left_encoded:  [32]^u8;
    var right_encoded: [32]^u8;
    field.encode(?left_encoded[0], left);
    field.encode(?right_encoded[0], right);
    val result: ^u8 = ct.eq_bytes(?left_encoded[0], ?right_encoded[0], 32);
    ct.zeroize(?left_encoded[0], 32);
    ct.zeroize(?right_encoded[0], 32);
    ret result;
}

#[oblivious]
fun field_is_zero(value: *field.Field) ^u8 {
    var zero: field.Field;
    field.set_small(?zero, 0);
    val result: ^u8 = field_equal(value, ?zero);
    field.destroy(?zero);
    ret result;
}

#[oblivious]
fun field_negate(output: *field.Field, input: *field.Field) {
    var zero: field.Field;
    field.set_small(?zero, 0);
    field.subtract(output, ?zero, input);
    field.destroy(?zero);
}

#[oblivious]
fun field_sqrt(output: *field.Field, input: *field.Field) ^u8 {
    var result: field.Field;
    field.raise_square_root(?result, input);
    var squared: field.Field;
    field.square(?squared, ?result);
    val direct:         ^u8 = field_equal(?squared, input);
    var sqrt_minus_one: field.Field;
    var corrected:      field.Field;
    field_constant(?sqrt_minus_one, (?SQRT_MINUS_ONE[0]):~*u64);
    field.multiply(?corrected, ?result, ?sqrt_minus_one);
    field_select(?result, ?corrected, ?result, direct);
    field.square(?squared, ?result);
    val valid: ^u8 = field_equal(?squared, input);
    field.copy(output, ?result);
    field.destroy(?result);
    field.destroy(?squared);
    field.destroy(?sqrt_minus_one);
    field.destroy(?corrected);
    ret valid;
}

#[oblivious]
fun point_copy(output: *Point, input: *Point) {
    field.copy(?output.x, ?input.x);
    field.copy(?output.y, ?input.y);
    field.copy(?output.z, ?input.z);
    field.copy(?output.t, ?input.t);
}

#[oblivious]
fun point_select(output: *Point, left: *Point, right: *Point,
    choose_right: ^u8) {
    field_select(?output.x, ?left.x, ?right.x, choose_right);
    field_select(?output.y, ?left.y, ?right.y, choose_right);
    field_select(?output.z, ?left.z, ?right.z, choose_right);
    field_select(?output.t, ?left.t, ?right.t, choose_right);
}

#[oblivious]
pub fun identity(output: *Point) {
    field.set_small(?output.x, 0);
    field.set_small(?output.y, 1);
    field.set_small(?output.z, 1);
    field.set_small(?output.t, 0);
}

#[oblivious]
pub fun generator(output: *Point) {
    field_constant(?output.x, (?BASE_X[0]):~*u64);
    field_constant(?output.y, (?BASE_Y[0]):~*u64);
    field.set_small(?output.z, 1);
    field.multiply(?output.t, ?output.x, ?output.y);
}

#[oblivious]
pub fun point_is_identity(point: *Point) ^u8 {
    ret field_is_zero(?point.x) & field_equal(?point.y, ?point.z);
}

#[oblivious]
pub fun point_add(output: *Point, left: *Point, right: *Point) {
    var a:       field.Field;
    var b:       field.Field;
    var c:       field.Field;
    var d_value: field.Field;
    var e:       field.Field;
    var f:       field.Field;
    var g:       field.Field;
    var h:       field.Field;
    var first:   field.Field;
    var second:  field.Field;
    var two_d:   field.Field;
    var result:  Point;
    field.subtract(?first, ?left.y, ?left.x);
    field.subtract(?second, ?right.y, ?right.x);
    field.multiply(?a, ?first, ?second);
    field.add(?first, ?left.y, ?left.x);
    field.add(?second, ?right.y, ?right.x);
    field.multiply(?b, ?first, ?second);
    field_constant(?two_d, (?CURVE_2D[0]):~*u64);
    field.multiply(?c, ?left.t, ?right.t);
    field.multiply(?c, ?c, ?two_d);
    field.multiply(?d_value, ?left.z, ?right.z);
    field.add(?d_value, ?d_value, ?d_value);
    field.subtract(?e, ?b, ?a);
    field.subtract(?f, ?d_value, ?c);
    field.add(?g, ?d_value, ?c);
    field.add(?h, ?b, ?a);
    field.multiply(?result.x, ?e, ?f);
    field.multiply(?result.y, ?g, ?h);
    field.multiply(?result.t, ?e, ?h);
    field.multiply(?result.z, ?f, ?g);
    point_copy(output, ?result);
    field.destroy(?a);
    field.destroy(?b);
    field.destroy(?c);
    field.destroy(?d_value);
    field.destroy(?e);
    field.destroy(?f);
    field.destroy(?g);
    field.destroy(?h);
    field.destroy(?first);
    field.destroy(?second);
    field.destroy(?two_d);
    destroy_point(?result);
}

#[oblivious]
fun point_double(output: *Point, input: *Point) {
    var a:         field.Field;
    var b:         field.Field;
    var c:         field.Field;
    var d_value:   field.Field;
    var e:         field.Field;
    var f:         field.Field;
    var g:         field.Field;
    var h:         field.Field;
    var temporary: field.Field;
    var result:    Point;
    field.square(?a, ?input.x);
    field.square(?b, ?input.y);
    field.square(?c, ?input.z);
    field.add(?c, ?c, ?c);
    field_negate(?d_value, ?a);
    field.add(?temporary, ?input.x, ?input.y);
    field.square(?e, ?temporary);
    field.subtract(?e, ?e, ?a);
    field.subtract(?e, ?e, ?b);
    field.add(?g, ?d_value, ?b);
    field.subtract(?f, ?g, ?c);
    field.subtract(?h, ?d_value, ?b);
    field.multiply(?result.x, ?e, ?f);
    field.multiply(?result.y, ?g, ?h);
    field.multiply(?result.t, ?e, ?h);
    field.multiply(?result.z, ?f, ?g);
    point_copy(output, ?result);
    field.destroy(?a);
    field.destroy(?b);
    field.destroy(?c);
    field.destroy(?d_value);
    field.destroy(?e);
    field.destroy(?f);
    field.destroy(?g);
    field.destroy(?h);
    field.destroy(?temporary);
    destroy_point(?result);
}

# multiply a point by a scalar with a fixed 4-bit window
#
# the extended twisted edwards addition is complete, so table entries and the
# accumulator need no equal-point or identity handling.
#[oblivious]
pub fun scalar_multiply(output: *Point, scalar: *Scalar, point: *Point) {
    var table:    [16]Point;
    var result:   Point;
    var selected: Point;
    identity(?table[0]);
    point_copy(?table[1], point);
    var index: usize = 2;
    for (index < 16) {
        point_add(?table[index], ?table[index - 1], point);
        index = index + 1;
    }

    identity(?result);
    var window: usize = 64;
    for (window > 0) {
        window = window - 1;
        point_double(?result, ?result);
        point_double(?result, ?result);
        point_double(?result, ?result);
        point_double(?result, ?result);
        val limb_index: usize = window >> 4;
        val shift:      u64   = ((window & 15) * 4)::u64;
        val digit:      ^u64  = (scalar.limb[limb_index] >> shift) & 15;
        point_copy(?selected, ?table[0]);
        index = 1;
        for (index < 16) {
            point_select(?selected, ?selected, ?table[index],
                ct.eq_u64(digit, index::u64));
            index = index + 1;
        }
        point_add(?result, ?result, ?selected);
    }
    point_copy(output, ?result);

    index = 0;
    for (index < 16) {
        destroy_point(?table[index]);
        index = index + 1;
    }
    destroy_point(?result);
    destroy_point(?selected);
}

# a table entry in niels form: y + x, y - x and 2 * d * x * y of an affine point
rec Niels {
    plus:    field.Field;
    minus:   field.Field;
    product: field.Field;
}

# or the limbs of one table entry into entry under mask
#[oblivious]
fun accumulate_entry(entry: *Niels, window: u64, digit: u64, mask: ^u64) {
    val base: usize = ((window * ed25519_base.DIGITS + digit - 1) * 15)::usize;
    var i:    usize = 0;
    for (i < 5) {
        entry.plus.limb[i]    = entry.plus.limb[i] | (ed25519_base.TABLE[base + i] & mask);
        entry.minus.limb[i]   = entry.minus.limb[i] | (ed25519_base.TABLE[base + 5 + i] & mask);
        entry.product.limb[i] = entry.product.limb[i] | (ed25519_base.TABLE[base + 10 + i] & mask);
        i                     = i + 1;
    }
}

# pick the entry for digit * 16^window * B by a masked scan over every candidate
#
# digit 0 selects the niels identity (1, 1, 0), which the complete addition absorbs.
#[oblivious]
fun select_entry(entry: *Niels, window: u64, digit: ^u64) {
    field.set_small(?entry.plus, 0);
    field.set_small(?entry.minus, 0);
    field.set_small(?entry.product, 0);
    val identity: ^u64 = 0 - ct.eq_u64(digit, 0)::^u64;
    entry.plus.limb[0]  = entry.plus.limb[0] | (identity & 1);
    entry.minus.limb[0] = entry.minus.limb[0] | (identity & 1);
    var candidate: u64 = 1;
    for (candidate <= ed25519_base.DIGITS) {
        val mask: ^u64 = 0 - ct.eq_u64(digit, candidate)::^u64;
        accumulate_entry(entry, window, candidate, mask);
        candidate = candidate + 1;
    }
}

# add a niels entry to an extended point with the complete mixed addition
#[oblivious]
fun point_add_niels(output: *Point, left: *Point, entry: *Niels) {
    var a:       field.Field;
    var b:       field.Field;
    var c:       field.Field;
    var d_value: field.Field;
    var e:       field.Field;
    var f:       field.Field;
    var g:       field.Field;
    var h:       field.Field;
    var sum:     field.Field;
    var result:  Point;
    field.subtract(?sum, ?left.y, ?left.x);
    field.multiply(?a, ?sum, ?entry.minus);
    field.add(?sum, ?left.y, ?left.x);
    field.multiply(?b, ?sum, ?entry.plus);
    field.multiply(?c, ?left.t, ?entry.product);
    field.add(?d_value, ?left.z, ?left.z);
    field.subtract(?e, ?b, ?a);
    field.subtract(?f, ?d_value, ?c);
    field.add(?g, ?d_value, ?c);
    field.add(?h, ?b, ?a);
    field.multiply(?result.x, ?e, ?f);
    field.multiply(?result.y, ?g, ?h);
    field.multiply(?result.t, ?e, ?h);
    field.multiply(?result.z, ?f, ?g);
    point_copy(output, ?result);
    field.destroy(?a);
    field.destroy(?b);
    field.destroy(?c);
    field.destroy(?d_value);
    field.destroy(?e);
    field.destroy(?f);
    field.destroy(?g);
    field.destroy(?h);
    field.destroy(?sum);
    destroy_point(?result);
}

# multiply the base point by a scalar below 2^256 with the fixed-base comb table
#
# each window adds digit * 16^window * B. the addition is complete, so the
# windows need no doubling, ordering, or identity handling.
#[oblivious]
pub fun scalar_multiply_base(output: *Point, scalar: *Scalar) {
    var result: Point;
    var entry:  Niels;
    identity(?result);
    var window: u64 = 0;
    for (window < ed25519_base.WINDOWS) {
        val limb_index: usize = (window >> 4)::usize;
        val shift:      u64   = (window & 15) * 4;
        val digit:      ^u64  = (scalar.limb[limb_index] >> shift) & 15;
        select_entry(?entry, window, digit);
        point_add_niels(?result, ?result, ?entry);
        window = window + 1;
    }
    point_copy(output, ?result);
    destroy_point(?result);
    field.destroy(?entry.plus);
    field.destroy(?entry.minus);
    field.destroy(?entry.product);
}

#[oblivious]
pub fun order_scalar(output: *Scalar) {
    var i: usize = 0;
    for (i < 4) {
        output.limb[i] = ORDER[i];
        i              = i + 1;
    }
}

#[oblivious]
fun point_encode_secret(output: *^u8, point: *Point) {
    var inverse:   field.Field;
    var x:         field.Field;
    var y:         field.Field;
    var x_encoded: [32]^u8;
    field.invert(?inverse, ?point.z);
    field.multiply(?x, ?point.x, ?inverse);
    field.multiply(?y, ?point.y, ?inverse);
    field.encode(?x_encoded[0], ?x);
    field.encode(output, ?y);
    output[31] = output[31] | ((x_encoded[0] & 1) << 7);
    field.destroy(?inverse);
    field.destroy(?x);
    field.destroy(?y);
    ct.zeroize(?x_encoded[0], 32);
}

#[oblivious]
pub fun point_encode_public(output: *u8, point: *Point) {
    var encoded: [32]^u8;
    point_encode_secret(?encoded[0], point);
    var i: usize = 0;
    for (i < 32) {
        output[i] = encoded[i]:>u8;
        i         = i + 1;
    }
    ct.zeroize(?encoded[0], 32);
}

#[oblivious]
pub fun point_encode_signature(output: *^u8, point: *Point) {
    point_encode_secret(output, point);
}

#[oblivious]
pub fun point_decode(output: *Point, input: *u8) ^u8 {
    var y_bytes:  [32]u8;
    var provided: [32]^u8;
    var i:        usize = 0;
    for (i < 32) {
        y_bytes[i]  = input[i];
        provided[i] = input[i];
        i           = i + 1;
    }
    val sign: u8 = y_bytes[31] >> 7;
    y_bytes[31]  = y_bytes[31] & 0x7F;
    provided[31] = provided[31] & 0x7F;
    field.decode(?output.y, ?y_bytes[0]);
    var canonical_y: [32]^u8;
    field.encode(?canonical_y[0], ?output.y);
    val canonical: ^u8 = ct.eq_bytes(?canonical_y[0], ?provided[0], 32);

    var y_squared:   field.Field;
    var numerator:   field.Field;
    var denominator: field.Field;
    var inverse:     field.Field;
    var x_squared:   field.Field;
    var one:         field.Field;
    var d_value:     field.Field;
    field.square(?y_squared, ?output.y);
    field.set_small(?one, 1);
    field.subtract(?numerator, ?y_squared, ?one);
    field_constant(?d_value, (?CURVE_D[0]):~*u64);
    field.multiply(?denominator, ?d_value, ?y_squared);
    field.add(?denominator, ?denominator, ?one);
    field.invert(?inverse, ?denominator);
    field.multiply(?x_squared, ?numerator, ?inverse);
    val has_root:   ^u8 = field_sqrt(?output.x, ?x_squared);
    var negative_x: field.Field;
    field_negate(?negative_x, ?output.x);
    var x_encoded: [32]^u8;
    field.encode(?x_encoded[0], ?output.x);
    val flip: ^u8 = (x_encoded[0] & 1) ^ sign;
    field_select(?output.x, ?output.x, ?negative_x, flip);
    val sign_valid: ^u8 = (field_is_zero(?output.x) & sign) ^ 1;
    field.set_small(?output.z, 1);
    field.multiply(?output.t, ?output.x, ?output.y);

    ct.zeroize(?provided[0], 32);
    ct.zeroize(?canonical_y[0], 32);
    ct.zeroize(?x_encoded[0], 32);
    field.destroy(?y_squared);
    field.destroy(?numerator);
    field.destroy(?denominator);
    field.destroy(?inverse);
    field.destroy(?x_squared);
    field.destroy(?one);
    field.destroy(?d_value);
    field.destroy(?negative_x);
    ret canonical & has_root & sign_valid;
}

test "ed25519 internal: order and basepoint constants are canonical" {
    if (ORDER[0] != 0x5812631A5CF5D3ED || ORDER[3] != 0x1000000000000000) { ret 1; }
    if (BASE_Y[0] != 0x6666666666658)                                     { ret 2; }
    ret 0;
}

test "ed25519 internal: every comb table entry is digit * 16^window * B" {
    var two_d: field.Field;
    field_constant(?two_d, (?CURVE_2D[0]):~*u64);
    var base: Point;
    generator(?base);
    var window: u64 = 0;
    for (window < ed25519_base.WINDOWS) {
        var multiple: Point;
        identity(?multiple);
        var digit: u64 = 1;
        for (digit <= ed25519_base.DIGITS) {
            point_add(?multiple, ?multiple, ?base);
            var entry:    Niels;
            var scaled:   field.Field;
            var expected: field.Field;
            field.set_small(?entry.plus, 0);
            field.set_small(?entry.minus, 0);
            field.set_small(?entry.product, 0);
            accumulate_entry(?entry, window, digit, 0 - 1);
            field.multiply(?scaled, ?entry.plus, ?multiple.z);
            field.add(?expected, ?multiple.y, ?multiple.x);
            if (field_equal(?scaled, ?expected):>u8 != 1) { ret 1; }
            field.multiply(?scaled, ?entry.minus, ?multiple.z);
            field.subtract(?expected, ?multiple.y, ?multiple.x);
            if (field_equal(?scaled, ?expected):>u8 != 1) { ret 2; }
            field.multiply(?scaled, ?entry.product, ?multiple.z);
            field.multiply(?expected, ?multiple.t, ?two_d);
            if (field_equal(?scaled, ?expected):>u8 != 1) { ret 3; }
            digit = digit + 1;
        }
        point_double(?base, ?base);
        point_double(?base, ?base);
        point_double(?base, ?base);
        point_double(?base, ?base);
        window = window + 1;
    }
    ret 0;
}

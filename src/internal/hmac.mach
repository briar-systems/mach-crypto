# streaming hmac over secret-state sha-2

use crypto.contracts;
use crypto.internal.lift;
use std.crypto.ct;
use std.crypto.hash.sha256;
use std.crypto.hash.sha512;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub rec Context256 {
    inner:     sha256.SecretState;
    outer_pad: [64]^u8;
    active:    bool;
}

pub rec Context384 {
    inner:     sha512.SecretState384;
    outer_pad: [128]^u8;
    active:    bool;
}

pub fun destroy256(context: *Context256) {
    if (context == nil) { ret; }
    sha256.destroy_secret(?context.inner);
    ct.zeroize(?context.outer_pad[0], sha256.BLOCK_SIZE);
    context.active = false;
}

pub fun destroy384(context: *Context384) {
    if (context == nil) { ret; }
    sha512.destroy_secret384(?context.inner);
    ct.zeroize(?context.outer_pad[0], sha512.BLOCK_SIZE);
    context.active = false;
}

#[oblivious]
pub fun init256(context: *Context256, key: contracts.SecretBytes) contracts.Error {
    if (context == nil) { ret contracts.INVALID_INPUT; }
    context.inner = sha256.init_secret();
    ct.zeroize(?context.outer_pad[0], sha256.BLOCK_SIZE);
    context.active = false;
    if (key.len != 0 && key.data == nil) {
        destroy256(context);
        ret contracts.INVALID_INPUT;
    }

    var key_block:  [64]^u8;
    var inner_pad:  [64]^u8;
    var key_digest: [32]^u8;
    ct.zeroize(?key_block[0], sha256.BLOCK_SIZE);
    ct.zeroize(?inner_pad[0], sha256.BLOCK_SIZE);
    ct.zeroize(?key_digest[0], sha256.DIGEST_SIZE);

    if (key.len > sha256.BLOCK_SIZE) {
        var key_state: sha256.SecretState;
        key_state = sha256.init_secret();
        if (!lift.update256_secret(?key_state, key.data, key.len)) {
            sha256.destroy_secret(?key_state);
            ct.zeroize(?key_block[0], sha256.BLOCK_SIZE);
            ct.zeroize(?inner_pad[0], sha256.BLOCK_SIZE);
            ct.zeroize(?key_digest[0], sha256.DIGEST_SIZE);
            destroy256(context);
            ret contracts.INVALID_KEY;
        }
        sha256.final_secret(?key_state, ?key_digest[0]);
        sha256.destroy_secret(?key_state);
        var i: usize = 0;
        for (i < sha256.DIGEST_SIZE) {
            key_block[i] = key_digest[i];
            i            = i + 1;
        }
    }
    or {
        var i: usize = 0;
        for (i < key.len) {
            key_block[i] = key.data[i];
            i            = i + 1;
        }
    }

    var i: usize = 0;
    for (i < sha256.BLOCK_SIZE) {
        inner_pad[i]         = key_block[i] ^ 0x36;
        context.outer_pad[i] = key_block[i] ^ 0x5C;
        i                    = i + 1;
    }
    if (!lift.update256_secret(?context.inner, ?inner_pad[0], sha256.BLOCK_SIZE)) {
        ct.zeroize(?key_block[0], sha256.BLOCK_SIZE);
        ct.zeroize(?inner_pad[0], sha256.BLOCK_SIZE);
        ct.zeroize(?key_digest[0], sha256.DIGEST_SIZE);
        destroy256(context);
        ret contracts.INVALID_STATE;
    }
    ct.zeroize(?key_block[0], sha256.BLOCK_SIZE);
    ct.zeroize(?inner_pad[0], sha256.BLOCK_SIZE);
    ct.zeroize(?key_digest[0], sha256.DIGEST_SIZE);
    context.active = true;
    ret contracts.OK;
}

#[oblivious]
pub fun init384(context: *Context384, key: contracts.SecretBytes) contracts.Error {
    if (context == nil) { ret contracts.INVALID_INPUT; }
    context.inner = sha512.init_secret384();
    ct.zeroize(?context.outer_pad[0], sha512.BLOCK_SIZE);
    context.active = false;
    if (key.len != 0 && key.data == nil) {
        destroy384(context);
        ret contracts.INVALID_INPUT;
    }

    var key_block:  [128]^u8;
    var inner_pad:  [128]^u8;
    var key_digest: [48]^u8;
    ct.zeroize(?key_block[0], sha512.BLOCK_SIZE);
    ct.zeroize(?inner_pad[0], sha512.BLOCK_SIZE);
    ct.zeroize(?key_digest[0], sha512.DIGEST_SIZE_384);

    if (key.len > sha512.BLOCK_SIZE) {
        var key_state: sha512.SecretState384;
        key_state = sha512.init_secret384();
        if (!lift.update384_secret(?key_state, key.data, key.len)) {
            sha512.destroy_secret384(?key_state);
            ct.zeroize(?key_block[0], sha512.BLOCK_SIZE);
            ct.zeroize(?inner_pad[0], sha512.BLOCK_SIZE);
            ct.zeroize(?key_digest[0], sha512.DIGEST_SIZE_384);
            destroy384(context);
            ret contracts.INVALID_KEY;
        }
        sha512.final_secret384(?key_state, ?key_digest[0]);
        sha512.destroy_secret384(?key_state);
        var i: usize = 0;
        for (i < sha512.DIGEST_SIZE_384) {
            key_block[i] = key_digest[i];
            i            = i + 1;
        }
    }
    or {
        var i: usize = 0;
        for (i < key.len) {
            key_block[i] = key.data[i];
            i            = i + 1;
        }
    }

    var i: usize = 0;
    for (i < sha512.BLOCK_SIZE) {
        inner_pad[i]         = key_block[i] ^ 0x36;
        context.outer_pad[i] = key_block[i] ^ 0x5C;
        i                    = i + 1;
    }
    if (!lift.update384_secret(?context.inner, ?inner_pad[0], sha512.BLOCK_SIZE)) {
        ct.zeroize(?key_block[0], sha512.BLOCK_SIZE);
        ct.zeroize(?inner_pad[0], sha512.BLOCK_SIZE);
        ct.zeroize(?key_digest[0], sha512.DIGEST_SIZE_384);
        destroy384(context);
        ret contracts.INVALID_STATE;
    }
    ct.zeroize(?key_block[0], sha512.BLOCK_SIZE);
    ct.zeroize(?inner_pad[0], sha512.BLOCK_SIZE);
    ct.zeroize(?key_digest[0], sha512.DIGEST_SIZE_384);
    context.active = true;
    ret contracts.OK;
}

pub fun update256_public(context: *Context256, data: *u8, len: usize) contracts.Error {
    if (context == nil || !context.active)                 { ret contracts.INVALID_STATE; }
    if (len != 0 && data == nil)                           { ret contracts.INVALID_INPUT; }
    if (!lift.update256_public(?context.inner, data, len)) { ret contracts.INVALID_INPUT; }
    ret contracts.OK;
}

pub fun update256_secret(context: *Context256, data: *^u8, len: usize) contracts.Error {
    if (context == nil || !context.active)                 { ret contracts.INVALID_STATE; }
    if (len != 0 && data == nil)                           { ret contracts.INVALID_INPUT; }
    if (!lift.update256_secret(?context.inner, data, len)) { ret contracts.INVALID_INPUT; }
    ret contracts.OK;
}

pub fun update384_public(context: *Context384, data: *u8, len: usize) contracts.Error {
    if (context == nil || !context.active)                 { ret contracts.INVALID_STATE; }
    if (len != 0 && data == nil)                           { ret contracts.INVALID_INPUT; }
    if (!lift.update384_public(?context.inner, data, len)) { ret contracts.INVALID_INPUT; }
    ret contracts.OK;
}

pub fun update384_secret(context: *Context384, data: *^u8, len: usize) contracts.Error {
    if (context == nil || !context.active)                 { ret contracts.INVALID_STATE; }
    if (len != 0 && data == nil)                           { ret contracts.INVALID_INPUT; }
    if (!lift.update384_secret(?context.inner, data, len)) { ret contracts.INVALID_INPUT; }
    ret contracts.OK;
}

pub fun final256(context: *Context256, tag: *^u8) contracts.Error {
    if (context == nil || !context.active) { ret contracts.INVALID_STATE; }
    if (tag == nil) {
        destroy256(context);
        ret contracts.INVALID_INPUT;
    }
    var inner_digest: [32]^u8;
    ct.zeroize(?inner_digest[0], sha256.DIGEST_SIZE);
    sha256.final_secret(?context.inner, ?inner_digest[0]);
    sha256.destroy_secret(?context.inner);

    var outer: sha256.SecretState;
    outer = sha256.init_secret();
    if (!lift.update256_secret(?outer, ?context.outer_pad[0], sha256.BLOCK_SIZE) ||
        !lift.update256_secret(?outer, ?inner_digest[0], sha256.DIGEST_SIZE)) {
        sha256.destroy_secret(?outer);
        ct.zeroize(?inner_digest[0], sha256.DIGEST_SIZE);
        destroy256(context);
        ret contracts.INVALID_STATE;
    }
    sha256.final_secret(?outer, tag);
    sha256.destroy_secret(?outer);
    ct.zeroize(?inner_digest[0], sha256.DIGEST_SIZE);
    destroy256(context);
    ret contracts.OK;
}

pub fun final384(context: *Context384, tag: *^u8) contracts.Error {
    if (context == nil || !context.active) { ret contracts.INVALID_STATE; }
    if (tag == nil) {
        destroy384(context);
        ret contracts.INVALID_INPUT;
    }
    var inner_digest: [48]^u8;
    ct.zeroize(?inner_digest[0], sha512.DIGEST_SIZE_384);
    sha512.final_secret384(?context.inner, ?inner_digest[0]);
    sha512.destroy_secret384(?context.inner);

    var outer: sha512.SecretState384;
    outer = sha512.init_secret384();
    if (!lift.update384_secret(?outer, ?context.outer_pad[0], sha512.BLOCK_SIZE) ||
        !lift.update384_secret(?outer, ?inner_digest[0], sha512.DIGEST_SIZE_384)) {
        sha512.destroy_secret384(?outer);
        ct.zeroize(?inner_digest[0], sha512.DIGEST_SIZE_384);
        destroy384(context);
        ret contracts.INVALID_STATE;
    }
    sha512.final_secret384(?outer, tag);
    sha512.destroy_secret384(?outer);
    ct.zeroize(?inner_digest[0], sha512.DIGEST_SIZE_384);
    destroy384(context);
    ret contracts.OK;
}

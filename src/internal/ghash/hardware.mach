# hardware ghash: pclmulqdq on x86_64, pmull and pmull2 on aarch64
#
# this is the hardware member behind crypto.internal.ghash. it multiplies
# with the carry-less multiply instruction and reduces with shifts, in the
# bit-reflected form of Gueron and Kounavis, "Intel Carry-Less Multiplication
# Instruction and its Usage for Computing the GCM Mode" (Intel white paper
# 323640, rev 2.02, 2014), and the same formulation on pmull (Gouvea and
# Lopez, "Implementing GCM on ARMv8", CT-RSA 2015):
# - a block is read as a 128-bit integer whose high word is its first eight
#   bytes, big-endian, which is the canonical accumulator of ghash.State. in
#   that form bit 127 - i is the coefficient of x^i, so the product of two
#   elements is the carry-less product reflected and shifted by one bit
# - the key keeps h * x^-1 in place of h (h shifted left one bit, and folded
#   with x^127 + x^6 + x + 1 when a bit leaves), so the 256-bit product of a
#   block with it needs no shift (the white paper's section on shifting h)
# - the 256-bit product is reduced modulo x^128 + x^7 + x^2 + x + 1 in two
#   phases of shifts by 57, 62 and 63 bits and by 1, 2 and 7, one per low
#   64-bit word (the white paper's algorithm 5 reduction)
# - four blocks share one reduction against h^4, h^3, h^2 and h (the white
#   paper's aggregated reduction), so the key keeps those four powers
#
# the kernels are outliers: each carries `#[extensions(pclmul)]` or
# `#[extensions(pmull)]` and runs only on a processor that has it, which the
# dispatcher checks before it records this member in a key. the multiplies
# are data-independent (Intel and Arm list pclmulqdq, pmull and pmull2 among
# the instructions whose timing does not depend on their operands), and every
# kernel is a fixed instruction stream with no branch and no secret address.
# the reduction is shifts and xors of secret words. the kernels clear the
# vector registers they used before returning.

use crypto.contracts;
use crypto.internal.extensions;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.size.usize;

pub val BLOCK_SIZE: usize = 16;

# blocks sharing one reduction
val AGGREGATE: usize = 4;

# h^4, h^3, h^2 and h, each times x^-1, as the low and then the high word,
# followed by the same four with their words exchanged
pub rec Key {
    powers: [16]^u64;
}

# whether this host can run the member
pub fun available() bool {
    ret extensions.carryless();
}

pub fun wipe(key: *Key) {
    ct.zeroize((?key.powers[0]):~*^u8, 128);
}

# reduce a 256-bit product, three 128-bit partial sums of low, middle and
# high products as low and high words, into the canonical accumulator
#[oblivious]
fun reduce(product: *^u64, accumulator: *^u64) {
    val z0: ^u64 = product[0];
    var z1: ^u64 = product[1] ^ product[2];
    var z2: ^u64 = product[4] ^ product[3];
    var z3: ^u64 = product[5];
    z1             = z1 ^ (z0 << 57) ^ (z0 << 62) ^ (z0 << 63);
    z2             = z2 ^ z0 ^ (z0 >> 1) ^ (z0 >> 2) ^ (z0 >> 7);
    z2             = z2 ^ (z1 << 57) ^ (z1 << 62) ^ (z1 << 63);
    z3             = z3 ^ z1 ^ (z1 >> 1) ^ (z1 >> 2) ^ (z1 >> 7);
    accumulator[0] = z3;
    accumulator[1] = z2;
    z1             = 0;
    z2             = 0;
    z3             = 0;
}

#[oblivious]
fun read_secret_u64_be(input: *^u8, offset: usize) ^u64 {
    var value: ^u64  = 0;
    var i:     usize = 0;
    for (i < 8) {
        value = (value << 8) | input[offset + i]::^u64;
        i     = i + 1;
    }
    ret value;
}

$if (extensions.ROWS && $mach.build.arch == $mach.arch.x86_64) {
    # 1 block against h^1..h^1, the accumulator folded into the first
    #[oblivious]
    #[extensions(pclmul)]
    fun multiply1(accumulator: *^u64, data: *u8, staged: *u64, powers: *^u64, product: *^u64) {
        asm x86_64 {
            mov rax, {data}
            mov rcx, {powers}
            mov rdx, {accumulator}
            mov rsi, {product}
            mov rdi, {staged}
            mov r8, [rax]
            bswap r8
            mov r9, [rax + 8]
            bswap r9
            mov [rdi], r9
            mov [rdi + 8], r8
            movdqu xmm0, [rdi]
            movdqu xmm1, [rdx]
            pshufd xmm1, xmm1, 0x4E
            pxor xmm0, xmm1
            movdqu xmm1, [rcx]
            movdqa xmm2, xmm0
            pclmulqdq xmm2, xmm1, 0x00
            movdqa xmm3, xmm0
            pclmulqdq xmm3, xmm1, 0x11
            movdqa xmm4, xmm0
            pclmulqdq xmm4, xmm1, 0x10
            pclmulqdq xmm0, xmm1, 0x01
            pxor xmm4, xmm0
            movdqu [rsi], xmm2
            movdqu [rsi + 16], xmm4
            movdqu [rsi + 32], xmm3
            pxor xmm0, xmm0
            pxor xmm1, xmm1
            pxor xmm2, xmm2
            pxor xmm3, xmm3
            pxor xmm4, xmm4
        }
    }

    # 4 blocks against h^4..h^1, the accumulator folded into the first
    #[oblivious]
    #[extensions(pclmul)]
    fun multiply4(accumulator: *^u64, data: *u8, staged: *u64, powers: *^u64, product: *^u64) {
        asm x86_64 {
            mov rax, {data}
            mov rcx, {powers}
            mov rdx, {accumulator}
            mov rsi, {product}
            mov rdi, {staged}
            mov r8, [rax]
            bswap r8
            mov r9, [rax + 8]
            bswap r9
            mov [rdi], r9
            mov [rdi + 8], r8
            mov r8, [rax + 16]
            bswap r8
            mov r9, [rax + 24]
            bswap r9
            mov [rdi + 16], r9
            mov [rdi + 24], r8
            mov r8, [rax + 32]
            bswap r8
            mov r9, [rax + 40]
            bswap r9
            mov [rdi + 32], r9
            mov [rdi + 40], r8
            mov r8, [rax + 48]
            bswap r8
            mov r9, [rax + 56]
            bswap r9
            mov [rdi + 48], r9
            mov [rdi + 56], r8
            movdqu xmm0, [rdi]
            movdqu xmm1, [rdx]
            pshufd xmm1, xmm1, 0x4E
            pxor xmm0, xmm1
            movdqu xmm1, [rcx]
            movdqa xmm2, xmm0
            pclmulqdq xmm2, xmm1, 0x00
            movdqa xmm3, xmm0
            pclmulqdq xmm3, xmm1, 0x11
            movdqa xmm4, xmm0
            pclmulqdq xmm4, xmm1, 0x10
            pclmulqdq xmm0, xmm1, 0x01
            pxor xmm4, xmm0
            movdqu xmm0, [rdi + 16]
            movdqu xmm1, [rcx + 16]
            movdqa xmm5, xmm0
            pclmulqdq xmm5, xmm1, 0x00
            pxor xmm2, xmm5
            movdqa xmm5, xmm0
            pclmulqdq xmm5, xmm1, 0x11
            pxor xmm3, xmm5
            movdqa xmm5, xmm0
            pclmulqdq xmm5, xmm1, 0x10
            pxor xmm4, xmm5
            pclmulqdq xmm0, xmm1, 0x01
            pxor xmm4, xmm0
            movdqu xmm0, [rdi + 32]
            movdqu xmm1, [rcx + 32]
            movdqa xmm5, xmm0
            pclmulqdq xmm5, xmm1, 0x00
            pxor xmm2, xmm5
            movdqa xmm5, xmm0
            pclmulqdq xmm5, xmm1, 0x11
            pxor xmm3, xmm5
            movdqa xmm5, xmm0
            pclmulqdq xmm5, xmm1, 0x10
            pxor xmm4, xmm5
            pclmulqdq xmm0, xmm1, 0x01
            pxor xmm4, xmm0
            movdqu xmm0, [rdi + 48]
            movdqu xmm1, [rcx + 48]
            movdqa xmm5, xmm0
            pclmulqdq xmm5, xmm1, 0x00
            pxor xmm2, xmm5
            movdqa xmm5, xmm0
            pclmulqdq xmm5, xmm1, 0x11
            pxor xmm3, xmm5
            movdqa xmm5, xmm0
            pclmulqdq xmm5, xmm1, 0x10
            pxor xmm4, xmm5
            pclmulqdq xmm0, xmm1, 0x01
            pxor xmm4, xmm0
            movdqu [rsi], xmm2
            movdqu [rsi + 16], xmm4
            movdqu [rsi + 32], xmm3
            pxor xmm0, xmm0
            pxor xmm1, xmm1
            pxor xmm2, xmm2
            pxor xmm3, xmm3
            pxor xmm4, xmm4
            pxor xmm5, xmm5
        }
    }

    # multiply the accumulator, xored with the first block, through `count`
    # blocks, which is 1 or AGGREGATE
    #[oblivious]
    fun absorb_group(key: *Key, accumulator: *^u64, data: *u8, count: usize) {
        var staged:  [8]u64;
        var product: [6]^u64;
        if (count == AGGREGATE) {
            multiply4(accumulator, data, ?staged[0], ?key.powers[0], ?product[0]);
        }
        or {
            multiply1(accumulator, data, ?staged[0], ?key.powers[6], ?product[0]);
        }
        reduce(?product[0], accumulator);
        ct.zeroize((?product[0]):~*^u8, 48);
    }
}
$or (extensions.ROWS && $mach.build.arch == $mach.arch.aarch64) {
    use std.math.bits;

    # 1 staged block against h^1..h^1
    #[oblivious]
    #[extensions(pmull)]
    fun multiply1(staged: *^u64, powers: *^u64, swapped: *^u64, product: *^u64) {
        asm aarch64 {
            ldr x9, {staged}
            ldr x10, {powers}
            ldr x11, {swapped}
            ldr x12, {product}
            ld1 {v0.16b}, [x9], 16
            ld1 {v1.16b}, [x10], 16
            ld1 {v5.16b}, [x11], 16
            pmull v2.1q, v0.1d, v1.1d
            pmull2 v3.1q, v0.2d, v1.2d
            pmull v4.1q, v0.1d, v5.1d
            pmull2 v6.1q, v0.2d, v5.2d
            eor v4.16b, v4.16b, v6.16b
            st1 {v2.16b}, [x12], 16
            st1 {v4.16b}, [x12], 16
            st1 {v3.16b}, [x12], 16
            eor v0.16b, v0.16b, v0.16b
            eor v1.16b, v1.16b, v1.16b
            eor v2.16b, v2.16b, v2.16b
            eor v3.16b, v3.16b, v3.16b
            eor v4.16b, v4.16b, v4.16b
            eor v5.16b, v5.16b, v5.16b
            eor v6.16b, v6.16b, v6.16b
        }
    }

    # 4 staged blocks against h^4..h^1
    #[oblivious]
    #[extensions(pmull)]
    fun multiply4(staged: *^u64, powers: *^u64, swapped: *^u64, product: *^u64) {
        asm aarch64 {
            ldr x9, {staged}
            ldr x10, {powers}
            ldr x11, {swapped}
            ldr x12, {product}
            ld1 {v0.16b}, [x9], 16
            ld1 {v1.16b}, [x10], 16
            ld1 {v5.16b}, [x11], 16
            pmull v2.1q, v0.1d, v1.1d
            pmull2 v3.1q, v0.2d, v1.2d
            pmull v4.1q, v0.1d, v5.1d
            pmull2 v6.1q, v0.2d, v5.2d
            eor v4.16b, v4.16b, v6.16b
            ld1 {v0.16b}, [x9], 16
            ld1 {v1.16b}, [x10], 16
            ld1 {v5.16b}, [x11], 16
            pmull v6.1q, v0.1d, v1.1d
            eor v2.16b, v2.16b, v6.16b
            pmull2 v6.1q, v0.2d, v1.2d
            eor v3.16b, v3.16b, v6.16b
            pmull v6.1q, v0.1d, v5.1d
            eor v4.16b, v4.16b, v6.16b
            pmull2 v6.1q, v0.2d, v5.2d
            eor v4.16b, v4.16b, v6.16b
            ld1 {v0.16b}, [x9], 16
            ld1 {v1.16b}, [x10], 16
            ld1 {v5.16b}, [x11], 16
            pmull v6.1q, v0.1d, v1.1d
            eor v2.16b, v2.16b, v6.16b
            pmull2 v6.1q, v0.2d, v1.2d
            eor v3.16b, v3.16b, v6.16b
            pmull v6.1q, v0.1d, v5.1d
            eor v4.16b, v4.16b, v6.16b
            pmull2 v6.1q, v0.2d, v5.2d
            eor v4.16b, v4.16b, v6.16b
            ld1 {v0.16b}, [x9], 16
            ld1 {v1.16b}, [x10], 16
            ld1 {v5.16b}, [x11], 16
            pmull v6.1q, v0.1d, v1.1d
            eor v2.16b, v2.16b, v6.16b
            pmull2 v6.1q, v0.2d, v1.2d
            eor v3.16b, v3.16b, v6.16b
            pmull v6.1q, v0.1d, v5.1d
            eor v4.16b, v4.16b, v6.16b
            pmull2 v6.1q, v0.2d, v5.2d
            eor v4.16b, v4.16b, v6.16b
            st1 {v2.16b}, [x12], 16
            st1 {v4.16b}, [x12], 16
            st1 {v3.16b}, [x12], 16
            eor v0.16b, v0.16b, v0.16b
            eor v1.16b, v1.16b, v1.16b
            eor v2.16b, v2.16b, v2.16b
            eor v3.16b, v3.16b, v3.16b
            eor v4.16b, v4.16b, v4.16b
            eor v5.16b, v5.16b, v5.16b
            eor v6.16b, v6.16b, v6.16b
        }
    }

    fun read_u64_be(input: *u8, offset: usize) u64 {
        ret bits.byte_swap(@((?input[offset]):~*u64));
    }

    # multiply the accumulator, xored with the first block, through `count`
    # blocks, which is 1 or AGGREGATE
    #
    # the vector byte reverse is not in the assembler's vocabulary, so the
    # public blocks are staged as low and high words here
    #[oblivious]
    fun absorb_group(key: *Key, accumulator: *^u64, data: *u8, count: usize) {
        var staged:  [8]^u64;
        var product: [6]^u64;
        var block:   usize = 0;
        for (block < count) {
            staged[block * 2]     = read_u64_be(data, block * 16 + 8);
            staged[block * 2 + 1] = read_u64_be(data, block * 16);
            block                 = block + 1;
        }
        staged[0] = staged[0] ^ accumulator[1];
        staged[1] = staged[1] ^ accumulator[0];
        if (count == AGGREGATE) {
            multiply4(?staged[0], ?key.powers[0], ?key.powers[8], ?product[0]);
        }
        or {
            multiply1(?staged[0], ?key.powers[6], ?key.powers[14], ?product[0]);
        }
        reduce(?product[0], accumulator);
        ct.zeroize((?staged[0]):~*^u8, 64);
        ct.zeroize((?product[0]):~*^u8, 48);
    }
}
$or {
    # no kernel exists here, and `available` is false, so a key never
    # records this member
    #[oblivious]
    fun absorb_group(key: *Key, accumulator: *^u64, data: *u8, count: usize) {}
}

# install the 16-byte subkey, e(k, 0^128), and its powers
#[oblivious]
pub fun expand(key: *Key, subkey: *^u8) {
    val high:  ^u64 = read_secret_u64_be(subkey, 0);
    val low:   ^u64 = read_secret_u64_be(subkey, 8);
    val carry: ^u64 = 0 - (high >> 63);
    # h * x^-1: one bit left, and x^-1 = x^127 + x^6 + x + 1 when a bit leaves
    var power: [2]^u64;
    power[0]       = ((high << 1) | (low >> 63)) ^ (0xC200000000000000 & carry);
    power[1]       = (low << 1) ^ (1 & carry);
    key.powers[6]  = power[1];
    key.powers[7]  = power[0];
    key.powers[14] = power[0];
    key.powers[15] = power[1];
    var zero:     [16]u8;
    var exponent: usize = 2;
    for (exponent <= AGGREGATE) {
        absorb_group(key, ?power[0], ?zero[0], 1);
        val slot: usize = (AGGREGATE - exponent) * 2;
        key.powers[slot]         = power[1];
        key.powers[slot + 1]     = power[0];
        key.powers[8 + slot]     = power[0];
        key.powers[8 + slot + 1] = power[1];
        exponent                 = exponent + 1;
    }
    ct.zeroize((?power[0]):~*^u8, 16);
}

# absorb `blocks` whole 16-byte blocks of public data
#[oblivious]
pub fun absorb(key: *Key, accumulator: *^u64, data: *u8, blocks: usize) {
    var done: usize = 0;
    for (blocks - done >= AGGREGATE) {
        absorb_group(key, accumulator, ?data[done * BLOCK_SIZE], AGGREGATE);
        done = done + AGGREGATE;
    }
    for (done < blocks) {
        absorb_group(key, accumulator, ?data[done * BLOCK_SIZE], 1);
        done = done + 1;
    }
}

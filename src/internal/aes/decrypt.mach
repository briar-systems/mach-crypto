# portable constant-time AES-128 and AES-256 block decryption
#
# Decryption reads the selected encryption backend's existing round keys.
# Byte substitution and MixColumns use fixed arithmetic, never secret indexes.

use crypto.contracts;
use core: crypto.internal.aes;
use crypto.internal.aes.software;
use std.crypto.ct;
use std.runtime;
use std.types.size.usize;

#[oblivious]
fun xtime(x: ^u8) ^u8 {
    val carry: ^u8 = (x >> 7) & 1;
    ret (x << 1) ^ ((0 - carry) & 0x1b);
}

#[oblivious]
fun multiply(x: ^u8, y: ^u8) ^u8 {
    var a:       ^u8   = x;
    var b:       ^u8   = y;
    var product: ^u8   = 0;
    var i:       usize = 0;
    for (i < 8) {
        product = product ^ (a & (0 - (b & 1)));
        a       = xtime(a);
        b       = b >> 1;
        i       = i + 1;
    }
    a = 0;
    b = 0;
    ret product;
}

#[oblivious]
fun rotate(x: ^u8, n: u32) ^u8 {
    ret (x << n) | (x >> (8 - n));
}

#[oblivious]
fun inverse_sbox(y: ^u8) ^u8 {
    val x:    ^u8 = rotate(y, 1) ^ rotate(y, 3) ^ rotate(y, 6) ^ 0x05;
    val x2:   ^u8 = multiply(x, x);
    val x4:   ^u8 = multiply(x2, x2);
    val x8:   ^u8 = multiply(x4, x4);
    val x16:  ^u8 = multiply(x8, x8);
    val x32:  ^u8 = multiply(x16, x16);
    val x64:  ^u8 = multiply(x32, x32);
    val x128: ^u8 = multiply(x64, x64);
    ret multiply(multiply(multiply(x128, x64), multiply(x32, x16)),
        multiply(multiply(x8, x4), x2));
}

#[oblivious]
fun add_round_key(context: *core.Context, state: *^u8, round: usize) {
    var i: usize = 0;
    for (i < 16) {
        var key_byte: ^u8 = 0;
        if (context.backend == core.HARDWARE) {
            key_byte = context.schedule.hardware.round_keys[round * 16 + i];
        }
        or {
            val position: u64   = ((i & 3) * 16 + (i >> 2) * 4)::u64;
            var plane:    usize = 0;
            for (plane < 8) {
                key_byte = key_byte |
                    ((((context.schedule.software.round_planes[round * 8 + plane] >> position) & 1)::^u8) << plane);
                plane = plane + 1;
            }
        }
        state[i] = state[i] ^ key_byte;
        i        = i + 1;
    }
}

#[oblivious]
fun inverse_shift_rows(state: *^u8) {
    var moved:  [16]^u8;
    var column: usize = 0;
    for (column < 4) {
        var row: usize = 0;
        for (row < 4) {
            moved[column * 4 + row] = state[((column + 4 - row) & 3) * 4 + row];
            row                     = row + 1;
        }
        column = column + 1;
    }
    var i: usize = 0;
    for (i < 16) {
        state[i] = moved[i];
        i        = i + 1;
    }
    ct.zeroize(?moved[0], 16);
}

#[oblivious]
fun inverse_sub_bytes(state: *^u8) {
    var i: usize = 0;
    for (i < 16) {
        state[i] = inverse_sbox(state[i]);
        i        = i + 1;
    }
}

#[oblivious]
fun inverse_mix_columns(state: *^u8) {
    var column: usize = 0;
    for (column < 4) {
        val off: usize = column * 4;
        val a0:  ^u8   = state[off];
        val a1:  ^u8   = state[off + 1];
        val a2:  ^u8   = state[off + 2];
        val a3:  ^u8   = state[off + 3];
        val b0:  ^u8   = xtime(a0);
        val b1:  ^u8   = xtime(a1);
        val b2:  ^u8   = xtime(a2);
        val b3:  ^u8   = xtime(a3);
        val c0:  ^u8   = xtime(b0);
        val c1:  ^u8   = xtime(b1);
        val c2:  ^u8   = xtime(b2);
        val c3:  ^u8   = xtime(b3);
        val d0:  ^u8   = xtime(c0);
        val d1:  ^u8   = xtime(c1);
        val d2:  ^u8   = xtime(c2);
        val d3:  ^u8   = xtime(c3);
        state[off]     = (d0 ^ c0 ^ b0) ^ (d1 ^ b1 ^ a1) ^ (d2 ^ c2 ^ a2) ^ (d3 ^ a3);
        state[off + 1] = (d0 ^ a0) ^ (d1 ^ c1 ^ b1) ^ (d2 ^ b2 ^ a2) ^ (d3 ^ c3 ^ a3);
        state[off + 2] = (d0 ^ c0 ^ a0) ^ (d1 ^ a1) ^ (d2 ^ c2 ^ b2) ^ (d3 ^ b3 ^ a3);
        state[off + 3] = (d0 ^ b0 ^ a0) ^ (d1 ^ c1 ^ a1) ^ (d2 ^ a2) ^ (d3 ^ c3 ^ b3);
        column         = column + 1;
    }
}

#[oblivious]
pub fun block(context: *core.Context, input: *^u8, output: *^u8) {
    var state: [16]^u8;
    var i:     usize = 0;
    for (i < 16) {
        state[i] = input[i];
        i        = i + 1;
    }
    add_round_key(context, ?state[0], context.rounds);
    var round: usize = context.rounds - 1;
    for (round > 0) {
        inverse_shift_rows(?state[0]);
        inverse_sub_bytes(?state[0]);
        add_round_key(context, ?state[0], round);
        inverse_mix_columns(?state[0]);
        round = round - 1;
    }
    inverse_shift_rows(?state[0]);
    inverse_sub_bytes(?state[0]);
    add_round_key(context, ?state[0], 0);
    i = 0;
    for (i < 16) {
        output[i] = state[i];
        i         = i + 1;
    }
    ct.zeroize(?state[0], 16);
}

test aes_decrypt__inverse_sbox_known_pairs {
    if (inverse_sbox(0x63):>u8 != 0x00 || inverse_sbox(0xed):>u8 != 0x53) { ret 1; }
    var value: usize = 0;
    for (value < 256) {
        var word: [4]^u8;
        word[0] = inverse_sbox(value::u8);
        word[1] = 0;
        word[2] = 0;
        word[3] = 0;
        software.substitute_word(?word[0]);
        if (word[0]:>u8 != value::u8) { ret 2; }
        value = value + 1;
    }
    ret 0;
}

test aes_decrypt__inverse_mix_column_known_pair {
    var state: [16]^u8;
    ct.zeroize(?state[0], 16);
    state[0] = 0x8e;
    state[1] = 0x4d;
    state[2] = 0xa1;
    state[3] = 0xbc;
    inverse_mix_columns(?state[0]);
    if (state[0]:>u8 != 0xdb || state[1]:>u8 != 0x13 ||
        state[2]:>u8 != 0x53 || state[3]:>u8 != 0x45) { ret 1; }
    ret 0;
}

test aes_decrypt__fips_round_key {
    var key: [16]^u8;
    var i:   usize = 0;
    for (i < 16) {
        key[i] = i::u8;
        i      = i + 1;
    }
    var context: core.Context;
    if (core.init_backend(?context, contracts.SecretBytes{data: ?key[0], len: 16},
        core.SOFTWARE) != contracts.OK) { ret 1; }
    var round_key: [16]^u8;
    ct.zeroize(?round_key[0], 16);
    add_round_key(?context, ?round_key[0], 10);
    if (context.rounds != 10 || round_key[0]:>u8 != 0x13 ||
        round_key[1]:>u8 != 0x11 || round_key[15]:>u8 != 0xc5) { ret 2; }
    var ciphertext: [16]^u8;
    var plaintext:  [16]^u8;
    val known:      [16]u8 = [16]u8{
        0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30,
        0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a
    };
    i = 0;
    for (i < 16) {
        ciphertext[i] = known[i];
        i             = i + 1;
    }
    block(?context, ?ciphertext[0], ?plaintext[0]);
    i = 0;
    for (i < 16) {
        if (plaintext[i]:>u8 != (i * 0x11)::u8) { ret 3; }
        i = i + 1;
    }
    core.destroy(?context);
    ret 0;
}

test aes_decrypt__software_aes256_known_answer {
    var key:        [32]^u8;
    var ciphertext: [16]^u8;
    var plaintext:  [16]^u8;
    val known:      [16]u8 = [16]u8{
        0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf,
        0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89
    };
    var i: usize = 0;
    for (i < 32) {
        key[i] = i::u8;
        i      = i + 1;
    }
    i = 0;
    for (i < 16) {
        ciphertext[i] = known[i];
        i             = i + 1;
    }
    var context: core.Context;
    if (core.init_backend(?context, contracts.SecretBytes{data: ?key[0], len: 32},
        core.SOFTWARE) != contracts.OK) { ret 1; }
    block(?context, ?ciphertext[0], ?plaintext[0]);
    i = 0;
    for (i < 16) {
        if (plaintext[i]:>u8 != (i * 0x11)::u8) { ret 2; }
        i = i + 1;
    }
    core.destroy(?context);
    ret 0;
}

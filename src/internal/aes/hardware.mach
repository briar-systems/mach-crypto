# hardware aes: aes-ni on x86_64, the armv8 aes rounds on aarch64
#
# this is the hardware member behind crypto.internal.aes. the schedule is the
# fips 197 round keys in byte order, which both instruction sets read as they
# stand, expanded once by the portable key expansion the software member runs.
#
# the kernels are outliers: each carries `#[extensions(aes)]` and runs only on
# a processor that has it. the dispatcher records this member in a context
# only after crypto.internal.extensions says the host has the extension, and
# every call goes through that record. the rounds are data-independent (Intel
# and Arm list aesenc, aesenclast, aese and aesmc among the instructions whose
# timing does not depend on their operands), and each kernel is a fixed,
# unrolled instruction stream with no branch and no secret address, which the
# `#[oblivious]` check verifies. each kernel clears the vector registers it
# used before returning, so no round key or state outlives the call there.

use crypto.contracts;
use crypto.internal.aes.software;
use crypto.internal.extensions;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.size.usize;

pub val BLOCK_SIZE:      usize = 16;
pub val PARALLEL_BLOCKS: usize = 8;

# the round keys in byte order, round 0 first
#
# the round count is the dispatcher's, so the schedule is secret storage alone
# and shares a context's storage with the software member's
pub rec Schedule {
    round_keys: [240]^u8;
}

# whether this host can run the member
pub fun available() bool {
    ret extensions.aes();
}

pub fun wipe(schedule: *Schedule) {
    ct.zeroize(?schedule.round_keys[0], 240);
}

# expand a key whose length the dispatcher has already checked, and return its
# round count
#[oblivious]
pub fun expand(schedule: *Schedule, key: contracts.SecretBytes) usize {
    ret software.expand_round_keys(?schedule.round_keys[0], key, substitute_word);
}

# the s-box on one key-schedule word, through one hardware round
#
# with the word in all four columns, shift rows moves nothing, so the last
# round against a zero round key leaves the substituted word in each column.
#[oblivious]
fun substitute_word(word: *^u8) {
    var state: [16]^u8;
    var i:     usize = 0;
    for (i < BLOCK_SIZE) {
        state[i] = word[i % 4];
        i        = i + 1;
    }
    substitute_columns(?state[0]);
    i = 0;
    for (i < 4) {
        word[i] = state[i];
        i       = i + 1;
    }
    ct.zeroize(?state[0], 16);
}

$if (extensions.ROWS && $mach.build.arch == $mach.arch.x86_64) {
    # subbytes and shiftrows of one block in place, the last round with a zero key
    #[oblivious]
    #[extensions(aes)]
    fun substitute_columns(state: *^u8) {
        asm x86_64 {
            mov rax, {state}
            movdqu xmm0, [rax]
            pxor xmm1, xmm1
            aesenclast xmm0, xmm1
            movdqu [rax], xmm0
            pxor xmm0, xmm0
        }
    }

    # 1 block, aes-128
    #[oblivious]
    #[extensions(aes)]
    fun encrypt1_128(keys: *^u8, input: *^u8, output: *^u8) {
        asm x86_64 {
            mov rax, {keys}
            mov rcx, {input}
            mov rdx, {output}
            movdqu xmm0, [rcx]
            movdqu xmm8, [rax]
            pxor xmm0, xmm8
            movdqu xmm8, [rax + 16]
            aesenc xmm0, xmm8
            movdqu xmm8, [rax + 32]
            aesenc xmm0, xmm8
            movdqu xmm8, [rax + 48]
            aesenc xmm0, xmm8
            movdqu xmm8, [rax + 64]
            aesenc xmm0, xmm8
            movdqu xmm8, [rax + 80]
            aesenc xmm0, xmm8
            movdqu xmm8, [rax + 96]
            aesenc xmm0, xmm8
            movdqu xmm8, [rax + 112]
            aesenc xmm0, xmm8
            movdqu xmm8, [rax + 128]
            aesenc xmm0, xmm8
            movdqu xmm8, [rax + 144]
            aesenc xmm0, xmm8
            movdqu xmm8, [rax + 160]
            aesenclast xmm0, xmm8
            movdqu [rdx], xmm0
            pxor xmm0, xmm0
            pxor xmm8, xmm8
        }
    }

    # 2 blocks, aes-128
    #[oblivious]

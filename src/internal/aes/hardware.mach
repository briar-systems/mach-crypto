$if (extensions.ROWS && ($mach.build.arch == $mach.arch.x86_64
    || $mach.build.arch == $mach.arch.aarch64)) {
    # encrypt `count` blocks, 1, 2, 4 or 8, with the kernel of that width
    #[oblivious]
    fun encrypt_width(schedule: *Schedule, rounds: usize, input: *^u8, output: *^u8,
        count: usize) {
        val keys: *^u8 = ?schedule.round_keys[0];
        if (rounds == 10) {
            if (count == 8) { encrypt8_128(keys, input, output); }
            or (count == 4) { encrypt4_128(keys, input, output); }
            or (count == 2) { encrypt2_128(keys, input, output); }
            or              { encrypt1_128(keys, input, output); }
        }
        or {
            if (count == 8) { encrypt8_256(keys, input, output); }
            or (count == 4) { encrypt4_256(keys, input, output); }
            or (count == 2) { encrypt2_256(keys, input, output); }
            or              { encrypt1_256(keys, input, output); }
        }
    }

    # encrypt `count` consecutive blocks, between one and PARALLEL_BLOCKS
    #
    # the count runs as its binary digits, eight, four, two and one blocks, each
    # through the kernel of that width. input and output may be the same
    # storage, since every kernel loads its blocks before it stores any.
    #[oblivious]
    pub fun encrypt_blocks(schedule: *Schedule, rounds: usize, input: *^u8, output: *^u8,
        count: usize) {
        var done:  usize = 0;
        var width: usize = PARALLEL_BLOCKS;
        for (width > 0) {
            if ((count - done) >= width) {
                encrypt_width(schedule, rounds, ?input[done * BLOCK_SIZE], ?output[done * BLOCK_SIZE],
                    width);
                done = done + width;
            }
            width = width / 2;
        }
    }
}
$or {
    # no kernel exists here, and `available` is false, so a context never
    # records this member
    #[oblivious]
    fun substitute_columns(state: *^u8) {}

    #[oblivious]
    pub fun encrypt_blocks(schedule: *Schedule, rounds: usize, input: *^u8, output: *^u8,
        count: usize) {}
}

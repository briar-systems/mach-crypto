            mov rax, {keys}
            mov rcx, {input}
            mov rdx, {output}
            movdqu xmm0, [rcx]
            movdqu xmm1, [rcx + 16]
            movdqu xmm8, [rax]
            pxor xmm0, xmm8
            pxor xmm1, xmm8
            movdqu xmm8, [rax + 16]
            aesenc xmm0, xmm8
            aesenc xmm1, xmm8
            movdqu xmm8, [rax + 32]
            aesenc xmm0, xmm8
            aesenc xmm1, xmm8
            movdqu xmm8, [rax + 48]
            aesenc xmm0, xmm8
            aesenc xmm1, xmm8
            movdqu xmm8, [rax + 64]
            aesenc xmm0, xmm8
            aesenc xmm1, xmm8
            movdqu xmm8, [rax + 80]
            aesenc xmm0, xmm8
            aesenc xmm1, xmm8
            movdqu xmm8, [rax + 96]
            aesenc xmm0, xmm8
            aesenc xmm1, xmm8
            movdqu xmm8, [rax + 112]
            aesenc xmm0, xmm8
            aesenc xmm1, xmm8
            movdqu xmm8, [rax + 128]
            aesenc xmm0, xmm8
            aesenc xmm1, xmm8
            movdqu xmm8, [rax + 144]
            aesenc xmm0, xmm8
            aesenc xmm1, xmm8
            movdqu xmm8, [rax + 160]
            aesenclast xmm0, xmm8
            aesenclast xmm1, xmm8
            movdqu [rdx], xmm0
            movdqu [rdx + 16], xmm1
            pxor xmm0, xmm0
            pxor xmm1, xmm1
            pxor xmm8, xmm8
        }
    }


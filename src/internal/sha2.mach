}

pub fun update384_secret(state: *State384, data: *^u8, len: usize) bool {
    if (!reserve384(state, len)) { ret false; }
    state.total = state.total + len::u64;
    var offset: usize = 0;
    for (offset < len) {
        val room: usize = SHA384_BLOCK_SIZE - state.block_len;
        var take: usize = len - offset;
        if (take > room) { take = room; }
        var i: usize = 0;
        for (i < take) {
            state.block[state.block_len + i] = data[offset + i];
            i                                = i + 1;
        }
        state.block_len = state.block_len + take;
        offset          = offset + take;
        if (state.block_len == SHA384_BLOCK_SIZE) {
            compress384(state, ?state.block[0]);
            state.block_len = 0;
        }
    }
    ret true;
}

pub fun update512_public(state: *State384, data: *u8, len: usize) bool {
    ret update384_public(state, data, len);
}

pub fun update512_secret(state: *State384, data: *^u8, len: usize) bool {
    ret update384_secret(state, data, len);
}

pub fun final256(state: *State256, digest: *^u8) {
    val total_bits: u64 = state.total * 8;
    state.block[state.block_len] = 0x80;
    state.block_len              = state.block_len + 1;
    if (state.block_len > 56) {
        for (state.block_len < SHA256_BLOCK_SIZE) {
            state.block[state.block_len] = 0;
            state.block_len              = state.block_len + 1;
        }
        compress256(state, ?state.block[0]);
        state.block_len = 0;
    }
    for (state.block_len < 56) {
        state.block[state.block_len] = 0;
        state.block_len              = state.block_len + 1;
    }
    state.block[56] = (total_bits >> 56)::u8;
    state.block[57] = (total_bits >> 48)::u8;
    state.block[58] = (total_bits >> 40)::u8;
    state.block[59] = (total_bits >> 32)::u8;
    state.block[60] = (total_bits >> 24)::u8;
    state.block[61] = (total_bits >> 16)::u8;
    state.block[62] = (total_bits >> 8)::u8;
    state.block[63] = total_bits::u8;
    compress256(state, ?state.block[0]);
    var i: usize = 0;
    for (i < 8) {
        write32(digest, i * 4, state.h[i]);
        i = i + 1;
    }
}

pub fun final384(state: *State384, digest: *^u8) {
    val high_bits: u64 = state.total >> 61;
    val low_bits:  u64 = state.total << 3;
    state.block[state.block_len] = 0x80;
    state.block_len              = state.block_len + 1;
    if (state.block_len > 112) {
        for (state.block_len < SHA384_BLOCK_SIZE) {
            state.block[state.block_len] = 0;
            state.block_len              = state.block_len + 1;
        }
        compress384(state, ?state.block[0]);
        state.block_len = 0;
    }
    for (state.block_len < 112) {
        state.block[state.block_len] = 0;
        state.block_len              = state.block_len + 1;
    }
    var i: usize = 0;
    for (i < 8) {
        state.block[112 + i] = (high_bits >> ((7 - i) * 8))::u8;
        state.block[120 + i] = (low_bits >> ((7 - i) * 8))::u8;
        i                    = i + 1;
    }
    compress384(state, ?state.block[0]);
    i = 0;
    for (i < 6) {
        write64(digest, i * 8, state.h[i]);
        i = i + 1;
    }
}

pub fun final512(state: *State384, digest: *^u8) {
    val high_bits: u64 = state.total >> 61;
    val low_bits:  u64 = state.total << 3;
    state.block[state.block_len] = 0x80;
    state.block_len              = state.block_len + 1;
    if (state.block_len > 112) {
        for (state.block_len < SHA384_BLOCK_SIZE) {
            state.block[state.block_len] = 0;
            state.block_len              = state.block_len + 1;
        }
        compress384(state, ?state.block[0]);
        state.block_len = 0;
    }
    for (state.block_len < 112) {
        state.block[state.block_len] = 0;
        state.block_len              = state.block_len + 1;
    }
    var i: usize = 0;
    for (i < 8) {
        state.block[112 + i] = (high_bits >> ((7 - i) << 3))::u8;
        state.block[120 + i] = (low_bits >> ((7 - i) << 3))::u8;
        i                    = i + 1;
    }
    compress384(state, ?state.block[0]);
    i = 0;
    for (i < 8) {
        write64(digest, i << 3, state.h[i]);
        i = i + 1;
    }
}

pub fun destroy256(state: *State256) {
    ct.zeroize((?state.h[0]):~*^u8, 32);
    ct.zeroize(?state.block[0], SHA256_BLOCK_SIZE);
    state.block_len = 0;
    state.total     = 0;
}

pub fun destroy384(state: *State384) {
    ct.zeroize((?state.h[0]):~*^u8, 64);
    ct.zeroize(?state.block[0], SHA384_BLOCK_SIZE);
    state.block_len = 0;
    state.total     = 0;
}

pub fun destroy512(state: *State384) {
    destroy384(state);
}

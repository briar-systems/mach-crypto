pub rec State256 {
    h:         [8]^u32;
    block:     [64]^u8;
    block_len: usize;
    total:     u64;
}

pub rec State384 {
    h:         [8]^u64;
    block:     [128]^u8;
    block_len: usize;
    total:     u64;
}

#[oblivious]
#[inline]
fun rotr32(x: ^u32, n: u32) ^u32 {
    ret (x >> n) | (x << (32 - n));
}

#[oblivious]
#[inline]
fun rotr64(x: ^u64, n: u64) ^u64 {
    ret (x >> n) | (x << (64 - n));
}

#[oblivious]
#[inline]
fun choose32(x: ^u32, y: ^u32, z: ^u32) ^u32 {
    ret (x & y) ^ (~x & z);
}

#[oblivious]
#[inline]
fun choose64(x: ^u64, y: ^u64, z: ^u64) ^u64 {
    ret (x & y) ^ (~x & z);
}

#[oblivious]
#[inline]
fun majority32(x: ^u32, y: ^u32, z: ^u32) ^u32 {
    ret (x & y) ^ (x & z) ^ (y & z);
}

#[oblivious]
#[inline]
fun majority64(x: ^u64, y: ^u64, z: ^u64) ^u64 {
    ret (x & y) ^ (x & z) ^ (y & z);
}

#[oblivious]
#[inline]
fun big_sigma256_0(x: ^u32) ^u32 {
    ret rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22);
}

#[oblivious]
#[inline]
fun big_sigma256_1(x: ^u32) ^u32 {
    ret rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25);
}

#[oblivious]
#[inline]
fun small_sigma256_0(x: ^u32) ^u32 {
    ret rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3);
}

#[oblivious]
#[inline]
fun small_sigma256_1(x: ^u32) ^u32 {
    ret rotr32(x, 17) ^ rotr32(x, 19) ^ (x >> 10);
}

#[oblivious]
#[inline]
fun big_sigma512_0(x: ^u64) ^u64 {
    ret rotr64(x, 28) ^ rotr64(x, 34) ^ rotr64(x, 39);
}

#[oblivious]
#[inline]
fun big_sigma512_1(x: ^u64) ^u64 {
    ret rotr64(x, 14) ^ rotr64(x, 18) ^ rotr64(x, 41);
}

#[oblivious]
#[inline]
fun small_sigma512_0(x: ^u64) ^u64 {
    ret rotr64(x, 1) ^ rotr64(x, 8) ^ (x >> 7);
}

#[oblivious]
#[inline]
fun small_sigma512_1(x: ^u64) ^u64 {
    ret rotr64(x, 19) ^ rotr64(x, 61) ^ (x >> 6);
}

#[oblivious]
#[inline]
fun read32(block: *^u8, offset: usize) ^u32 {
    ret (block[offset]::^u32 << 24) | (block[offset + 1]::^u32 << 16) |
        (block[offset + 2]::^u32 << 8) | block[offset + 3]::^u32;
}

#[oblivious]
#[inline]
fun read64(block: *^u8, offset: usize) ^u64 {
    ret (block[offset]::^u64 << 56) | (block[offset + 1]::^u64 << 48) |
        (block[offset + 2]::^u64 << 40) | (block[offset + 3]::^u64 << 32) |
        (block[offset + 4]::^u64 << 24) | (block[offset + 5]::^u64 << 16) |
        (block[offset + 6]::^u64 << 8) | block[offset + 7]::^u64;
}

#[oblivious]
#[inline]
fun write32(output: *^u8, offset: usize, value: ^u32) {
    output[offset]     = (value >> 24)::^u8;
    output[offset + 1] = (value >> 16)::^u8;
    output[offset + 2] = (value >> 8)::^u8;
    output[offset + 3] = value::^u8;
}

#[oblivious]
#[inline]
fun write64(output: *^u8, offset: usize, value: ^u64) {
    output[offset]     = (value >> 56)::^u8;
    output[offset + 1] = (value >> 48)::^u8;
    output[offset + 2] = (value >> 40)::^u8;
    output[offset + 3] = (value >> 32)::^u8;
    output[offset + 4] = (value >> 24)::^u8;
    output[offset + 5] = (value >> 16)::^u8;
    output[offset + 6] = (value >> 8)::^u8;
    output[offset + 7] = value::^u8;
}

#[oblivious]
fun compress256(state: *State256, block: *^u8) {
    var schedule: [64]^u32;
    var i:        usize = 0;
    for (i < 16) {
        schedule[i] = read32(block, i * 4);
        i           = i + 1;
    }
    for (i < 64) {
        schedule[i] = small_sigma256_1(schedule[i - 2]) + schedule[i - 7] +
            small_sigma256_0(schedule[i - 15]) + schedule[i - 16];
        i = i + 1;
    }

    var a: ^u32 = state.h[0];
    var b: ^u32 = state.h[1];
    var c: ^u32 = state.h[2];
    var d: ^u32 = state.h[3];
    var e: ^u32 = state.h[4];
    var f: ^u32 = state.h[5];
    var g: ^u32 = state.h[6];
    var h: ^u32 = state.h[7];

    i = 0;
    for (i < 64) {
        val first:  ^u32 = h + big_sigma256_1(e) + choose32(e, f, g) + K256[i] + schedule[i];
        val second: ^u32 = big_sigma256_0(a) + majority32(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + first;
        d = c;
        c = b;
        b = a;
        a = first + second;
        i = i + 1;
    }

    state.h[0] = state.h[0] + a;
    state.h[1] = state.h[1] + b;
    state.h[2] = state.h[2] + c;
    state.h[3] = state.h[3] + d;
    state.h[4] = state.h[4] + e;
    state.h[5] = state.h[5] + f;
    state.h[6] = state.h[6] + g;
    state.h[7] = state.h[7] + h;

    a = 0;
    b = 0;
    c = 0;
    d = 0;
    e = 0;
    f = 0;
    g = 0;
    h = 0;
    ct.zeroize((?schedule[0]):~*^u8, 256);
}

#[oblivious]
fun compress384(state: *State384, block: *^u8) {
    var schedule: [80]^u64;
    var i:        usize = 0;
    for (i < 16) {
        schedule[i] = read64(block, i * 8);
        i           = i + 1;
    }
    for (i < 80) {
        schedule[i] = small_sigma512_1(schedule[i - 2]) + schedule[i - 7] +
            small_sigma512_0(schedule[i - 15]) + schedule[i - 16];
        i = i + 1;
    }

    var a: ^u64 = state.h[0];
    var b: ^u64 = state.h[1];
    var c: ^u64 = state.h[2];
    var d: ^u64 = state.h[3];
    var e: ^u64 = state.h[4];
    var f: ^u64 = state.h[5];
    var g: ^u64 = state.h[6];
    var h: ^u64 = state.h[7];

    i = 0;
    for (i < 80) {
        val first:  ^u64 = h + big_sigma512_1(e) + choose64(e, f, g) + K512[i] + schedule[i];
        val second: ^u64 = big_sigma512_0(a) + majority64(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + first;
        d = c;
        c = b;
        b = a;
        a = first + second;
        i = i + 1;
    }

    state.h[0] = state.h[0] + a;
    state.h[1] = state.h[1] + b;
    state.h[2] = state.h[2] + c;
    state.h[3] = state.h[3] + d;
    state.h[4] = state.h[4] + e;
    state.h[5] = state.h[5] + f;
    state.h[6] = state.h[6] + g;
    state.h[7] = state.h[7] + h;

    a = 0;
    b = 0;
    c = 0;
    d = 0;
    e = 0;
    f = 0;
    g = 0;
    h = 0;
    ct.zeroize((?schedule[0]):~*^u8, 640);
}

pub fun init256(state: *State256) {
    state.h[0] = 0x6a09e667;
    state.h[1] = 0xbb67ae85;
    state.h[2] = 0x3c6ef372;
    state.h[3] = 0xa54ff53a;
    state.h[4] = 0x510e527f;
    state.h[5] = 0x9b05688c;
    state.h[6] = 0x1f83d9ab;
    state.h[7] = 0x5be0cd19;
    ct.zeroize(?state.block[0], SHA256_BLOCK_SIZE);
    state.block_len = 0;
    state.total     = 0;
}

pub fun init384(state: *State384) {
    state.h[0] = 0xcbbb9d5dc1059ed8;
    state.h[1] = 0x629a292a367cd507;
    state.h[2] = 0x9159015a3070dd17;
    state.h[3] = 0x152fecd8f70e5939;
    state.h[4] = 0x67332667ffc00b31;
    state.h[5] = 0x8eb44a8768581511;
    state.h[6] = 0xdb0c2e0d64f98fa7;
    state.h[7] = 0x47b5481dbefa4fa4;
    ct.zeroize(?state.block[0], SHA384_BLOCK_SIZE);
    state.block_len = 0;
    state.total     = 0;
}

pub fun init512(state: *State384) {
    state.h[0] = 0x6a09e667f3bcc908;
    state.h[1] = 0xbb67ae8584caa73b;
    state.h[2] = 0x3c6ef372fe94f82b;
    state.h[3] = 0xa54ff53a5f1d36f1;
    state.h[4] = 0x510e527fade682d1;
    state.h[5] = 0x9b05688c2b3e6c1f;
    state.h[6] = 0x1f83d9abfb41bd6b;
    state.h[7] = 0x5be0cd19137e2179;
    ct.zeroize(?state.block[0], SHA384_BLOCK_SIZE);
    state.block_len = 0;
    state.total     = 0;
}

fun reserve256(state: *State256, len: usize) bool {
    if (len::u64 > SHA256_MAX_BYTES) { ret false; }
    ret state.total <= SHA256_MAX_BYTES - len::u64;
}

fun reserve384(state: *State384, len: usize) bool {
    ret len::u64 <= SHA384_MAX_BYTES - state.total;
}

pub fun update256_public(state: *State256, data: *u8, len: usize) bool {
    if (!reserve256(state, len)) { ret false; }
    state.total = state.total + len::u64;
    var offset: usize = 0;
    for (offset < len) {
        val room: usize = SHA256_BLOCK_SIZE - state.block_len;
        var take: usize = len - offset;
        if (take > room) { take = room; }
        var i: usize = 0;
        for (i < take) {
            state.block[state.block_len + i] = data[offset + i];
            i                                = i + 1;
        }
        state.block_len = state.block_len + take;
        offset          = offset + take;
        if (state.block_len == SHA256_BLOCK_SIZE) {
            compress256(state, ?state.block[0]);
            state.block_len = 0;
        }
    }
    ret true;
}

pub fun update256_secret(state: *State256, data: *^u8, len: usize) bool {
    if (!reserve256(state, len)) { ret false; }
    state.total = state.total + len::u64;
    var offset: usize = 0;
    for (offset < len) {
        val room: usize = SHA256_BLOCK_SIZE - state.block_len;
        var take: usize = len - offset;
        if (take > room) { take = room; }
        var i: usize = 0;
        for (i < take) {
            state.block[state.block_len + i] = data[offset + i];
            i                                = i + 1;
        }
        state.block_len = state.block_len + take;
        offset          = offset + take;
        if (state.block_len == SHA256_BLOCK_SIZE) {
            compress256(state, ?state.block[0]);
            state.block_len = 0;
        }
    }
    ret true;
}


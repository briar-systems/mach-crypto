# the aes block cipher behind one keyed context, over interchangeable backends
#
# a backend is a member that expands a key once into its own schedule and
# encrypts up to PARALLEL_BLOCKS blocks from it. the member is chosen when the
# key is installed and recorded in the context, so every later call runs the
# same one. the choice is a public fact of the host, never of the key.
#
# the contract every member holds:
# - its schedule is a case of Schedules with secret-typed words, so the context
#   stays welded and nothing derived from the key can be declassified. the
#   cases share storage, since a context runs one member, so a context is as
#   large as the largest schedule and no larger
# - `expand` writes only its own schedule and wipes its temporaries
# - `encrypt_blocks` takes 1..PARALLEL_BLOCKS blocks, may run in place, and is
#   constant time: no branch or address depends on key or data
# - `wipe` zeroizes the whole schedule
# `destroy` wipes every member's schedule, which covers the whole storage
# whichever member held it.
#
# software is the portable member and runs everywhere. hardware is aes-ni on
# x86_64 and the armv8 aes rounds on aarch64, available where
# crypto.internal.extensions says the host has them. `preferred` picks it
# there, so a context chooses once, at init, and keeps that choice.

use crypto.contracts;
use crypto.internal.aes.hardware;
use crypto.internal.aes.software;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val BLOCK_SIZE:      usize = 16;
pub val AES128_KEY_SIZE: usize = 16;
pub val AES256_KEY_SIZE: usize = 32;
pub val PARALLEL_BLOCKS: usize = hardware.PARALLEL_BLOCKS;

pub def Backend: u8;

pub val NONE:     Backend = 0;
pub val SOFTWARE: Backend = 1;
pub val HARDWARE: Backend = 2;

# the schedule of whichever member the context runs
pub uni Schedules {
    software: software.Schedule;
    hardware: hardware.Schedule;
}

pub rec Context {
    schedule: Schedules;
    rounds:   usize;
    backend:  Backend;
    active:   bool;
}

# whether this host can run the backend
pub fun available(backend: Backend) bool {
    if (backend == SOFTWARE) { ret true; }
    if (backend == HARDWARE) { ret hardware.available(); }
    ret false;
}

# the fastest backend this host can run
pub fun preferred() Backend {
    if (hardware.available()) { ret HARDWARE; }
    ret SOFTWARE;
}

pub fun destroy(context: *Context) {
    if (context == nil) { ret; }
    software.wipe(?context.schedule.software);
    hardware.wipe(?context.schedule.hardware);
    context.rounds  = 0;
    context.backend = NONE;
    context.active  = false;
}

# expand the key with a named backend, which tests use to force a member
#[oblivious]
pub fun init_backend(context: *Context, key: contracts.SecretBytes,
    backend: Backend) contracts.Error {
    if (context == nil) { ret contracts.INVALID_INPUT; }
    destroy(context);
    if (key.len != AES128_KEY_SIZE && key.len != AES256_KEY_SIZE) {
        ret contracts.INVALID_KEY;
    }
    if (key.data == nil)     { ret contracts.INVALID_INPUT; }
    if (!available(backend)) { ret contracts.UNSUPPORTED; }
    if (backend == HARDWARE) { context.rounds = hardware.expand(?context.schedule.hardware, key); }
    or                       { context.rounds = software.expand(?context.schedule.software, key); }
    context.backend = backend;
    context.active  = true;
    ret contracts.OK;
}

#[oblivious]
pub fun init(context: *Context, key: contracts.SecretBytes) contracts.Error {
    ret init_backend(context, key, preferred());
}

# encrypt `count` consecutive blocks, between one and PARALLEL_BLOCKS
#
# input and output may be the same storage.
#[oblivious]
pub fun encrypt_blocks(context: *Context, input: *^u8, output: *^u8, count: usize) {
    if (context.backend == HARDWARE) {
        hardware.encrypt_blocks(?context.schedule.hardware, context.rounds, input, output, count);
        ret;
    }
    # the software member takes four blocks per pass
    var done: usize = 0;
    for (done < count) {
        var take: usize = count - done;
        if (take > software.PARALLEL_BLOCKS) { take = software.PARALLEL_BLOCKS; }
        software.encrypt_blocks(?context.schedule.software, context.rounds,
            ?input[done * BLOCK_SIZE], ?output[done * BLOCK_SIZE], take);
        done = done + take;
    }
}

#[oblivious]
pub fun encrypt(context: *Context, input: *^u8, output: *^u8) {
    encrypt_blocks(context, input, output, 1);
}

# fips 197 appendix c.1 and c.3, and nist sp 800-38a f.1.1 and f.1.5
val FIPS_PLAINTEXT: [16]u8 = [16]u8{
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
    0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff
};

val FIPS_AES128: [16]u8 = [16]u8{
    0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30,
    0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a
};

val FIPS_AES256: [16]u8 = [16]u8{
    0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf,
    0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89
};

# nist sp 800-38a f.1.1 and f.1.5, all four ecb blocks
val ECB_AES128_KEY: [16]u8 = [16]u8{
    0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6,
    0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c
};

val ECB_AES256_KEY: [32]u8 = [32]u8{
    0x60, 0x3d, 0xeb, 0x10, 0x15, 0xca, 0x71, 0xbe,
    0x2b, 0x73, 0xae, 0xf0, 0x85, 0x7d, 0x77, 0x81,
    0x1f, 0x35, 0x2c, 0x07, 0x3b, 0x61, 0x08, 0xd7,
    0x2d, 0x98, 0x10, 0xa3, 0x09, 0x14, 0xdf, 0xf4
};

val ECB_PLAINTEXT: [64]u8 = [64]u8{
    0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96,
    0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a,
    0xae, 0x2d, 0x8a, 0x57, 0x1e, 0x03, 0xac, 0x9c,
    0x9e, 0xb7, 0x6f, 0xac, 0x45, 0xaf, 0x8e, 0x51,
    0x30, 0xc8, 0x1c, 0x46, 0xa3, 0x5c, 0xe4, 0x11,
    0xe5, 0xfb, 0xc1, 0x19, 0x1a, 0x0a, 0x52, 0xef,
    0xf6, 0x9f, 0x24, 0x45, 0xdf, 0x4f, 0x9b, 0x17,
    0xad, 0x2b, 0x41, 0x7b, 0xe6, 0x6c, 0x37, 0x10
};

val ECB_AES128: [64]u8 = [64]u8{
    0x3a, 0xd7, 0x7b, 0xb4, 0x0d, 0x7a, 0x36, 0x60,
    0xa8, 0x9e, 0xca, 0xf3, 0x24, 0x66, 0xef, 0x97,
    0xf5, 0xd3, 0xd5, 0x85, 0x03, 0xb9, 0x69, 0x9d,
    0xe7, 0x85, 0x89, 0x5a, 0x96, 0xfd, 0xba, 0xaf,
    0x43, 0xb1, 0xcd, 0x7f, 0x59, 0x8e, 0xce, 0x23,
    0x88, 0x1b, 0x00, 0xe3, 0xed, 0x03, 0x06, 0x88,
    0x7b, 0x0c, 0x78, 0x5e, 0x27, 0xe8, 0xad, 0x3f,
    0x82, 0x23, 0x20, 0x71, 0x04, 0x72, 0x5d, 0xd4
};

val ECB_AES256: [64]u8 = [64]u8{
    0xf3, 0xee, 0xd1, 0xbd, 0xb5, 0xd2, 0xa0, 0x3c,
    0x06, 0x4b, 0x5a, 0x7e, 0x3d, 0xb1, 0x81, 0xf8,
    0x59, 0x1c, 0xcb, 0x10, 0xd4, 0x10, 0xed, 0x26,
    0xdc, 0x5b, 0xa7, 0x4a, 0x31, 0x36, 0x28, 0x70,
    0xb6, 0xed, 0x21, 0xb9, 0x9c, 0xa6, 0xf4, 0xf9,
    0xf1, 0x53, 0xe7, 0xb1, 0xbe, 0xaf, 0xed, 0x1d,
    0x23, 0x30, 0x4b, 0x7a, 0x39, 0xf9, 0xf3, 0xff,
    0x06, 0x7d, 0x8d, 0x8f, 0x9e, 0x24, 0xec, 0xc7
};

# the eight-block pattern: the four sp 800-38a blocks, twice
fun ecb_block(index: usize) usize {
    ret (index % 4) * BLOCK_SIZE;
}

# encrypt `count` blocks of the ecb pattern through one call and check them
fun check_ecb(context: *Context, expected: *u8, count: usize) bool {
    var blocks: [128]^u8;
    var block:  usize = 0;
    for (block < count) {
        var i: usize = 0;
        for (i < BLOCK_SIZE) {
            blocks[block * BLOCK_SIZE + i] = ECB_PLAINTEXT[ecb_block(block) + i];
            i                              = i + 1;
        }
        block = block + 1;
    }
    # in place, as aes-gcm's keystream runs
    encrypt_blocks(context, ?blocks[0], ?blocks[0], count);
    block = 0;
    for (block < count) {
        var i: usize = 0;
        for (i < BLOCK_SIZE) {
            if (blocks[block * BLOCK_SIZE + i]:>u8 != expected[ecb_block(block) + i]) { ret false; }
            i = i + 1;
        }
        block = block + 1;
    }
    ret true;
}

# the known-answer blocks on one member, 0 when they all match
fun check_member(backend: Backend) i32 {
    var key:     [32]^u8;
    var block:   [16]^u8;
    var context: Context;
    var i:       usize = 0;
    for (i < 32) {
        key[i] = i::u8;
        i      = i + 1;
    }
    var size: usize = AES128_KEY_SIZE;
    for (size <= AES256_KEY_SIZE) {
        if (init_backend(?context, contracts.SecretBytes{data: ?key[0], len: size}, backend) !=
            contracts.OK) { ret 1; }
        if (context.backend != backend) { ret 2; }
        i = 0;
        for (i < BLOCK_SIZE) {
            block[i] = FIPS_PLAINTEXT[i];
            i        = i + 1;
        }
        encrypt(?context, ?block[0], ?block[0]);
        var expected: *u8 = (?FIPS_AES128[0]):~*u8;
        if (size == AES256_KEY_SIZE) { expected = (?FIPS_AES256[0]):~*u8; }
        i = 0;
        for (i < BLOCK_SIZE) {
            if (block[i]:>u8 != expected[i]) { ret 3; }
            i = i + 1;
        }
        destroy(?context);
        size = size + (AES256_KEY_SIZE - AES128_KEY_SIZE);
    }

    i = 0;
    for (i < 16) {
        key[i] = ECB_AES128_KEY[i];
        i      = i + 1;
    }
    if (init_backend(?context, contracts.SecretBytes{data: ?key[0], len: 16}, backend) !=
        contracts.OK) { ret 4; }
    var count: usize = 1;
    for (count <= PARALLEL_BLOCKS) {
        if (!check_ecb(?context, (?ECB_AES128[0]):~*u8, count)) { ret 5; }
        count = count + 1;
    }
    destroy(?context);
    i = 0;
    for (i < 32) {
        key[i] = ECB_AES256_KEY[i];
        i      = i + 1;
    }
    if (init_backend(?context, contracts.SecretBytes{data: ?key[0], len: 32}, backend) !=
        contracts.OK) { ret 6; }
    count = 1;
    for (count <= PARALLEL_BLOCKS) {
        if (!check_ecb(?context, (?ECB_AES256[0]):~*u8, count)) { ret 7; }
        count = count + 1;
    }
    destroy(?context);
    ret 0;
}

test "aes: fips 197 and sp 800-38a blocks on every member this host runs" {
    if (check_member(SOFTWARE) != 0) { ret 1; }
    if (available(HARDWARE)) {
        val failed: i32 = check_member(HARDWARE);
        if (failed != 0) { ret 10 + failed; }
    }
    or {
        # a member the host lacks is refused and leaves the context empty
        var key:     [16]^u8;
        var context: Context;
        if (init_backend(?context, contracts.SecretBytes{data: ?key[0], len: 16}, HARDWARE) !=
            contracts.UNSUPPORTED) { ret 2; }
        if (context.active || context.backend != NONE) { ret 3; }
    }
    ret 0;
}

# splitmix64, a fixed stream so a failure reproduces
fun next_random(state: *u64) u64 {
    @state = @state + 0x9E3779B97F4A7C15;
    var z: u64 = @state;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    ret z ^ (z >> 31);
}

test "aes: hardware and software members agree over random keys and block counts" {
    if (!available(HARDWARE)) { ret 0; }
    var state:    u64   = 197;
    var round:    usize = 0;
    var hardware: Context;
    var software: Context;
    for (round < 128) {
        var key:   [32]^u8;
        var input: [128]^u8;
        var left:  [128]^u8;
        var right: [128]^u8;
        var i:     usize = 0;
        for (i < 32) {
            key[i] = next_random(?state)::u8;
            i      = i + 1;
        }
        i = 0;
        for (i < 128) {
            input[i] = next_random(?state)::u8;
            i        = i + 1;
        }
        var size: usize = AES128_KEY_SIZE;
        if (((round / PARALLEL_BLOCKS) & 1) == 1) { size = AES256_KEY_SIZE; }
        val count:  usize                 = round % PARALLEL_BLOCKS + 1;
        val secret: contracts.SecretBytes = contracts.SecretBytes{data: ?key[0], len: size};
        if (init_backend(?hardware, secret, HARDWARE) != contracts.OK) { ret 1; }
        if (init_backend(?software, secret, SOFTWARE) != contracts.OK) { ret 2; }
        encrypt_blocks(?hardware, ?input[0], ?left[0], count);
        encrypt_blocks(?software, ?input[0], ?right[0], count);
        i = 0;
        for (i < 128) {
            if (i < count * BLOCK_SIZE && left[i]:>u8 != right[i]:>u8) { ret 3; }
            # nothing past the last block is written
            if (i >= count * BLOCK_SIZE && left[i]:>u8 != 0) { ret 4; }
            i = i + 1;
        }
        destroy(?hardware);
        destroy(?software);
        round = round + 1;
    }
    ret 0;
}

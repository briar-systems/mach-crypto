# secret-state bitsliced aes-128 and aes-256 encryption
#
# the state is eight 64-bit bit planes holding up to four blocks at once. bit
# `row * 16 + column * 4 + block` of plane `b` is bit `b` of that state byte, so
# shift rows is a nibble rotation within a row and mix columns a 16-bit rotation.

use crypto.contracts;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val BLOCK_SIZE:      usize = 16;
pub val AES128_KEY_SIZE: usize = 16;
pub val AES256_KEY_SIZE: usize = 32;
pub val PARALLEL_BLOCKS: usize = 4;

val MAX_ROUNDS: usize = 14;

pub rec Context {
    round_planes: [120]^u64;
    rounds:       usize;
    active:       bool;
}

# boyar-peralta forward s-box circuit over eight bit planes, plane 0 the lsb
#[oblivious]
fun substitute(q: *^u64) {
    val x0: ^u64 = q[7];
    val x1: ^u64 = q[6];
    val x2: ^u64 = q[5];
    val x3: ^u64 = q[4];
    val x4: ^u64 = q[3];
    val x5: ^u64 = q[2];
    val x6: ^u64 = q[1];
    val x7: ^u64 = q[0];

    val y14: ^u64 = x3 ^ x5;
    val y13: ^u64 = x0 ^ x6;
    val y9:  ^u64 = x0 ^ x3;
    val y8:  ^u64 = x0 ^ x5;
    val t0:  ^u64 = x1 ^ x2;
    val y1:  ^u64 = t0 ^ x7;
    val y4:  ^u64 = y1 ^ x3;
    val y12: ^u64 = y13 ^ y14;
    val y2:  ^u64 = y1 ^ x0;
    val y5:  ^u64 = y1 ^ x6;
    val y3:  ^u64 = y5 ^ y8;
    val t1:  ^u64 = x4 ^ y12;
    val y15: ^u64 = t1 ^ x5;
    val y20: ^u64 = t1 ^ x1;
    val y6:  ^u64 = y15 ^ x7;
    val y10: ^u64 = y15 ^ t0;
    val y11: ^u64 = y20 ^ y9;
    val y7:  ^u64 = x7 ^ y11;
    val y17: ^u64 = y10 ^ y11;
    val y19: ^u64 = y10 ^ y8;
    val y16: ^u64 = t0 ^ y11;
    val y21: ^u64 = y13 ^ y16;
    val y18: ^u64 = x0 ^ y16;

    val t2:  ^u64 = y12 & y15;
    val t3:  ^u64 = y3 & y6;
    val t4:  ^u64 = t3 ^ t2;
    val t5:  ^u64 = y4 & x7;
    val t6:  ^u64 = t5 ^ t2;
    val t7:  ^u64 = y13 & y16;
    val t8:  ^u64 = y5 & y1;
    val t9:  ^u64 = t8 ^ t7;
    val t10: ^u64 = y2 & y7;
    val t11: ^u64 = t10 ^ t7;
    val t12: ^u64 = y9 & y11;
    val t13: ^u64 = y14 & y17;
    val t14: ^u64 = t13 ^ t12;
    val t15: ^u64 = y8 & y10;
    val t16: ^u64 = t15 ^ t12;
    val t17: ^u64 = t4 ^ t14;
    val t18: ^u64 = t6 ^ t16;
    val t19: ^u64 = t9 ^ t14;
    val t20: ^u64 = t11 ^ t16;
    val t21: ^u64 = t17 ^ y20;
    val t22: ^u64 = t18 ^ y19;
    val t23: ^u64 = t19 ^ y21;
    val t24: ^u64 = t20 ^ y18;

    val t25: ^u64 = t21 ^ t22;
    val t26: ^u64 = t21 & t23;
    val t27: ^u64 = t24 ^ t26;
    val t28: ^u64 = t25 & t27;
    val t29: ^u64 = t28 ^ t22;
    val t30: ^u64 = t23 ^ t24;
    val t31: ^u64 = t22 ^ t26;
    val t32: ^u64 = t31 & t30;
    val t33: ^u64 = t32 ^ t24;
    val t34: ^u64 = t23 ^ t33;
    val t35: ^u64 = t27 ^ t33;
    val t36: ^u64 = t24 & t35;
    val t37: ^u64 = t36 ^ t34;
    val t38: ^u64 = t27 ^ t36;
    val t39: ^u64 = t29 & t38;
    val t40: ^u64 = t25 ^ t39;

    val t41: ^u64 = t40 ^ t37;
    val t42: ^u64 = t29 ^ t33;
    val t43: ^u64 = t29 ^ t40;
    val t44: ^u64 = t33 ^ t37;
    val t45: ^u64 = t42 ^ t41;
    val z0:  ^u64 = t44 & y15;
    val z1:  ^u64 = t37 & y6;
    val z2:  ^u64 = t33 & x7;
    val z3:  ^u64 = t43 & y16;
    val z4:  ^u64 = t40 & y1;
    val z5:  ^u64 = t29 & y7;
    val z6:  ^u64 = t42 & y11;
    val z7:  ^u64 = t45 & y17;
    val z8:  ^u64 = t41 & y10;
    val z9:  ^u64 = t44 & y12;
    val z10: ^u64 = t37 & y3;
    val z11: ^u64 = t33 & y4;
    val z12: ^u64 = t43 & y13;
    val z13: ^u64 = t40 & y5;
    val z14: ^u64 = t29 & y2;
    val z15: ^u64 = t42 & y9;
    val z16: ^u64 = t45 & y14;
    val z17: ^u64 = t41 & y8;

    val t46: ^u64 = z15 ^ z16;
    val t47: ^u64 = z10 ^ z11;
    val t48: ^u64 = z5 ^ z13;
    val t49: ^u64 = z9 ^ z10;
    val t50: ^u64 = z2 ^ z12;
    val t51: ^u64 = z2 ^ z5;
    val t52: ^u64 = z7 ^ z8;
    val t53: ^u64 = z0 ^ z3;
    val t54: ^u64 = z6 ^ z7;
    val t55: ^u64 = z16 ^ z17;
    val t56: ^u64 = z12 ^ t48;
    val t57: ^u64 = t50 ^ t53;
    val t58: ^u64 = z4 ^ t46;
    val t59: ^u64 = z3 ^ t54;
    val t60: ^u64 = t46 ^ t57;
    val t61: ^u64 = z14 ^ t57;
    val t62: ^u64 = t52 ^ t58;
    val t63: ^u64 = t49 ^ t58;
    val t64: ^u64 = z4 ^ t59;
    val t65: ^u64 = t61 ^ t62;
    val t66: ^u64 = z1 ^ t63;
    val s0:  ^u64 = t59 ^ t63;
    val s6:  ^u64 = t56 ^ ~t62;
    val s7:  ^u64 = t48 ^ ~t60;
    val t67: ^u64 = t64 ^ t65;
    val s3:  ^u64 = t53 ^ t66;
    val s4:  ^u64 = t51 ^ t66;
    val s5:  ^u64 = t47 ^ t65;
    val s1:  ^u64 = t64 ^ ~s3;
    val s2:  ^u64 = t55 ^ ~t67;

    q[7] = s0;
    q[6] = s1;
    q[5] = s2;
    q[4] = s3;
    q[3] = s4;
    q[2] = s5;
    q[1] = s6;
    q[0] = s7;
}

# substitute four key-schedule bytes in place through the bitsliced circuit
#[oblivious]
fun substitute_word(word: *^u8) {
    var planes: [8]^u64;
    var plane:  usize = 0;
    for (plane < 8) {
        var value: ^u64  = 0;
        var i:     usize = 0;
        for (i < 4) {
            value = value | (((word[i] >> plane)::^u64 & 1) << i);
            i     = i + 1;
        }
        planes[plane] = value;
        plane         = plane + 1;
    }
    substitute(?planes[0]);
    var i: usize = 0;
    for (i < 4) {
        var byte: ^u8 = 0;
        plane = 0;
        for (plane < 8) {
            byte  = byte | (((planes[plane] >> i) & 1)::^u8 << plane);
            plane = plane + 1;
        }
        word[i] = byte;
        i       = i + 1;
    }
    ct.zeroize((?planes[0]):~*^u8, 64);
}

fun next_rcon(value: u8) u8 {
    if ((value & 0x80) != 0) { ret (value << 1) ^ 0x1B; }
    ret value << 1;
}

pub fun destroy(context: *Context) {
    if (context == nil) { ret; }
    ct.zeroize((?context.round_planes[0]):~*^u8, 960);
    context.rounds = 0;
    context.active = false;
}

# spread one 16-byte round key over the bit planes of every parallel block
#[oblivious]
fun spread_round_key(context: *Context, round: usize, key: *^u8) {
    val base:  usize = round * 8;
    var plane: usize = 0;
    for (plane < 8) {
        context.round_planes[base + plane] = 0;
        plane                              = plane + 1;
    }
    var i: usize = 0;
    for (i < BLOCK_SIZE) {
        val position: u64 = ((i & 3) * 16 + (i >> 2) * 4)::u64;
        plane = 0;
        for (plane < 8) {
            val bit:    ^u64 = (key[i] >> plane)::^u64 & 1;
            val nibble: ^u64 = (0 - bit) & 0xF;
            context.round_planes[base + plane] =
                context.round_planes[base + plane] | (nibble << position);
            plane = plane + 1;
        }
        i = i + 1;
    }
}

#[oblivious]
pub fun init(context: *Context, key: contracts.SecretBytes) contracts.Error {
    if (context == nil) { ret contracts.INVALID_INPUT; }
    destroy(context);
    if (key.len != AES128_KEY_SIZE && key.len != AES256_KEY_SIZE) {
        ret contracts.INVALID_KEY;
    }
    if (key.data == nil) { ret contracts.INVALID_INPUT; }

    context.rounds = 10;
    if (key.len == AES256_KEY_SIZE) { context.rounds = 14; }
    val expanded_size: usize = (context.rounds + 1) * BLOCK_SIZE;
    var round_keys:    [240]^u8;
    var generated:     usize = 0;
    for (generated < key.len) {
        round_keys[generated] = key.data[generated];
        generated             = generated + 1;
    }

    var temporary: [4]^u8;
    ct.zeroize(?temporary[0], 4);
    var rcon: u8 = 1;
    for (generated < expanded_size) {
        var i: usize = 0;
        for (i < 4) {
            temporary[i] = round_keys[generated - 4 + i];
            i            = i + 1;
        }
        if (generated % key.len == 0) {
            val first: ^u8 = temporary[0];
            temporary[0] = temporary[1];
            temporary[1] = temporary[2];
            temporary[2] = temporary[3];
            temporary[3] = first;
            substitute_word(?temporary[0]);
            temporary[0] = temporary[0] ^ rcon;
            rcon         = next_rcon(rcon);
        }
        or (key.len == AES256_KEY_SIZE && generated % key.len == 16) {
            substitute_word(?temporary[0]);
        }
        i = 0;
        for (i < 4) {
            round_keys[generated] = round_keys[generated - key.len] ^ temporary[i];
            generated             = generated + 1;
            i                     = i + 1;
        }
    }
    var round: usize = 0;
    for (round <= context.rounds) {
        spread_round_key(context, round, ?round_keys[round * BLOCK_SIZE]);
        round = round + 1;
    }
    ct.zeroize(?temporary[0], 4);
    ct.zeroize(?round_keys[0], 240);
    context.active = true;
    ret contracts.OK;
}

#[oblivious]
fun add_round_key(context: *Context, q: *^u64, round: usize) {
    val base:  usize = round * 8;
    var plane: usize = 0;
    for (plane < 8) {
        q[plane] = q[plane] ^ context.round_planes[base + plane];
        plane    = plane + 1;
    }
}

#[oblivious]
fun shift_rows(q: *^u64) {
    var plane: usize = 0;
    for (plane < 8) {
        val x: ^u64 = q[plane];
        q[plane] = (x & 0x000000000000FFFF)
            | ((x & 0x00000000FFF00000) >> 4)
            | ((x & 0x00000000000F0000) << 12)
            | ((x & 0x0000FF0000000000) >> 8)
            | ((x & 0x000000FF00000000) << 8)
            | ((x & 0xF000000000000000) >> 12)
            | ((x & 0x0FFF000000000000) << 4);
        plane = plane + 1;
    }
}

#[oblivious]
#[inline]
fun rotate_rows(x: ^u64) ^u64 {
    ret (x >> 16) | (x << 48);
}

#[oblivious]
#[inline]
fun rotate_half(x: ^u64) ^u64 {
    ret (x << 32) | (x >> 32);
}

#[oblivious]
fun mix_columns(q: *^u64) {
    val q0: ^u64 = q[0];
    val q1: ^u64 = q[1];
    val q2: ^u64 = q[2];
    val q3: ^u64 = q[3];
    val q4: ^u64 = q[4];
    val q5: ^u64 = q[5];
    val q6: ^u64 = q[6];
    val q7: ^u64 = q[7];
    val r0: ^u64 = rotate_rows(q0);
    val r1: ^u64 = rotate_rows(q1);
    val r2: ^u64 = rotate_rows(q2);
    val r3: ^u64 = rotate_rows(q3);
    val r4: ^u64 = rotate_rows(q4);
    val r5: ^u64 = rotate_rows(q5);
    val r6: ^u64 = rotate_rows(q6);
    val r7: ^u64 = rotate_rows(q7);

    q[0] = q7 ^ r7 ^ r0 ^ rotate_half(q0 ^ r0);
    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotate_half(q1 ^ r1);
    q[2] = q1 ^ r1 ^ r2 ^ rotate_half(q2 ^ r2);
    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotate_half(q3 ^ r3);
    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotate_half(q4 ^ r4);
    q[5] = q4 ^ r4 ^ r5 ^ rotate_half(q5 ^ r5);
    q[6] = q5 ^ r5 ^ r6 ^ rotate_half(q6 ^ r6);
    q[7] = q6 ^ r6 ^ r7 ^ rotate_half(q7 ^ r7);
}

#[oblivious]
fun load_blocks(q: *^u64, input: *^u8, count: usize) {
    var plane: usize = 0;
    for (plane < 8) {
        q[plane] = 0;
        plane    = plane + 1;
    }
    var block: usize = 0;
    for (block < count) {
        var i: usize = 0;
        for (i < BLOCK_SIZE) {
            val byte:     ^u64 = input[block * BLOCK_SIZE + i]::^u64;
            val position: u64  = ((i & 3) * 16 + (i >> 2) * 4 + block)::u64;
            plane = 0;
            for (plane < 8) {
                q[plane] = q[plane] | (((byte >> plane) & 1) << position);
                plane    = plane + 1;
            }
            i = i + 1;
        }
        block = block + 1;
    }
}

#[oblivious]
fun unload_blocks(q: *^u64, output: *^u8, count: usize) {
    var block: usize = 0;
    for (block < count) {
        var i: usize = 0;
        for (i < BLOCK_SIZE) {
            val position: u64   = ((i & 3) * 16 + (i >> 2) * 4 + block)::u64;
            var byte:     ^u8   = 0;
            var plane:    usize = 0;
            for (plane < 8) {
                byte  = byte | (((q[plane] >> position) & 1)::^u8 << plane);
                plane = plane + 1;
            }
            output[block * BLOCK_SIZE + i] = byte;
            i                              = i + 1;
        }
        block = block + 1;
    }
}

# encrypt `count` consecutive blocks in one bitsliced pass
#
# count must be between one and PARALLEL_BLOCKS. input and output may be the
# same storage because every input byte is loaded before any output write.
#[oblivious]
pub fun encrypt_blocks(context: *Context, input: *^u8, output: *^u8, count: usize) {
    var q: [8]^u64;
    load_blocks(?q[0], input, count);
    add_round_key(context, ?q[0], 0);
    var round: usize = 1;
    for (round < context.rounds) {
        substitute(?q[0]);
        shift_rows(?q[0]);
        mix_columns(?q[0]);
        add_round_key(context, ?q[0], round);
        round = round + 1;
    }
    substitute(?q[0]);
    shift_rows(?q[0]);
    add_round_key(context, ?q[0], context.rounds);
    unload_blocks(?q[0], output, count);
    ct.zeroize((?q[0]):~*^u8, 64);
}

#[oblivious]
pub fun encrypt(context: *Context, input: *^u8, output: *^u8) {
    encrypt_blocks(context, input, output, 1);
}

fun reference_multiply(x: u8, y: u8) u8 {
    var left:   u8 = x;
    var right:  u8 = y;
    var result: u8 = 0;
    for (right != 0) {
        if ((right & 1) != 0) { result = result ^ left; }
        var reduce: u8 = 0;
        if ((left & 0x80) != 0) { reduce = 0x1B; }
        left  = (left << 1) ^ reduce;
        right = right >> 1;
    }
    ret result;
}

fun reference_rotate(x: u8, n: u8) u8 {
    ret (x << n) | (x >> (8 - n));
}

# fips 197 s-box from its definition, public and variable-time, for tests only
fun reference_substitute(x: u8) u8 {
    var inverse: u8  = 0;
    var y:       u16 = 1;
    for (x != 0 && y < 256) {
        if (reference_multiply(x, y::u8) == 1) {
            inverse = y::u8;
            brk;
        }
        y = y + 1;
    }
    ret inverse ^ reference_rotate(inverse, 1) ^ reference_rotate(inverse, 2) ^
        reference_rotate(inverse, 3) ^ reference_rotate(inverse, 4) ^ 0x63;
}

test "aes: bitsliced s-box matches the fips 197 definition for every byte" {
    if (reference_substitute(0x00) != 0x63 || reference_substitute(0x53) != 0xED) { ret 1; }
    var value: u16 = 0;
    for (value < 256) {
        var word: [4]^u8;
        word[0] = value::u8;
        word[1] = (value ^ 0xA5)::u8;
        word[2] = (255 - value)::u8;
        word[3] = (value * 7)::u8;
        substitute_word(?word[0]);
        if (word[0]:>u8 != reference_substitute(value::u8))          { ret 2; }
        if (word[1]:>u8 != reference_substitute((value ^ 0xA5)::u8)) { ret 3; }
        if (word[2]:>u8 != reference_substitute((255 - value)::u8))  { ret 4; }
        if (word[3]:>u8 != reference_substitute((value * 7)::u8))    { ret 5; }
        value = value + 1;
    }
    ret 0;
}

test "aes: parallel blocks equal one-block encryption in every lane" {
    var key: [16]^u8;
    var i:   usize = 0;
    for (i < 16) {
        key[i] = (i * 13 + 1)::u8;
        i      = i + 1;
    }
    var context: Context;
    if (init(?context, contracts.SecretBytes{data: ?key[0], len: 16}) != contracts.OK) { ret 1; }
    var input:  [64]^u8;
    var batch:  [64]^u8;
    var single: [16]^u8;
    i = 0;
    for (i < 64) {
        input[i] = (i * 29 + 7)::u8;
        i        = i + 1;
    }
    var count: usize = 1;
    for (count <= PARALLEL_BLOCKS) {
        encrypt_blocks(?context, ?input[0], ?batch[0], count);
        var block: usize = 0;
        for (block < count) {
            encrypt(?context, ?input[block * 16], ?single[0]);
            i = 0;
            for (i < 16) {
                if (single[i]:>u8 != batch[block * 16 + i]:>u8) { ret 2; }
                i = i + 1;
            }
            block = block + 1;
        }
        count = count + 1;
    }
    destroy(?context);
    ret 0;
}

test "aes: fips 197 appendix c aes-128 and aes-256 blocks" {
    var key:    [32]^u8;
    var block:  [16]^u8;
    var output: [16]^u8;
    var i:      usize = 0;
    for (i < 32) {
        key[i] = i::u8;
        i      = i + 1;
    }
    i = 0;
    for (i < 16) {
        block[i] = (i * 0x11)::u8;
        i        = i + 1;
    }
    val expected128: [16]u8 = [16]u8{
        0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30,
        0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a
    };
    val expected256: [16]u8 = [16]u8{
        0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf,
        0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89
    };
    var context: Context;
    if (init(?context, contracts.SecretBytes{data: ?key[0], len: 16}) != contracts.OK) { ret 1; }
    encrypt(?context, ?block[0], ?output[0]);
    i = 0;
    for (i < 16) {
        if (output[i]:>u8 != expected128[i]) { ret 2; }
        i = i + 1;
    }
    if (init(?context, contracts.SecretBytes{data: ?key[0], len: 32}) != contracts.OK) { ret 3; }
    encrypt(?context, ?block[0], ?output[0]);
    i = 0;
    for (i < 16) {
        if (output[i]:>u8 != expected256[i]) { ret 4; }
        i = i + 1;
    }
    destroy(?context);
    ret 0;
}

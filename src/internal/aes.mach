# secret-state aes-128 and aes-256 encryption

use crypto.contracts;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub val BLOCK_SIZE:      usize = 16;
pub val AES128_KEY_SIZE: usize = 16;
pub val AES256_KEY_SIZE: usize = 32;

pub rec Context {
    round_keys: [240]^u8;
    rounds:     usize;
    active:     bool;
}

#[oblivious]
#[inline]
fun multiply(x: ^u8, y: ^u8) ^u8 {
    var left:   ^u8   = x;
    var right:  ^u8   = y;
    var result: ^u8   = 0;
    var i:      usize = 0;
    for (i < 8) {
        val use_left: ^u8 = 0 - (right & 1);
        result = result ^ (left & use_left);
        val reduce: ^u8 = 0 - (left >> 7);
        left  = (left << 1) ^ (0x1B & reduce);
        right = right >> 1;
        i     = i + 1;
    }
    left  = 0;
    right = 0;
    ret result;
}

#[oblivious]
#[inline]
fun rotate_left(x: ^u8, n: u8) ^u8 {
    ret (x << n) | (x >> (8 - n));
}

#[oblivious]
#[inline]
fun substitute(x: ^u8) ^u8 {
    val x2:      ^u8 = multiply(x, x);
    val x4:      ^u8 = multiply(x2, x2);
    val x8:      ^u8 = multiply(x4, x4);
    val x16:     ^u8 = multiply(x8, x8);
    val x32:     ^u8 = multiply(x16, x16);
    val x64:     ^u8 = multiply(x32, x32);
    val x128:    ^u8 = multiply(x64, x64);
    var inverse: ^u8 = multiply(x128, x64);
    inverse = multiply(inverse, x32);
    inverse = multiply(inverse, x16);
    inverse = multiply(inverse, x8);
    inverse = multiply(inverse, x4);
    inverse = multiply(inverse, x2);
    val output: ^u8 = inverse ^ rotate_left(inverse, 1) ^ rotate_left(inverse, 2) ^
        rotate_left(inverse, 3) ^ rotate_left(inverse, 4) ^ 0x63;
    inverse = 0;
    ret output;
}

fun next_rcon(value: u8) u8 {
    if ((value & 0x80) != 0) { ret (value << 1) ^ 0x1B; }
    ret value << 1;
}

pub fun destroy(context: *Context) {
    if (context == nil) { ret; }
    ct.zeroize(?context.round_keys[0], 240);
    context.rounds = 0;
    context.active = false;
}

#[oblivious]
pub fun init(context: *Context, key: contracts.SecretBytes) contracts.Error {
    if (context == nil) { ret contracts.INVALID_INPUT; }
    ct.zeroize(?context.round_keys[0], 240);
    context.rounds = 0;
    context.active = false;
    if (key.len != AES128_KEY_SIZE && key.len != AES256_KEY_SIZE) {
        ret contracts.INVALID_KEY;
    }
    if (key.data == nil) { ret contracts.INVALID_INPUT; }

    context.rounds = 10;
    if (key.len == AES256_KEY_SIZE) { context.rounds = 14; }
    val expanded_size: usize = (context.rounds + 1) * BLOCK_SIZE;
    var generated:     usize = 0;
    for (generated < key.len) {
        context.round_keys[generated] = key.data[generated];
        generated                     = generated + 1;
    }

    var temporary: [4]^u8;
    ct.zeroize(?temporary[0], 4);
    var rcon: u8 = 1;
    for (generated < expanded_size) {
        var i: usize = 0;
        for (i < 4) {
            temporary[i] = context.round_keys[generated - 4 + i];
            i            = i + 1;
        }
        if (generated % key.len == 0) {
            val first: ^u8 = temporary[0];
            temporary[0] = substitute(temporary[1]) ^ rcon;
            temporary[1] = substitute(temporary[2]);
            temporary[2] = substitute(temporary[3]);
            temporary[3] = substitute(first);
            rcon         = next_rcon(rcon);
        }
        or (key.len == AES256_KEY_SIZE && generated % key.len == 16) {
            i = 0;
            for (i < 4) {
                temporary[i] = substitute(temporary[i]);
                i            = i + 1;
            }
        }
        i = 0;
        for (i < 4) {
            context.round_keys[generated] = context.round_keys[generated - key.len] ^ temporary[i];
            generated                     = generated + 1;
            i                             = i + 1;
        }
    }
    ct.zeroize(?temporary[0], 4);
    context.active = true;
    ret contracts.OK;
}

#[oblivious]
fun add_round_key(context: *Context, state: *^u8, round: usize) {
    val offset: usize = round * BLOCK_SIZE;
    var i:      usize = 0;
    for (i < BLOCK_SIZE) {
        state[i] = state[i] ^ context.round_keys[offset + i];
        i        = i + 1;
    }
}

#[oblivious]
fun sub_bytes(state: *^u8) {
    var i: usize = 0;
    for (i < BLOCK_SIZE) {
        state[i] = substitute(state[i]);
        i        = i + 1;
    }
}

fun shift_rows(state: *^u8) {
    var copy: [16]^u8;
    var i:    usize = 0;
    for (i < BLOCK_SIZE) {
        copy[i] = state[i];
        i       = i + 1;
    }
    state[0]  = copy[0];
    state[4]  = copy[4];
    state[8]  = copy[8];
    state[12] = copy[12];
    state[1]  = copy[5];
    state[5]  = copy[9];
    state[9]  = copy[13];
    state[13] = copy[1];
    state[2]  = copy[10];
    state[6]  = copy[14];
    state[10] = copy[2];
    state[14] = copy[6];
    state[3]  = copy[15];
    state[7]  = copy[3];
    state[11] = copy[7];
    state[15] = copy[11];
    ct.zeroize(?copy[0], BLOCK_SIZE);
}

#[oblivious]
#[inline]
fun xtime(value: ^u8) ^u8 {
    val reduce: ^u8 = 0 - (value >> 7);
    ret (value << 1) ^ (0x1B & reduce);
}

#[oblivious]
fun mix_columns(state: *^u8) {
    var column: usize = 0;
    for (column < 4) {
        val offset: usize = column * 4;
        val a:      ^u8   = state[offset];
        val b:      ^u8   = state[offset + 1];
        val c:      ^u8   = state[offset + 2];
        val d:      ^u8   = state[offset + 3];
        val total:  ^u8   = a ^ b ^ c ^ d;
        state[offset]     = a ^ total ^ xtime(a ^ b);
        state[offset + 1] = b ^ total ^ xtime(b ^ c);
        state[offset + 2] = c ^ total ^ xtime(c ^ d);
        state[offset + 3] = d ^ total ^ xtime(d ^ a);
        column            = column + 1;
    }
}

#[oblivious]
pub fun encrypt(context: *Context, input: *^u8, output: *^u8) {
    var state: [16]^u8;
    var i:     usize = 0;
    for (i < BLOCK_SIZE) {
        state[i] = input[i];
        i        = i + 1;
    }
    add_round_key(context, ?state[0], 0);
    var round: usize = 1;
    for (round < context.rounds) {
        sub_bytes(?state[0]);
        shift_rows(?state[0]);
        mix_columns(?state[0]);
        add_round_key(context, ?state[0], round);
        round = round + 1;
    }
    sub_bytes(?state[0]);
    shift_rows(?state[0]);
    add_round_key(context, ?state[0], context.rounds);
    i = 0;
    for (i < BLOCK_SIZE) {
        output[i] = state[i];
        i         = i + 1;
    }
    ct.zeroize(?state[0], BLOCK_SIZE);
}

# the secret word multiply every field and ring shares
#
# a target that admits a constant-time low multiply of 64-bit secrets
# (briar-systems/mach#3497, queried with $mach.build.ct_mul) computes the product
# with that instruction. every other target keeps the masked sum over the
# multiplier's low bits. this is the one place that knows which (#83)

use std.types.size.usize;

# 1 where the build target computes secret products in hardware
pub val HARDWARE: u8 = $mach.build.ct_mul(low, 64);

# 1 where the build target computes the full 64 x 64 product in hardware: one
# widening instruction for the low half and one for the high half
pub val HARDWARE_WIDE: u8 = $mach.build.ct_mul(low, 128);

# 1 where the sum of two limbs would carry
#[oblivious]
#[inline]
pub fun carry_of(left: ^u64, right: ^u64, sum: ^u64) ^u64 {
    ret ((left & right) | ((left | right) & ~sum)) >> 63;
}

# 1 where left - right - borrow would borrow
#[oblivious]
#[inline]
pub fun borrow_of(left: ^u64, right: ^u64, difference: ^u64) ^u64 {
    ret ((~left & right) | ((~left | right) & difference)) >> 63;
}

# low 64 bits of left * right, for right below 2^bits
#[oblivious]
#[inline]
pub fun multiply(left: ^u64, right: ^u64, $bits: usize) ^u64 {
    $if (HARDWARE == 1) {
        val mask: u64 = 0xFFFFFFFFFFFFFFFF >> (64 - bits);
        ret left * (right & mask);
    }
    $or {
        ret serial_multiply(left, right, bits);
    }
}

# the bit-serial reference: a masked add per multiplier bit, on every target
#[oblivious]
pub fun serial_multiply(left: ^u64, right: ^u64, $bits: usize) ^u64 {
    var product:    ^u64  = 0;
    var shifted:    ^u64  = left;
    var multiplier: ^u64  = right;
    var i:          usize = 0;
    for (i < bits) {
        product    = product + (shifted & (0 - (multiplier & 1)));
        shifted    = shifted << 1;
        multiplier = multiplier >> 1;
        i          = i + 1;
    }
    shifted    = 0;
    multiplier = 0;
    ret product;
}

# the full 128-bit product left * right
#[oblivious]
#[inline]
pub fun multiply_wide(left: ^u64, right: ^u64) ^u128 {
    $if (HARDWARE_WIDE == 1) {
        ret (left::^u128) * (right::^u128);
    }
    $or {
        ret serial_multiply_wide(left, right);
    }
}

# the bit-serial reference for the full product, on every target
#[oblivious]
pub fun serial_multiply_wide(left: ^u64, right: ^u64) ^u128 {
    var product:    ^u128 = 0;
    var shifted:    ^u128 = left::^u128;
    var multiplier: ^u64  = right;
    var i:          usize = 0;
    for (i < 64) {
        product    = product + (shifted & (0 - (multiplier & 1)::^u128));
        shifted    = shifted << 1;
        multiplier = multiplier >> 1;
        i          = i + 1;
    }
    shifted    = 0;
    multiplier = 0;
    ret product;
}

test "word: products match exact values at 32 and 29 bits" {
    if (multiply(0, 0xFFFFFFFF, 32):>u64 != 0)                            { ret 1; }
    if (multiply(1, 0xFFFFFFFF, 32):>u64 != 0xFFFFFFFF)                   { ret 2; }
    if (multiply(0xFFFFFFFF, 0xFFFFFFFF, 32):>u64 != 0xFFFFFFFE00000001)  { ret 3; }
    if (multiply(0x80000000, 0x80000000, 32):>u64 != 0x4000000000000000)  { ret 4; }
    if (multiply(0xAAAAAAAA, 0x55555555, 32):>u64 != 0x38E38E3871C71C72)  { ret 5; }
    if (multiply(0x100000001, 0x100000001, 32):>u64 != 0x100000001)       { ret 6; }
    if (multiply(0x7FFFFFFFF, 0x1FFFFFFF, 29):>u64 != 0xFFFFFFF7E0000001) { ret 7; }
    if (multiply(0x3FFFFFF, 0x1FFFFFFB, 29):>u64 != 0x7FFFFFCC000005)     { ret 8; }
    if (multiply(0x12345678, 0x9ABCDEF, 29):>u64 != 0xB00EA4E242D208)     { ret 9; }
    ret 0;
}

test "word: wide products match exact values" {
    val all: u64 = 0xFFFFFFFFFFFFFFFF;
    if (multiply_wide(0, all):>u128 != 0)                                        { ret 1; }
    if (multiply_wide(1, all):>u128 != all::u128)                                { ret 2; }
    if (multiply_wide(all, all):>u128 != 0xFFFFFFFFFFFFFFFE0000000000000001u128) { ret 3; }
    if (multiply_wide(0x8000000000000000, 2):>u128 != (1u128 << 64))             { ret 4; }
    if (multiply_wide(0x123456789ABCDEF0, 0xFEDCBA9876543210):>u128 !=
        0x121FA00AD77D7422236D88FE5618CF00u128) { ret 5; }
    if ((multiply_wide(0x123456789ABCDEF0, 0xFEDCBA9876543210):>u128 >> 64)::u64 !=
        0x121FA00AD77D7422) { ret 6; }
    ret 0;
}

# the primitive differential: the selected path against the serial reference on
# edge words and a deterministic sweep. on a target without the hardware cell
# both sides are the serial path and the test still runs
test "word: the selected multiply agrees with the serial reference" {
    val edges: [12]u64 = [12]u64{
        0, 1, 2, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF, 0x100000000, 0x100000001,
        0x8000000000000000, 0xFFFFFFFFFFFFFFFF, 0xAAAAAAAAAAAAAAAA, 0x5555555555555555
    };
    var i: usize = 0;
    for (i < 12) {
        var j: usize = 0;
        for (j < 12) {
            val left:  ^u64 = edges[i];
            val right: ^u64 = edges[j];
            if (multiply(left, right, 32):>u64 != serial_multiply(left, right, 32):>u64)     { ret 1; }
            if (multiply(left, right, 29):>u64 != serial_multiply(left, right, 29):>u64)     { ret 2; }
            if (multiply(left, right, 64):>u64 != serial_multiply(left, right, 64):>u64)     { ret 3; }
            if (multiply_wide(left, right):>u128 != serial_multiply_wide(left, right):>u128) { ret 4; }
            j = j + 1;
        }
        i = i + 1;
    }
    var state: u64 = 0x9E3779B97F4A7C15;
    i = 0;
    for (i < 4096) {
        state = state * 6364136223846793005 + 1442695040888963407;
        val left: ^u64 = state;
        state = state * 6364136223846793005 + 1442695040888963407;
        val right: ^u64 = state;
        if (multiply(left, right, 32):>u64 != serial_multiply(left, right, 32):>u64)     { ret 7; }
        if (multiply(left, right, 64):>u64 != serial_multiply(left, right, 64):>u64)     { ret 5; }
        if (multiply_wide(left, right):>u128 != serial_multiply_wide(left, right):>u128) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

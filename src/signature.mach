# signatures needed by tls certificates and handshakes

use crypto.contracts;
use crypto.internal.hmac;
use core: crypto.internal.p256;
use crypto.internal.sha2;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def Algorithm: u16;

pub val ECDSA_P256_SHA256: Algorithm = 0x0403;
pub val ED25519:           Algorithm = 0x0807;
pub val RSA_PSS_RSAE_SHA256: Algorithm = 0x0804;
pub val RSA_PSS_RSAE_SHA384: Algorithm = 0x0805;

pub val ECDSA_P256_PRIVATE_KEY_SIZE: usize = 32;
pub val ECDSA_P256_PUBLIC_KEY_SIZE: usize = 65;
pub val ECDSA_P256_SIGNATURE_MIN_SIZE: usize = 8;
pub val ECDSA_P256_SIGNATURE_MAX_SIZE: usize = 72;

# verification returns auth_failed for an invalid signature
pub def VerifyFun: fun(contracts.Bytes, contracts.Bytes, contracts.Bytes) contracts.Error;

# signing writes a wire-format signature with explicit capacity
pub def SignFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Buffer) contracts.Operation;

rec NonceState {
    key:   [32]^u8;
    value: [32]^u8;
}

fun failed(error: contracts.Error) contracts.Operation {
    ret contracts.Operation{error: error, written: 0};
}

#[oblivious]
fun destroy_nonce(state: *NonceState) {
    ct.zeroize(?state.key[0], 32);
    ct.zeroize(?state.value[0], 32);
}

#[oblivious]
fun hash_message(message: contracts.Bytes, digest: *^u8) contracts.Error {
    var state: sha2.State256;
    sha2.init256(?state);
    if (!sha2.update256_public(?state, message.data, message.len)) {
        sha2.destroy256(?state);
        ret contracts.INVALID_INPUT;
    }
    sha2.final256(?state, digest);
    sha2.destroy256(?state);
    ret contracts.OK;
}

#[oblivious]
fun hmac_one(output: *^u8, key: *^u8, first: *^u8,
    first_len: usize) contracts.Error {
    var context: hmac.Context256;
    var status: contracts.Error = hmac.init256(?context,
        contracts.SecretBytes{data: key, len: 32});
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, first, first_len);
    }
    if (status == contracts.OK) {
        status = hmac.final256(?context, output);
    } or {
        hmac.destroy256(?context);
    }
    ret status;
}

#[oblivious]
fun hmac_two(output: *^u8, key: *^u8, first: *^u8, first_len: usize,
    second: *^u8, second_len: usize) contracts.Error {
    var context: hmac.Context256;
    var status: contracts.Error = hmac.init256(?context,
        contracts.SecretBytes{data: key, len: 32});
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, first, first_len);
    }
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, second, second_len);
    }
    if (status == contracts.OK) {
        status = hmac.final256(?context, output);
    } or {
        hmac.destroy256(?context);
    }
    ret status;
}

#[oblivious]
fun hmac_four(output: *^u8, key: *^u8,
    first: *^u8, first_len: usize, second: *^u8, second_len: usize,
    third: *^u8, third_len: usize, fourth: *^u8,
    fourth_len: usize) contracts.Error {
    var context: hmac.Context256;
    var status: contracts.Error = hmac.init256(?context,
        contracts.SecretBytes{data: key, len: 32});
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, first, first_len);
    }
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, second, second_len);
    }
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, third, third_len);
    }
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, fourth, fourth_len);
    }
    if (status == contracts.OK) {
        status = hmac.final256(?context, output);
    } or {
        hmac.destroy256(?context);
    }
    ret status;
}

#[oblivious]
fun nonce_init(state: *NonceState, private_key: *^u8,
    digest: *^u8) contracts.Error {
    var reduced_hash: core.UInt;
    var encoded_hash: [32]^u8;
    var prefix: [1]^u8;
    core.decode_secret(?reduced_hash, digest);
    core.reduce_scalar_once(?reduced_hash);
    core.encode_secret(?encoded_hash[0], ?reduced_hash);
    ct.zeroize(?state.key[0], 32);
    var i: usize = 0;
    for (i < 32) {
        state.value[i] = 1;
        i = i + 1;
    }
    prefix[0] = 0;
    var status: contracts.Error = hmac_four(?state.key[0], ?state.key[0],
        ?state.value[0], 32, ?prefix[0], 1, private_key, 32,
        ?encoded_hash[0], 32);
    if (status == contracts.OK) {
        status = hmac_one(?state.value[0], ?state.key[0], ?state.value[0], 32);
    }
    prefix[0] = 1;
    if (status == contracts.OK) {
        status = hmac_four(?state.key[0], ?state.key[0], ?state.value[0], 32,
            ?prefix[0], 1, private_key, 32, ?encoded_hash[0], 32);
    }
    if (status == contracts.OK) {
        status = hmac_one(?state.value[0], ?state.key[0], ?state.value[0], 32);
    }
    prefix[0] = 0;
    core.destroy_uint(?reduced_hash);
    ct.zeroize(?encoded_hash[0], 32);
    ct.zeroize(?prefix[0], 1);
    if (status != contracts.OK) { destroy_nonce(state); }
    ret status;
}

#[oblivious]
fun nonce_advance(state: *NonceState) contracts.Error {
    var prefix: [1]^u8;
    prefix[0] = 0;
    var status: contracts.Error = hmac_two(?state.key[0], ?state.key[0],
        ?state.value[0], 32, ?prefix[0], 1);
    if (status == contracts.OK) {
        status = hmac_one(?state.value[0], ?state.key[0], ?state.value[0], 32);
    }
    ct.zeroize(?prefix[0], 1);
    ret status;
}

#[oblivious]
fun nonce_next(state: *NonceState, nonce: *core.UInt) contracts.Error {
    val status: contracts.Error = hmac_one(?state.value[0], ?state.key[0],
        ?state.value[0], 32);
    if (status != contracts.OK) { ret status; }
    core.decode_secret(nonce, ?state.value[0]);
    ret contracts.OK;
}

fun der_integer_length(encoded: *^u8) usize {
    var first: usize = 0;
    for (first < 31 && encoded[first]:^ == 0) {
        first = first + 1;
    }
    var prefix: usize = 0;
    if ((encoded[first]:^ & 0x80) != 0) { prefix = 1; }
    ret 32 - first + prefix;
}

fun write_der_integer(output: *^u8, offset: usize, encoded: *^u8) usize {
    var first: usize = 0;
    for (first < 31 && encoded[first]:^ == 0) {
        first = first + 1;
    }
    var prefix: usize = 0;
    if ((encoded[first]:^ & 0x80) != 0) { prefix = 1; }
    val length: usize = 32 - first + prefix;
    output[offset] = 0x02;
    output[offset + 1] = length::u8;
    var position: usize = offset + 2;
    if (prefix == 1) {
        output[position] = 0;
        position = position + 1;
    }
    var i: usize = first;
    for (i < 32) {
        output[position] = encoded[i];
        position = position + 1;
        i = i + 1;
    }
    ret position;
}

#[oblivious]
fun encode_signature(output: *^u8, r: *core.UInt, s: *core.UInt) usize {
    var r_encoded: [32]^u8;
    var s_encoded: [32]^u8;
    core.encode_secret(?r_encoded[0], r);
    core.encode_secret(?s_encoded[0], s);
    val r_length: usize = der_integer_length(?r_encoded[0]);
    val s_length: usize = der_integer_length(?s_encoded[0]);
    output[0] = 0x30;
    output[1] = (4 + r_length + s_length)::u8;
    val next: usize = write_der_integer(output, 2, ?r_encoded[0]);
    val end: usize = write_der_integer(output, next, ?s_encoded[0]);
    ct.zeroize(?r_encoded[0], 32);
    ct.zeroize(?s_encoded[0], 32);
    ret end;
}

fun parse_der_integer(output: *core.UInt, input: *u8, offset: usize,
    length: usize) bool {
    if (length == 0 || length > 33) { ret false; }
    if ((input[offset] & 0x80) != 0) { ret false; }
    if (length > 1 && input[offset] == 0 && (input[offset + 1] & 0x80) == 0) {
        ret false;
    }
    if (length == 33 && input[offset] != 0) { ret false; }
    var encoded: [32]u8;
    var i: usize = 0;
    for (i < 32) {
        encoded[i] = 0;
        i = i + 1;
    }
    var skip: usize = 0;
    if (length == 33) { skip = 1; }
    val significant: usize = length - skip;
    i = 0;
    for (i < significant) {
        encoded[32 - significant + i] = input[offset + skip + i];
        i = i + 1;
    }
    core.decode_public(output, ?encoded[0], 0);
    ret true;
}

fun parse_signature(r: *core.UInt, s: *core.UInt,
    signature: contracts.Bytes) bool {
    if (signature.len < 8 || signature.len > ECDSA_P256_SIGNATURE_MAX_SIZE) {
        ret false;
    }
    if (signature.data[0] != 0x30 || signature.data[1]::usize != signature.len - 2) {
        ret false;
    }
    if (signature.data[2] != 0x02) { ret false; }
    val r_length: usize = signature.data[3]::usize;
    if (r_length == 0 || r_length > 33) { ret false; }
    val s_tag: usize = 4 + r_length;
    if (s_tag + 2 > signature.len || signature.data[s_tag] != 0x02) { ret false; }
    val s_length: usize = signature.data[s_tag + 1]::usize;
    if (s_tag + 2 + s_length != signature.len) { ret false; }
    if (!parse_der_integer(r, signature.data, 4, r_length)) { ret false; }
    if (!parse_der_integer(s, signature.data, s_tag + 2, s_length)) { ret false; }
    ret true;
}

# sign sha-256(message) with a canonical p-256 scalar and rfc 6979 nonce
#
# the signature is strict der. all failures leave output unchanged.
#[oblivious]
pub fun sign_ecdsa_p256_sha256(private_key: contracts.SecretBytes,
    message: contracts.Bytes, output: contracts.Buffer) contracts.Operation {
    if (private_key.len != ECDSA_P256_PRIVATE_KEY_SIZE) {
        ret failed(contracts.INVALID_KEY);
    }
    if (private_key.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (message.len != 0 && message.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (output.capacity < ECDSA_P256_SIGNATURE_MIN_SIZE) {
        ret failed(contracts.OUTPUT_TOO_SMALL);
    }
    if (output.data == nil) { ret failed(contracts.INVALID_INPUT); }

    ct.begin();
    var private_scalar: core.UInt;
    core.decode_secret(?private_scalar, private_key.data);
    val private_valid: ^u8 = core.valid_scalar(?private_scalar);
    if (private_valid:^ != 1) {
        core.destroy_uint(?private_scalar);
        ct.end();
        ret failed(contracts.INVALID_KEY);
    }
    var digest: [32]^u8;
    var status: contracts.Error = hash_message(message, ?digest[0]);
    if (status != contracts.OK) {
        core.destroy_uint(?private_scalar);
        ct.zeroize(?digest[0], 32);
        ct.end();
        ret failed(status);
    }
    var hash_scalar: core.UInt;
    core.decode_secret(?hash_scalar, ?digest[0]);
    core.reduce_scalar_once(?hash_scalar);
    var nonce_state: NonceState;
    status = nonce_init(?nonce_state, private_key.data, ?digest[0]);
    ct.zeroize(?digest[0], 32);
    if (status != contracts.OK) {
        core.destroy_uint(?private_scalar);
        core.destroy_uint(?hash_scalar);
        ct.end();
        ret failed(status);
    }

    var r: core.UInt;
    var s: core.UInt;
    var nonce: core.UInt;
    var basepoint: core.Point;
    var nonce_point: core.Point;
    var x: core.UInt;
    var y: core.UInt;
    var product: core.UInt;
    var sum: core.UInt;
    var inverse: core.UInt;
    core.generator(?basepoint);
    var complete: bool = false;
    for (!complete) {
        status = nonce_next(?nonce_state, ?nonce);
        if (status != contracts.OK) { complete = true; }
        or {
            val nonce_valid: ^u8 = core.valid_scalar(?nonce);
            if (nonce_valid:^ == 1) {
                core.scalar_multiply(?nonce_point, ?nonce, ?basepoint);
                core.to_affine(?x, ?y, ?nonce_point);
                core.copy(?r, ?x);
                core.reduce_scalar_once(?r);
                core.scalar_multiply_values(?product, ?r, ?private_scalar);
                core.scalar_add(?sum, ?hash_scalar, ?product);
                core.scalar_inverse(?inverse, ?nonce);
                core.scalar_multiply_values(?s, ?inverse, ?sum);
                val usable: ^u8 = (core.is_zero(?r) | core.is_zero(?s)) ^ 1;
                if (usable:^ == 1) { complete = true; }
                or { status = nonce_advance(?nonce_state); }
            } or {
                status = nonce_advance(?nonce_state);
            }
        }
    }

    var encoded: [72]^u8;
    ct.zeroize(?encoded[0], 72);
    var written: usize = 0;
    if (status == contracts.OK) {
        written = encode_signature(?encoded[0], ?r, ?s);
        if (output.capacity < written) { status = contracts.OUTPUT_TOO_SMALL; }
    }
    if (status == contracts.OK) {
        var i: usize = 0;
        for (i < written) {
            output.data[i] = encoded[i]:^;
            i = i + 1;
        }
    } or {
        written = 0;
    }
    ct.zeroize(?encoded[0], 72);
    destroy_nonce(?nonce_state);
    core.destroy_uint(?private_scalar);
    core.destroy_uint(?hash_scalar);
    core.destroy_uint(?r);
    core.destroy_uint(?s);
    core.destroy_uint(?nonce);
    core.destroy_point(?basepoint);
    core.destroy_point(?nonce_point);
    core.destroy_uint(?x);
    core.destroy_uint(?y);
    core.destroy_uint(?product);
    core.destroy_uint(?sum);
    core.destroy_uint(?inverse);
    ct.end();
    ret contracts.Operation{error: status, written: written};
}

# verify a strict der p-256 signature over sha-256(message)
#[oblivious]
pub fun verify_ecdsa_p256_sha256(public_key: contracts.Bytes,
    message: contracts.Bytes, signature: contracts.Bytes) contracts.Error {
    if (public_key.len != ECDSA_P256_PUBLIC_KEY_SIZE) { ret contracts.INVALID_KEY; }
    if (public_key.data == nil) { ret contracts.INVALID_INPUT; }
    if (public_key.data[0] != 0x04) { ret contracts.INVALID_KEY; }
    if (message.len != 0 && message.data == nil) { ret contracts.INVALID_INPUT; }
    if (signature.len != 0 && signature.data == nil) { ret contracts.INVALID_INPUT; }

    ct.begin();
    var peer: core.Point;
    val point_valid: ^u8 = core.parse_point(?peer, public_key.data);
    if (point_valid:^ != 1) {
        core.destroy_point(?peer);
        ct.end();
        ret contracts.INVALID_KEY;
    }
    var r: core.UInt;
    var s: core.UInt;
    if (!parse_signature(?r, ?s, signature)) {
        core.destroy_point(?peer);
        core.destroy_uint(?r);
        core.destroy_uint(?s);
        ct.end();
        ret contracts.AUTH_FAILED;
    }
    val r_valid: ^u8 = core.valid_scalar(?r);
    val s_valid: ^u8 = core.valid_scalar(?s);
    if ((r_valid & s_valid):^ != 1) {
        core.destroy_point(?peer);
        core.destroy_uint(?r);
        core.destroy_uint(?s);
        ct.end();
        ret contracts.AUTH_FAILED;
    }
    var digest: [32]^u8;
    val hash_status: contracts.Error = hash_message(message, ?digest[0]);
    if (hash_status != contracts.OK) {
        core.destroy_point(?peer);
        core.destroy_uint(?r);
        core.destroy_uint(?s);
        ct.zeroize(?digest[0], 32);
        ct.end();
        ret hash_status;
    }
    var hash_scalar: core.UInt;
    var inverse: core.UInt;
    var u1: core.UInt;
    var u2: core.UInt;
    var basepoint: core.Point;
    var first: core.Point;
    var second: core.Point;
    var sum: core.Point;
    var x: core.UInt;
    var y: core.UInt;
    core.decode_secret(?hash_scalar, ?digest[0]);
    core.reduce_scalar_once(?hash_scalar);
    ct.zeroize(?digest[0], 32);
    core.scalar_inverse(?inverse, ?s);
    core.scalar_multiply_values(?u1, ?hash_scalar, ?inverse);
    core.scalar_multiply_values(?u2, ?r, ?inverse);
    core.generator(?basepoint);
    core.scalar_multiply(?first, ?u1, ?basepoint);
    core.scalar_multiply(?second, ?u2, ?peer);
    core.point_add(?sum, ?first, ?second);
    val infinity: ^u8 = core.point_is_infinity(?sum);
    core.to_affine(?x, ?y, ?sum);
    core.reduce_scalar_once(?x);
    val matches: ^u8 = core.equal(?x, ?r) & (infinity ^ 1);
    var result: contracts.Error = contracts.AUTH_FAILED;
    if (matches:^ == 1) { result = contracts.OK; }
    core.destroy_point(?peer);
    core.destroy_uint(?r);
    core.destroy_uint(?s);
    core.destroy_uint(?hash_scalar);
    core.destroy_uint(?inverse);
    core.destroy_uint(?u1);
    core.destroy_uint(?u2);
    core.destroy_point(?basepoint);
    core.destroy_point(?first);
    core.destroy_point(?second);
    core.destroy_point(?sum);
    core.destroy_uint(?x);
    core.destroy_uint(?y);
    ct.end();
    ret result;
}

test "signature: algorithm ids match the tls registry" {
    if (ECDSA_P256_SHA256 != 0x0403) { ret 1; }
    if (ED25519 != 0x0807) { ret 1; }
    if (RSA_PSS_RSAE_SHA256 != 0x0804) { ret 1; }
    ret 0;
}

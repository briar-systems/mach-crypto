# signatures needed by tls certificates and handshakes

use crypto.contracts;
use ed: crypto.internal.ed25519;
use crypto.internal.hmac;
use crypto.internal.lift;
use core: crypto.internal.p256;
use crypto.internal.p384;
use crypto.internal.rsa;
use std.crypto.ct;
use std.crypto.hash.sha256;
use std.crypto.hash.sha512;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def Algorithm: u16;

pub val ECDSA_P256_SHA256:   Algorithm = 0x0403;
pub val ECDSA_P384_SHA384:   Algorithm = 0x0503;
pub val ED25519:             Algorithm = 0x0807;
pub val RSA_PKCS1_SHA256:    Algorithm = 0x0401;
pub val RSA_PKCS1_SHA384:    Algorithm = 0x0501;
pub val RSA_PSS_RSAE_SHA256: Algorithm = 0x0804;
pub val RSA_PSS_RSAE_SHA384: Algorithm = 0x0805;

pub fun algorithm_status(algorithm: Algorithm) contracts.Error {
    if (algorithm == ECDSA_P256_SHA256 || algorithm == ECDSA_P384_SHA384 ||
        algorithm == ED25519 ||
        algorithm == RSA_PKCS1_SHA256 || algorithm == RSA_PKCS1_SHA384 ||
        algorithm == RSA_PSS_RSAE_SHA256 || algorithm == RSA_PSS_RSAE_SHA384) {
        ret contracts.OK;
    }
    ret contracts.UNSUPPORTED;
}

pub val ECDSA_P256_PRIVATE_KEY_SIZE:   usize = 32;
pub val ECDSA_P256_PUBLIC_KEY_SIZE:    usize = 65;
pub val ECDSA_P256_SIGNATURE_MIN_SIZE: usize = 8;
pub val ECDSA_P256_SIGNATURE_MAX_SIZE: usize = 72;

pub val ECDSA_P384_PUBLIC_KEY_SIZE:    usize = 97;
pub val ECDSA_P384_SIGNATURE_MIN_SIZE: usize = 8;
pub val ECDSA_P384_SIGNATURE_MAX_SIZE: usize = 104;

pub val ED25519_PRIVATE_KEY_SIZE: usize = 32;
pub val ED25519_PUBLIC_KEY_SIZE:  usize = 32;
pub val ED25519_SIGNATURE_SIZE:   usize = 64;

pub val RSA_MIN_MODULUS_SIZE:     usize = rsa.MIN_MODULUS_BYTES;
pub val RSA_MAX_MODULUS_SIZE:     usize = rsa.MAX_MODULUS_BYTES;
pub val RSA_PSS_SHA256_SALT_SIZE: usize = 32;
pub val RSA_PSS_SHA384_SALT_SIZE: usize = 48;

val RSA_PKCS1_DIGEST_INFO_PREFIX_SIZE: usize = 19;

val RSA_PKCS1_SHA256_DIGEST_INFO: [19]u8 = [19]u8{
    0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86,
    0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05,
    0x00, 0x04, 0x20
};

val RSA_PKCS1_SHA384_DIGEST_INFO: [19]u8 = [19]u8{
    0x30, 0x41, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86,
    0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02, 0x05,
    0x00, 0x04, 0x30
};

pub rec RsaPublicKey {
    modulus:  contracts.Bytes;
    exponent: contracts.Bytes;
}

pub rec RsaPrivateKey {
    modulus:          contracts.Bytes;
    public_exponent:  contracts.Bytes;
    private_exponent: contracts.SecretBytes;
}

# verification returns auth_failed for an invalid signature
pub def VerifyFun: fun(contracts.Bytes, contracts.Bytes, contracts.Bytes) contracts.Error;

# signing writes a wire-format signature with explicit capacity
pub def SignFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Buffer) contracts.Operation;

rec NonceState {
    key:   [32]^u8;
    value: [32]^u8;
}

fun failed(error: contracts.Error) contracts.Operation {
    ret contracts.Operation{error: error, written: 0};
}

#[oblivious]
fun hash512_secret(input: *^u8, len: usize, digest: *^u8) contracts.Error {
    var state: sha512.SecretState512 = sha512.init_secret512();
    if (!lift.update512_secret(?state, input, len)) {
        sha512.destroy_secret512(?state);
        ret contracts.INVALID_INPUT;
    }
    sha512.final_secret512(?state, digest);
    sha512.destroy_secret512(?state);
    ret contracts.OK;
}

#[oblivious]
fun hash512_secret_public(secret: *^u8, secret_len: usize,
    public: contracts.Bytes, digest: *^u8) contracts.Error {
    var state: sha512.SecretState512 = sha512.init_secret512();
    if (!lift.update512_secret(?state, secret, secret_len) ||
        !lift.update512_public(?state, public.data, public.len)) {
        sha512.destroy_secret512(?state);
        ret contracts.INVALID_INPUT;
    }
    sha512.final_secret512(?state, digest);
    sha512.destroy_secret512(?state);
    ret contracts.OK;
}

#[oblivious]
fun hash512_two_secret_public(first: *^u8, second: *^u8,
    public: contracts.Bytes, digest: *^u8) contracts.Error {
    var state: sha512.SecretState512 = sha512.init_secret512();
    if (!lift.update512_secret(?state, first, 32) ||
        !lift.update512_secret(?state, second, 32) ||
        !lift.update512_public(?state, public.data, public.len)) {
        sha512.destroy_secret512(?state);
        ret contracts.INVALID_INPUT;
    }
    sha512.final_secret512(?state, digest);
    sha512.destroy_secret512(?state);
    ret contracts.OK;
}

#[oblivious]
fun ed25519_expand(seed: contracts.SecretBytes, expanded: *^u8,
    scalar: *ed.Scalar) contracts.Error {
    val status: contracts.Error = hash512_secret(seed.data, seed.len, expanded);
    if (status != contracts.OK) { ret status; }
    expanded[0]  = expanded[0] & 248;
    expanded[31] = (expanded[31] & 63) | 64;
    ed.scalar_reduce_secret(scalar, expanded, 32);
    ret contracts.OK;
}

# derive the rfc 8032 public key from a 32-byte private seed
#[oblivious]
pub fun derive_ed25519_public(private_key: contracts.SecretBytes,
    output: contracts.Buffer) contracts.Operation {
    if (private_key.len != ED25519_PRIVATE_KEY_SIZE) { ret failed(contracts.INVALID_KEY); }
    if (private_key.data == nil)                     { ret failed(contracts.INVALID_INPUT); }
    if (output.capacity < ED25519_PUBLIC_KEY_SIZE) {
        ret failed(contracts.OUTPUT_TOO_SMALL);
    }
    if (output.data == nil) { ret failed(contracts.INVALID_INPUT); }
    ct.begin();
    var expanded:     [64]^u8;
    var scalar:       ed.Scalar;
    var public_point: ed.Point;
    ct.zeroize(?expanded[0], 64);
    val status: contracts.Error = ed25519_expand(private_key, ?expanded[0], ?scalar);
    if (status == contracts.OK) {
        ed.scalar_multiply_base(?public_point, ?scalar);
        ed.point_encode_public(output.data, ?public_point);
    }
    ct.zeroize(?expanded[0], 64);
    ed.destroy_scalar(?scalar);
    ed.destroy_point(?public_point);
    ct.end();
    if (status != contracts.OK) { ret failed(status); }
    ret contracts.Operation{error: contracts.OK, written: ED25519_PUBLIC_KEY_SIZE};
}

# sign the exact message with rfc 8032 ed25519
#[oblivious]
pub fun sign_ed25519(private_key: contracts.SecretBytes, message: contracts.Bytes,
    output: contracts.Buffer) contracts.Operation {
    if (private_key.len != ED25519_PRIVATE_KEY_SIZE) { ret failed(contracts.INVALID_KEY); }
    if (private_key.data == nil)                     { ret failed(contracts.INVALID_INPUT); }
    if (message.len != 0 && message.data == nil)     { ret failed(contracts.INVALID_INPUT); }
    if (output.capacity < ED25519_SIGNATURE_SIZE)    { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (output.data == nil)                          { ret failed(contracts.INVALID_INPUT); }

    ct.begin();
    var expanded:        [64]^u8;
    var prefix:          [32]^u8;
    var public_encoded:  [32]^u8;
    var r_encoded:       [32]^u8;
    var s_encoded:       [32]^u8;
    var digest:          [64]^u8;
    var signature_bytes: [64]^u8;
    ct.zeroize(?expanded[0], 64);
    ct.zeroize(?prefix[0], 32);
    ct.zeroize(?public_encoded[0], 32);
    ct.zeroize(?r_encoded[0], 32);
    ct.zeroize(?s_encoded[0], 32);
    ct.zeroize(?digest[0], 64);
    ct.zeroize(?signature_bytes[0], 64);
    var private_scalar: ed.Scalar;
    var nonce:          ed.Scalar;
    var challenge:      ed.Scalar;
    var product:        ed.Scalar;
    var response:       ed.Scalar;
    var public_point:   ed.Point;
    var nonce_point:    ed.Point;
    var status:         contracts.Error = ed25519_expand(private_key, ?expanded[0],
        ?private_scalar);
    if (status == contracts.OK) {
        var i: usize = 0;
        for (i < 32) {
            prefix[i] = expanded[32 + i];
            i         = i + 1;
        }
        ed.scalar_multiply_base(?public_point, ?private_scalar);
        ed.point_encode_signature(?public_encoded[0], ?public_point);
        status = hash512_secret_public(?prefix[0], 32, message, ?digest[0]);
    }
    if (status == contracts.OK) {
        ed.scalar_reduce_secret(?nonce, ?digest[0], 64);
        ed.scalar_multiply_base(?nonce_point, ?nonce);
        ed.point_encode_signature(?r_encoded[0], ?nonce_point);
        status = hash512_two_secret_public(?r_encoded[0], ?public_encoded[0],
            message, ?digest[0]);
    }
    if (status == contracts.OK) {
        ed.scalar_reduce_secret(?challenge, ?digest[0], 64);
        ed.scalar_multiply_values(?product, ?challenge, ?private_scalar);
        ed.scalar_add(?response, ?nonce, ?product);
        ed.scalar_encode_secret(?s_encoded[0], ?response);
        var i: usize = 0;
        for (i < 32) {
            signature_bytes[i]      = r_encoded[i];
            signature_bytes[32 + i] = s_encoded[i];
            i                       = i + 1;
        }
        i = 0;
        for (i < ED25519_SIGNATURE_SIZE) {
            output.data[i] = signature_bytes[i]:>u8;
            i              = i + 1;
        }
    }
    ct.zeroize(?expanded[0], 64);
    ct.zeroize(?prefix[0], 32);
    ct.zeroize(?public_encoded[0], 32);
    ct.zeroize(?r_encoded[0], 32);
    ct.zeroize(?s_encoded[0], 32);
    ct.zeroize(?digest[0], 64);
    ct.zeroize(?signature_bytes[0], 64);
    ed.destroy_scalar(?private_scalar);
    ed.destroy_scalar(?nonce);
    ed.destroy_scalar(?challenge);
    ed.destroy_scalar(?product);
    ed.destroy_scalar(?response);
    ed.destroy_point(?public_point);
    ed.destroy_point(?nonce_point);
    ct.end();
    if (status != contracts.OK) { ret failed(status); }
    ret contracts.Operation{error: contracts.OK, written: ED25519_SIGNATURE_SIZE};
}

# verify strict prime-subgroup rfc 8032 ed25519
#[oblivious]
pub fun verify_ed25519(public_key: contracts.Bytes, message: contracts.Bytes,
    signature_bytes: contracts.Bytes) contracts.Error {
    if (public_key.len != ED25519_PUBLIC_KEY_SIZE)     { ret contracts.INVALID_KEY; }
    if (public_key.data == nil)                        { ret contracts.INVALID_INPUT; }
    if (message.len != 0 && message.data == nil)       { ret contracts.INVALID_INPUT; }
    if (signature_bytes.len != ED25519_SIGNATURE_SIZE) { ret contracts.AUTH_FAILED; }
    if (signature_bytes.data == nil)                   { ret contracts.INVALID_INPUT; }

    ct.begin();
    var public_point:   ed.Point;
    var nonce_point:    ed.Point;
    var order:          ed.Scalar;
    var subgroup:       ed.Point;
    val public_decoded: ^u8 = ed.point_decode(?public_point, public_key.data);
    ed.order_scalar(?order);
    ed.scalar_multiply(?subgroup, ?order, ?public_point);
    val public_subgroup: ^u8 = ed.point_is_identity(?subgroup) &
        (ed.point_is_identity(?public_point) ^ 1);
    if ((public_decoded & public_subgroup):>u8 != 1) {
        ed.destroy_point(?public_point);
        ed.destroy_point(?nonce_point);
        ed.destroy_scalar(?order);
        ed.destroy_point(?subgroup);
        ct.end();
        ret contracts.INVALID_KEY;
    }
    val nonce_decoded: ^u8 = ed.point_decode(?nonce_point, signature_bytes.data);
    ed.scalar_multiply(?subgroup, ?order, ?nonce_point);
    val nonce_subgroup: ^u8 = ed.point_is_identity(?subgroup) &
        (ed.point_is_identity(?nonce_point) ^ 1);
    var response: ed.Scalar;
    ed.scalar_decode_public(?response, signature_bytes.data, 32);
    val response_valid: ^u8 = ed.scalar_valid(?response);
    if ((nonce_decoded & nonce_subgroup & response_valid):>u8 != 1) {
        ed.destroy_point(?public_point);
        ed.destroy_point(?nonce_point);
        ed.destroy_scalar(?order);
        ed.destroy_point(?subgroup);
        ed.destroy_scalar(?response);
        ct.end();
        ret contracts.AUTH_FAILED;
    }
    var r_secret:      [32]^u8;
    var public_secret: [32]^u8;
    var digest:        [64]^u8;
    ct.zeroize(?r_secret[0], 32);
    ct.zeroize(?public_secret[0], 32);
    ct.zeroize(?digest[0], 64);
    var i: usize = 0;
    for (i < 32) {
        r_secret[i]      = signature_bytes.data[i];
        public_secret[i] = public_key.data[i];
        i                = i + 1;
    }
    val hash_status: contracts.Error = hash512_two_secret_public(?r_secret[0],
        ?public_secret[0], message, ?digest[0]);
    if (hash_status != contracts.OK) {
        ct.zeroize(?r_secret[0], 32);
        ct.zeroize(?public_secret[0], 32);
        ct.zeroize(?digest[0], 64);
        ed.destroy_point(?public_point);
        ed.destroy_point(?nonce_point);
        ed.destroy_scalar(?order);
        ed.destroy_point(?subgroup);
        ed.destroy_scalar(?response);
        ct.end();
        ret hash_status;
    }
    var challenge:     ed.Scalar;
    var left:          ed.Point;
    var product_point: ed.Point;
    var right:         ed.Point;
    var left_encoded:  [32]^u8;
    var right_encoded: [32]^u8;
    ed.scalar_reduce_secret(?challenge, ?digest[0], 64);
    ed.scalar_multiply_base(?left, ?response);
    ed.scalar_multiply(?product_point, ?challenge, ?public_point);
    ed.point_add(?right, ?nonce_point, ?product_point);
    ed.point_encode_signature(?left_encoded[0], ?left);
    ed.point_encode_signature(?right_encoded[0], ?right);
    val matches: ^u8             = ct.eq_bytes(?left_encoded[0], ?right_encoded[0], 32);
    var result:  contracts.Error = contracts.AUTH_FAILED;
    if (matches:>u8 == 1) { result = contracts.OK; }
    ct.zeroize(?r_secret[0], 32);
    ct.zeroize(?public_secret[0], 32);
    ct.zeroize(?digest[0], 64);
    ct.zeroize(?left_encoded[0], 32);
    ct.zeroize(?right_encoded[0], 32);
    ed.destroy_point(?public_point);
    ed.destroy_point(?nonce_point);
    ed.destroy_scalar(?order);
    ed.destroy_point(?subgroup);
    ed.destroy_scalar(?response);
    ed.destroy_scalar(?challenge);
    ed.destroy_point(?left);
    ed.destroy_point(?product_point);
    ed.destroy_point(?right);
    ct.end();
    ret result;
}

fun valid_rsa_public(key: RsaPublicKey) bool {
    if (!rsa.valid_modulus(key.modulus.data, key.modulus.len)) { ret false; }
    ret rsa.valid_exponent(key.exponent.data, key.exponent.len,
        key.modulus.data, key.modulus.len);
}

fun valid_rsa_private(key: RsaPrivateKey) bool {
    if (!rsa.valid_modulus(key.modulus.data, key.modulus.len)) { ret false; }
    if (!rsa.valid_exponent(key.public_exponent.data, key.public_exponent.len,
        key.modulus.data, key.modulus.len)) { ret false; }
    if (key.private_exponent.data == nil ||
        key.private_exponent.len != key.modulus.len) { ret false; }
    ret true;
}

#[oblivious]
fun rsa_hash_message(output: *^u8, message: contracts.Bytes,
    sha384: bool) contracts.Error {
    if (sha384) {
        var state384: sha512.SecretState384;
        state384 = sha512.init_secret384();
        if (!lift.update384_public(?state384, message.data, message.len)) {
            sha512.destroy_secret384(?state384);
            ret contracts.INVALID_INPUT;
        }
        sha512.final_secret384(?state384, output);
        sha512.destroy_secret384(?state384);
        ret contracts.OK;
    }
    ret hash_message(message, output);
}

#[oblivious]
fun pss_hash_prime(output: *^u8, message_hash: *^u8, salt: *^u8,
    hash_len: usize, sha384: bool) contracts.Error {
    var zeros: [8]^u8;
    ct.zeroize(?zeros[0], 8);
    if (sha384) {
        var state384: sha512.SecretState384;
        state384 = sha512.init_secret384();
        if (!lift.update384_secret(?state384, ?zeros[0], 8) ||
            !lift.update384_secret(?state384, message_hash, hash_len) ||
            !lift.update384_secret(?state384, salt, hash_len)) {
            sha512.destroy_secret384(?state384);
            ct.zeroize(?zeros[0], 8);
            ret contracts.INVALID_INPUT;
        }
        sha512.final_secret384(?state384, output);
        sha512.destroy_secret384(?state384);
    }
    or {
        var state256: sha256.SecretState;
        state256 = sha256.init_secret();
        if (!lift.update256_secret(?state256, ?zeros[0], 8) ||
            !lift.update256_secret(?state256, message_hash, hash_len) ||
            !lift.update256_secret(?state256, salt, hash_len)) {
            sha256.destroy_secret(?state256);
            ct.zeroize(?zeros[0], 8);
            ret contracts.INVALID_INPUT;
        }
        sha256.final_secret(?state256, output);
        sha256.destroy_secret(?state256);
    }
    ct.zeroize(?zeros[0], 8);
    ret contracts.OK;
}

#[oblivious]
fun pss_mgf1(output: *^u8, output_len: usize, seed: *^u8,
    hash_len: usize, sha384: bool) contracts.Error {
    var digest:  [48]^u8;
    var counter: [4]^u8;
    ct.zeroize(?digest[0], 48);
    ct.zeroize(?counter[0], 4);
    var generated: usize           = 0;
    var block:     usize           = 0;
    var status:    contracts.Error = contracts.OK;
    for (generated < output_len) {
        counter[0] = (block >> 24)::u8;
        counter[1] = (block >> 16)::u8;
        counter[2] = (block >> 8)::u8;
        counter[3] = block::u8;
        if (sha384) {
            var state384: sha512.SecretState384;
            state384 = sha512.init_secret384();
            if (!lift.update384_secret(?state384, seed, hash_len) ||
                !lift.update384_secret(?state384, ?counter[0], 4)) {
                sha512.destroy_secret384(?state384);
                status = contracts.INVALID_INPUT;
            }
            or {
                sha512.final_secret384(?state384, ?digest[0]);
                sha512.destroy_secret384(?state384);
            }
        }
        or {
            var state256: sha256.SecretState;
            state256 = sha256.init_secret();
            if (!lift.update256_secret(?state256, seed, hash_len) ||
                !lift.update256_secret(?state256, ?counter[0], 4)) {
                sha256.destroy_secret(?state256);
                status = contracts.INVALID_INPUT;
            }
            or {
                sha256.final_secret(?state256, ?digest[0]);
                sha256.destroy_secret(?state256);
            }
        }
        if (status != contracts.OK) {
            ct.zeroize(?digest[0], 48);
            ct.zeroize(?counter[0], 4);
            ret status;
        }
        var copied: usize = 0;
        for (copied < hash_len && generated < output_len) {
            output[generated] = digest[copied];
            copied            = copied + 1;
            generated         = generated + 1;
        }
        block = block + 1;
    }
    ct.zeroize(?digest[0], 48);
    ct.zeroize(?counter[0], 4);
    ret contracts.OK;
}

#[oblivious]
fun pss_encode(output: *^u8, encoded_len: usize, message: contracts.Bytes,
    salt: contracts.SecretBytes, hash_len: usize, sha384: bool) contracts.Error {
    var message_hash: [48]^u8;
    var encoded_hash: [48]^u8;
    var mask:         [512]^u8;
    ct.zeroize(?message_hash[0], 48);
    ct.zeroize(?encoded_hash[0], 48);
    ct.zeroize(?mask[0], 512);
    var status: contracts.Error = rsa_hash_message(?message_hash[0], message, sha384);
    if (status == contracts.OK) {
        status = pss_hash_prime(?encoded_hash[0], ?message_hash[0], salt.data,
            hash_len, sha384);
    }
    val data_len: usize = encoded_len - hash_len - 1;
    if (status == contracts.OK) {
        status = pss_mgf1(?mask[0], data_len, ?encoded_hash[0], hash_len, sha384);
    }
    if (status == contracts.OK) {
        val padding_len: usize = encoded_len - (hash_len << 1) - 2;
        var i:           usize = 0;
        for (i < padding_len) {
            output[i] = mask[i];
            i         = i + 1;
        }
        output[padding_len] = 1 ^ mask[padding_len];
        i                   = 0;
        for (i < hash_len) {
            output[padding_len + 1 + i] = salt.data[i] ^ mask[padding_len + 1 + i];
            output[data_len + i]        = encoded_hash[i];
            i                           = i + 1;
        }
        output[0]               = output[0] & 0x7f;
        output[encoded_len - 1] = 0xbc;
    }
    ct.zeroize(?message_hash[0], 48);
    ct.zeroize(?encoded_hash[0], 48);
    ct.zeroize(?mask[0], 512);
    ret status;
}

#[oblivious]
fun pss_check(encoded: *^u8, encoded_len: usize, message: contracts.Bytes,
    hash_len: usize, sha384: bool) contracts.Error {
    var message_hash:  [48]^u8;
    var expected_hash: [48]^u8;
    var mask:          [512]^u8;
    var salt:          [48]^u8;
    ct.zeroize(?message_hash[0], 48);
    ct.zeroize(?expected_hash[0], 48);
    ct.zeroize(?mask[0], 512);
    ct.zeroize(?salt[0], 48);
    val data_len: usize           = encoded_len - hash_len - 1;
    var status:   contracts.Error = rsa_hash_message(?message_hash[0], message, sha384);
    if (status == contracts.OK) {
        status = pss_mgf1(?mask[0], data_len, ?encoded[data_len], hash_len, sha384);
    }
    var valid: ^u8 = 1;
    valid = valid & ct.eq_u8(encoded[encoded_len - 1], 0xbc);
    valid = valid & ct.eq_u8(encoded[0] & 0x80, 0);
    val padding_len: usize = encoded_len - (hash_len << 1) - 2;
    var i:           usize = 0;
    for (i < padding_len) {
        var value: ^u8 = encoded[i] ^ mask[i];
        if (i == 0) { value = value & 0x7f; }
        valid = valid & ct.eq_u8(value, 0);
        value = 0;
        i     = i + 1;
    }
    valid = valid & ct.eq_u8(encoded[padding_len] ^ mask[padding_len], 1);
    i     = 0;
    for (i < hash_len) {
        salt[i] = encoded[padding_len + 1 + i] ^ mask[padding_len + 1 + i];
        i       = i + 1;
    }
    if (status == contracts.OK) {
        status = pss_hash_prime(?expected_hash[0], ?message_hash[0], ?salt[0],
            hash_len, sha384);
    }
    valid = valid & ct.eq_bytes(?expected_hash[0], ?encoded[data_len], hash_len);
    var result: contracts.Error = contracts.AUTH_FAILED;
    if (status != contracts.OK)                   { result = status; }
    if (status == contracts.OK && valid:>u8 == 1) { result = contracts.OK; }
    ct.zeroize(?message_hash[0], 48);
    ct.zeroize(?expected_hash[0], 48);
    ct.zeroize(?mask[0], 512);
    ct.zeroize(?salt[0], 48);
    valid = 0;
    ret result;
}

#[oblivious]
fun sign_rsa_pss(private_key: RsaPrivateKey, message: contracts.Bytes,
    salt: contracts.SecretBytes, output: contracts.Buffer, hash_len: usize,
    sha384: bool) contracts.Operation {
    if (!valid_rsa_private(private_key))         { ret failed(contracts.INVALID_KEY); }
    if (message.len != 0 && message.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (salt.len != hash_len)                    { ret failed(contracts.INVALID_INPUT); }
    if (salt.data == nil)                        { ret failed(contracts.INVALID_INPUT); }
    if (output.capacity < private_key.modulus.len) {
        ret failed(contracts.OUTPUT_TOO_SMALL);
    }
    if (output.data == nil) { ret failed(contracts.INVALID_INPUT); }
    ct.begin();
    var encoded:         [512]^u8;
    var signature_bytes: [512]^u8;
    var recovered:       [512]^u8;
    ct.zeroize(?encoded[0], 512);
    ct.zeroize(?signature_bytes[0], 512);
    ct.zeroize(?recovered[0], 512);
    var status: contracts.Error = pss_encode(?encoded[0], private_key.modulus.len,
        message, salt, hash_len, sha384);
    var valid: ^u8 = 0;
    if (status == contracts.OK) {
        valid = rsa.private_apply(?signature_bytes[0], ?encoded[0],
            private_key.modulus.data, private_key.modulus.len,
            private_key.private_exponent.data, private_key.private_exponent.len);
        valid = valid & rsa.public_apply_secret(?recovered[0], ?signature_bytes[0],
            private_key.modulus.data, private_key.modulus.len,
            private_key.public_exponent.data, private_key.public_exponent.len);
        valid = valid & ct.eq_bytes(?recovered[0], ?encoded[0], private_key.modulus.len);
        if (valid:>u8 != 1) { status = contracts.INVALID_KEY; }
    }
    if (status == contracts.OK) {
        var i: usize = 0;
        for (i < private_key.modulus.len) {
            output.data[i] = signature_bytes[i]:>u8;
            i              = i + 1;
        }
    }
    ct.zeroize(?encoded[0], 512);
    ct.zeroize(?signature_bytes[0], 512);
    ct.zeroize(?recovered[0], 512);
    valid = 0;
    ct.end();
    if (status != contracts.OK) { ret failed(status); }
    ret contracts.Operation{error: contracts.OK, written: private_key.modulus.len};
}

#[oblivious]
fun verify_rsa_pss(public_key: RsaPublicKey, message: contracts.Bytes,
    signature_bytes: contracts.Bytes, hash_len: usize, sha384: bool) contracts.Error {
    if (!valid_rsa_public(public_key))                 { ret contracts.INVALID_KEY; }
    if (message.len != 0 && message.data == nil)       { ret contracts.INVALID_INPUT; }
    if (signature_bytes.len != public_key.modulus.len) { ret contracts.AUTH_FAILED; }
    if (signature_bytes.data == nil)                   { ret contracts.INVALID_INPUT; }
    if (!rsa.public_less_than(signature_bytes.data, public_key.modulus.data,
        public_key.modulus.len)) { ret contracts.AUTH_FAILED; }
    ct.begin();
    var encoded: [512]^u8;
    ct.zeroize(?encoded[0], 512);
    val valid: ^u8 = rsa.public_apply(?encoded[0], signature_bytes.data,
        public_key.modulus.data, public_key.modulus.len, public_key.exponent.data,
        public_key.exponent.len);
    var result: contracts.Error = contracts.AUTH_FAILED;
    if (valid:>u8 == 1) {
        result = pss_check(?encoded[0], public_key.modulus.len, message,
            hash_len, sha384);
    }
    ct.zeroize(?encoded[0], 512);
    ct.end();
    ret result;
}

# sign rsa-pss with an exact 32-byte caller-provided salt
pub fun sign_rsa_pss_sha256(private_key: RsaPrivateKey, message: contracts.Bytes,
    salt: contracts.SecretBytes, output: contracts.Buffer) contracts.Operation {
    ret sign_rsa_pss(private_key, message, salt, output, 32, false);
}

# sign rsa-pss with an exact 48-byte caller-provided salt
pub fun sign_rsa_pss_sha384(private_key: RsaPrivateKey, message: contracts.Bytes,
    salt: contracts.SecretBytes, output: contracts.Buffer) contracts.Operation {
    ret sign_rsa_pss(private_key, message, salt, output, 48, true);
}

pub fun verify_rsa_pss_sha256(public_key: RsaPublicKey, message: contracts.Bytes,
    signature_bytes: contracts.Bytes) contracts.Error {
    ret verify_rsa_pss(public_key, message, signature_bytes, 32, false);
}

pub fun verify_rsa_pss_sha384(public_key: RsaPublicKey, message: contracts.Bytes,
    signature_bytes: contracts.Bytes) contracts.Error {
    ret verify_rsa_pss(public_key, message, signature_bytes, 48, true);
}

#[oblivious]
fun pkcs1_check(encoded: *^u8, encoded_len: usize, message: contracts.Bytes,
    hash_len: usize, sha384: bool) contracts.Error {
    val digest_info_len: usize = RSA_PKCS1_DIGEST_INFO_PREFIX_SIZE + hash_len;
    if (encoded_len < digest_info_len + 11) { ret contracts.AUTH_FAILED; }
    val digest_info_offset: usize = encoded_len - digest_info_len;
    val separator:          usize = digest_info_offset - 1;
    var digest:             [48]^u8;
    ct.zeroize(?digest[0], 48);
    val status: contracts.Error = rsa_hash_message(?digest[0], message, sha384);
    var valid:  ^u8             = 1;
    valid = valid & ct.eq_u8(encoded[0], 0);
    valid = valid & ct.eq_u8(encoded[1], 1);
    var i: usize = 2;
    for (i < separator) {
        valid = valid & ct.eq_u8(encoded[i], 0xff);
        i     = i + 1;
    }
    valid = valid & ct.eq_u8(encoded[separator], 0);
    i     = 0;
    if (sha384) {
        for (i < RSA_PKCS1_DIGEST_INFO_PREFIX_SIZE) {
            valid = valid & ct.eq_u8(encoded[digest_info_offset + i],
                RSA_PKCS1_SHA384_DIGEST_INFO[i]);
            i = i + 1;
        }
    }
    or {
        for (i < RSA_PKCS1_DIGEST_INFO_PREFIX_SIZE) {
            valid = valid & ct.eq_u8(encoded[digest_info_offset + i],
                RSA_PKCS1_SHA256_DIGEST_INFO[i]);
            i = i + 1;
        }
    }
    valid = valid & ct.eq_bytes(?encoded[digest_info_offset +
        RSA_PKCS1_DIGEST_INFO_PREFIX_SIZE], ?digest[0], hash_len);
    var result: contracts.Error = contracts.AUTH_FAILED;
    if (status != contracts.OK)                   { result = status; }
    if (status == contracts.OK && valid:>u8 == 1) { result = contracts.OK; }
    ct.zeroize(?digest[0], 48);
    valid = 0;
    ret result;
}

#[oblivious]
fun verify_rsa_pkcs1(public_key: RsaPublicKey, message: contracts.Bytes,
    signature_bytes: contracts.Bytes, hash_len: usize,
    sha384: bool) contracts.Error {
    if (!valid_rsa_public(public_key))                 { ret contracts.INVALID_KEY; }
    if (message.len != 0 && message.data == nil)       { ret contracts.INVALID_INPUT; }
    if (signature_bytes.len != public_key.modulus.len) { ret contracts.AUTH_FAILED; }
    if (signature_bytes.data == nil)                   { ret contracts.INVALID_INPUT; }
    if (!rsa.public_less_than(signature_bytes.data, public_key.modulus.data,
        public_key.modulus.len)) { ret contracts.AUTH_FAILED; }
    ct.begin();
    var encoded: [512]^u8;
    ct.zeroize(?encoded[0], 512);
    val valid: ^u8 = rsa.public_apply(?encoded[0], signature_bytes.data,
        public_key.modulus.data, public_key.modulus.len, public_key.exponent.data,
        public_key.exponent.len);
    var result: contracts.Error = contracts.AUTH_FAILED;
    if (valid:>u8 == 1) {
        result = pkcs1_check(?encoded[0], public_key.modulus.len, message,
            hash_len, sha384);
    }
    ct.zeroize(?encoded[0], 512);
    ct.end();
    ret result;
}

# verify exact rfc 8017 emsa-pkcs1-v1_5 with sha-256
pub fun verify_rsa_pkcs1_sha256(public_key: RsaPublicKey,
    message: contracts.Bytes, signature_bytes: contracts.Bytes) contracts.Error {
    ret verify_rsa_pkcs1(public_key, message, signature_bytes, 32, false);
}

# verify exact rfc 8017 emsa-pkcs1-v1_5 with sha-384
pub fun verify_rsa_pkcs1_sha384(public_key: RsaPublicKey,
    message: contracts.Bytes, signature_bytes: contracts.Bytes) contracts.Error {
    ret verify_rsa_pkcs1(public_key, message, signature_bytes, 48, true);
}

#[oblivious]
fun destroy_nonce(state: *NonceState) {
    ct.zeroize(?state.key[0], 32);
    ct.zeroize(?state.value[0], 32);
}

# the message is public, so it hashes on std's sha256 and the digest is lifted
# into the secret buffer the arithmetic reads
fun hash_message(message: contracts.Bytes, digest: *^u8) contracts.Error {
    if (message.len::u64 > lift.SHA256_MAX_BYTES) { ret contracts.INVALID_INPUT; }
    var public_digest: [32]u8;
    sha256.hash(message.data, message.len, ?public_digest[0]);
    var i: usize = 0;
    for (i < sha256.DIGEST_SIZE) {
        digest[i] = public_digest[i];
        i         = i + 1;
    }
    ret contracts.OK;
}

#[oblivious]
fun hmac_one(output: *^u8, key: *^u8, first: *^u8,
    first_len: usize) contracts.Error {
    var context: hmac.Context256;
    var status:  contracts.Error = hmac.init256(?context,
        contracts.SecretBytes{data: key, len: 32});
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, first, first_len);
    }
    if (status == contracts.OK) {
        status = hmac.final256(?context, output);
    }
    or {
        hmac.destroy256(?context);
    }
    ret status;
}

#[oblivious]
fun hmac_two(output: *^u8, key: *^u8, first: *^u8, first_len: usize,
    second: *^u8, second_len: usize) contracts.Error {
    var context: hmac.Context256;
    var status:  contracts.Error = hmac.init256(?context,
        contracts.SecretBytes{data: key, len: 32});
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, first, first_len);
    }
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, second, second_len);
    }
    if (status == contracts.OK) {
        status = hmac.final256(?context, output);
    }
    or {
        hmac.destroy256(?context);
    }
    ret status;
}

#[oblivious]
fun hmac_four(output: *^u8, key: *^u8,
    first: *^u8, first_len: usize, second: *^u8, second_len: usize,
    third: *^u8, third_len: usize, fourth: *^u8,
    fourth_len: usize) contracts.Error {
    var context: hmac.Context256;
    var status:  contracts.Error = hmac.init256(?context,
        contracts.SecretBytes{data: key, len: 32});
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, first, first_len);
    }
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, second, second_len);
    }
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, third, third_len);
    }
    if (status == contracts.OK) {
        status = hmac.update256_secret(?context, fourth, fourth_len);
    }
    if (status == contracts.OK) {
        status = hmac.final256(?context, output);
    }
    or {
        hmac.destroy256(?context);
    }
    ret status;
}

#[oblivious]
fun nonce_init(state: *NonceState, private_key: *^u8,
    digest: *^u8) contracts.Error {
    var reduced_hash: core.UInt;
    var encoded_hash: [32]^u8;
    var prefix:       [1]^u8;
    core.decode_secret(?reduced_hash, digest);
    core.reduce_scalar_once(?reduced_hash);
    core.encode_secret(?encoded_hash[0], ?reduced_hash);
    ct.zeroize(?state.key[0], 32);
    var i: usize = 0;
    for (i < 32) {
        state.value[i] = 1;
        i              = i + 1;
    }
    prefix[0] = 0;
    var status: contracts.Error = hmac_four(?state.key[0], ?state.key[0],
        ?state.value[0], 32, ?prefix[0], 1, private_key, 32,
        ?encoded_hash[0], 32);
    if (status == contracts.OK) {
        status = hmac_one(?state.value[0], ?state.key[0], ?state.value[0], 32);
    }
    prefix[0] = 1;
    if (status == contracts.OK) {
        status = hmac_four(?state.key[0], ?state.key[0], ?state.value[0], 32,
            ?prefix[0], 1, private_key, 32, ?encoded_hash[0], 32);
    }
    if (status == contracts.OK) {
        status = hmac_one(?state.value[0], ?state.key[0], ?state.value[0], 32);
    }
    prefix[0] = 0;
    core.destroy_uint(?reduced_hash);
    ct.zeroize(?encoded_hash[0], 32);
    ct.zeroize(?prefix[0], 1);
    if (status != contracts.OK) { destroy_nonce(state); }
    ret status;
}

#[oblivious]
fun nonce_advance(state: *NonceState) contracts.Error {
    var prefix: [1]^u8;
    prefix[0] = 0;
    var status: contracts.Error = hmac_two(?state.key[0], ?state.key[0],
        ?state.value[0], 32, ?prefix[0], 1);
    if (status == contracts.OK) {
        status = hmac_one(?state.value[0], ?state.key[0], ?state.value[0], 32);
    }
    ct.zeroize(?prefix[0], 1);
    ret status;
}

#[oblivious]
fun nonce_next(state: *NonceState, nonce: *core.UInt) contracts.Error {
    val status: contracts.Error = hmac_one(?state.value[0], ?state.key[0],
        ?state.value[0], 32);
    if (status != contracts.OK) { ret status; }
    core.decode_secret(nonce, ?state.value[0]);
    ret contracts.OK;
}

fun der_integer_length(encoded: *^u8) usize {
    var first: usize = 0;
    for (first < 31 && encoded[first]:>u8 == 0) {
        first = first + 1;
    }
    var prefix: usize = 0;
    if ((encoded[first]:>u8 & 0x80) != 0) { prefix = 1; }
    ret 32 - first + prefix;
}

fun write_der_integer(output: *^u8, offset: usize, encoded: *^u8) usize {
    var first: usize = 0;
    for (first < 31 && encoded[first]:>u8 == 0) {
        first = first + 1;
    }
    var prefix: usize = 0;
    if ((encoded[first]:>u8 & 0x80) != 0) { prefix = 1; }
    val length: usize = 32 - first + prefix;
    output[offset]     = 0x02;
    output[offset + 1] = length::u8;
    var position: usize = offset + 2;
    if (prefix == 1) {
        output[position] = 0;
        position         = position + 1;
    }
    var i: usize = first;
    for (i < 32) {
        output[position] = encoded[i];
        position         = position + 1;
        i                = i + 1;
    }
    ret position;
}

#[oblivious]
fun encode_signature(output: *^u8, r: *core.UInt, s: *core.UInt) usize {
    var r_encoded: [32]^u8;
    var s_encoded: [32]^u8;
    core.encode_secret(?r_encoded[0], r);
    core.encode_secret(?s_encoded[0], s);
    val r_length: usize = der_integer_length(?r_encoded[0]);
    val s_length: usize = der_integer_length(?s_encoded[0]);
    output[0] = 0x30;
    output[1] = (4 + r_length + s_length)::u8;
    val next: usize = write_der_integer(output, 2, ?r_encoded[0]);
    val end:  usize = write_der_integer(output, next, ?s_encoded[0]);
    ct.zeroize(?r_encoded[0], 32);
    ct.zeroize(?s_encoded[0], 32);
    ret end;
}

fun parse_der_integer(output: *core.UInt, input: *u8, offset: usize,
    length: usize) bool {
    if (length == 0 || length > 33)  { ret false; }
    if ((input[offset] & 0x80) != 0) { ret false; }
    if (length > 1 && input[offset] == 0 && (input[offset + 1] & 0x80) == 0) {
        ret false;
    }
    if (length == 33 && input[offset] != 0) { ret false; }
    var encoded: [32]u8;
    var i:       usize = 0;
    for (i < 32) {
        encoded[i] = 0;
        i          = i + 1;
    }
    var skip: usize = 0;
    if (length == 33) { skip = 1; }
    val significant: usize = length - skip;
    i = 0;
    for (i < significant) {
        encoded[32 - significant + i] = input[offset + skip + i];
        i                             = i + 1;
    }
    core.decode_public(output, ?encoded[0], 0);
    ret true;
}

fun parse_signature(r: *core.UInt, s: *core.UInt,
    signature: contracts.Bytes) bool {
    if (signature.len < 8 || signature.len > ECDSA_P256_SIGNATURE_MAX_SIZE) {
        ret false;
    }
    if (signature.data[0] != 0x30 || signature.data[1]::usize != signature.len - 2) {
        ret false;
    }
    if (signature.data[2] != 0x02) { ret false; }
    val r_length: usize = signature.data[3]::usize;
    if (r_length == 0 || r_length > 33) { ret false; }
    val s_tag: usize = 4 + r_length;
    if (s_tag + 2 > signature.len || signature.data[s_tag] != 0x02) { ret false; }
    val s_length: usize = signature.data[s_tag + 1]::usize;
    if (s_tag + 2 + s_length != signature.len)                      { ret false; }
    if (!parse_der_integer(r, signature.data, 4, r_length))         { ret false; }
    if (!parse_der_integer(s, signature.data, s_tag + 2, s_length)) { ret false; }
    ret true;
}

# sign sha-256(message) with a canonical p-256 scalar and rfc 6979 nonce
#
# the signature is strict der. all failures leave output unchanged.
#[oblivious]
pub fun sign_ecdsa_p256_sha256(private_key: contracts.SecretBytes,
    message: contracts.Bytes, output: contracts.Buffer) contracts.Operation {
    if (private_key.len != ECDSA_P256_PRIVATE_KEY_SIZE) {
        ret failed(contracts.INVALID_KEY);
    }
    if (private_key.data == nil)                 { ret failed(contracts.INVALID_INPUT); }
    if (message.len != 0 && message.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (output.capacity < ECDSA_P256_SIGNATURE_MIN_SIZE) {
        ret failed(contracts.OUTPUT_TOO_SMALL);
    }
    if (output.data == nil) { ret failed(contracts.INVALID_INPUT); }

    ct.begin();
    var private_scalar: core.UInt;
    core.decode_secret(?private_scalar, private_key.data);
    val private_valid: ^u8 = core.valid_scalar(?private_scalar);
    if (private_valid:>u8 != 1) {
        core.destroy_uint(?private_scalar);
        ct.end();
        ret failed(contracts.INVALID_KEY);
    }
    var digest: [32]^u8;
    var status: contracts.Error = hash_message(message, ?digest[0]);
    if (status != contracts.OK) {
        core.destroy_uint(?private_scalar);
        ct.zeroize(?digest[0], 32);
        ct.end();
        ret failed(status);
    }
    var hash_scalar: core.UInt;
    core.decode_secret(?hash_scalar, ?digest[0]);
    core.reduce_scalar_once(?hash_scalar);
    var nonce_state: NonceState;
    status = nonce_init(?nonce_state, private_key.data, ?digest[0]);
    ct.zeroize(?digest[0], 32);
    if (status != contracts.OK) {
        core.destroy_uint(?private_scalar);
        core.destroy_uint(?hash_scalar);
        ct.end();
        ret failed(status);
    }

    var r:               core.UInt;
    var s:               core.UInt;
    var nonce:           core.UInt;
    var nonce_one:       core.UInt;
    var candidate_nonce: core.UInt;
    var nonce_point:     core.Point;
    var x:               core.UInt;
    var y:               core.UInt;
    var product:         core.UInt;
    var sum:             core.UInt;
    var inverse:         core.UInt;
    core.set_small(?nonce_one, 1);
    core.copy(?nonce, ?nonce_one);
    # fixed candidates hide rfc rejection count at a 2^-256 failure bound
    var selected: ^u8   = 0;
    var attempt:  usize = 0;
    for (attempt < 8 && status == contracts.OK) {
        status = nonce_next(?nonce_state, ?candidate_nonce);
        if (status == contracts.OK) {
            val candidate_valid: ^u8 = core.valid_scalar(?candidate_nonce);
            val choose:          ^u8 = candidate_valid & (selected ^ 1);
            core.select(?nonce, ?nonce, ?candidate_nonce, choose);
            selected = selected | candidate_valid;
            status   = nonce_advance(?nonce_state);
        }
        attempt = attempt + 1;
    }
    if (status == contracts.OK) {
        core.scalar_multiply_base(?nonce_point, ?nonce);
        core.to_affine(?x, ?y, ?nonce_point);
        core.copy(?r, ?x);
        core.reduce_scalar_once(?r);
        core.scalar_multiply_values(?product, ?r, ?private_scalar);
        core.scalar_add(?sum, ?hash_scalar, ?product);
        core.scalar_inverse(?inverse, ?nonce);
        core.scalar_multiply_values(?s, ?inverse, ?sum);
        val usable: ^u8 = selected & ((core.is_zero(?r) | core.is_zero(?s)) ^ 1);
        if (usable:>u8 != 1) { status = contracts.INVALID_STATE; }
    }

    var encoded: [72]^u8;
    ct.zeroize(?encoded[0], 72);
    var written: usize = 0;
    if (status == contracts.OK) {
        written = encode_signature(?encoded[0], ?r, ?s);
        if (output.capacity < written) { status = contracts.OUTPUT_TOO_SMALL; }
    }
    if (status == contracts.OK) {
        var i: usize = 0;
        for (i < written) {
            output.data[i] = encoded[i]:>u8;
            i              = i + 1;
        }
    }
    or {
        written = 0;
    }
    ct.zeroize(?encoded[0], 72);
    destroy_nonce(?nonce_state);
    core.destroy_uint(?private_scalar);
    core.destroy_uint(?hash_scalar);
    core.destroy_uint(?r);
    core.destroy_uint(?s);
    core.destroy_uint(?nonce);
    core.destroy_uint(?nonce_one);
    core.destroy_uint(?candidate_nonce);
    core.destroy_point(?nonce_point);
    core.destroy_uint(?x);
    core.destroy_uint(?y);
    core.destroy_uint(?product);
    core.destroy_uint(?sum);
    core.destroy_uint(?inverse);
    ct.end();
    ret contracts.Operation{error: status, written: written};
}

# verify a strict der p-256 signature over sha-256(message)
#[oblivious]
pub fun verify_ecdsa_p256_sha256(public_key: contracts.Bytes,
    message: contracts.Bytes, signature: contracts.Bytes) contracts.Error {
    if (public_key.len != ECDSA_P256_PUBLIC_KEY_SIZE) { ret contracts.INVALID_KEY; }
    if (public_key.data == nil)                       { ret contracts.INVALID_INPUT; }
    if (public_key.data[0] != 0x04)                   { ret contracts.INVALID_KEY; }
    if (message.len != 0 && message.data == nil)      { ret contracts.INVALID_INPUT; }
    if (signature.len != 0 && signature.data == nil)  { ret contracts.INVALID_INPUT; }

    ct.begin();
    var peer:        core.Point;
    val point_valid: ^u8 = core.parse_point(?peer, public_key.data);
    if (point_valid:>u8 != 1) {
        core.destroy_point(?peer);
        ct.end();
        ret contracts.INVALID_KEY;
    }
    var r: core.UInt;
    var s: core.UInt;
    if (!parse_signature(?r, ?s, signature)) {
        core.destroy_point(?peer);
        core.destroy_uint(?r);
        core.destroy_uint(?s);
        ct.end();
        ret contracts.AUTH_FAILED;
    }
    val r_valid: ^u8 = core.valid_scalar(?r);
    val s_valid: ^u8 = core.valid_scalar(?s);
    if ((r_valid & s_valid):>u8 != 1) {
        core.destroy_point(?peer);
        core.destroy_uint(?r);
        core.destroy_uint(?s);
        ct.end();
        ret contracts.AUTH_FAILED;
    }
    var digest:      [32]^u8;
    val hash_status: contracts.Error = hash_message(message, ?digest[0]);
    if (hash_status != contracts.OK) {
        core.destroy_point(?peer);
        core.destroy_uint(?r);
        core.destroy_uint(?s);
        ct.zeroize(?digest[0], 32);
        ct.end();
        ret hash_status;
    }
    var hash_scalar: core.UInt;
    var inverse:     core.UInt;
    var u1:          core.UInt;
    var u2:          core.UInt;
    var first:       core.Point;
    var second:      core.Point;
    var sum:         core.Point;
    var x:           core.UInt;
    var y:           core.UInt;
    core.decode_secret(?hash_scalar, ?digest[0]);
    core.reduce_scalar_once(?hash_scalar);
    ct.zeroize(?digest[0], 32);
    core.scalar_inverse(?inverse, ?s);
    core.scalar_multiply_values(?u1, ?hash_scalar, ?inverse);
    core.scalar_multiply_values(?u2, ?r, ?inverse);
    core.scalar_multiply_base(?first, ?u1);
    core.scalar_multiply(?second, ?u2, ?peer);
    core.point_add(?sum, ?first, ?second);
    val infinity: ^u8 = core.point_is_infinity(?sum);
    core.to_affine(?x, ?y, ?sum);
    core.reduce_scalar_once(?x);
    val matches: ^u8             = core.equal(?x, ?r) & (infinity ^ 1);
    var result:  contracts.Error = contracts.AUTH_FAILED;
    if (matches:>u8 == 1) { result = contracts.OK; }
    core.destroy_point(?peer);
    core.destroy_uint(?r);
    core.destroy_uint(?s);
    core.destroy_uint(?hash_scalar);
    core.destroy_uint(?inverse);
    core.destroy_uint(?u1);
    core.destroy_uint(?u2);
    core.destroy_point(?first);
    core.destroy_point(?second);
    core.destroy_point(?sum);
    core.destroy_uint(?x);
    core.destroy_uint(?y);
    ct.end();
    ret result;
}

# verify a strict der p-384 signature over sha-384(message)
#[oblivious]
pub fun verify_ecdsa_p384_sha384(public_key: contracts.Bytes,
    message: contracts.Bytes, signature: contracts.Bytes) contracts.Error {
    ret p384.verify_sha384(public_key, message, signature);
}

test "signature: algorithm ids match the tls registry" {
    if (ECDSA_P256_SHA256 != 0x0403)   { ret 1; }
    if (ECDSA_P384_SHA384 != 0x0503)   { ret 1; }
    if (ED25519 != 0x0807)             { ret 1; }
    if (RSA_PKCS1_SHA256 != 0x0401)    { ret 1; }
    if (RSA_PKCS1_SHA384 != 0x0501)    { ret 1; }
    if (RSA_PSS_RSAE_SHA256 != 0x0804) { ret 1; }
    if (RSA_PSS_RSAE_SHA384 != 0x0805) { ret 1; }
    ret 0;
}

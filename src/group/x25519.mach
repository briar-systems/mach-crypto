# x25519 key agreement

use crypto.contracts;
use ed:   crypto.internal.ed25519;
use core: crypto.internal.x25519;
use std.crypto.ct;
use std.types.size.usize;

pub val PRIVATE_KEY_SIZE:   usize = 32;
pub val PUBLIC_KEY_SIZE:    usize = 32;
pub val SHARED_SECRET_SIZE: usize = 32;

pub def DerivePublicFun: fun(contracts.SecretBytes, contracts.Buffer) contracts.Operation;
pub def AgreeFun:        fun(contracts.SecretBytes, contracts.Bytes, contracts.SecretBuffer) contracts.Operation;

fun failed(error: contracts.Error) contracts.Operation {
    ret contracts.Operation{error: error, written: 0};
}

# the u-coordinate of [k]B for the clamped private scalar k, by the edwards comb
#
# [k]B on edwards25519 maps to the montgomery base point multiple through
# u = (1 + y) / (1 - y) = (Z + Y) / (Z - Y). a clamped k is a multiple of 8 in
# [2^254, 2^255), and L is odd and above 2^252, so [k]B is never the identity
# and Z - Y is never zero.
#[oblivious]
fun multiply_base(private_key: contracts.SecretBytes, output: *^u8) {
    var clamped: [32]^u8;
    var i:       usize = 0;
    for (i < 32) {
        clamped[i] = private_key.data[i];
        i          = i + 1;
    }
    clamped[0]  = clamped[0] & 248;
    clamped[31] = (clamped[31] & 127) | 64;
    var scalar:      ed.Scalar;
    var point:       ed.Point;
    var numerator:   core.Field;
    var denominator: core.Field;
    var u:           core.Field;
    ed.scalar_decode_secret(?scalar, ?clamped[0]);
    ed.scalar_multiply_base(?point, ?scalar);
    core.add(?numerator, ?point.z, ?point.y);
    core.subtract(?denominator, ?point.z, ?point.y);
    core.invert(?denominator, ?denominator);
    core.multiply(?u, ?numerator, ?denominator);
    core.encode(output, ?u);
    ct.zeroize(?clamped[0], 32);
    ed.destroy_scalar(?scalar);
    ed.destroy_point(?point);
    core.destroy(?numerator);
    core.destroy(?denominator);
    core.destroy(?u);
}

# derive the rfc 7748 public u-coordinate for a private scalar
#[oblivious]
pub fun derive_public(private_key: contracts.SecretBytes,
    output: contracts.Buffer) contracts.Operation {
    if (private_key.len != PRIVATE_KEY_SIZE) { ret failed(contracts.INVALID_KEY); }
    if (private_key.data == nil)             { ret failed(contracts.INVALID_INPUT); }
    if (output.capacity < PUBLIC_KEY_SIZE)   { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (output.data == nil)                  { ret failed(contracts.INVALID_INPUT); }

    var encoded: [32]^u8;
    ct.zeroize(?encoded[0], 32);
    ct.begin();
    multiply_base(private_key, ?encoded[0]);
    var i: usize = 0;
    for (i < PUBLIC_KEY_SIZE) {
        output.data[i] = encoded[i]:>u8;
        i              = i + 1;
    }
    ct.zeroize(?encoded[0], 32);
    ct.end();
    ret contracts.Operation{error: contracts.OK, written: PUBLIC_KEY_SIZE};
}

# agree accepts rfc non-canonical encodings and rejects every all-zero result
#
# validation and low-order failures leave output unchanged. successful output
# may overlap the private key because the scalar is snapshotted before writing.
#[oblivious]
pub fun agree(private_key: contracts.SecretBytes, peer_public: contracts.Bytes,
    output: contracts.SecretBuffer) contracts.Operation {
    if (private_key.len != PRIVATE_KEY_SIZE)  { ret failed(contracts.INVALID_KEY); }
    if (private_key.data == nil)              { ret failed(contracts.INVALID_INPUT); }
    if (peer_public.len != PUBLIC_KEY_SIZE)   { ret failed(contracts.INVALID_KEY); }
    if (peer_public.data == nil)              { ret failed(contracts.INVALID_INPUT); }
    if (output.capacity < SHARED_SECRET_SIZE) { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (output.data == nil)                   { ret failed(contracts.INVALID_INPUT); }

    var shared: [32]^u8;
    var zero:   [32]^u8;
    ct.zeroize(?shared[0], 32);
    ct.zeroize(?zero[0], 32);
    ct.begin();
    core.scalar_multiply(private_key, peer_public.data, ?shared[0]);
    val low_order: ^u8 = ct.eq_bytes(?shared[0], ?zero[0], SHARED_SECRET_SIZE);
    ct.zeroize(?zero[0], 32);
    if (low_order:>u8 == 1) {
        ct.zeroize(?shared[0], 32);
        ct.end();
        ret failed(contracts.INVALID_KEY);
    }
    var i: usize = 0;
    for (i < SHARED_SECRET_SIZE) {
        output.data[i] = shared[i];
        i              = i + 1;
    }
    ct.zeroize(?shared[0], 32);
    ct.end();
    ret contracts.Operation{error: contracts.OK, written: SHARED_SECRET_SIZE};
}

test "x25519: every wire and key value is 32 bytes" {
    if (PRIVATE_KEY_SIZE != 32 || PUBLIC_KEY_SIZE != 32) { ret 1; }
    if (SHARED_SECRET_SIZE != 32)                        { ret 1; }
    ret 0;
}

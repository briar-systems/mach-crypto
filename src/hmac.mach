# hmac contracts

use crypto.contracts;
use core: crypto.internal.hmac;
use std.crypto.ct;
use std.types.size.usize;

pub val SHA256_BLOCK_SIZE: usize = 64;
pub val SHA256_TAG_SIZE:   usize = 32;
pub val SHA384_BLOCK_SIZE: usize = 128;
pub val SHA384_TAG_SIZE:   usize = 48;

# one-shot hmac callback with a secret key and public message
pub def MacFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Buffer) contracts.Operation;

fun failed(error: contracts.Error) contracts.Operation {
    ret contracts.Operation{error: error, written: 0};
}

# authenticate a public message with hmac-sha-256
#
# the output may overlap the message because it is written only after the
# complete tag exists. a nonempty public output cannot alias the secret key.
pub fun sha256(key: contracts.SecretBytes, message: contracts.Bytes,
    output: contracts.Buffer) contracts.Operation {
    if (key.len != 0 && key.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (message.len != 0 && message.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (output.capacity < SHA256_TAG_SIZE) { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (output.data == nil) { ret failed(contracts.INVALID_INPUT); }

    var context: core.Context256;
    val initialized: contracts.Error = core.init256(?context, key);
    if (initialized != contracts.OK) { ret failed(initialized); }
    var tag: [32]^u8;
    ct.zeroize(?tag[0], SHA256_TAG_SIZE);
    val updated: contracts.Error = core.update256_public(?context, message.data, message.len);
    if (updated != contracts.OK) {
        core.destroy256(?context);
        ct.zeroize(?tag[0], SHA256_TAG_SIZE);
        ret failed(updated);
    }
    val finalized: contracts.Error = core.final256(?context, ?tag[0]);
    if (finalized != contracts.OK) {
        ct.zeroize(?tag[0], SHA256_TAG_SIZE);
        ret failed(finalized);
    }
    var i: usize = 0;
    for (i < SHA256_TAG_SIZE) {
        output.data[i] = tag[i]:>u8;
        i = i + 1;
    }
    ct.zeroize(?tag[0], SHA256_TAG_SIZE);
    ret contracts.Operation{error: contracts.OK, written: SHA256_TAG_SIZE};
}

# authenticate a public message with hmac-sha-384
#
# the output may overlap the message because it is written only after the
# complete tag exists. a nonempty public output cannot alias the secret key.
pub fun sha384(key: contracts.SecretBytes, message: contracts.Bytes,
    output: contracts.Buffer) contracts.Operation {
    if (key.len != 0 && key.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (message.len != 0 && message.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (output.capacity < SHA384_TAG_SIZE) { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (output.data == nil) { ret failed(contracts.INVALID_INPUT); }

    var context: core.Context384;
    val initialized: contracts.Error = core.init384(?context, key);
    if (initialized != contracts.OK) { ret failed(initialized); }
    var tag: [48]^u8;
    ct.zeroize(?tag[0], SHA384_TAG_SIZE);
    val updated: contracts.Error = core.update384_public(?context, message.data, message.len);
    if (updated != contracts.OK) {
        core.destroy384(?context);
        ct.zeroize(?tag[0], SHA384_TAG_SIZE);
        ret failed(updated);
    }
    val finalized: contracts.Error = core.final384(?context, ?tag[0]);
    if (finalized != contracts.OK) {
        ct.zeroize(?tag[0], SHA384_TAG_SIZE);
        ret failed(finalized);
    }
    var i: usize = 0;
    for (i < SHA384_TAG_SIZE) {
        output.data[i] = tag[i]:>u8;
        i = i + 1;
    }
    ct.zeroize(?tag[0], SHA384_TAG_SIZE);
    ret contracts.Operation{error: contracts.OK, written: SHA384_TAG_SIZE};
}

test "hmac: sha-2 dimensions match their hash functions" {
    if (SHA256_BLOCK_SIZE != 64 || SHA256_TAG_SIZE != 32) { ret 1; }
    if (SHA384_BLOCK_SIZE != 128 || SHA384_TAG_SIZE != 48) { ret 1; }
    ret 0;
}

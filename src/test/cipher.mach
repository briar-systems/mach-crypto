# block cipher contract tests

use crypto.cipher.aes;
use crypto.contracts;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

#[testing]
val FIPS_PLAINTEXT: [16]u8 = [16]u8{
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
    0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff
};

#[testing]
val FIPS_AES128: [16]u8 = [16]u8{
    0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30,
    0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a
};

#[testing]
val FIPS_AES256: [16]u8 = [16]u8{
    0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf,
    0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89
};

#[testing]
fun secret_equal(actual: *^u8, expected: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i]:>u8 != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun secret_filled(actual: *^u8, value: u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i]:>u8 != value) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun load_secret(output: *^u8, input: *u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        output[i] = input[i];
        i         = i + 1;
    }
}

#[testing]
fun fill_secret(output: *^u8, value: u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        output[i] = value;
        i         = i + 1;
    }
}

#[testing]
fun nibble(c: u8) u8 {
    if (c >= '0' && c <= '9') { ret c - '0'; }
    if (c >= 'a' && c <= 'f') { ret c - 'a' + 10; }
    ret 255;
}

#[testing]
#[oblivious]
fun load_hex_secret(output: *^u8, input: *u8, bytes: usize) bool {
    var i: usize = 0;
    for (i < bytes) {
        val hi: u8 = nibble(input[i * 2]);
        val lo: u8 = nibble(input[i * 2 + 1]);
        if (hi == 255 || lo == 255) { ret false; }
        output[i] = (hi << 4) | lo;
        i         = i + 1;
    }
    ret true;
}

test aes_cbc__nist_sp_800_38a_encrypt_decrypt_and_chunks {
    val plaintext: *u8 =
        "6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710"::*u8;
    val cipher128: *u8 =
        "7649abac8119b246cee98e9b12e9197d5086cb9b507219ee95db113a917678b273bed6b8e3c1743b7116e69e222295163ff1caa1681fac09120eca307586e1a7"::*u8;
    val cipher256: *u8 =
        "f58c4c04d6e5f1ba779eabfb5f7bfbd69cfc4e967edb808d679f777bc6702c7d39f23369a9d9bacfa530e26304231461b2eb05e2c39be9fcda6c19078c6a9d1b"::*u8;
    var key:      [32]^u8;
    var input:    [64]^u8;
    var expected: [64]^u8;
    var output:   [64]^u8;
    var iv:       [16]u8;
    var i:        usize = 0;
    for (i < 16) {
        iv[i] = i::u8;
        i     = i + 1;
    }
    if (!load_hex_secret(?key[0], "2b7e151628aed2a6abf7158809cf4f3c"::*u8, 16) ||
        !load_hex_secret(?input[0], plaintext, 64) ||
        !load_hex_secret(?expected[0], cipher128, 64)) { ret 1; }
    var context: aes.CbcContext = aes.empty_cbc();
    if (aes.init_cbc(?context, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 16}) != contracts.OK) { ret 2; }
    var result: contracts.Operation = aes.encrypt_cbc(?context,
        contracts.SecretBytes{data: ?input[0], len: 16},
        contracts.SecretBuffer{data: ?output[0], capacity: 16});
    if (result.error != contracts.OK || result.written != 16) { ret 3; }
    result = aes.encrypt_cbc(?context,
        contracts.SecretBytes{data: ?input[16], len: 48},
        contracts.SecretBuffer{data: ?output[16], capacity: 48});
    if (result.error != contracts.OK || result.written != 48) { ret 4; }
    i = 0;
    for (i < 64) {
        if (output[i]:>u8 != expected[i]:>u8) { ret 5; }
        i = i + 1;
    }
    if (aes.dnit_cbc(?context) != contracts.OK ||
        aes.init_cbc(?context, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 16}) != contracts.OK) { ret 6; }
    result = aes.decrypt_cbc(?context,
        contracts.SecretBytes{data: ?output[0], len: 64},
        contracts.SecretBuffer{data: ?output[0], capacity: 64});
    if (result.error != contracts.OK || result.written != 64) { ret 7; }
    i = 0;
    for (i < 64) {
        if (output[i]:>u8 != input[i]:>u8) { ret 8; }
        i = i + 1;
    }
    if (aes.dnit_cbc(?context) != contracts.OK) { ret 9; }

    if (!load_hex_secret(?key[0],
        "603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4"::*u8,
        32) || !load_hex_secret(?expected[0], cipher256, 64)) { ret 10; }
    if (aes.init_cbc(?context, contracts.SecretBytes{data: ?key[0], len: 32},
        contracts.Bytes{data: ?iv[0], len: 16}) != contracts.OK) { ret 11; }
    result = aes.encrypt_cbc(?context,
        contracts.SecretBytes{data: ?input[0], len: 64},
        contracts.SecretBuffer{data: ?output[0], capacity: 64});
    if (result.error != contracts.OK || result.written != 64) { ret 12; }
    i = 0;
    for (i < 64) {
        if (output[i]:>u8 != expected[i]:>u8) { ret 13; }
        i = i + 1;
    }
    if (aes.dnit_cbc(?context) != contracts.OK ||
        aes.init_cbc(?context, contracts.SecretBytes{data: ?key[0], len: 32},
        contracts.Bytes{data: ?iv[0], len: 16}) != contracts.OK) { ret 14; }
    result = aes.decrypt_cbc(?context,
        contracts.SecretBytes{data: ?output[0], len: 64},
        contracts.SecretBuffer{data: ?output[0], capacity: 64});
    if (result.error != contracts.OK || result.written != 64) { ret 15; }
    i = 0;
    for (i < 64) {
        if (output[i]:>u8 != input[i]:>u8) { ret 16; }
        i = i + 1;
    }
    if (aes.dnit_cbc(?context) != contracts.OK) { ret 17; }
    ret 0;
}

test aes_cbc__invalid_lengths_and_lifecycle_preserve_output {
    var key:    [16]^u8;
    var input:  [32]^u8;
    var output: [32]^u8;
    var iv:     [16]u8;
    var i:      usize = 0;
    for (i < 32) {
        input[i]  = i::u8;
        output[i] = 0xa5;
        if (i < 16) {
            iv[i]  = i::u8;
            key[i] = i::u8;
        }
        i = i + 1;
    }
    var context: aes.CbcContext         = aes.empty_cbc();
    val message: contracts.SecretBytes  = contracts.SecretBytes{data: ?input[0], len: 32};
    val buffer:  contracts.SecretBuffer = contracts.SecretBuffer{data: ?output[0], capacity: 32};
    if (aes.encrypt_cbc(?context, message, buffer).error != contracts.INVALID_STATE ||
        aes.decrypt_cbc(?context, message, buffer).error != contracts.INVALID_STATE ||
        aes.init_cbc(?context, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 15}) != contracts.INVALID_INPUT) { ret 1; }
    if (aes.init_cbc(?context, contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?iv[0], len: 16}) != contracts.OK) { ret 2; }
    if (aes.encrypt_cbc(?context, contracts.SecretBytes{data: ?input[0], len: 17}, buffer).error !=
        contracts.INVALID_INPUT ||
        aes.decrypt_cbc(?context, message,
        contracts.SecretBuffer{data: ?output[0], capacity: 31}).error !=
        contracts.OUTPUT_TOO_SMALL ||
        aes.encrypt_cbc(?context, contracts.SecretBytes{data: nil, len: 16}, buffer).error !=
        contracts.INVALID_INPUT) { ret 3; }
    i = 0;
    for (i < 32) {
        if (output[i]:>u8 != 0xa5) { ret 4; }
        i = i + 1;
    }
    if (aes.dnit_cbc(?context) != contracts.OK || aes.dnit_cbc(?context) != contracts.OK ||
        aes.decrypt_cbc(?context, message, buffer).error != contracts.INVALID_STATE) { ret 5; }
    if (!secret_filled(?context.iv[0], 0, 16)) { ret 6; }
    ret 0;
}

test aes__fips_197_blocks_through_one_keyed_context {
    var key:    [32]^u8;
    var input:  [16]^u8;
    var output: [16]^u8;
    var i:      usize = 0;
    for (i < 32) {
        key[i] = i::u8;
        i      = i + 1;
    }
    load_secret(?input[0], (?FIPS_PLAINTEXT[0]):~*u8, 16);
    var context: aes.Context = aes.empty();
    if (aes.init(?context, contracts.SecretBytes{data: ?key[0], len: 16}) != contracts.OK) { ret 1; }
    # the key is consumed by init, so overwriting it changes nothing
    fill_secret(?key[0], 0xA5, 32);
    var round: usize = 0;
    for (round < 3) {
        if (aes.encrypt_block(?context, contracts.SecretBytes{data: ?input[0], len: 16},
            contracts.SecretBuffer{data: ?output[0], capacity: 16}) != contracts.OK) { ret 2; }
        if (!secret_equal(?output[0], (?FIPS_AES128[0]):~*u8, 16)) { ret 3; }
        round = round + 1;
    }
    val decrypted: contracts.Error = aes.decrypt_block(?context,
        contracts.SecretBytes{data: ?output[0], len: 16},
        contracts.SecretBuffer{data: ?output[0], capacity: 16});
    if (decrypted != contracts.OK)                                { ret 100 + decrypted::i32; }
    if (!secret_equal(?output[0], (?FIPS_PLAINTEXT[0]):~*u8, 16)) { ret 9; }
    if (aes.dnit(?context) != contracts.OK)                       { ret 4; }

    i = 0;
    for (i < 32) {
        key[i] = i::u8;
        i      = i + 1;
    }
    if (aes.init(?context, contracts.SecretBytes{data: ?key[0], len: 32}) != contracts.OK) { ret 5; }
    if (aes.encrypt_block(?context, contracts.SecretBytes{data: ?input[0], len: 16},
        contracts.SecretBuffer{data: ?output[0], capacity: 16}) != contracts.OK) { ret 6; }
    if (!secret_equal(?output[0], (?FIPS_AES256[0]):~*u8, 16)) { ret 7; }
    if (aes.decrypt_block(?context,
        contracts.SecretBytes{data: ?output[0], len: 16},
        contracts.SecretBuffer{data: ?output[0], capacity: 16}) != contracts.OK ||
        !secret_equal(?output[0], (?FIPS_PLAINTEXT[0]):~*u8, 16)) { ret 10; }
    if (aes.dnit(?context) != contracts.OK) { ret 8; }
    ret 0;
}

test aes__the_context_refuses_use_outside_init_and_dnit_which_zeroizes_it {
    var key:    [32]^u8;
    var block:  [16]^u8;
    var output: [16]^u8;
    fill_secret(?key[0], 7, 32);
    fill_secret(?block[0], 1, 16);
    fill_secret(?output[0], 0xA5, 16);
    val input:  contracts.SecretBytes  = contracts.SecretBytes{data: ?block[0], len: 16};
    val buffer: contracts.SecretBuffer = contracts.SecretBuffer{data: ?output[0], capacity: 16};

    if (aes.init(nil, contracts.SecretBytes{data: ?key[0], len: 16}) != contracts.INVALID_INPUT) { ret 1; }
    if (aes.encrypt_block(nil, input, buffer) != contracts.INVALID_INPUT)                        { ret 2; }
    if (aes.dnit(nil) != contracts.INVALID_INPUT)                                                { ret 3; }

    var context: aes.Context = aes.empty();
    if (aes.encrypt_block(?context, input, buffer) != contracts.INVALID_STATE)                      { ret 4; }
    if (aes.init(?context, contracts.SecretBytes{data: ?key[0], len: 24}) != contracts.INVALID_KEY) { ret 5; }
    if (context.state != aes.EMPTY)                                                                 { ret 6; }
    if (aes.init(?context, contracts.SecretBytes{data: nil, len: 16}) != contracts.INVALID_INPUT)   { ret 7; }
    if (context.state != aes.EMPTY)                                                                 { ret 8; }
    if (!secret_filled(?output[0], 0xA5, 16))                                                       { ret 9; }

    if (aes.init(?context, contracts.SecretBytes{data: ?key[0], len: 16}) != contracts.OK)            { ret 10; }
    if (aes.init(?context, contracts.SecretBytes{data: ?key[0], len: 16}) != contracts.INVALID_STATE) { ret 11; }
    if (aes.encrypt_block(?context, contracts.SecretBytes{data: ?block[0], len: 15}, buffer) !=
        contracts.INVALID_INPUT) { ret 12; }
    if (aes.encrypt_block(?context, contracts.SecretBytes{data: nil, len: 16}, buffer) !=
        contracts.INVALID_INPUT) { ret 13; }
    if (aes.encrypt_block(?context, input, contracts.SecretBuffer{data: ?output[0], capacity: 15}) !=
        contracts.OUTPUT_TOO_SMALL) { ret 14; }
    if (aes.encrypt_block(?context, input, contracts.SecretBuffer{data: nil, capacity: 16}) !=
        contracts.INVALID_INPUT) { ret 15; }
    if (aes.decrypt_block(?context, contracts.SecretBytes{data: ?block[0], len: 15}, buffer) !=
        contracts.INVALID_INPUT ||
        aes.decrypt_block(?context, input,
        contracts.SecretBuffer{data: ?output[0], capacity: 15}) !=
        contracts.OUTPUT_TOO_SMALL) { ret 25; }
    if (!secret_filled(?output[0], 0xA5, 16)) { ret 16; }

    # the active member holds the key, and dnit clears every member
    val planes: *^u8 = (?context.cipher.schedule.software.round_planes[0]):~*^u8;
    val rounds: *^u8 = ?context.cipher.schedule.hardware.round_keys[0];
    if (secret_filled(planes, 0, 960) && secret_filled(rounds, 0, 240)) { ret 23; }
    if (aes.dnit(?context) != contracts.OK)                             { ret 17; }
    if (!secret_filled(planes, 0, 960) || !secret_filled(rounds, 0, 240) ||
        context.cipher.active) { ret 24; }
    if (aes.dnit(?context) != contracts.OK)                                    { ret 18; }
    if (aes.encrypt_block(?context, input, buffer) != contracts.INVALID_STATE) { ret 19; }
    if (!secret_filled(?output[0], 0xA5, 16))                                  { ret 20; }
    context.state = 9;
    if (aes.dnit(?context) != contracts.INVALID_STATE) { ret 21; }
    if (context.state != aes.EMPTY)                    { ret 22; }
    ret 0;
}

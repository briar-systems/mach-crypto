# PBKDF2-HMAC-SHA256 vectors and bounded-output contract

use crypto.contracts;
use crypto.pbkdf2;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

#[testing]
fun hex_nibble(c: u8) u8 {
    if (c >= '0' && c <= '9') { ret c - '0'; }
    if (c >= 'a' && c <= 'f') { ret c - 'a' + 10; }
    ret 255;
}

#[testing]
fun matches_hex(actual: *^u8, expected: *u8, bytes: usize) bool {
    var i: usize = 0;
    for (i < bytes) {
        val hi: u8 = hex_nibble(expected[i * 2]);
        val lo: u8 = hex_nibble(expected[i * 2 + 1]);
        if (hi == 255 || lo == 255 || actual[i]:>u8 != ((hi << 4) | lo)) { ret false; }
        i = i + 1;
    }
    ret true;
}

test pbkdf2__published_and_multiblock_vectors {
    var password: [8]^u8;
    var i:        usize = 0;
    for (i < 8) {
        password[i] = "password"[i];
        i           = i + 1;
    }
    val key:    contracts.SecretBytes = contracts.SecretBytes{data: ?password[0], len: 8};
    val salt:   contracts.Bytes       = contracts.Bytes{data: "salt"::*u8, len: 4};
    var output: [64]^u8;
    var result: contracts.Operation   = pbkdf2.sha256(key, salt, 1,
        contracts.SecretBuffer{data: ?output[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !matches_hex(?output[0],
        "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b"::*u8,
        32)) { ret 1; }
    result = pbkdf2.sha256(key, salt, 2,
        contracts.SecretBuffer{data: ?output[0], capacity: 64});
    if (result.error != contracts.OK || result.written != 64 ||
        !matches_hex(?output[0],
        "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43830651afcb5c862f0b249bd031f7a67520d136470f5ec271ece91c07773253d9"::*u8,
        64)) { ret 2; }
    ret 0;
}

test pbkdf2__invalid_parameters_leave_output_untouched {
    var password: [8]^u8;
    var output:   [32]^u8;
    var i:        usize = 0;
    for (i < 32) {
        output[i] = 0xa5;
        i         = i + 1;
    }
    val key:  contracts.SecretBytes = contracts.SecretBytes{data: ?password[0], len: 8};
    val salt: contracts.Bytes       = contracts.Bytes{data: "salt"::*u8, len: 4};
    if (pbkdf2.sha256(key, salt, 0,
        contracts.SecretBuffer{data: ?output[0], capacity: 32}).error != contracts.INVALID_INPUT ||
        pbkdf2.sha256(contracts.SecretBytes{data: nil, len: 1}, salt, 1,
        contracts.SecretBuffer{data: ?output[0], capacity: 32}).error != contracts.INVALID_INPUT ||
        pbkdf2.sha256(key, contracts.Bytes{data: nil, len: 1}, 1,
        contracts.SecretBuffer{data: ?output[0], capacity: 32}).error != contracts.INVALID_INPUT ||
        pbkdf2.sha256(key, salt, 1,
        contracts.SecretBuffer{data: nil, capacity: 32}).error != contracts.INVALID_INPUT) { ret 1; }
    for (i < 32) {
        if (output[i]:>u8 != 0xa5) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

test pbkdf2__long_salt_and_password_output_overlap {
    var salt:           [80]u8;
    var key_and_output: [40]^u8;
    var i:              usize = 0;
    for (i < 80) {
        salt[i] = i::u8;
        i       = i + 1;
    }
    i = 0;
    for (i < 8) {
        key_and_output[i] = "password"[i];
        i                 = i + 1;
    }
    var separate: [40]^u8;
    val first:    contracts.Operation = pbkdf2.sha256(
        contracts.SecretBytes{data: ?key_and_output[0], len: 8},
        contracts.Bytes{data: ?salt[0], len: 80}, 3,
        contracts.SecretBuffer{data: ?separate[0], capacity: 40});
    if (first.error != contracts.OK || !matches_hex(?separate[0],
        "464f711049044f0c5575c3ec63c30bc46d90917f8ad09fc482b0797f457cee7417cec58edc493e7a"::*u8,
        40)) { ret 2; }
    val result: contracts.Operation = pbkdf2.sha256(
        contracts.SecretBytes{data: ?key_and_output[0], len: 8},
        contracts.Bytes{data: ?salt[0], len: 80}, 3,
        contracts.SecretBuffer{data: ?key_and_output[0], capacity: 40});
    if (result.error != contracts.OK || result.written != 40 ||
        !matches_hex(?key_and_output[0],
        "464f711049044f0c5575c3ec63c30bc46d90917f8ad09fc482b0797f457cee7417cec58edc493e7a"::*u8,
        40)) { ret 1; }
    ret 0;
}

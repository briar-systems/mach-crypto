# x25519 production contract tests

use crypto.contracts;
use crypto.group.p256;
use crypto.group.x25519;
use ed:    crypto.internal.ed25519;
use core:  crypto.internal.p256;
use field: crypto.internal.x25519;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

fun public_equal(actual: *u8, expected: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun secret_equal(actual: *^u8, expected: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i]:>u8 != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun secrets_equal(actual: *^u8, expected: *^u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i]:>u8 != expected[i]:>u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun public_filled(actual: *u8, value: u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i] != value) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun secret_filled(actual: *^u8, value: u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i]:>u8 != value) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "p256: scalar one derives the sec1 generator" {
    var private_key: [32]^u8;
    var i:           usize = 0;
    for (i < 32) {
        private_key[i] = 0;
        i              = i + 1;
    }
    private_key[31] = 1;
    val expected: [65]u8 = [65]u8{
        0x04,
        0x6b, 0x17, 0xd1, 0xf2, 0xe1, 0x2c, 0x42, 0x47,
        0xf8, 0xbc, 0xe6, 0xe5, 0x63, 0xa4, 0x40, 0xf2,
        0x77, 0x03, 0x7d, 0x81, 0x2d, 0xeb, 0x33, 0xa0,
        0xf4, 0xa1, 0x39, 0x45, 0xd8, 0x98, 0xc2, 0x96,
        0x4f, 0xe3, 0x42, 0xe2, 0xfe, 0x1a, 0x7f, 0x9b,
        0x8e, 0xe7, 0xeb, 0x4a, 0x7c, 0x0f, 0x9e, 0x16,
        0x2b, 0xce, 0x33, 0x57, 0x6b, 0x31, 0x5e, 0xce,
        0xcb, 0xb6, 0x40, 0x68, 0x37, 0xbf, 0x51, 0xf5
    };
    var output: [65]u8;
    val result: contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: ?output[0], capacity: 65});
    if (result.error != contracts.OK || result.written != 65) { ret 1; }
    if (!public_equal(?output[0], (?expected[0]):~*u8, 65))   { ret 2; }
    ret 0;
}

test "p256: nist cavp p-256 cdh count zero" {
    var private_key: [32]^u8 = [32]^u8{
        0x7d, 0x7d, 0xc5, 0xf7, 0x1e, 0xb2, 0x9d, 0xda,
        0xf8, 0x0d, 0x62, 0x14, 0x63, 0x2e, 0xea, 0xe0,
        0x3d, 0x90, 0x58, 0xaf, 0x1f, 0xb6, 0xd2, 0x2e,
        0xd8, 0x0b, 0xad, 0xb6, 0x2b, 0xc1, 0xa5, 0x34
    };
    val expected_public: [65]u8 = [65]u8{
        0x04,
        0xea, 0xd2, 0x18, 0x59, 0x01, 0x19, 0xe8, 0x87,
        0x6b, 0x29, 0x14, 0x6f, 0xf8, 0x9c, 0xa6, 0x17,
        0x70, 0xc4, 0xed, 0xbb, 0xf9, 0x7d, 0x38, 0xce,
        0x38, 0x5e, 0xd2, 0x81, 0xd8, 0xa6, 0xb2, 0x30,
        0x28, 0xaf, 0x61, 0x28, 0x1f, 0xd3, 0x5e, 0x2f,
        0xa7, 0x00, 0x25, 0x23, 0xac, 0xc8, 0x5a, 0x42,
        0x9c, 0xb0, 0x6e, 0xe6, 0x64, 0x83, 0x25, 0x38,
        0x9f, 0x59, 0xed, 0xfc, 0xe1, 0x40, 0x51, 0x41
    };
    val peer: [65]u8 = [65]u8{
        0x04,
        0x70, 0x0c, 0x48, 0xf7, 0x7f, 0x56, 0x58, 0x4c,
        0x5c, 0xc6, 0x32, 0xca, 0x65, 0x64, 0x0d, 0xb9,
        0x1b, 0x6b, 0xac, 0xce, 0x3a, 0x4d, 0xf6, 0xb4,
        0x2c, 0xe7, 0xcc, 0x83, 0x88, 0x33, 0xd2, 0x87,
        0xdb, 0x71, 0xe5, 0x09, 0xe3, 0xfd, 0x9b, 0x06,
        0x0d, 0xdb, 0x20, 0xba, 0x5c, 0x51, 0xdc, 0xc5,
        0x94, 0x8d, 0x46, 0xfb, 0xf6, 0x40, 0xdf, 0xe0,
        0x44, 0x17, 0x82, 0xca, 0xb8, 0x5f, 0xa4, 0xac
    };
    val expected_shared: [32]u8 = [32]u8{
        0x46, 0xfc, 0x62, 0x10, 0x64, 0x20, 0xff, 0x01,
        0x2e, 0x54, 0xa4, 0x34, 0xfb, 0xdd, 0x2d, 0x25,
        0xcc, 0xc5, 0x85, 0x20, 0x60, 0x56, 0x1e, 0x68,
        0x04, 0x0d, 0xd7, 0x77, 0x89, 0x97, 0xbd, 0x7b
    };
    var public_key: [65]u8;
    var result:     contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: ?public_key[0], capacity: 65});
    if (result.error != contracts.OK || result.written != 65 ||
        !public_equal(?public_key[0], (?expected_public[0]):~*u8, 65)) { ret 1; }
    var shared: [32]^u8;
    result = p256.agree(contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?peer[0]):~*u8, len: 65},
        contracts.SecretBuffer{data: ?shared[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !secret_equal(?shared[0], (?expected_shared[0]):~*u8, 32)) { ret 2; }
    ret 0;
}

test "p256: invalid scalars and sec1 points preserve output" {
    var scalar:        [32]^u8;
    var public_output: [65]u8;
    var secret_output: [32]^u8;
    var peer:          [65]u8;
    var i:             usize = 0;
    for (i < 32) {
        scalar[i]        = 0;
        secret_output[i] = 0xa5;
        i                = i + 1;
    }
    i = 0;
    for (i < 65) {
        public_output[i] = 0x5a;
        peer[i]          = 0;
        i                = i + 1;
    }
    peer[0] = 0x04;
    var result: contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?scalar[0], len: 32},
        contracts.Buffer{data: ?public_output[0], capacity: 65});
    if (result.error != contracts.INVALID_KEY || result.written != 0 ||
        !public_filled(?public_output[0], 0x5a, 65)) { ret 1; }

    val order: [32]u8 = [32]u8{
        0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        0xbc, 0xe6, 0xfa, 0xad, 0xa7, 0x17, 0x9e, 0x84,
        0xf3, 0xb9, 0xca, 0xc2, 0xfc, 0x63, 0x25, 0x51
    };
    i = 0;
    for (i < 32) {
        scalar[i] = order[i];
        i         = i + 1;
    }
    result = p256.derive_public(contracts.SecretBytes{data: ?scalar[0], len: 32},
        contracts.Buffer{data: ?public_output[0], capacity: 65});
    if (result.error != contracts.INVALID_KEY ||
        !public_filled(?public_output[0], 0x5a, 65)) { ret 2; }

    scalar[0] = 0;
    i         = 1;
    for (i < 31) {
        scalar[i] = 0;
        i         = i + 1;
    }
    scalar[31] = 1;
    result     = p256.agree(contracts.SecretBytes{data: ?scalar[0], len: 32},
        contracts.Bytes{data: ?peer[0], len: 65},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 32});
    if (result.error != contracts.INVALID_KEY || result.written != 0 ||
        !secret_filled(?secret_output[0], 0xa5, 32)) { ret 3; }
    peer[0] = 0x02;
    result  = p256.agree(contracts.SecretBytes{data: ?scalar[0], len: 32},
        contracts.Bytes{data: ?peer[0], len: 65},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 32});
    if (result.error != contracts.INVALID_KEY ||
        !secret_filled(?secret_output[0], 0xa5, 32)) { ret 4; }
    peer[0] = 0x04;
    result  = p256.agree(contracts.SecretBytes{data: ?scalar[0], len: 32},
        contracts.Bytes{data: ?peer[0], len: 64},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 32});
    if (result.error != contracts.INVALID_KEY ||
        !secret_filled(?secret_output[0], 0xa5, 32)) { ret 5; }
    val prime: [32]u8 = [32]u8{
        0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x01,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff
    };
    peer[0] = 0x04;
    i       = 0;
    for (i < 32) {
        peer[1 + i] = prime[i];
        i           = i + 1;
    }
    result = p256.agree(contracts.SecretBytes{data: ?scalar[0], len: 32},
        contracts.Bytes{data: ?peer[0], len: 65},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 32});
    if (result.error != contracts.INVALID_KEY ||
        !secret_filled(?secret_output[0], 0xa5, 32)) { ret 6; }
    result = p256.agree(contracts.SecretBytes{data: ?scalar[0], len: 32},
        contracts.Bytes{data: ?peer[0], len: 65},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 31});
    if (result.error != contracts.OUTPUT_TOO_SMALL ||
        !secret_filled(?secret_output[0], 0xa5, 32)) { ret 7; }
    ret 0;
}

test "p256: successful agreement snapshots an overlapping private scalar" {
    var storage: [32]^u8 = [32]^u8{
        0x7d, 0x7d, 0xc5, 0xf7, 0x1e, 0xb2, 0x9d, 0xda,
        0xf8, 0x0d, 0x62, 0x14, 0x63, 0x2e, 0xea, 0xe0,
        0x3d, 0x90, 0x58, 0xaf, 0x1f, 0xb6, 0xd2, 0x2e,
        0xd8, 0x0b, 0xad, 0xb6, 0x2b, 0xc1, 0xa5, 0x34
    };
    val peer: [65]u8 = [65]u8{
        0x04,
        0x70, 0x0c, 0x48, 0xf7, 0x7f, 0x56, 0x58, 0x4c,
        0x5c, 0xc6, 0x32, 0xca, 0x65, 0x64, 0x0d, 0xb9,
        0x1b, 0x6b, 0xac, 0xce, 0x3a, 0x4d, 0xf6, 0xb4,
        0x2c, 0xe7, 0xcc, 0x83, 0x88, 0x33, 0xd2, 0x87,
        0xdb, 0x71, 0xe5, 0x09, 0xe3, 0xfd, 0x9b, 0x06,
        0x0d, 0xdb, 0x20, 0xba, 0x5c, 0x51, 0xdc, 0xc5,
        0x94, 0x8d, 0x46, 0xfb, 0xf6, 0x40, 0xdf, 0xe0,
        0x44, 0x17, 0x82, 0xca, 0xb8, 0x5f, 0xa4, 0xac
    };
    val expected: [32]u8 = [32]u8{
        0x46, 0xfc, 0x62, 0x10, 0x64, 0x20, 0xff, 0x01,
        0x2e, 0x54, 0xa4, 0x34, 0xfb, 0xdd, 0x2d, 0x25,
        0xcc, 0xc5, 0x85, 0x20, 0x60, 0x56, 0x1e, 0x68,
        0x04, 0x0d, 0xd7, 0x77, 0x89, 0x97, 0xbd, 0x7b
    };
    val result: contracts.Operation = p256.agree(
        contracts.SecretBytes{data: ?storage[0], len: 32},
        contracts.Bytes{data: (?peer[0]):~*u8, len: 65},
        contracts.SecretBuffer{data: ?storage[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !secret_equal(?storage[0], (?expected[0]):~*u8, 32)) { ret 1; }
    ret 0;
}


test "ed25519 internal: comb base multiplication matches the generic window" {
    var generator: ed.Point;
    ed.generator(?generator);
    var scalar:       ed.Scalar;
    var comb:         ed.Point;
    var window:       ed.Point;
    var comb_bytes:   [32]u8;
    var window_bytes: [32]u8;
    var index:        usize = 0;
    for (index < COMB_CASES) {
        ed.scalar_decode_public(?scalar, (?COMB_SCALARS[0]):~*u8, index * 32);
        ed.scalar_multiply_base(?comb, ?scalar);
        ed.scalar_multiply(?window, ?scalar, ?generator);
        ed.point_encode_public(?comb_bytes[0], ?comb);
        ed.point_encode_public(?window_bytes[0], ?window);
        if (!public_equal(?comb_bytes[0], ?window_bytes[0], 32)) { ret 1; }
        index = index + 1;
    }
    var sweep: [32]^u8;
    var round: usize = 0;
    for (round < 16) {
        var i: usize = 0;
        for (i < 32) {
            sweep[i] = ((round + 3) * 97 + i * i * 13 + i * 29)::u8;
            i        = i + 1;
        }
        ed.scalar_decode_secret(?scalar, ?sweep[0]);
        ed.scalar_multiply_base(?comb, ?scalar);
        ed.scalar_multiply(?window, ?scalar, ?generator);
        ed.point_encode_public(?comb_bytes[0], ?comb);
        ed.point_encode_public(?window_bytes[0], ?window);
        if (!public_equal(?comb_bytes[0], ?window_bytes[0], 32)) { ret 2; }
        round = round + 1;
    }
    ret 0;
}


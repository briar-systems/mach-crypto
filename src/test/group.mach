fun same_multiple(left: *core.Point, right: *core.Point) bool {
    val left_infinity:  u8 = core.point_is_infinity(left):>u8;
    val right_infinity: u8 = core.point_is_infinity(right):>u8;
    if (left_infinity != right_infinity) { ret false; }
    if (left_infinity == 1)              { ret true; }
    var left_x:  core.UInt;
    var left_y:  core.UInt;
    var right_x: core.UInt;
    var right_y: core.UInt;
    core.to_affine(?left_x, ?left_y, left);
    core.to_affine(?right_x, ?right_y, right);
    ret core.equal(?left_x, ?right_x):>u8 == 1 && core.equal(?left_y, ?right_y):>u8 == 1;
}

test "p256 internal: comb base multiplication matches the generic window" {
    var generator: core.Point;
    core.generator(?generator);
    var scalar: core.UInt;
    var comb:   core.Point;
    var window: core.Point;
    var index:  usize = 0;
    for (index < BASE_CASES) {
        load_limbs(?scalar, (?BASE_SCALARS[0]):~*u64, index * 8);
        core.scalar_multiply_base(?comb, ?scalar);
        core.scalar_multiply(?window, ?scalar, ?generator);
        if (!same_multiple(?comb, ?window)) { ret 1; }
        index = index + 1;
    }
    # a deterministic sweep: each scalar is the previous one times a fixed multiplier mod n
    var multiplier: core.UInt;
    load_limbs(?scalar, (?BASE_SCALARS[0]):~*u64, 21 * 8);
    load_limbs(?multiplier, (?BASE_SCALARS[0]):~*u64, 23 * 8);
    core.reduce_scalar_once(?scalar);
    var round: usize = 0;
    for (round < 16) {
        core.scalar_multiply_values(?scalar, ?scalar, ?multiplier);
        core.scalar_multiply_base(?comb, ?scalar);
        core.scalar_multiply(?window, ?scalar, ?generator);
        if (!same_multiple(?comb, ?window)) { ret 2; }
        round = round + 1;
    }
    ret 0;
}


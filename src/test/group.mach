#[oblivious]
fun load_scalar_words(output: *ed.Scalar, bytes: *u8) {
    var word: usize = 0;
    for (word < 8) {
        val offset: usize = word * 4;
        output.limb[word] = bytes[offset]::u64 | (bytes[offset + 1]::u64 << 8) |
            (bytes[offset + 2]::u64 << 16) | (bytes[offset + 3]::u64 << 24);
        word = word + 1;
    }
}

test "ed25519 internal: windowed scalar multiplication matches independent vectors across the scalar range" {
    val vectors: *u8   = (?ED_VECTORS[0]):~*u8;
    var index:   usize = 0;
    for (index < ED_CASES) {
        val base:    usize = index * 96;
        var scalar:  ed.Scalar;
        var point:   ed.Point;
        var product: ed.Point;
        var encoded: [32]u8;
        load_scalar_words(?scalar, ?vectors[base]);
        if (ed.point_decode(?point, ?vectors[base + 32]):>u8 != 1) { ret 1; }
        ed.scalar_multiply(?product, ?scalar, ?point);
        ed.point_encode_public(?encoded[0], ?product);
        if (!public_equal(?encoded[0], ?vectors[base + 64], 32)) { ret 2; }
        index = index + 1;
    }
    ret 0;
}

fun field_matches(value: *field.Field, expected: *u8) bool {
    var encoded: [32]^u8;
    field.encode(?encoded[0], value);
    ret secret_equal(?encoded[0], expected, 32);
}

test "x25519 internal: field arithmetic matches independent vectors" {
    val vectors: *u8   = (?FIELD25519_VECTORS[0]):~*u8;
    var index:   usize = 0;
    for (index < FIELD25519_CASES) {
        val base:       usize = index * 192;
        var left:       field.Field;
        var right:      field.Field;
        var result:     field.Field;
        var difference: field.Field;
        var sum:        field.Field;
        field.decode(?left, ?vectors[base]);
        field.decode(?right, ?vectors[base + 32]);
        field.multiply(?result, ?left, ?right);
        if (!field_matches(?result, ?vectors[base + 64])) { ret 1; }
        field.square(?result, ?left);
        if (!field_matches(?result, ?vectors[base + 96])) { ret 2; }
        field.invert(?result, ?left);
        if (!field_matches(?result, ?vectors[base + 128])) { ret 3; }
        field.subtract(?difference, ?left, ?right);
        field.add(?sum, ?left, ?right);
        field.multiply(?result, ?difference, ?sum);
        if (!field_matches(?result, ?vectors[base + 160])) { ret 4; }
        field.multiply(?left, ?left, ?right);
        if (!field_matches(?left, ?vectors[base + 64])) { ret 5; }
        index = index + 1;
    }
    ret 0;
}

test "x25519: agreement matches independent vectors across private keys and coordinates" {
    val vectors: *u8   = (?AGREE_VECTORS[0]):~*u8;
    var index:   usize = 0;
    for (index < AGREE_CASES) {
        val base:        usize = index * 97;
        var private_key: [32]^u8;
        var shared:      [32]^u8;
        var i:           usize = 0;
        for (i < 32) {
            private_key[i] = vectors[base + i];
            i              = i + 1;
        }
        val result: contracts.Operation = x25519.agree(
            contracts.SecretBytes{data: ?private_key[0], len: 32},
            contracts.Bytes{data: ?vectors[base + 32], len: 32},
            contracts.SecretBuffer{data: ?shared[0], capacity: 32});
        if (vectors[base + 96] == 1) {
            if (result.error != contracts.OK || result.written != 32) { ret 1; }
            if (!secret_equal(?shared[0], ?vectors[base + 64], 32))   { ret 2; }
        }
        or {
            if (result.error != contracts.INVALID_KEY) { ret 3; }
        }
        index = index + 1;
    }
    ret 0;
}

test "x25519: rfc 7748 alice and bob exchange" {
    var alice_private: [32]^u8 = [32]^u8{
        0x77, 0x07, 0x6d, 0x0a, 0x73, 0x18, 0xa5, 0x7d,
        0x3c, 0x16, 0xc1, 0x72, 0x51, 0xb2, 0x66, 0x45,
        0xdf, 0x4c, 0x2f, 0x87, 0xeb, 0xc0, 0x99, 0x2a,
        0xb1, 0x77, 0xfb, 0xa5, 0x1d, 0xb9, 0x2c, 0x2a
    };
    var bob_private: [32]^u8 = [32]^u8{
        0x5d, 0xab, 0x08, 0x7e, 0x62, 0x4a, 0x8a, 0x4b,
        0x79, 0xe1, 0x7f, 0x8b, 0x83, 0x80, 0x0e, 0xe6,
        0x6f, 0x3b, 0xb1, 0x29, 0x26, 0x18, 0xb6, 0xfd,
        0x1c, 0x2f, 0x8b, 0x27, 0xff, 0x88, 0xe0, 0xeb
    };
    val alice_public: [32]u8 = [32]u8{
        0x85, 0x20, 0xf0, 0x09, 0x89, 0x30, 0xa7, 0x54,
        0x74, 0x8b, 0x7d, 0xdc, 0xb4, 0x3e, 0xf7, 0x5a,
        0x0d, 0xbf, 0x3a, 0x0d, 0x26, 0x38, 0x1a, 0xf4,
        0xeb, 0xa4, 0xa9, 0x8e, 0xaa, 0x9b, 0x4e, 0x6a
    };
    val bob_public: [32]u8 = [32]u8{
        0xde, 0x9e, 0xdb, 0x7d, 0x7b, 0x7d, 0xc1, 0xb4,
        0xd3, 0x5b, 0x61, 0xc2, 0xec, 0xe4, 0x35, 0x37,
        0x3f, 0x83, 0x43, 0xc8, 0x5b, 0x78, 0x67, 0x4d,
        0xad, 0xfc, 0x7e, 0x14, 0x6f, 0x88, 0x2b, 0x4f
    };
    val shared: [32]u8 = [32]u8{
        0x4a, 0x5d, 0x9d, 0x5b, 0xa4, 0xce, 0x2d, 0xe1,
        0x72, 0x8e, 0x3b, 0xf4, 0x80, 0x35, 0x0f, 0x25,
        0xe0, 0x7e, 0x21, 0xc9, 0x47, 0xd1, 0x9e, 0x33,
        0x76, 0xf0, 0x9b, 0x3c, 0x1e, 0x16, 0x17, 0x42
    };
    var output: [32]u8;
    var result: contracts.Operation = x25519.derive_public(
        contracts.SecretBytes{data: ?alice_private[0], len: 32},
        contracts.Buffer{data: ?output[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !public_equal(?output[0], (?alice_public[0]):~*u8, 32)) { ret 1; }
    result = x25519.derive_public(contracts.SecretBytes{data: ?bob_private[0], len: 32},
        contracts.Buffer{data: ?output[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !public_equal(?output[0], (?bob_public[0]):~*u8, 32)) { ret 2; }
    var agreed: [32]^u8;
    result = x25519.agree(contracts.SecretBytes{data: ?alice_private[0], len: 32},
        contracts.Bytes{data: (?bob_public[0]):~*u8, len: 32},
        contracts.SecretBuffer{data: ?agreed[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !secret_equal(?agreed[0], (?shared[0]):~*u8, 32)) { ret 3; }
    result = x25519.agree(contracts.SecretBytes{data: ?bob_private[0], len: 32},
        contracts.Bytes{data: (?alice_public[0]):~*u8, len: 32},
        contracts.SecretBuffer{data: ?agreed[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !secret_equal(?agreed[0], (?shared[0]):~*u8, 32)) { ret 4; }
    ret 0;
}

test "x25519: rfc 7748 direct function vectors" {
    var scalar: [32]^u8 = [32]^u8{
        0xa5, 0x46, 0xe3, 0x6b, 0xf0, 0x52, 0x7c, 0x9d,
        0x3b, 0x16, 0x15, 0x4b, 0x82, 0x46, 0x5e, 0xdd,
        0x62, 0x14, 0x4c, 0x0a, 0xc1, 0xfc, 0x5a, 0x18,
        0x50, 0x6a, 0x22, 0x44, 0xba, 0x44, 0x9a, 0xc4
    };
    var coordinate: [32]u8 = [32]u8{
        0xe6, 0xdb, 0x68, 0x67, 0x58, 0x30, 0x30, 0xdb,
        0x35, 0x94, 0xc1, 0xa4, 0x24, 0xb1, 0x5f, 0x7c,
        0x72, 0x66, 0x24, 0xec, 0x26, 0xb3, 0x35, 0x3b,
        0x10, 0xa9, 0x03, 0xa6, 0xd0, 0xab, 0x1c, 0x4c
    };
    val expected_one: [32]u8 = [32]u8{
        0xc3, 0xda, 0x55, 0x37, 0x9d, 0xe9, 0xc6, 0x90,
        0x8e, 0x94, 0xea, 0x4d, 0xf2, 0x8d, 0x08, 0x4f,
        0x32, 0xec, 0xcf, 0x03, 0x49, 0x1c, 0x71, 0xf7,
        0x54, 0xb4, 0x07, 0x55, 0x77, 0xa2, 0x85, 0x52
    };
    var output: [32]^u8;
    var result: contracts.Operation = x25519.agree(
        contracts.SecretBytes{data: ?scalar[0], len: 32},
        contracts.Bytes{data: ?coordinate[0], len: 32},
        contracts.SecretBuffer{data: ?output[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !secret_equal(?output[0], (?expected_one[0]):~*u8, 32)) { ret 1; }

    val scalar_two: [32]u8 = [32]u8{
        0x4b, 0x66, 0xe9, 0xd4, 0xd1, 0xb4, 0x67, 0x3c,
        0x5a, 0xd2, 0x26, 0x91, 0x95, 0x7d, 0x6a, 0xf5,
        0xc1, 0x1b, 0x64, 0x21, 0xe0, 0xea, 0x01, 0xd4,
        0x2c, 0xa4, 0x16, 0x9e, 0x79, 0x18, 0xba, 0x0d
    };
    val coordinate_two: [32]u8 = [32]u8{
        0xe5, 0x21, 0x0f, 0x12, 0x78, 0x68, 0x11, 0xd3,
        0xf4, 0xb7, 0x95, 0x9d, 0x05, 0x38, 0xae, 0x2c,
        0x31, 0xdb, 0xe7, 0x10, 0x6f, 0xc0, 0x3c, 0x3e,
        0xfc, 0x4c, 0xd5, 0x49, 0xc7, 0x15, 0xa4, 0x93
    };
    val expected_two: [32]u8 = [32]u8{
        0x95, 0xcb, 0xde, 0x94, 0x76, 0xe8, 0x90, 0x7d,
        0x7a, 0xad, 0xe4, 0x5c, 0xb4, 0xb8, 0x73, 0xf8,
        0x8b, 0x59, 0x5a, 0x68, 0x79, 0x9f, 0xa1, 0x52,
        0xe6, 0xf8, 0xf7, 0x64, 0x7a, 0xac, 0x79, 0x57
    };
    var i: usize = 0;
    for (i < 32) {
        scalar[i]     = scalar_two[i];
        coordinate[i] = coordinate_two[i];
        i             = i + 1;
    }
    result = x25519.agree(contracts.SecretBytes{data: ?scalar[0], len: 32},
        contracts.Bytes{data: ?coordinate[0], len: 32},
        contracts.SecretBuffer{data: ?output[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !secret_equal(?output[0], (?expected_two[0]):~*u8, 32)) { ret 2; }
    ret 0;
}

test "x25519: rfc 7748 one-thousand iteration vector" {
    var scalar:     [32]^u8;
    var coordinate: [32]u8;
    var next:       [32]^u8;
    var i:          usize = 0;
    for (i < 32) {
        scalar[i]     = 0;
        coordinate[i] = 0;
        i             = i + 1;
    }
    scalar[0]     = 9;
    coordinate[0] = 9;
    val expected_one: [32]u8 = [32]u8{
        0x42, 0x2c, 0x8e, 0x7a, 0x62, 0x27, 0xd7, 0xbc,
        0xa1, 0x35, 0x0b, 0x3e, 0x2b, 0xb7, 0x27, 0x9f,
        0x78, 0x97, 0xb8, 0x7b, 0xb6, 0x85, 0x4b, 0x78,
        0x3c, 0x60, 0xe8, 0x03, 0x11, 0xae, 0x30, 0x79
    };
    var iteration: usize = 0;
    for (iteration < 1000) {
        val result: contracts.Operation = x25519.agree(
            contracts.SecretBytes{data: ?scalar[0], len: 32},
            contracts.Bytes{data: ?coordinate[0], len: 32},
            contracts.SecretBuffer{data: ?next[0], capacity: 32});
        if (result.error != contracts.OK || result.written != 32)                   { ret 1; }
        if (iteration == 0 && !secret_equal(?next[0], (?expected_one[0]):~*u8, 32)) { ret 2; }
        i = 0;
        for (i < 32) {
            coordinate[i] = scalar[i]:>u8;
            scalar[i]     = next[i];
            i             = i + 1;
        }
        iteration = iteration + 1;
    }
    val expected: [32]u8 = [32]u8{
        0x68, 0x4c, 0xf5, 0x9b, 0xa8, 0x33, 0x09, 0x55,
        0x28, 0x00, 0xef, 0x56, 0x6f, 0x2f, 0x4d, 0x3c,
        0x1c, 0x38, 0x87, 0xc4, 0x93, 0x60, 0xe3, 0x87,
        0x5f, 0x2e, 0xb9, 0x4d, 0x99, 0x53, 0x2c, 0x51
    };
    if (!secret_equal(?scalar[0], (?expected[0]):~*u8, 32)) { ret 3; }
    ret 0;
}

test "x25519: clamping, high-bit masking, and non-canonical inputs follow rfc 7748" {
    var private_key:       [32]^u8;
    var variant:           [32]^u8;
    var basepoint:         [32]u8;
    var high_bit:          [32]u8;
    var noncanonical_nine: [32]u8;
    var i:                 usize = 0;
    for (i < 32) {
        private_key[i]       = i::u8;
        variant[i]           = i::u8;
        basepoint[i]         = 0;
        high_bit[i]          = 0;
        noncanonical_nine[i] = 0xff;
        i                    = i + 1;
    }
    variant[0]            = 7;
    variant[31]           = 0x9f;
    basepoint[0]          = 9;
    high_bit[0]           = 9;
    high_bit[31]          = 0x80;
    noncanonical_nine[0]  = 0xf6;
    noncanonical_nine[31] = 0x7f;
    var expected: [32]u8;
    var result:   contracts.Operation = x25519.derive_public(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: ?expected[0], capacity: 32});
    if (result.error != contracts.OK) { ret 1; }
    var clamped: [32]u8;
    result = x25519.derive_public(contracts.SecretBytes{data: ?variant[0], len: 32},
        contracts.Buffer{data: ?clamped[0], capacity: 32});
    if (result.error != contracts.OK || !public_equal(?clamped[0], ?expected[0], 32)) { ret 2; }
    var agreed: [32]^u8;
    result = x25519.agree(contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: ?basepoint[0], len: 32},
        contracts.SecretBuffer{data: ?agreed[0], capacity: 32});
    if (result.error != contracts.OK || !secret_equal(?agreed[0], ?expected[0], 32)) { ret 3; }
    result = x25519.agree(contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: ?high_bit[0], len: 32},
        contracts.SecretBuffer{data: ?agreed[0], capacity: 32});
    if (result.error != contracts.OK || !secret_equal(?agreed[0], ?expected[0], 32)) { ret 4; }
    result = x25519.agree(contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: ?noncanonical_nine[0], len: 32},
        contracts.SecretBuffer{data: ?agreed[0], capacity: 32});
    if (result.error != contracts.OK || !secret_equal(?agreed[0], ?expected[0], 32)) { ret 5; }
    ret 0;
}

test "x25519: low-order inputs reject without changing output" {
    var private_key: [32]^u8;
    var peer:        [32]u8;
    var output:      [64]^u8;
    var i:           usize = 0;
    for (i < 32) {
        private_key[i] = i::u8;
        peer[i]        = 0;
        i              = i + 1;
    }
    var case: usize = 0;
    for (case < 4) {
        i = 0;
        for (i < 32) {
            peer[i]        = 0;
            output[i]      = 0xA5;
            output[32 + i] = 0x5A;
            i              = i + 1;
        }
        if (case == 1) { peer[0] = 1; }
        or (case == 2) {
            peer[0] = 0xed;
            i       = 1;
            for (i < 31) {
                peer[i] = 0xff;
                i       = i + 1;
            }
            peer[31] = 0x7f;
        }
        or {
            peer[0] = 0xee;
            i       = 1;
            for (i < 31) {
                peer[i] = 0xff;
                i       = i + 1;
            }
            peer[31] = 0x7f;
        }
        val result: contracts.Operation = x25519.agree(
            contracts.SecretBytes{data: ?private_key[0], len: 32},
            contracts.Bytes{data: ?peer[0], len: 32},
            contracts.SecretBuffer{data: ?output[0], capacity: 64});
        if (result.error != contracts.INVALID_KEY || result.written != 0)                  { ret 1; }
        if (!secret_filled(?output[0], 0xA5, 32) || !secret_filled(?output[32], 0x5A, 32)) { ret 2; }
        case = case + 1;
    }
    ret 0;
}

test "x25519: validation and capacity failures leave output unchanged" {
    var private_key:   [32]^u8;
    var peer:          [32]u8;
    var public_output: [32]u8;
    var secret_output: [32]^u8;
    var i:             usize = 0;
    for (i < 32) {
        private_key[i]   = i::u8;
        peer[i]          = 0;
        public_output[i] = 0xA5;
        secret_output[i] = 0xA5;
        i                = i + 1;
    }
    peer[0] = 9;
    var result: contracts.Operation = x25519.derive_public(
        contracts.SecretBytes{data: ?private_key[0], len: 31},
        contracts.Buffer{data: ?public_output[0], capacity: 32});
    if (result.error != contracts.INVALID_KEY || !public_filled(?public_output[0], 0xA5, 32)) { ret 1; }
    result = x25519.derive_public(contracts.SecretBytes{data: nil, len: 32},
        contracts.Buffer{data: ?public_output[0], capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !public_filled(?public_output[0], 0xA5, 32)) { ret 2; }
    result = x25519.derive_public(contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: ?public_output[0], capacity: 31});
    if (result.error != contracts.OUTPUT_TOO_SMALL || !public_filled(?public_output[0], 0xA5, 32)) { ret 3; }
    result = x25519.derive_public(contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: nil, capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !public_filled(?public_output[0], 0xA5, 32)) { ret 4; }

    result = x25519.agree(contracts.SecretBytes{data: ?private_key[0], len: 31},
        contracts.Bytes{data: ?peer[0], len: 32},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 32});
    if (result.error != contracts.INVALID_KEY || !secret_filled(?secret_output[0], 0xA5, 32)) { ret 5; }
    result = x25519.agree(contracts.SecretBytes{data: nil, len: 32},
        contracts.Bytes{data: ?peer[0], len: 32},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !secret_filled(?secret_output[0], 0xA5, 32)) { ret 6; }
    result = x25519.agree(contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: ?peer[0], len: 31},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 32});
    if (result.error != contracts.INVALID_KEY || !secret_filled(?secret_output[0], 0xA5, 32)) { ret 7; }
    result = x25519.agree(contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: nil, len: 32},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !secret_filled(?secret_output[0], 0xA5, 32)) { ret 8; }
    result = x25519.agree(contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: ?peer[0], len: 32},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 31});
    if (result.error != contracts.OUTPUT_TOO_SMALL || !secret_filled(?secret_output[0], 0xA5, 32)) { ret 9; }
    result = x25519.agree(contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: ?peer[0], len: 32},
        contracts.SecretBuffer{data: nil, capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !secret_filled(?secret_output[0], 0xA5, 32)) { ret 10; }
    ret 0;
}

test "x25519: independent differential vector and private output overlap" {
    var key_output:   [32]^u8;
    var peer_private: [32]^u8;
    var i:            usize = 0;
    for (i < 32) {
        key_output[i]   = i::u8;
        peer_private[i] = (32 + i)::u8;
        i               = i + 1;
    }
    val public_key: [32]u8 = [32]u8{
        0x8f, 0x40, 0xc5, 0xad, 0xb6, 0x8f, 0x25, 0x62,
        0x4a, 0xe5, 0xb2, 0x14, 0xea, 0x76, 0x7a, 0x6e,
        0xc9, 0x4d, 0x82, 0x9d, 0x3d, 0x7b, 0x5e, 0x1a,
        0xd1, 0xba, 0x6f, 0x3e, 0x21, 0x38, 0x28, 0x5f
    };
    val peer: [32]u8 = [32]u8{
        0x35, 0x80, 0x72, 0xd6, 0x36, 0x58, 0x80, 0xd1,
        0xae, 0xea, 0x32, 0x9a, 0xdf, 0x91, 0x21, 0x38,
        0x38, 0x51, 0xed, 0x21, 0xa2, 0x8e, 0x3b, 0x75,
        0xe9, 0x65, 0xd0, 0xd2, 0xcd, 0x16, 0x62, 0x54
    };
    val expected: [32]u8 = [32]u8{
        0x96, 0x63, 0xaa, 0x1d, 0xa9, 0x7e, 0x84, 0x8a,
        0x91, 0x4a, 0x43, 0x6d, 0x04, 0x16, 0x3d, 0xfb,
        0xb8, 0x91, 0x78, 0xf1, 0x07, 0xf1, 0xb5, 0xb7,
        0x7e, 0xd3, 0x85, 0x42, 0x03, 0x38, 0x28, 0x54
    };
    var derived: [32]u8;
    var result:  contracts.Operation = x25519.derive_public(
        contracts.SecretBytes{data: ?key_output[0], len: 32},
        contracts.Buffer{data: ?derived[0], capacity: 32});
    if (result.error != contracts.OK || !public_equal(?derived[0], (?public_key[0]):~*u8, 32)) { ret 1; }
    result = x25519.derive_public(contracts.SecretBytes{data: ?peer_private[0], len: 32},
        contracts.Buffer{data: ?derived[0], capacity: 32});
    if (result.error != contracts.OK || !public_equal(?derived[0], (?peer[0]):~*u8, 32)) { ret 2; }
    result = x25519.agree(
        contracts.SecretBytes{data: ?key_output[0], len: 32},
        contracts.Bytes{data: (?peer[0]):~*u8, len: 32},
        contracts.SecretBuffer{data: ?key_output[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !secret_equal(?key_output[0], (?expected[0]):~*u8, 32)) { ret 3; }
    ret 0;
}

# derive through the ladder at u = 9, the path derive_public replaced
fun ladder_public(private_key: *^u8, output: *u8) {
    var basepoint: [32]u8;
    var i:         usize = 0;
    for (i < 32) {
        basepoint[i] = 0;
        i            = i + 1;
    }
    basepoint[0] = 9;
    var encoded: [32]^u8;
    field.scalar_multiply(contracts.SecretBytes{data: private_key, len: 32}, ?basepoint[0],
        ?encoded[0]);
    i = 0;
    for (i < 32) {
        output[i] = encoded[i]:>u8;
        i         = i + 1;
    }
}

test "x25519: comb key derivation matches the montgomery ladder" {
    var key:    [32]^u8;
    var comb:   [32]u8;
    var ladder: [32]u8;
    var index:  usize = 0;
    for (index < LADDER_CASES + 16) {
        var i: usize = 0;
        for (i < 32) {
            if (index < LADDER_CASES) {
                key[i] = LADDER_KEYS[index * 32 + i];
            }
            or {
                key[i] = ((index + 1) * 131 + i * i * 7 + i * 53)::u8;
            }
            i = i + 1;
        }
        val result: contracts.Operation = x25519.derive_public(
            contracts.SecretBytes{data: ?key[0], len: 32},
            contracts.Buffer{data: ?comb[0], capacity: 32});
        if (result.error != contracts.OK || result.written != 32) { ret 1; }
        ladder_public(?key[0], ?ladder[0]);
        if (!public_equal(?comb[0], ?ladder[0], 32)) { ret 2; }
        index = index + 1;
    }
    ret 0;
}


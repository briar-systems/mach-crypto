# incremental public transcript hash tests

use crypto.contracts;
use crypto.hash;
use crypto.hash.sha1;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

test sha1__fips_vectors_and_secret_state {
    var expected_empty: [20]u8;
    var expected_abc:   [20]u8;
    var expected_long:  [20]u8;
    if (!decode_hex("da39a3ee5e6b4b0d3255bfef95601890afd80709"::*u8, 40, ?expected_empty[0]) ||
        !decode_hex("a9993e364706816aba3e25717850c26c9cd0d89d"::*u8, 40, ?expected_abc[0]) ||
        !decode_hex("84983e441c3bd26ebaae4aa1f95129e5e54670f1"::*u8, 40, ?expected_long[0])) { ret 1; }
    var state:  hash.Sha1 = hash.empty_sha1();
    var output: [20]u8;
    if (hash.init_sha1(?state) != contracts.OK ||
        hash.snapshot_sha1(?state, contracts.Buffer{data: ?output[0], capacity: 20}).error != contracts.OK ||
        !equal(?output[0], ?expected_empty[0], 20)) { ret 2; }
    if (hash.update_sha1(?state, contracts.Bytes{data: "a"::*u8, len: 1}) != contracts.OK ||
        hash.update_sha1(?state, contracts.Bytes{data: "bc"::*u8, len: 2}) != contracts.OK ||
        hash.final_sha1(?state, contracts.Buffer{data: ?output[0], capacity: 20}).error != contracts.OK ||
        !equal(?output[0], ?expected_abc[0], 20)) { ret 3; }
    if (hash.init_sha1(?state) != contracts.OK ||
        hash.update_sha1(?state, contracts.Bytes{
        data: "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"::*u8,
        len:  56
    }) != contracts.OK ||
        hash.final_sha1(?state, contracts.Buffer{data: ?output[0], capacity: 20}).error != contracts.OK ||
        !equal(?output[0], ?expected_long[0], 20)) { ret 4; }
    var secret_input: [3]^u8;
    secret_input[0] = 'a';
    secret_input[1] = 'b';
    secret_input[2] = 'c';
    var secret_output: [20]^u8;
    var secret_state:  sha1.SecretState = sha1.init_secret();
    sha1.update_secret(?secret_state, ?secret_input[0], 3);
    sha1.final_secret(?secret_state, ?secret_output[0]);
    var i: usize = 0;
    for (i < 20) {
        if (secret_output[i]:>u8 != expected_abc[i]) { ret 5; }
        i = i + 1;
    }
    sha1.destroy_secret(?secret_state);
    for (i < 5) {
        if (secret_state.h[i]:>u32 != 0) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test sha1__invalid_inputs_preserve_state_and_output {
    var state:  hash.Sha1 = hash.empty_sha1();
    var output: [20]u8;
    var i:      usize     = 0;
    for (i < 20) {
        output[i] = 0xa5;
        i         = i + 1;
    }
    if (hash.snapshot_sha1(?state, contracts.Buffer{data: ?output[0], capacity: 20}).error !=
        contracts.INVALID_STATE || hash.init_sha1(?state) != contracts.OK) { ret 1; }
    val before: hash.Sha1 = state;
    if (hash.update_sha1(?state, contracts.Bytes{data: nil, len: 1}) != contracts.INVALID_INPUT ||
        hash.snapshot_sha1(?state, contracts.Buffer{data: ?output[0], capacity: 19}).error !=
        contracts.OUTPUT_TOO_SMALL ||
        hash.final_sha1(?state, contracts.Buffer{data: nil, capacity: 20}).error !=
        contracts.INVALID_INPUT || state.inner.total != before.inner.total ||
        state.inner.buf_len != before.inner.buf_len || !filled(?output[0], 0xa5, 20)) { ret 2; }
    state.inner.total   = sha1.MAX_BYTES;
    state.inner.buf_len = (sha1.MAX_BYTES % sha1.BLOCK_SIZE::u64)::usize;
    if (hash.update_sha1(?state, contracts.Bytes{data: "x"::*u8, len: 1}) !=
        contracts.INVALID_INPUT || !filled(?output[0], 0xa5, 20)) { ret 3; }
    if (hash.destroy_sha1(?state) != contracts.OK || state.state != hash.EMPTY ||
        hash.destroy_sha1(?state) != contracts.OK) { ret 4; }
    ret 0;
}

#[testing]
fun nibble(byte: u8) u8 {
    if (byte >= '0' && byte <= '9') { ret byte - '0'; }
    if (byte >= 'a' && byte <= 'f') { ret byte - 'a' + 10; }
    if (byte >= 'A' && byte <= 'F') { ret byte - 'A' + 10; }
    ret 255;
}

#[testing]
fun decode_hex(text: *u8, text_len: usize, output: *u8) bool {
    if (text == nil || output == nil || text_len % 2 != 0) { ret false; }
    var i: usize = 0;
    for (i < text_len / 2) {
        val high: u8 = nibble(text[i * 2]);
        val low:  u8 = nibble(text[i * 2 + 1]);
        if (high == 255 || low == 255) { ret false; }
        output[i] = (high << 4) | low;
        i         = i + 1;
    }
    ret true;
}

#[testing]
fun equal(left: *u8, right: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (left[i] != right[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun filled(input: *u8, byte: u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (input[i] != byte) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun equal_sha256(left: *hash.Sha256, right: *hash.Sha256) bool {
    if (left.state != right.state || left.inner.buf_len != right.inner.buf_len ||
        left.inner.total != right.inner.total) { ret false; }
    if (left.inner.h0 != right.inner.h0 || left.inner.h1 != right.inner.h1 ||
        left.inner.h2 != right.inner.h2 || left.inner.h3 != right.inner.h3 ||
        left.inner.h4 != right.inner.h4 || left.inner.h5 != right.inner.h5 ||
        left.inner.h6 != right.inner.h6 || left.inner.h7 != right.inner.h7) {
        ret false;
    }
    var i: usize = 0;
    for (i < 64) {
        if (left.inner.buf[i] != right.inner.buf[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun equal_sha384(left: *hash.Sha384, right: *hash.Sha384) bool {
    if (left.state != right.state || left.inner.buf_len != right.inner.buf_len ||
        left.inner.total != right.inner.total) { ret false; }
    if (left.inner.h0:>u64 != right.inner.h0:>u64 || left.inner.h1:>u64 != right.inner.h1:>u64 ||
        left.inner.h2:>u64 != right.inner.h2:>u64 || left.inner.h3:>u64 != right.inner.h3:>u64 ||
        left.inner.h4:>u64 != right.inner.h4:>u64 || left.inner.h5:>u64 != right.inner.h5:>u64 ||
        left.inner.h6:>u64 != right.inner.h6:>u64 || left.inner.h7:>u64 != right.inner.h7:>u64) {
        ret false;
    }
    var i: usize = 0;
    for (i < 128) {
        if (left.inner.buf[i]:>u8 != right.inner.buf[i]:>u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun zero_sha256(context: *hash.Sha256) bool {
    if (context.state != hash.EMPTY || context.inner.buf_len != 0 ||
        context.inner.total != 0) { ret false; }
    if ((context.inner.h0 | context.inner.h1 | context.inner.h2 | context.inner.h3 |
        context.inner.h4 | context.inner.h5 | context.inner.h6 | context.inner.h7) != 0) {
        ret false;
    }
    var i: usize = 0;
    for (i < 64) {
        if (context.inner.buf[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun zero_sha384(context: *hash.Sha384) bool {
    if (context.state != hash.EMPTY || context.inner.buf_len != 0 ||
        context.inner.total != 0) { ret false; }
    if ((context.inner.h0:>u64 | context.inner.h1:>u64 | context.inner.h2:>u64 |
        context.inner.h3:>u64 | context.inner.h4:>u64 | context.inner.h5:>u64 |
        context.inner.h6:>u64 | context.inner.h7:>u64) != 0) {
        ret false;
    }
    var i: usize = 0;
    for (i < 128) {
        if (context.inner.buf[i]:>u8 != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

test hash__nist_empty_and_abc_vectors_preserve_snapshots {
    var empty256: [32]u8;
    var abc256:   [32]u8;
    var empty384: [48]u8;
    var abc384:   [48]u8;
    if (!decode_hex(
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"::*u8,
        64, ?empty256[0]) ||
        !decode_hex(
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"::*u8,
        64, ?abc256[0]) ||
        !decode_hex(
        "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"::*u8,
        96, ?empty384[0]) ||
        !decode_hex(
        "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"::*u8,
        96, ?abc384[0])) { ret 1; }

    var sha256: hash.Sha256 = hash.empty_sha256();
    var sha384: hash.Sha384 = hash.empty_sha384();
    var output: [48]u8;
    if (hash.snapshot_sha256(?sha256,
        contracts.Buffer{data: ?output[0], capacity: 48}).error !=
        contracts.INVALID_STATE ||
        hash.init_sha256(?sha256) != contracts.OK ||
        hash.init_sha384(?sha384) != contracts.OK) { ret 2; }
    if (hash.update_sha256(?sha256,
        contracts.Bytes{data: nil, len: 0}) != contracts.OK ||
        hash.update_sha384(?sha384,
        contracts.Bytes{data: nil, len: 0}) != contracts.OK) { ret 3; }
    var before256: hash.Sha256         = sha256;
    var before384: hash.Sha384         = sha384;
    var operation: contracts.Operation = hash.snapshot_sha256(?sha256,
        contracts.Buffer{data: ?output[0], capacity: 48});
    if (operation.error != contracts.OK || operation.written != 32 ||
        !equal(?output[0], ?empty256[0], 32) ||
        !equal_sha256(?sha256, ?before256)) { ret 4; }
    operation = hash.snapshot_sha384(?sha384,
        contracts.Buffer{data: ?output[0], capacity: 48});
    if (operation.error != contracts.OK || operation.written != 48 ||
        !equal(?output[0], ?empty384[0], 48) ||
        !equal_sha384(?sha384, ?before384)) { ret 5; }
    if (hash.update_sha256(?sha256,
        contracts.Bytes{data: "abc"::*u8, len: 3}) != contracts.OK ||
        hash.update_sha384(?sha384,
        contracts.Bytes{data: "abc"::*u8, len: 3}) != contracts.OK) { ret 6; }
    operation = hash.snapshot_sha256(?sha256,
        contracts.Buffer{data: ?output[0], capacity: 48});
    if (operation.error != contracts.OK || !equal(?output[0], ?abc256[0], 32)) {
        ret 7;
    }
    operation = hash.snapshot_sha384(?sha384,
        contracts.Buffer{data: ?output[0], capacity: 48});
    if (operation.error != contracts.OK || !equal(?output[0], ?abc384[0], 48)) {
        ret 8;
    }
    if (hash.destroy_sha256(?sha256) != contracts.OK ||
        hash.destroy_sha384(?sha384) != contracts.OK ||
        !zero_sha256(?sha256) || !zero_sha384(?sha384)) { ret 9; }
    ret 0;
}

test hash__splits_and_byte_fragments_match_nist_multiblock_vectors {
    val message: *u8 =
        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"::*u8;
    var expected256: [32]u8;
    var expected384: [48]u8;
    if (!decode_hex(
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"::*u8,
        64, ?expected256[0]) ||
        !decode_hex(
        "3391fdddfc8dc7393707a65b1b4709397cf8b1d162af05abfe8f450de5f36bc6b0455a8520bc4e6f5fe95b1fe3c8452b"::*u8,
        96, ?expected384[0])) { ret 1; }
    var output: [48]u8;
    var split:  usize = 0;
    for (split <= 56) {
        var sha256: hash.Sha256 = hash.empty_sha256();
        var sha384: hash.Sha384 = hash.empty_sha384();
        if (hash.init_sha256(?sha256) != contracts.OK ||
            hash.init_sha384(?sha384) != contracts.OK ||
            hash.update_sha256(?sha256,
            contracts.Bytes{data: message, len: split}) != contracts.OK ||
            hash.update_sha384(?sha384,
            contracts.Bytes{data: message, len: split}) != contracts.OK) { ret 2; }
        var tail: *u8 = nil;
        if (split < 56) { tail = ?message[split]; }
        if (hash.update_sha256(?sha256,
            contracts.Bytes{data: tail, len: 56 - split}) != contracts.OK ||
            hash.update_sha384(?sha384,
            contracts.Bytes{data: tail, len: 56 - split}) != contracts.OK) { ret 3; }
        if (hash.snapshot_sha256(?sha256,
            contracts.Buffer{data: ?output[0], capacity: 48}).error != contracts.OK ||
            !equal(?output[0], ?expected256[0], 32)) { ret 4; }
        if (hash.snapshot_sha384(?sha384,
            contracts.Buffer{data: ?output[0], capacity: 48}).error != contracts.OK ||
            !equal(?output[0], ?expected384[0], 48)) { ret 5; }
        hash.destroy_sha256(?sha256);
        hash.destroy_sha384(?sha384);
        split = split + 28;
    }

    var byte256: hash.Sha256 = hash.empty_sha256();
    var byte384: hash.Sha384 = hash.empty_sha384();
    if (hash.init_sha256(?byte256) != contracts.OK ||
        hash.init_sha384(?byte384) != contracts.OK) { ret 6; }
    var i: usize = 0;
    for (i < 56) {
        if (hash.update_sha256(?byte256,
            contracts.Bytes{data: ?message[i], len: 1}) != contracts.OK ||
            hash.update_sha384(?byte384,
            contracts.Bytes{data: ?message[i], len: 1}) != contracts.OK) { ret 7; }
        i = i + 1;
    }
    if (hash.final_sha256(?byte256,
        contracts.Buffer{data: ?output[0], capacity: 48}).error != contracts.OK ||
        !equal(?output[0], ?expected256[0], 32) || !zero_sha256(?byte256)) {
        ret 8;
    }
    if (hash.final_sha384(?byte384,
        contracts.Buffer{data: ?output[0], capacity: 48}).error != contracts.OK ||
        !equal(?output[0], ?expected384[0], 48) || !zero_sha384(?byte384)) {
        ret 9;
    }
    ret 0;
}

test hash__million_byte_nist_vectors_span_repeated_fragments {
    var expected256: [32]u8;
    var expected384: [48]u8;
    if (!decode_hex(
        "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"::*u8,
        64, ?expected256[0]) ||
        !decode_hex(
        "9d0e1809716474cb086e834e310a4a1ced149e9c00f248527972cec5704c2a5b07b8b3dc38ecc4ebae97ddd87f3d8985"::*u8,
        96, ?expected384[0])) { ret 1; }
    var fragment: [1000]u8;
    var i:        usize = 0;
    for (i < 1000) {
        fragment[i] = 'a';
        i           = i + 1;
    }
    var sha256: hash.Sha256 = hash.empty_sha256();
    var sha384: hash.Sha384 = hash.empty_sha384();
    if (hash.init_sha256(?sha256) != contracts.OK ||
        hash.init_sha384(?sha384) != contracts.OK) { ret 2; }
    i = 0;
    for (i < 1000) {
        if (hash.update_sha256(?sha256,
            contracts.Bytes{data: ?fragment[0], len: 1000}) != contracts.OK ||
            hash.update_sha384(?sha384,
            contracts.Bytes{data: ?fragment[0], len: 1000}) != contracts.OK) {
            ret 3;
        }
        i = i + 1;
    }
    var output: [48]u8;
    if (hash.final_sha256(?sha256,
        contracts.Buffer{data: ?output[0], capacity: 48}).error != contracts.OK ||
        !equal(?output[0], ?expected256[0], 32)) { ret 4; }
    if (hash.final_sha384(?sha384,
        contracts.Buffer{data: ?output[0], capacity: 48}).error != contracts.OK ||
        !equal(?output[0], ?expected384[0], 48)) { ret 5; }
    ret 0;
}

test hash__snapshot_continues_and_final_consumes_only_after_success {
    var abc256:    [32]u8;
    var abc384:    [48]u8;
    var abcdef256: [32]u8;
    var abcdef384: [48]u8;
    if (!decode_hex(
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"::*u8,
        64, ?abc256[0]) ||
        !decode_hex(
        "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"::*u8,
        96, ?abc384[0]) ||
        !decode_hex(
        "bef57ec7f53a6d40beb640a780a639c83bc29ac8a9816f1fc6c5c6dcd93c4721"::*u8,
        64, ?abcdef256[0]) ||
        !decode_hex(
        "c6a4c65b227e7387b9c3e839d44869c4cfca3ef583dea64117859b808c1e3d8ae689e1e314eeef52a6ffe22681aa11f5"::*u8,
        96, ?abcdef384[0])) { ret 1; }
    var sha256: hash.Sha256 = hash.empty_sha256();
    var sha384: hash.Sha384 = hash.empty_sha384();
    if (hash.init_sha256(?sha256) != contracts.OK ||
        hash.init_sha384(?sha384) != contracts.OK ||
        hash.update_sha256(?sha256,
        contracts.Bytes{data: "abc"::*u8, len: 3}) != contracts.OK ||
        hash.update_sha384(?sha384,
        contracts.Bytes{data: "abc"::*u8, len: 3}) != contracts.OK) { ret 2; }
    var before256: hash.Sha256 = sha256;
    var before384: hash.Sha384 = sha384;
    var output:    [48]u8;
    if (hash.snapshot_sha256(?sha256,
        contracts.Buffer{data: ?output[0], capacity: 48}).error != contracts.OK ||
        !equal(?output[0], ?abc256[0], 32) ||
        !equal_sha256(?sha256, ?before256)) { ret 3; }
    if (hash.snapshot_sha384(?sha384,
        contracts.Buffer{data: ?output[0], capacity: 48}).error != contracts.OK ||
        !equal(?output[0], ?abc384[0], 48) ||
        !equal_sha384(?sha384, ?before384)) { ret 4; }
    if (hash.update_sha256(?sha256,
        contracts.Bytes{data: "def"::*u8, len: 3}) != contracts.OK ||
        hash.update_sha384(?sha384,
        contracts.Bytes{data: "def"::*u8, len: 3}) != contracts.OK) { ret 5; }

    var sentinel: [48]u8;
    var i:        usize = 0;
    for (i < 48) {
        sentinel[i] = 0xa5;
        i           = i + 1;
    }
    before256 = sha256;
    before384 = sha384;
    if (hash.final_sha256(?sha256,
        contracts.Buffer{data: ?sentinel[0], capacity: 31}).error !=
        contracts.OUTPUT_TOO_SMALL || !filled(?sentinel[0], 0xa5, 48) ||
        !equal_sha256(?sha256, ?before256)) { ret 6; }
    if (hash.final_sha384(?sha384,
        contracts.Buffer{data: ?sentinel[0], capacity: 47}).error !=
        contracts.OUTPUT_TOO_SMALL || !filled(?sentinel[0], 0xa5, 48) ||
        !equal_sha384(?sha384, ?before384)) { ret 7; }
    if (hash.final_sha256(?sha256,
        contracts.Buffer{data: ?output[0], capacity: 48}).error != contracts.OK ||
        !equal(?output[0], ?abcdef256[0], 32) || !zero_sha256(?sha256)) {
        ret 8;
    }
    if (hash.final_sha384(?sha384,
        contracts.Buffer{data: ?output[0], capacity: 48}).error != contracts.OK ||
        !equal(?output[0], ?abcdef384[0], 48) || !zero_sha384(?sha384)) {
        ret 9;
    }
    if (hash.update_sha256(?sha256,
        contracts.Bytes{data: nil, len: 0}) != contracts.INVALID_STATE ||
        hash.snapshot_sha384(?sha384,
        contracts.Buffer{data: ?output[0], capacity: 48}).error !=
        contracts.INVALID_STATE || hash.init_sha256(?sha256) != contracts.OK ||
        hash.init_sha384(?sha384) != contracts.OK ||
        hash.destroy_sha256(?sha256) != contracts.OK ||
        hash.destroy_sha384(?sha384) != contracts.OK) { ret 10; }
    ret 0;
}

test hash__validation_and_overflow_failures_preserve_state_and_output {
    var sha256: hash.Sha256 = hash.empty_sha256();
    var sha384: hash.Sha384 = hash.empty_sha384();
    if (hash.init_sha256(?sha256) != contracts.OK ||
        hash.init_sha384(?sha384) != contracts.OK) { ret 1; }
    var before256: hash.Sha256 = sha256;
    var before384: hash.Sha384 = sha384;
    if (hash.init_sha256(?sha256) != contracts.INVALID_STATE ||
        hash.init_sha384(?sha384) != contracts.INVALID_STATE ||
        !equal_sha256(?sha256, ?before256) || !equal_sha384(?sha384, ?before384)) {
        ret 2;
    }
    if (hash.update_sha256(?sha256,
        contracts.Bytes{data: nil, len: 1}) != contracts.INVALID_INPUT ||
        hash.update_sha384(?sha384,
        contracts.Bytes{data: nil, len: 1}) != contracts.INVALID_INPUT ||
        !equal_sha256(?sha256, ?before256) || !equal_sha384(?sha384, ?before384)) {
        ret 3;
    }
    var output: [48]u8;
    var i:      usize = 0;
    for (i < 48) {
        output[i] = 0xa5;
        i         = i + 1;
    }
    if (hash.snapshot_sha256(?sha256,
        contracts.Buffer{data: nil, capacity: 32}).error != contracts.INVALID_INPUT ||
        hash.snapshot_sha384(?sha384,
        contracts.Buffer{data: nil, capacity: 48}).error != contracts.INVALID_INPUT ||
        !filled(?output[0], 0xa5, 48) ||
        !equal_sha256(?sha256, ?before256) || !equal_sha384(?sha384, ?before384)) {
        ret 4;
    }

    sha256.inner.total   = 0x1fffffffffffffff;
    sha256.inner.buf_len = 63;
    sha384.inner.total   = 1;
    sha384.inner.buf_len = 1;
    before256            = sha256;
    before384            = sha384;
    if (hash.update_sha256(?sha256,
        contracts.Bytes{data: ?output[0], len: 1}) != contracts.INVALID_INPUT ||
        hash.update_sha384(?sha384,
        contracts.Bytes{data: ?output[0], len: 0xffffffffffffffff}) !=
        contracts.INVALID_INPUT || !equal_sha256(?sha256, ?before256) ||
        !equal_sha384(?sha384, ?before384)) { ret 5; }

    if (hash.destroy_sha256(?sha256) != contracts.OK ||
        hash.destroy_sha384(?sha384) != contracts.OK ||
        hash.destroy_sha256(?sha256) != contracts.OK ||
        hash.destroy_sha384(?sha384) != contracts.OK ||
        !zero_sha256(?sha256) || !zero_sha384(?sha384)) { ret 6; }
    sha256.state    = 7;
    sha384.state    = 7;
    sha256.inner.h0 = 1;
    sha384.inner.h0 = 1;
    if (hash.destroy_sha256(?sha256) != contracts.INVALID_STATE ||
        hash.destroy_sha384(?sha384) != contracts.INVALID_STATE ||
        !zero_sha256(?sha256) || !zero_sha384(?sha384)) { ret 7; }
    if (hash.init_sha256(nil) != contracts.INVALID_INPUT ||
        hash.init_sha384(nil) != contracts.INVALID_INPUT ||
        hash.update_sha256(nil,
        contracts.Bytes{data: nil, len: 0}) != contracts.INVALID_INPUT ||
        hash.snapshot_sha384(nil,
        contracts.Buffer{data: ?output[0], capacity: 48}).error !=
        contracts.INVALID_INPUT || hash.destroy_sha256(nil) !=
        contracts.INVALID_INPUT) { ret 8; }
    ret 0;
}

# the operating system's secret allocators and entropy source

use crypto.contracts;
use crypto.secret.Allocator;
use crypto.secret.ArrayAllocator;
use crypto.secret.EMPTY;
use crypto.secret.Entropy;
use crypto.secret.Secret;
use crypto.secret.SecretArray;
use crypto.secret.array_active;
use crypto.secret.array_cleanup_pending;
use crypto.secret.array_data;
use crypto.secret.array_dnit;
use crypto.secret.array_init;
use crypto.secret.bytes;
use crypto.secret.dnit;
use crypto.secret.empty;
use crypto.secret.empty_array;
use crypto.secret.init;
use crypto.secret.init_random;
use crypto.system.allocator;
use crypto.system.entropy;
use secret_memory: std.memory.secret;
use std.runtime;
use std.types.size.usize;

#[testing]
rec DeepSecretLeaf {
    value: ^u64;
}

#[testing]
rec DeepSecretRecord {
    public: u64;
    nested: DeepSecretLeaf;
}

test system__native_allocator_and_entropy_initialize_usable_storage {
    # a host that cannot lock serves secret storage only once accepted, and locking is not what this checks
    secret_memory.accept_unlocked();
    var owner:  Allocator = allocator.make();
    var source: Entropy   = entropy.make();
    var secret: Secret    = empty();
    if (init_random(?secret, ?owner, 32, ?source) != contracts.OK) { ret 1; }
    var view: contracts.SecretBytes;
    if (bytes(?secret, 0, 32, ?view) != contracts.OK || view.data == nil || view.len != 32) {
        dnit(?secret);
        ret 2;
    }
    view.data[0]  = 0xA5;
    view.data[31] = 0x5A;
    if (view.data[0]:>u8 != 0xA5 || view.data[31]:>u8 != 0x5A) {
        dnit(?secret);
        ret 3;
    }
    if (dnit(?secret) != contracts.OK) { ret 4; }

    # std's allocation is the only zeroing init relies on here
    if (init(?secret, ?owner, 32) != contracts.OK) { ret 5; }
    var i: usize = 0;
    for (i < 32) {
        if (secret.data[i]:>u8 != 0) {
            dnit(?secret);
            ret 6;
        }
        i = i + 1;
    }
    if (dnit(?secret) != contracts.OK) { ret 7; }
    ret 0;
}

test system__native_allocator_owns_deeply_secret_records {
    # a host that cannot lock serves secret storage only once accepted, and locking is not what this checks
    secret_memory.accept_unlocked();
    var owner: ArrayAllocator[DeepSecretRecord] =
        allocator.make_array[DeepSecretRecord]();
    var array: SecretArray[DeepSecretRecord] = empty_array[DeepSecretRecord]();
    if (array_init[DeepSecretRecord](?array, ?owner, 2) != contracts.OK) { ret 1; }
    val data: *DeepSecretRecord = array_data[DeepSecretRecord](?array);
    if (data == nil || array.count != 2 ||
        array.bytes != $size_of(DeepSecretRecord) * 2) {
        array_dnit[DeepSecretRecord](?array);
        ret 2;
    }
    var i: usize = 0;
    for (i < 2) {
        if (data[i].public != 0 || data[i].nested.value:>u64 != 0) {
            array_dnit[DeepSecretRecord](?array);
            ret 3;
        }
        data[i].public       = (i + 1)::u64;
        data[i].nested.value = 0xB6B6B6B6B6B6B6B6;
        i                    = i + 1;
    }
    if (array_dnit[DeepSecretRecord](?array) != contracts.OK ||
        array.state != EMPTY || array_active[DeepSecretRecord](?array) ||
        array_cleanup_pending[DeepSecretRecord](?array)) { ret 4; }
    ret 0;
}

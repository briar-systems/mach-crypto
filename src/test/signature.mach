# ecdsa p-256 production contract tests

use crypto.contracts;
use crypto.group.p256;
use crypto.signature;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

#[testing]
fun public_equal(actual: *u8, expected: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun public_filled(actual: *u8, value: u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i] != value) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun nibble(byte: u8) u8 {
    if (byte >= '0' && byte <= '9') { ret byte - '0'; }
    if (byte >= 'a' && byte <= 'f') { ret byte - 'a' + 10; }
    if (byte >= 'A' && byte <= 'F') { ret byte - 'A' + 10; }
    ret 255;
}

#[testing]
fun decode_hex(text: *u8, text_len: usize, output: *u8) bool {
    if (text == nil || output == nil || text_len % 2 != 0) { ret false; }
    var i: usize = 0;
    for (i < text_len / 2) {
        val high: u8 = nibble(text[i * 2]);
        val low:  u8 = nibble(text[i * 2 + 1]);
        if (high == 255 || low == 255) { ret false; }
        output[i] = (high << 4) | low;
        i         = i + 1;
    }
    ret true;
}

#[testing]
fun copy_public(output: *u8, input: *u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        output[i] = input[i];
        i         = i + 1;
    }
}

#[testing]
fun pkcs1_hostile_rejected(public_key: signature.RsaPublicKey,
    message: contracts.Bytes, encoded: *u8) bool {
    var signature_bytes: [256]u8;
    var snapshot:        [256]u8;
    if (!decode_hex(encoded, 512, ?signature_bytes[0])) { ret false; }
    copy_public(?snapshot[0], ?signature_bytes[0], 256);
    val status: contracts.Error = signature.verify_rsa_pkcs1_sha256(public_key,
        message, contracts.Bytes{data: ?signature_bytes[0], len: 256});
    ret status == contracts.AUTH_FAILED &&
        public_equal(?signature_bytes[0], ?snapshot[0], 256);
}

#[testing]
fun pkcs1_sha384_hostile_rejected(public_key: signature.RsaPublicKey,
    message: contracts.Bytes, encoded: *u8) bool {
    var signature_bytes: [256]u8;
    var snapshot:        [256]u8;
    if (!decode_hex(encoded, 512, ?signature_bytes[0])) { ret false; }
    copy_public(?snapshot[0], ?signature_bytes[0], 256);
    val status: contracts.Error = signature.verify_rsa_pkcs1_sha384(public_key,
        message, contracts.Bytes{data: ?signature_bytes[0], len: 256});
    ret status == contracts.AUTH_FAILED &&
        public_equal(?signature_bytes[0], ?snapshot[0], 256);
}

#[testing]
fun set_rfc_private(output: *^u8) {
    val value: [32]u8 = [32]u8{
        0xc9, 0xaf, 0xa9, 0xd8, 0x45, 0xba, 0x75, 0x16,
        0x6b, 0x5c, 0x21, 0x57, 0x67, 0xb1, 0xd6, 0x93,
        0x4e, 0x50, 0xc3, 0xdb, 0x36, 0xe8, 0x9b, 0x12,
        0x7b, 0x8a, 0x62, 0x2b, 0x12, 0x0f, 0x67, 0x21
    };
    var i: usize = 0;
    for (i < 32) {
        output[i] = value[i];
        i         = i + 1;
    }
}

test ecdsa_p_256__rfc_6979_sha_256_sample {
    var private_key: [32]^u8 = [32]^u8{
        0xc9, 0xaf, 0xa9, 0xd8, 0x45, 0xba, 0x75, 0x16,
        0x6b, 0x5c, 0x21, 0x57, 0x67, 0xb1, 0xd6, 0x93,
        0x4e, 0x50, 0xc3, 0xdb, 0x36, 0xe8, 0x9b, 0x12,
        0x7b, 0x8a, 0x62, 0x2b, 0x12, 0x0f, 0x67, 0x21
    };
    val public_key: [65]u8 = [65]u8{
        0x04,
        0x60, 0xfe, 0xd4, 0xba, 0x25, 0x5a, 0x9d, 0x31,
        0xc9, 0x61, 0xeb, 0x74, 0xc6, 0x35, 0x6d, 0x68,
        0xc0, 0x49, 0xb8, 0x92, 0x3b, 0x61, 0xfa, 0x6c,
        0xe6, 0x69, 0x62, 0x2e, 0x60, 0xf2, 0x9f, 0xb6,
        0x79, 0x03, 0xfe, 0x10, 0x08, 0xb8, 0xbc, 0x99,
        0xa4, 0x1a, 0xe9, 0xe9, 0x56, 0x28, 0xbc, 0x64,
        0xf2, 0xf1, 0xb2, 0x0c, 0x2d, 0x7e, 0x9f, 0x51,
        0x77, 0xa3, 0xc2, 0x94, 0xd4, 0x46, 0x22, 0x99
    };
    val expected: [72]u8 = [72]u8{
        0x30, 0x46, 0x02, 0x21, 0x00,
        0xef, 0xd4, 0x8b, 0x2a, 0xac, 0xb6, 0xa8, 0xfd,
        0x11, 0x40, 0xdd, 0x9c, 0xd4, 0x5e, 0x81, 0xd6,
        0x9d, 0x2c, 0x87, 0x7b, 0x56, 0xaa, 0xf9, 0x91,
        0xc3, 0x4d, 0x0e, 0xa8, 0x4e, 0xaf, 0x37, 0x16,
        0x02, 0x21, 0x00,
        0xf7, 0xcb, 0x1c, 0x94, 0x2d, 0x65, 0x7c, 0x41,
        0xd4, 0x36, 0xc7, 0xa1, 0xb6, 0xe2, 0x9f, 0x65,
        0xf3, 0xe9, 0x00, 0xdb, 0xb9, 0xaf, 0xf4, 0x06,
        0x4d, 0xc4, 0xab, 0x2f, 0x84, 0x3a, 0xcd, 0xa8
    };
    val message:   [6]u8               = [6]u8{'s', 'a', 'm', 'p', 'l', 'e'};
    var derived:   [65]u8;
    var operation: contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: ?derived[0], capacity: 65});
    if (operation.error != contracts.OK || operation.written != 65 ||
        !public_equal(?derived[0], (?public_key[0]):~*u8, 65)) { ret 1; }
    var encoded: [72]u8;
    operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 6},
        contracts.Buffer{data: ?encoded[0], capacity: 72});
    if (operation.error != contracts.OK || operation.written != 72 ||
        !public_equal(?encoded[0], (?expected[0]):~*u8, 72)) { ret 2; }
    val verified: contracts.Error = signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: (?public_key[0]):~*u8, len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 6},
        contracts.Bytes{data: ?encoded[0], len: operation.written});
    if (verified != contracts.OK) { ret 3; }
    ret 0;
}

test ecdsa_p_256__deterministic_signing_and_failures_preserve_output {
    var private_key: [32]^u8;
    set_rfc_private(?private_key[0]);
    val sample: [6]u8 = [6]u8{'s', 'a', 'm', 'p', 'l', 'e'};
    var first:  [72]u8;
    var second: [72]u8;
    var i:      usize = 0;
    for (i < 72) {
        first[i]  = 0xa5;
        second[i] = 0x5a;
        i         = i + 1;
    }
    var result: contracts.Operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?sample[0]):~*u8, len: 6},
        contracts.Buffer{data: ?first[0], capacity: 72});
    if (result.error != contracts.OK || result.written != 72) { ret 1; }
    val again: contracts.Operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?sample[0]):~*u8, len: 6},
        contracts.Buffer{data: ?second[0], capacity: 72});
    if (again.error != contracts.OK || again.written != result.written ||
        !public_equal(?first[0], ?second[0], result.written)) { ret 2; }

    i = 0;
    for (i < 72) {
        second[i] = 0x5a;
        i         = i + 1;
    }
    result = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?sample[0]):~*u8, len: 6},
        contracts.Buffer{data: ?second[0], capacity: 71});
    if (result.error != contracts.OUTPUT_TOO_SMALL || result.written != 0 ||
        !public_filled(?second[0], 0x5a, 72)) { ret 3; }

    i = 0;
    for (i < 32) {
        private_key[i] = 0;
        i              = i + 1;
    }
    result = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?sample[0]):~*u8, len: 6},
        contracts.Buffer{data: ?second[0], capacity: 72});
    if (result.error != contracts.INVALID_KEY || result.written != 0 ||
        !public_filled(?second[0], 0x5a, 72)) { ret 4; }

    set_rfc_private(?private_key[0]);
    result = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: nil, len: 1},
        contracts.Buffer{data: ?second[0], capacity: 72});
    if (result.error != contracts.INVALID_INPUT || result.written != 0 ||
        !public_filled(?second[0], 0x5a, 72)) { ret 5; }
    ret 0;
}

test ecdsa_p_256__empty_messages_and_high_s_signatures_verify {
    var private_key: [32]^u8;
    set_rfc_private(?private_key[0]);
    var public_key:      [65]u8;
    var signature_bytes: [72]u8;
    var operation:       contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: ?public_key[0], capacity: 65});
    if (operation.error != contracts.OK) { ret 1; }
    operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: nil, len: 0},
        contracts.Buffer{data: ?signature_bytes[0], capacity: 72});
    if (operation.error != contracts.OK) { ret 2; }
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: nil, len: 0},
        contracts.Bytes{data: ?signature_bytes[0], len: operation.written}) != contracts.OK) {
        ret 3;
    }
    ret 0;
}

test ecdsa_p_256__wycheproof_style_tampering_and_strict_der_rejection {
    var private_key: [32]^u8;
    var i:           usize = 0;
    for (i < 32) {
        private_key[i] = 0;
        i              = i + 1;
    }
    private_key[31] = 1;
    var public_key: [65]u8;
    val message:    [4]u8               = [4]u8{'t', 'e', 's', 't'};
    var encoded:    [73]u8;
    var operation:  contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: ?public_key[0], capacity: 65});
    if (operation.error != contracts.OK) { ret 1; }
    operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Buffer{data: ?encoded[0], capacity: 72});
    if (operation.error != contracts.OK) { ret 2; }
    val encoded_len: usize = operation.written;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 3},
        contracts.Bytes{data: ?encoded[0], len: encoded_len}) != contracts.AUTH_FAILED) {
        ret 3;
    }
    encoded[encoded_len - 1] = encoded[encoded_len - 1] ^ 1;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?encoded[0], len: encoded_len}) != contracts.AUTH_FAILED) {
        ret 4;
    }
    encoded[encoded_len - 1] = encoded[encoded_len - 1] ^ 1;
    encoded[encoded_len]     = 0;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?encoded[0], len: encoded_len + 1}) != contracts.AUTH_FAILED) {
        ret 5;
    }
    encoded[1] = encoded[1] - 1;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?encoded[0], len: encoded_len}) != contracts.AUTH_FAILED) {
        ret 6;
    }
    encoded[1]     = encoded[1] + 1;
    public_key[64] = public_key[64] ^ 1;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?encoded[0], len: encoded_len}) != contracts.INVALID_KEY) {
        ret 7;
    }
    public_key[64] = public_key[64] ^ 1;

    var malformed: [40]u8;
    i = 0;
    for (i < 40) {
        malformed[i] = 0;
        i            = i + 1;
    }
    malformed[0] = 0x30;
    malformed[1] = 0x06;
    malformed[2] = 0x02;
    malformed[3] = 0x01;
    malformed[4] = 0x00;
    malformed[5] = 0x02;
    malformed[6] = 0x01;
    malformed[7] = 0x01;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?malformed[0], len: 8}) != contracts.AUTH_FAILED) {
        ret 8;
    }
    malformed[1] = 0x07;
    malformed[3] = 0x02;
    malformed[4] = 0x00;
    malformed[5] = 0x01;
    malformed[6] = 0x02;
    malformed[7] = 0x01;
    malformed[8] = 0x01;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?malformed[0], len: 9}) != contracts.AUTH_FAILED) {
        ret 9;
    }
    malformed[1] = 0x06;
    malformed[3] = 0x01;
    malformed[4] = 0x80;
    malformed[5] = 0x02;
    malformed[6] = 0x01;
    malformed[7] = 0x01;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?malformed[0], len: 8}) != contracts.AUTH_FAILED) {
        ret 10;
    }
    val order: [32]u8 = [32]u8{
        0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        0xbc, 0xe6, 0xfa, 0xad, 0xa7, 0x17, 0x9e, 0x84,
        0xf3, 0xb9, 0xca, 0xc2, 0xfc, 0x63, 0x25, 0x51
    };
    malformed[0] = 0x30;
    malformed[1] = 0x26;
    malformed[2] = 0x02;
    malformed[3] = 0x21;
    malformed[4] = 0;
    i            = 0;
    for (i < 32) {
        malformed[5 + i] = order[i];
        i                = i + 1;
    }
    malformed[37] = 0x02;
    malformed[38] = 0x01;
    malformed[39] = 0x01;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?malformed[0], len: 40}) != contracts.AUTH_FAILED) {
        ret 11;
    }
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: nil, len: 0}) != contracts.AUTH_FAILED) {
        ret 12;
    }
    ret 0;
}

#[testing]
fun set_nist_p384_public(output: *u8) bool {
    ret decode_hex(
        "043bf701bc9e9d36b4d5f1455343f09126f2564390f2b487365071243c61e6471fb9d2ab74657b82f9086489d9ef0f5cb5d1a358eafbf952e68d533855ccbdaa6ff75b137a5101443199325583552a6295ffe5382d00cfcda30344a9b5b68db855"::*u8,
        194, output);
}

#[testing]
fun set_nist_p384_signature(output: *u8) bool {
    ret decode_hex(
        "3065023030ea514fc0d38d8208756f068113c7cada9f66a3b40ea3b313d040d9b57dd41a332795d02cc7d507fcef9faf01a27088023100cc808e504be414f46c9027bcbf78adf067a43922d6fcaa66c4476875fbb7b94efd1f7d5dbe620bfb821c46d549683ad8"::*u8,
        206, output);
}

test ecdsa_p_384__nist_sha_384_verification_vector {
    if (signature.algorithm_status(signature.ECDSA_P384_SHA384) != contracts.OK ||
        signature.ECDSA_P384_PUBLIC_KEY_SIZE != 97 ||
        signature.ECDSA_P384_SIGNATURE_MIN_SIZE != 8 ||
        signature.ECDSA_P384_SIGNATURE_MAX_SIZE != 104) { ret 1; }
    var public_key: [97]u8;
    var encoded:    [103]u8;
    if (!set_nist_p384_public(?public_key[0]) ||
        !set_nist_p384_signature(?encoded[0])) { ret 2; }
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97},
        contracts.Bytes{data: "Example of ECDSA with P-384"::*u8, len: 27},
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.OK) { ret 3; }
    ret 0;
}

#[testing]
fun set_openssl_p384_public(output: *u8) bool {
    ret decode_hex(
        "049816a286606cea1874f2f550d4121c96027902525ddbbca64f7d720f58218f2a84bcf9767890e6e9e4bdf0b328d37892f2565f1ebf645970e24c194b47c797bca53720c2c6fcc9c065ca85d3f23a89bfaf5209247c536d6facd3102f0bb17209"::*u8,
        194, output);
}

#[testing]
fun set_openssl_p384_signature(output: *u8) bool {
    ret decode_hex(
        "306502303adc7480a491147009ff35616cef36c90a3724b915deb9ad1b807e44d568e221da28d876ef3b3de4b664a3ce2901244b023100e1d37af608875c086063043afa1500fb2c6b15955feff2a2f28b35d331d3331cec7740e56b6875042790371a4ef5ee9c"::*u8,
        206, output);
}

test ecdsa_p_384__independent_openssl_vector_rejects_tampering {
    var public_key: [97]u8;
    var encoded:    [103]u8;
    var message:    [32]u8;
    copy_public(?message[0], "mach-crypto P-384 OpenSSL vector"::*u8, 32);
    if (!set_openssl_p384_public(?public_key[0]) ||
        !set_openssl_p384_signature(?encoded[0])) { ret 1; }
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97},
        contracts.Bytes{data: ?message[0], len: 32},
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.OK) { ret 2; }

    message[31] = message[31] ^ 1;
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97},
        contracts.Bytes{data: ?message[0], len: 32},
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.AUTH_FAILED) {
        ret 3;
    }
    message[31]  = message[31] ^ 1;
    encoded[102] = encoded[102] ^ 1;
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97},
        contracts.Bytes{data: ?message[0], len: 32},
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.AUTH_FAILED) {
        ret 4;
    }
    encoded[102]   = encoded[102] ^ 1;
    public_key[96] = public_key[96] ^ 1;
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97},
        contracts.Bytes{data: ?message[0], len: 32},
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.INVALID_KEY) {
        ret 5;
    }
    ret 0;
}

test ecdsa_p_384__scalars_strict_der_points_and_nil_inputs_are_bounded {
    var public_key: [97]u8;
    var encoded:    [104]u8;
    if (!set_nist_p384_public(?public_key[0]) ||
        !set_nist_p384_signature(?encoded[0])) { ret 1; }
    val message: contracts.Bytes = contracts.Bytes{
        data: "Example of ECDSA with P-384"::*u8, len: 27
    };

    var i: usize = 0;
    for (i < 103) {
        if (signature.verify_ecdsa_p384_sha384(
            contracts.Bytes{data: ?public_key[0], len: 97}, message,
            contracts.Bytes{data: ?encoded[0], len: i}) != contracts.AUTH_FAILED) {
            ret 2;
        }
        i = i + 1;
    }
    encoded[103] = 0;
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: ?encoded[0], len: 104}) != contracts.AUTH_FAILED) {
        ret 3;
    }
    encoded[0] = 0x31;
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.AUTH_FAILED) {
        ret 4;
    }
    encoded[0] = 0x30;
    encoded[4] = 0x80;
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.AUTH_FAILED) {
        ret 5;
    }

    var noncanonical: [104]u8;
    noncanonical[0] = 0x30;
    noncanonical[1] = 0x66;
    noncanonical[2] = 0x02;
    noncanonical[3] = 0x31;
    noncanonical[4] = 0;
    if (!set_nist_p384_signature(?encoded[0])) { ret 6; }
    i = 4;
    for (i < 103) {
        noncanonical[i + 1] = encoded[i];
        i                   = i + 1;
    }
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: ?noncanonical[0], len: 104}) !=
        contracts.AUTH_FAILED) { ret 7; }

    var missing_prefix: [102]u8;
    i = 0;
    for (i < 54) {
        missing_prefix[i] = encoded[i];
        i                 = i + 1;
    }
    missing_prefix[1]  = 0x64;
    missing_prefix[53] = 0x30;
    i                  = 55;
    for (i < 103) {
        missing_prefix[i - 1] = encoded[i];
        i                     = i + 1;
    }
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: ?missing_prefix[0], len: 102}) !=
        contracts.AUTH_FAILED) { ret 8; }

    var scalar: [56]u8;
    if (!decode_hex(
        "3036023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973020101"::*u8,
        112, ?scalar[0]) ||
        signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: ?scalar[0], len: 56}) != contracts.AUTH_FAILED) {
        ret 9;
    }
    if (!decode_hex(
        "3036020101023100ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"::*u8,
        112, ?scalar[0]) ||
        signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: ?scalar[0], len: 56}) != contracts.AUTH_FAILED) {
        ret 10;
    }
    val zero_scalar: [8]u8 = [8]u8{
        0x30, 0x06, 0x02, 0x01, 0x00, 0x02, 0x01, 0x01
    };
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: (?zero_scalar[0]):~*u8, len: 8}) !=
        contracts.AUTH_FAILED) { ret 11; }

    public_key[0] = 0x02;
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.INVALID_KEY) {
        ret 12;
    }
    public_key[0]  = 0x04;
    public_key[96] = public_key[96] ^ 1;
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.INVALID_KEY) {
        ret 13;
    }
    if (!set_nist_p384_public(?public_key[0]) || !decode_hex(
        "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff"::*u8,
        96, ?public_key[1]) || signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.INVALID_KEY) {
        ret 16;
    }
    if (!set_nist_p384_public(?public_key[0])) { ret 17; }
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 96}, message,
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.INVALID_KEY ||
        signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 98}, message,
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.INVALID_KEY) {
        ret 14;
    }
    if (signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: nil, len: 97}, message,
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.INVALID_INPUT ||
        signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97},
        contracts.Bytes{data: nil, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 103}) != contracts.INVALID_INPUT ||
        signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: nil, len: 1}) != contracts.INVALID_INPUT ||
        signature.verify_ecdsa_p384_sha384(
        contracts.Bytes{data: ?public_key[0], len: 97}, message,
        contracts.Bytes{data: nil, len: 0}) != contracts.AUTH_FAILED) { ret 15; }
    ret 0;
}

#[testing]
fun ecdsa_case(curve: signature.Curve, hash: signature.Hash, key: *u8, key_len: usize,
    message: *u8, message_len: usize, encoded: *u8, encoded_len: usize,
    valid: bool) bool {
    var key_bytes:       [133]u8;
    var message_bytes:   [128]u8;
    var signature_bytes: [192]u8;
    if (!decode_hex(key, key_len, ?key_bytes[0]) ||
        !decode_hex(message, message_len, ?message_bytes[0]) ||
        !decode_hex(encoded, encoded_len, ?signature_bytes[0])) { ret false; }
    val result: contracts.Error = signature.verify_ecdsa(curve, hash,
        contracts.Bytes{data: ?key_bytes[0], len: key_len / 2},
        contracts.Bytes{data: ?message_bytes[0], len: message_len / 2},
        contracts.Bytes{data: ?signature_bytes[0], len: encoded_len / 2});
    ret (result == contracts.OK) == valid;
}

#[testing]
fun ecdsa_digest_case(curve: signature.Curve, key: *u8, key_len: usize, digest: *u8,
    digest_len: usize, encoded: *u8, encoded_len: usize, valid: bool) bool {
    var key_bytes:       [133]u8;
    var digest_bytes:    [64]u8;
    var signature_bytes: [192]u8;
    if (!decode_hex(key, key_len, ?key_bytes[0]) ||
        !decode_hex(digest, digest_len, ?digest_bytes[0]) ||
        !decode_hex(encoded, encoded_len, ?signature_bytes[0])) { ret false; }
    val result: contracts.Error = signature.verify_ecdsa_digest(curve,
        contracts.Bytes{data: ?key_bytes[0], len: key_len / 2},
        contracts.Bytes{data: ?digest_bytes[0], len: digest_len / 2},
        contracts.Bytes{data: ?signature_bytes[0], len: encoded_len / 2});
    ret (result == contracts.OK) == valid;
}


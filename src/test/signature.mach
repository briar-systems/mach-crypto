        0x65, 0x7a, 0xac, 0x63, 0x9f, 0x84, 0x2a, 0x2c, 0xcc, 0x34, 0x7b, 0xac,
        0xed, 0x66, 0xb9, 0x8f, 0xb8, 0x84, 0x45, 0x05, 0x13, 0x6b, 0x63, 0x30,
        0xbe, 0xb9, 0x7e, 0x05, 0x81, 0x1a, 0x20, 0xe2, 0xb8, 0xa2, 0x88, 0x36,
        0xad, 0x9c, 0xa1, 0xe1, 0x3c, 0x54, 0x7c, 0x0a, 0x4b, 0x33, 0xd7, 0xc8,
        0xac, 0xec, 0x6d, 0xd3, 0x2f, 0x2f, 0x71, 0x83
    };
    val exponent: [3]u8           = [3]u8{0x01, 0x00, 0x01};
    val message:  contracts.Bytes = contracts.Bytes{
        data: "half-limb modulus differential"::*u8, len: 30
    };
    val public_key: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus:  contracts.Bytes{data: (?modulus[0]):~*u8, len: 260},
        exponent: contracts.Bytes{data: (?exponent[0]):~*u8, len: 3}
    };
    if (signature.verify_rsa_pss_sha256(public_key, message,
        contracts.Bytes{data: (?openssl_signature[0]):~*u8, len: 260}) !=
        contracts.OK) { ret 1; }
    var tampered: [260]u8;
    var i:        usize = 0;
    for (i < 260) {
        tampered[i] = openssl_signature[i];
        i           = i + 1;
    }
    tampered[259] = tampered[259] ^ 1;
    if (signature.verify_rsa_pss_sha256(public_key, message,
        contracts.Bytes{data: ?tampered[0], len: 260}) != contracts.AUTH_FAILED) { ret 2; }
    val private_key: signature.RsaPrivateKey = signature.RsaPrivateKey{
        modulus:          contracts.Bytes{data: (?modulus[0]):~*u8, len: 260},
        public_exponent:  contracts.Bytes{data: (?exponent[0]):~*u8, len: 3},
        private_exponent: contracts.SecretBytes{data: ?private_exponent[0], len: 260}
    };
    var salt: [32]^u8;
    i = 0;
    for (i < 32) {
        salt[i] = (i * 3)::u8;
        i       = i + 1;
    }
    var made:      [260]u8;
    val operation: contracts.Operation = signature.sign_rsa_pss_sha256(private_key,
        message, contracts.SecretBytes{data: ?salt[0], len: 32},
        contracts.Buffer{data: ?made[0], capacity: 260});
    if (operation.error != contracts.OK || operation.written != 260) { ret 3; }
    if (signature.verify_rsa_pss_sha256(public_key, message,
        contracts.Bytes{data: ?made[0], len: 260}) != contracts.OK) { ret 4; }
    ret 0;
}


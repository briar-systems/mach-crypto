        0x70, 0x3b, 0xac, 0x03, 0x1c, 0xae, 0x7f, 0x60
    };
    val first_public: [32]u8 = [32]u8{
        0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7,
        0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a,
        0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25,
        0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a
    };
    val first_signature: [64]u8 = [64]u8{
        0xe5, 0x56, 0x43, 0x00, 0xc3, 0x60, 0xac, 0x72,
        0x90, 0x86, 0xe2, 0xcc, 0x80, 0x6e, 0x82, 0x8a,
        0x84, 0x87, 0x7f, 0x1e, 0xb8, 0xe5, 0xd9, 0x74,
        0xd8, 0x73, 0xe0, 0x65, 0x22, 0x49, 0x01, 0x55,
        0x5f, 0xb8, 0x82, 0x15, 0x90, 0xa3, 0x3b, 0xac,
        0xc6, 0x1e, 0x39, 0x70, 0x1c, 0xf9, 0xb4, 0x6b,
        0xd2, 0x5b, 0xf5, 0xf0, 0x59, 0x5b, 0xbe, 0x24,
        0x65, 0x51, 0x41, 0x43, 0x8e, 0x7a, 0x10, 0x0b
    };
    var derived:   [32]u8;
    var encoded:   [64]u8;
    var operation: contracts.Operation = signature.derive_ed25519_public(
        contracts.SecretBytes{data: ?first_seed[0], len: 32},
        contracts.Buffer{data: ?derived[0], capacity: 32});
    if (operation.error != contracts.OK || operation.written != 32 ||
        !public_equal(?derived[0], (?first_public[0]):~*u8, 32)) { ret 1; }
    operation = signature.sign_ed25519(
        contracts.SecretBytes{data: ?first_seed[0], len: 32},
        contracts.Bytes{data: nil, len: 0},
        contracts.Buffer{data: ?encoded[0], capacity: 64});
    if (operation.error != contracts.OK || operation.written != 64 ||
        !public_equal(?encoded[0], (?first_signature[0]):~*u8, 64)) { ret 2; }
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?first_public[0]):~*u8, len: 32},
        contracts.Bytes{data: nil, len: 0},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.OK) { ret 3; }

    var second_seed: [32]^u8 = [32]^u8{
        0x4c, 0xcd, 0x08, 0x9b, 0x28, 0xff, 0x96, 0xda,
        0x9d, 0xb6, 0xc3, 0x46, 0xec, 0x11, 0x4e, 0x0f,
        0x5b, 0x8a, 0x31, 0x9f, 0x35, 0xab, 0xa6, 0x24,
        0xda, 0x8c, 0xf6, 0xed, 0x4f, 0xb8, 0xa6, 0xfb
    };
    val second_public: [32]u8 = [32]u8{
        0x3d, 0x40, 0x17, 0xc3, 0xe8, 0x43, 0x89, 0x5a,
        0x92, 0xb7, 0x0a, 0xa7, 0x4d, 0x1b, 0x7e, 0xbc,
        0x9c, 0x98, 0x2c, 0xcf, 0x2e, 0xc4, 0x96, 0x8c,
        0xc0, 0xcd, 0x55, 0xf1, 0x2a, 0xf4, 0x66, 0x0c
    };
    val second_signature: [64]u8 = [64]u8{
        0x92, 0xa0, 0x09, 0xa9, 0xf0, 0xd4, 0xca, 0xb8,
        0x72, 0x0e, 0x82, 0x0b, 0x5f, 0x64, 0x25, 0x40,
        0xa2, 0xb2, 0x7b, 0x54, 0x16, 0x50, 0x3f, 0x8f,
        0xb3, 0x76, 0x22, 0x23, 0xeb, 0xdb, 0x69, 0xda,
        0x08, 0x5a, 0xc1, 0xe4, 0x3e, 0x15, 0x99, 0x6e,
        0x45, 0x8f, 0x36, 0x13, 0xd0, 0xf1, 0x1d, 0x8c,
        0x38, 0x7b, 0x2e, 0xae, 0xb4, 0x30, 0x2a, 0xee,
        0xb0, 0x0d, 0x29, 0x16, 0x12, 0xbb, 0x0c, 0x00
    };
    val message: [1]u8 = [1]u8{0x72};
    operation = signature.derive_ed25519_public(
        contracts.SecretBytes{data: ?second_seed[0], len: 32},
        contracts.Buffer{data: ?derived[0], capacity: 32});
    if (operation.error != contracts.OK ||
        !public_equal(?derived[0], (?second_public[0]):~*u8, 32)) { ret 4; }
    operation = signature.sign_ed25519(
        contracts.SecretBytes{data: ?second_seed[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Buffer{data: ?encoded[0], capacity: 64});
    if (operation.error != contracts.OK ||
        !public_equal(?encoded[0], (?second_signature[0]):~*u8, 64)) { ret 5; }
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?second_public[0]):~*u8, len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.OK) { ret 6; }
    encoded[63] = encoded[63] ^ 1;
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?second_public[0]):~*u8, len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.AUTH_FAILED) { ret 7; }
    encoded[63] = encoded[63] ^ 1;
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?second_public[0]):~*u8, len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 63}) != contracts.AUTH_FAILED) { ret 8; }
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?second_public[0]):~*u8, len: 31},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.INVALID_KEY) { ret 9; }
    var identity:     [32]u8;
    var noncanonical: [32]u8;
    var i:            usize = 0;
    for (i < 32) {
        identity[i]     = 0;
        noncanonical[i] = 0xff;
        i               = i + 1;
    }
    identity[0]      = 1;
    noncanonical[0]  = 0xed;
    noncanonical[31] = 0x7f;
    if (signature.verify_ed25519(
        contracts.Bytes{data: ?identity[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.INVALID_KEY) { ret 10; }
    if (signature.verify_ed25519(
        contracts.Bytes{data: ?noncanonical[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.INVALID_KEY) { ret 11; }
    val order: [32]u8 = [32]u8{
        0xed, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58,
        0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10
    };
    i = 0;
    for (i < 32) {
        encoded[32 + i] = order[i];
        i               = i + 1;
    }
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?second_public[0]):~*u8, len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.AUTH_FAILED) { ret 12; }
    i = 0;
    for (i < 64) {
        encoded[i] = 0xa5;
        i          = i + 1;
    }
    operation = signature.sign_ed25519(
        contracts.SecretBytes{data: ?second_seed[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Buffer{data: ?encoded[0], capacity: 63});
    if (operation.error != contracts.OUTPUT_TOO_SMALL || operation.written != 0 ||
        !public_filled(?encoded[0], 0xa5, 64)) { ret 13; }
    var overlap: [64]u8;
    overlap[0] = 0x72;
    operation  = signature.sign_ed25519(
        contracts.SecretBytes{data: ?second_seed[0], len: 32},
        contracts.Bytes{data: ?overlap[0], len: 1},
        contracts.Buffer{data: ?overlap[0], capacity: 64});
    if (operation.error != contracts.OK ||
        !public_equal(?overlap[0], (?second_signature[0]):~*u8, 64)) { ret 14; }
    i = 0;
    for (i < 32) {
        derived[i] = 0x5a;
        i          = i + 1;
    }
    operation = signature.derive_ed25519_public(
        contracts.SecretBytes{data: ?second_seed[0], len: 32},
        contracts.Buffer{data: ?derived[0], capacity: 31});
    if (operation.error != contracts.OUTPUT_TOO_SMALL || operation.written != 0 ||
        !public_filled(?derived[0], 0x5a, 32)) { ret 16; }
    operation = signature.sign_ed25519(
        contracts.SecretBytes{data: ?second_seed[0], len: 31},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Buffer{data: ?encoded[0], capacity: 64});
    if (operation.error != contracts.INVALID_KEY || operation.written != 0) { ret 17; }
    ret 0;
}


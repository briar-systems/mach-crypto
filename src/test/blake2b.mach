test blake2b__invalid_inputs_are_retryable_and_final_consumes_state {
    var context: hash.Blake2b     = hash.empty_blake2b();
    var output:  [64]u8;
    val buffer:  contracts.Buffer = contracts.Buffer{data: ?output[0], capacity: 64};
    if (hash.init_blake2b(nil, blake2b.params(64)) != contracts.INVALID_INPUT)                                                                                                 { ret 1; }
    if (hash.init_blake2b(?context, blake2b.params(0)) != contracts.INVALID_INPUT || context.state != hash.EMPTY)                                                              { ret 2; }
    if (hash.init_blake2b(?context, blake2b.params(65)) != contracts.INVALID_INPUT || context.state != hash.EMPTY)                                                             { ret 3; }
    if (hash.update_blake2b(?context, contracts.Bytes{data: nil, len: 0}) != contracts.INVALID_STATE)                                                                          { ret 4; }
    if (hash.init_blake2b(?context, blake2b.params(64)) != contracts.OK)                                                                                                       { ret 5; }
    if (hash.init_blake2b(?context, blake2b.params(64)) != contracts.INVALID_STATE)                                                                                            { ret 6; }
    if (hash.update_blake2b(?context, contracts.Bytes{data: nil, len: 1}) != contracts.INVALID_INPUT)                                                                          { ret 7; }
    if (hash.update_blake2b(?context, contracts.Bytes{data: nil, len: 0}) != contracts.OK)                                                                                     { ret 8; }
    if (hash.final_blake2b(?context, contracts.Buffer{data: ?output[0], capacity: 63}).error != contracts.OUTPUT_TOO_SMALL)                                                    { ret 9; }
    if (hash.final_blake2b(?context, contracts.Buffer{data: nil, capacity: 64}).error != contracts.INVALID_INPUT)                                                              { ret 10; }
    if (hash.update_blake2b(?context, contracts.Bytes{data: "abc"::*u8, len: 3}) != contracts.OK)                                                                              { ret 11; }
    if (hash.final_blake2b(?context, buffer).error != contracts.OK)                                                                                                            { ret 12; }
    if (matches(?output[0], "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"::*u8, 64) == 0) { ret 13; }
    if (hash.final_blake2b(?context, buffer).error != contracts.INVALID_STATE)                                                                                                 { ret 14; }
    if (hash.destroy_blake2b(?context) != contracts.OK || hash.destroy_blake2b(?context) != contracts.OK)                                                                      { ret 15; }
    if (hash.init_blake2b(?context, blake2b.params(32)) != contracts.OK)                                                                                                       { ret 16; }
    var deep: blake2b.Params = blake2b.params(32);
    deep.depth = 0;
    if (hash.digest_blake2b(deep, contracts.Bytes{data: nil, len: 0}, buffer).error != contracts.INVALID_INPUT) { ret 17; }
    deep           = blake2b.params(32);
    deep.inner_len = 65;
    if (hash.digest_blake2b(deep, contracts.Bytes{data: nil, len: 0}, buffer).error != contracts.INVALID_INPUT) { ret 18; }
    context.inner.buf_len = 129;
    if (hash.final_blake2b(?context, buffer).error != contracts.INVALID_STATE) { ret 19; }
    if (hash.destroy_blake2b(?context) != contracts.OK)                        { ret 20; }
    var i: usize = 0;
    for (i < 8) {
        if (context.inner.h[i] != 0) { ret 21; }
        i = i + 1;
    }
    i = 0;
    for (i < 128) {
        if (context.inner.buf[i] != 0) { ret 22; }
        i = i + 1;
    }
    ret 0;
}

test blake2b__hashlib_megabyte_byte_fragments {
    var context: hash.Blake2b = hash.empty_blake2b();
    if (hash.init_blake2b(?context, blake2b.params(64)) != contracts.OK) { ret 1; }
    var input:  [256]u8;
    var output: [64]u8;
    var i:      usize = 0;
    for (i < 256) {
        input[i] = i::u8;
        i        = i + 1;
    }
    var block: usize = 0;
    for (block < 4096) {
        i = 0;
        for (i < 256) {
            if (hash.update_blake2b(?context, contracts.Bytes{data: ?input[i], len: 1}) != contracts.OK) { ret 2; }
            i = i + 1;
        }
        block = block + 1;
    }
    if (hash.final_blake2b(?context, contracts.Buffer{data: ?output[0], capacity: 64}).error != contracts.OK)                                                                  { ret 3; }
    if (matches(?output[0], "988b9f48e713f594ab9d5bbac2de5f1f04714169d0ff806844089dfed9d7dcad92d90e5c7d9d0676042e059ab231b6839113f2d2b8abf631ee0a49c593d4491d"::*u8, 64) == 0) { ret 4; }
    ret 0;
}

# generated with minisign 0.12, modern ED format, over bytes 0..255 repeated
# 4096 times. only public key/signature bytes are retained; no signing secret.
test blake2b__minisign_megabyte_signature {
    var key: [32]u8 = [32]u8{0x79, 0x30, 0x9c, 0xd9, 0x34, 0xb3, 0x9a, 0xd4, 0x71, 0x33, 0xff, 0x18, 0xf7, 0xd8, 0x33, 0x63, 0x7f, 0x48, 0x79, 0x1b, 0x29, 0xf7, 0xe1, 0xc7, 0xbd, 0x00, 0xa6, 0xce, 0xf7, 0xd0, 0x06, 0x62};
    var sig: [64]u8 = [64]u8{0x65, 0xb8, 0xc5, 0xba, 0x34, 0xd4, 0x0b, 0x6e, 0x63, 0x3c, 0x50, 0xa1, 0x20, 0x5a, 0xf7, 0xd9, 0x1e, 0xcf, 0x70, 0x0d, 0x6e, 0x61, 0x5c, 0x29, 0x53, 0x21, 0x1d, 0x92, 0xff, 0xd4, 0x4d, 0x72, 0xb9, 0x74, 0xda, 0xb9, 0xa3, 0x70, 0x3f, 0x99, 0xba, 0xdf, 0x0f, 0x22, 0x51, 0x20, 0x57, 0xdb, 0x88, 0x2a, 0x2f, 0x2f, 0xf8, 0x0c, 0x2d, 0xf3, 0xf8, 0xa7, 0x68, 0x32, 0x91, 0x22, 0x0d, 0x06};

    var context: hash.Blake2b = hash.empty_blake2b();
    var input:   [256]u8;
    var digest:  [64]u8;
    var i:       usize        = 0;
    for (i < 256) {
        input[i] = i::u8;
        i        = i + 1;
    }
    if (hash.init_blake2b(?context, blake2b.params(64)) != contracts.OK) { ret 1; }
    i = 0;
    for (i < 4096) {
        if (hash.update_blake2b(?context, contracts.Bytes{data: ?input[0], len: 256}) != contracts.OK) { ret 2; }
        i = i + 1;
    }
    if (hash.final_blake2b(?context, contracts.Buffer{data: ?digest[0], capacity: 64}).error != contracts.OK) { ret 3; }
    val public_key: contracts.Bytes = contracts.Bytes{data: ?key[0], len: 32};
    val message:    contracts.Bytes = contracts.Bytes{data: ?digest[0], len: 64};
    val signed:     contracts.Bytes = contracts.Bytes{data: ?sig[0], len: 64};
    if (signature.verify_ed25519(public_key, message, signed) != contracts.OK) { ret 4; }
    digest[0] = digest[0] ^ 1;
    if (signature.verify_ed25519(public_key, message, signed) == contracts.OK) { ret 5; }
    ret 0;
}

# keyed vectors from the BLAKE2 reference blake2b-kat.txt: key 00..3f, input
# the first n bytes of 00..ff. checks both one-shots and every split of the
# streaming secret context, public input before the split and secret after
#[testing]
fun keyed_vector(n: usize, expected: *u8) u8 {
    var key:    [64]^u8;
    var input:  [256]u8;
    var lifted: [256]^u8;
    var output: [64]u8;
    var tag:    [64]^u8;
    var i:      usize = 0;
    for (i < 256) {
        if (i < 64) { key[i] = i::u8; }
        input[i]  = i::u8;
        lifted[i] = input[i];
        i         = i + 1;
    }
    val k: contracts.SecretBytes = contracts.SecretBytes{data: ?key[0], len: 64};
    val m: contracts.Bytes       = contracts.Bytes{data: ?input[0], len: n};
    val r: contracts.Operation   = hash.mac_blake2b(blake2b.params(64), k, m,
        contracts.Buffer{data: ?output[0], capacity: 64});
    if (r.error != contracts.OK || r.written != 64 || matches(?output[0], expected, 64) == 0) { ret 1; }
    val s: contracts.Operation = hash.mac_blake2b_secret(blake2b.params(64), k, m,
        contracts.SecretBuffer{data: ?tag[0], capacity: 64});
    if (s.error != contracts.OK || s.written != 64) { ret 2; }
    i = 0;
    for (i < 64) {
        output[i] = tag[i]:>u8;
        i         = i + 1;
    }
    if (matches(?output[0], expected, 64) == 0) { ret 2; }
    var split: usize = 0;
    for (split <= n) {
        var context: hash.Blake2bSecret     = hash.empty_blake2b_secret();
        val sink:    contracts.SecretBuffer = contracts.SecretBuffer{data: ?tag[0], capacity: 64};
        if (hash.init_blake2b_secret(?context, blake2b.params(64), k) != contracts.OK)                                         { ret 3; }
        if (hash.update_blake2b_public(?context, contracts.Bytes{data: ?input[0], len: split}) != contracts.OK)                { ret 4; }
        if (hash.snapshot_blake2b_secret(?context, sink).error != contracts.OK)                                                { ret 5; }
        if (hash.update_blake2b_secret(?context, contracts.SecretBytes{data: ?lifted[split], len: n - split}) != contracts.OK) { ret 6; }
        val done: contracts.Operation = hash.final_blake2b_secret(?context, sink);
        if (done.error != contracts.OK || done.written != 64) { ret 7; }
        i = 0;
        for (i < 64) {
            output[i] = tag[i]:>u8;
            i         = i + 1;
        }
        if (matches(?output[0], expected, 64) == 0)                    { ret 7; }
        if (context.state != hash.EMPTY || context.inner.buf_len != 0) { ret 8; }
        split = split + 1;
    }
    ret 0;
}

test blake2b__reference_kat_keyed_vectors {
    if (keyed_vector(0, "10ebb67700b1868efb4417987acf4690ae9d972fb7a590c2f02871799aaa4786b5e996e8f0f4eb981fc214b005f42d2ff4233499391653df7aefcbc13fc51568"::*u8) != 0)   { ret 1; }
    if (keyed_vector(1, "961f6dd1e4dd30f63901690c512e78e4b45e4742ed197c3c5e45c549fd25f2e4187b0bc9fe30492b16b0d0bc4ef9b0f34c7003fac09a5ef1532e69430234cebd"::*u8) != 0)   { ret 2; }
    if (keyed_vector(63, "bd965bf31e87d70327536f2a341cebc4768eca275fa05ef98f7f1b71a0351298de006fba73fe6733ed01d75801b4a928e54231b38e38c562b2e33ea1284992fa"::*u8) != 0)  { ret 3; }
    if (keyed_vector(64, "65676d800617972fbd87e4b9514e1c67402b7a331096d3bfac22f1abb95374abc942f16e9ab0ead33b87c91968a6e509e119ff07787b3ef483e1dcdccf6e3022"::*u8) != 0)  { ret 4; }
    if (keyed_vector(127, "76d2d819c92bce55fa8e092ab1bf9b9eab237a25267986cacf2b8ee14d214d730dc9a5aa2d7b596e86a1fd8fa0804c77402d2fcd45083688b218b1cdfa0dcbcb"::*u8) != 0) { ret 5; }
    if (keyed_vector(128, "72065ee4dd91c2d8509fa1fc28a37c7fc9fa7d5b3f8ad3d0d7a25626b57b1b44788d4caf806290425f9890a3a2a35a905ab4b37acfd0da6e4517b2525c9651e4"::*u8) != 0) { ret 6; }
    if (keyed_vector(129, "64475dfe7600d7171bea0b394e27c9b00d8e74dd1e416a79473682ad3dfdbb706631558055cfc8a40e07bd015a4540dcdea15883cbbf31412df1de1cd4152b91"::*u8) != 0) { ret 7; }
    if (keyed_vector(255, "142709d62e28fcccd0af97fad0f8465b971e82201dc51070faa0372aa43e92484be1c1e73ba10906d5d1853db6a4106e0a7bf9800d373d6dee2d46d62ef2a461"::*u8) != 0) { ret 8; }
    ret 0;
}

test blake2b__hashlib_salt_personal_and_tree_parameters {
    var input:  [200]u8;
    var output: [64]u8;
    var key:    [17]^u8;
    var i:      usize = 0;
    for (i < 200) {
        input[i] = i::u8;
        i        = i + 1;
    }
    val message: contracts.Bytes  = contracts.Bytes{data: ?input[0], len: 200};
    val buffer:  contracts.Buffer = contracts.Buffer{data: ?output[0], capacity: 64};
    val person:  *u8              = "mach-crypto test"::*u8;

    var salted: blake2b.Params = blake2b.params(32);
    i = 0;
    for (i < 16) {
        salted.salt[i]     = (0x10 + i)::u8;
        salted.personal[i] = person[i];
        i                  = i + 1;
    }
    val a: contracts.Operation = hash.digest_blake2b(salted, message, buffer);
    if (a.error != contracts.OK || a.written != 32 ||
        matches(?output[0], "d2724da5ad5dcec11ffbf0d3e3aa33919dcc6b110227ffdbb5949d5a8bef8722"::*u8, 32) == 0) { ret 1; }

    var tree: blake2b.Params = blake2b.params(48);
    tree.fanout      = 2;
    tree.depth       = 3;
    tree.leaf_len    = 4096;
    tree.node_offset = 0x0102030405060708;
    tree.node_depth  = 1;
    tree.inner_len   = 32;
    tree.last_node   = 1;
    val b: contracts.Operation = hash.digest_blake2b(tree, message, buffer);
    if (b.error != contracts.OK || b.written != 48 ||
        matches(?output[0], "f72ec0c61f9102ea98ad87c747f760f1ad009a983b2158a1d7d90d53e9469e5810e1355fb2f1b54d3b453d502f14b461"::*u8, 48) == 0) { ret 2; }

    var edge: blake2b.Params = blake2b.params(64);
    edge.fanout      = 0;
    edge.depth       = 255;
    edge.leaf_len    = 0xffffffff;
    edge.node_offset = 0xffffffffffffffff;
    edge.node_depth  = 255;
    edge.inner_len   = 64;
    val c: contracts.Operation = hash.digest_blake2b(edge, contracts.Bytes{data: nil, len: 0}, buffer);
    if (c.error != contracts.OK || c.written != 64 ||
        matches(?output[0], "c9da63a475c090d0833e34a750669c59b42d075fa27406d2d8317f9b65535c71dce639f6921dc9b175ae1b144d1e4ec2b7af86a73c9ccbdbf98bca7d9c1155b8"::*u8, 64) == 0) { ret 3; }

    i = 0;
    for (i < 17) {
        key[i] = i::u8;
        i      = i + 1;
    }
    salted.digest_len = 20;
    val d: contracts.Operation = hash.mac_blake2b(salted,
        contracts.SecretBytes{data: ?key[0], len: 17}, message, buffer);
    if (d.error != contracts.OK || d.written != 20 ||
        matches(?output[0], "737caf52613059c3dfab9294f33c315d334179e4"::*u8, 20) == 0) { ret 4; }
    ret 0;
}

test blake2b__secret_state_matches_public_over_random_splits {
    var buf:      [1024]u8;
    var lifted:   [1024]^u8;
    var expected: [64]u8;
    var tag:      [64]^u8;
    var seed:     u64   = 0x9e3779b97f4a7c15;
    var round:    usize = 0;
    for (round < 100) {
        seed = seed * 6364136223846793005 + 1442695040888963407;
        val len:  usize = (seed >> 33)::usize % 1024;
        val size: usize = 1 + (seed >> 20)::usize % 64;
        var i:    usize = 0;
        for (i < len) {
            seed      = seed * 6364136223846793005 + 1442695040888963407;
            buf[i]    = (seed >> 56)::u8;
            lifted[i] = buf[i];
            i         = i + 1;
        }
        val public: contracts.Operation = hash.digest_blake2b(blake2b.params(size),
            contracts.Bytes{data: ?buf[0], len: len}, contracts.Buffer{data: ?expected[0], capacity: 64});
        if (public.error != contracts.OK || public.written != size) { ret 1; }
        seed = seed * 6364136223846793005 + 1442695040888963407;
        var cut: usize = 0;
        if (len > 0) { cut = (seed >> 40)::usize % len; }
        var context: hash.Blake2bSecret = hash.empty_blake2b_secret();
        if (hash.init_blake2b_secret(?context, blake2b.params(size), contracts.SecretBytes{data: nil, len: 0}) != contracts.OK) { ret 2; }
        if (hash.update_blake2b_secret(?context, contracts.SecretBytes{data: ?lifted[0], len: cut}) != contracts.OK)            { ret 3; }
        if (hash.update_blake2b_public(?context, contracts.Bytes{data: ?buf[cut], len: len - cut}) != contracts.OK)             { ret 4; }
        val secret: contracts.Operation = hash.final_blake2b_secret(?context,
            contracts.SecretBuffer{data: ?tag[0], capacity: 64});
        if (secret.error != contracts.OK || secret.written != size) { ret 5; }
        i = 0;
        for (i < size) {
            if (tag[i]:>u8 != expected[i]) { ret 6; }
            i = i + 1;
        }
        round = round + 1;
    }
    ret 0;
}

test blake2b__secret_contract_rejects_and_wipes {
    var context: hash.Blake2bSecret     = hash.empty_blake2b_secret();
    var key:     [65]^u8;
    var tag:     [64]^u8;
    var output:  [64]u8;
    val sink:    contracts.SecretBuffer = contracts.SecretBuffer{data: ?tag[0], capacity: 64};
    val full:    contracts.SecretBytes  = contracts.SecretBytes{data: ?key[0], len: 64};
    val long:    contracts.SecretBytes  = contracts.SecretBytes{data: ?key[0], len: 65};
    val none:    contracts.Bytes        = contracts.Bytes{data: nil, len: 0};
    if (hash.init_blake2b_secret(nil, blake2b.params(64), full) != contracts.INVALID_INPUT)                                                     { ret 1; }
    if (hash.init_blake2b_secret(?context, blake2b.params(64), long) != contracts.INVALID_KEY || context.state != hash.EMPTY)                   { ret 2; }
    if (hash.init_blake2b_secret(?context, blake2b.params(0), full) != contracts.INVALID_INPUT)                                                 { ret 3; }
    if (hash.init_blake2b_secret(?context, blake2b.params(64), contracts.SecretBytes{data: nil, len: 1}) != contracts.INVALID_INPUT)            { ret 4; }
    if (hash.update_blake2b_secret(?context, contracts.SecretBytes{data: nil, len: 0}) != contracts.INVALID_STATE)                              { ret 5; }
    if (hash.init_blake2b_secret(?context, blake2b.params(64), full) != contracts.OK)                                                           { ret 6; }
    if (context.inner.buf_len != blake2b.BLOCK_SIZE || context.inner.t0 != 0)                                                                   { ret 7; }
    if (hash.init_blake2b_secret(?context, blake2b.params(64), full) != contracts.INVALID_STATE)                                                { ret 8; }
    if (hash.update_blake2b_secret(?context, contracts.SecretBytes{data: nil, len: 1}) != contracts.INVALID_INPUT)                              { ret 9; }
    if (hash.final_blake2b_secret(?context, contracts.SecretBuffer{data: ?tag[0], capacity: 63}).error != contracts.OUTPUT_TOO_SMALL)           { ret 10; }
    if (hash.mac_blake2b(blake2b.params(32), full, none, contracts.Buffer{data: ?output[0], capacity: 31}).error != contracts.OUTPUT_TOO_SMALL) { ret 11; }
    if (hash.mac_blake2b(blake2b.params(32), long, none, contracts.Buffer{data: ?output[0], capacity: 64}).error != contracts.INVALID_KEY)      { ret 12; }
    if (hash.update_blake2b_public(?context, contracts.Bytes{data: "abc"::*u8, len: 3}) != contracts.OK)                                        { ret 13; }
    if (hash.destroy_blake2b_secret(?context) != contracts.OK)                                                                                  { ret 14; }
    if (context.inner.buf_len != 0 || context.inner.t0 != 0 || context.inner.t1 != 0 || context.inner.digest_len != 0)                          { ret 15; }
    var i: usize = 0;
    for (i < 8) {
        if (context.inner.h[i]:>u64 != 0) { ret 16; }
        i = i + 1;
    }
    i = 0;
    for (i < 128) {
        if (context.inner.buf[i]:>u8 != 0) { ret 17; }
        i = i + 1;
    }
    if (hash.final_blake2b_secret(?context, sink).error != contracts.INVALID_STATE) { ret 18; }
    ret 0;
}

test blake2b__counter_carries_into_the_high_word {
    var p: blake2b.Params = blake2b.params(64);
    var s: blake2b.State  = blake2b.init(?p);
    s.t0      = 0xffffffffffffff80;
    s.buf_len = blake2b.BLOCK_SIZE;
    blake2b.update(?s, "x"::*u8, 1);
    if (s.t0 != 0 || s.t1 != 1 || s.buf_len != 1) { ret 1; }
    ret 0;
}

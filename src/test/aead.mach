# aead production contract tests

use crypto.aead.aes_gcm;
use crypto.aead.chacha20_poly1305;
use crypto.contracts;
use std.crypto.hash.sha256;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

var long_plaintext: [4097]^u8;
var long_sealed: [4113]u8;
var long_opened: [4097]^u8;
var record_plaintext: [16388]^u8;
var record_sealed: [16404]u8;
var record_opened: [16388]^u8;
var long_chacha_plaintext: [16385]^u8;
var long_chacha_sealed: [16401]u8;
var long_chacha_opened: [16385]^u8;

fun public_equal(actual: *u8, expected: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun secret_equal(actual: *^u8, expected: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i]:>u8 != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun secrets_equal(actual: *^u8, expected: *^u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i]:>u8 != expected[i]:>u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun public_filled(actual: *u8, value: u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i] != value) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun secret_filled(actual: *^u8, value: u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i]:>u8 != value) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun fill_secret(output: *^u8, value: u8, len: usize) {
    var i: usize = 0;
    for (i < len) { output[i] = value; i = i + 1; }
}

test "aes-gcm: nist empty and single-block aes-128 vectors" {
    var key: [16]^u8;
    var nonce: [12]u8;
    fill_secret(?key[0], 0, 16);
    var output: [32]u8;
    val empty_tag: [16]u8 = [16]u8{
        0x58, 0xe2, 0xfc, 0xce, 0xfa, 0x7e, 0x30, 0x61,
        0x36, 0x7f, 0x1d, 0x57, 0xa4, 0xe7, 0x45, 0x5a
    };
    var result: contracts.Operation = aes_gcm.seal(
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBytes{data: nil, len: 0}, contracts.Buffer{data: ?output[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 16 ||
        !public_equal(?output[0], (?empty_tag[0]):~*u8, 16)) { ret 1; }
    result = aes_gcm.open(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.Bytes{data: ?output[0], len: 16}, contracts.SecretBuffer{data: nil, capacity: 0});
    if (result.error != contracts.OK || result.written != 0) { ret 2; }

    var plaintext: [16]^u8;
    fill_secret(?plaintext[0], 0, 16);
    val expected: [32]u8 = [32]u8{
        0x03, 0x88, 0xda, 0xce, 0x60, 0xb6, 0xa3, 0x92,
        0xf3, 0x28, 0xc2, 0xb9, 0x71, 0xb2, 0xfe, 0x78,
        0xab, 0x6e, 0x47, 0xd4, 0x2c, 0xec, 0x13, 0xbd,
        0xf5, 0x3a, 0x67, 0xb2, 0x12, 0x57, 0xbd, 0xdf
    };
    result = aes_gcm.seal(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBytes{data: ?plaintext[0], len: 16},
        contracts.Buffer{data: ?output[0], capacity: 32});
    if (result.error != contracts.OK || result.written != 32 ||
        !public_equal(?output[0], (?expected[0]):~*u8, 32)) { ret 3; }
    var opened: [16]^u8;
    fill_secret(?opened[0], 0xA5, 16);
    result = aes_gcm.open(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.Bytes{data: ?output[0], len: 32},
        contracts.SecretBuffer{data: ?opened[0], capacity: 16});
    if (result.error != contracts.OK || result.written != 16 || !secret_filled(?opened[0], 0, 16)) { ret 4; }
    ret 0;
}

test "aes-gcm: nist empty and single-block aes-256 vectors" {
    var key: [32]^u8;
    var nonce: [12]u8;
    fill_secret(?key[0], 0, 32);
    var output: [32]u8;
    val empty_tag: [16]u8 = [16]u8{
        0x53, 0x0f, 0x8a, 0xfb, 0xc7, 0x45, 0x36, 0xb9,
        0xa9, 0x63, 0xb4, 0xf1, 0xc4, 0xcb, 0x73, 0x8b
    };
    var result: contracts.Operation = aes_gcm.seal(
        contracts.SecretBytes{data: ?key[0], len: 32},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBytes{data: nil, len: 0}, contracts.Buffer{data: ?output[0], capacity: 32});
    if (result.error != contracts.OK || !public_equal(?output[0], (?empty_tag[0]):~*u8, 16)) { ret 1; }
    var plaintext: [16]^u8;
    fill_secret(?plaintext[0], 0, 16);
    val expected: [32]u8 = [32]u8{
        0xce, 0xa7, 0x40, 0x3d, 0x4d, 0x60, 0x6b, 0x6e,
        0x07, 0x4e, 0xc5, 0xd3, 0xba, 0xf3, 0x9d, 0x18,
        0xd0, 0xd1, 0xc8, 0xa7, 0x99, 0x99, 0x6b, 0xf0,
        0x26, 0x5b, 0x98, 0xb5, 0xd4, 0x8a, 0xb9, 0x19
    };
    result = aes_gcm.seal(contracts.SecretBytes{data: ?key[0], len: 32},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBytes{data: ?plaintext[0], len: 16},
        contracts.Buffer{data: ?output[0], capacity: 32});
    if (result.error != contracts.OK || !public_equal(?output[0], (?expected[0]):~*u8, 32)) { ret 2; }
    ret 0;
}

test "aes-gcm: nist aad and partial-block vector seals and opens" {
    var key: [16]^u8 = [16]^u8{
        0xfe, 0xff, 0xe9, 0x92, 0x86, 0x65, 0x73, 0x1c,
        0x6d, 0x6a, 0x8f, 0x94, 0x67, 0x30, 0x83, 0x08
    };
    val nonce: [12]u8 = [12]u8{
        0xca, 0xfe, 0xba, 0xbe, 0xfa, 0xce, 0xdb, 0xad,
        0xde, 0xca, 0xf8, 0x88
    };
    val aad: [20]u8 = [20]u8{
        0xfe, 0xed, 0xfa, 0xce, 0xde, 0xad, 0xbe, 0xef,
        0xfe, 0xed, 0xfa, 0xce, 0xde, 0xad, 0xbe, 0xef,
        0xab, 0xad, 0xda, 0xd2
    };
    var plaintext: [60]^u8 = [60]^u8{
        0xd9, 0x31, 0x32, 0x25, 0xf8, 0x84, 0x06, 0xe5,
        0xa5, 0x59, 0x09, 0xc5, 0xaf, 0xf5, 0x26, 0x9a,
        0x86, 0xa7, 0xa9, 0x53, 0x15, 0x34, 0xf7, 0xda,
        0x2e, 0x4c, 0x30, 0x3d, 0x8a, 0x31, 0x8a, 0x72,
        0x1c, 0x3c, 0x0c, 0x95, 0x95, 0x68, 0x09, 0x53,
        0x2f, 0xcf, 0x0e, 0x24, 0x49, 0xa6, 0xb5, 0x25,
        0xb1, 0x6a, 0xed, 0xf5, 0xaa, 0x0d, 0xe6, 0x57,
        0xba, 0x63, 0x7b, 0x39
    };
    val expected: [76]u8 = [76]u8{
        0x42, 0x83, 0x1e, 0xc2, 0x21, 0x77, 0x74, 0x24,
        0x4b, 0x72, 0x21, 0xb7, 0x84, 0xd0, 0xd4, 0x9c,
        0xe3, 0xaa, 0x21, 0x2f, 0x2c, 0x02, 0xa4, 0xe0,
        0x35, 0xc1, 0x7e, 0x23, 0x29, 0xac, 0xa1, 0x2e,
        0x21, 0xd5, 0x14, 0xb2, 0x54, 0x66, 0x93, 0x1c,
        0x7d, 0x8f, 0x6a, 0x5a, 0xac, 0x84, 0xaa, 0x05,
        0x1b, 0xa3, 0x0b, 0x39, 0x6a, 0x0a, 0xac, 0x97,
        0x3d, 0x58, 0xe0, 0x91, 0x5b, 0xc9, 0x4f, 0xbc,
        0x32, 0x21, 0xa5, 0xdb, 0x94, 0xfa, 0xe9, 0x5a,
        0xe7, 0x12, 0x1a, 0x47
    };
    var output: [76]u8;
    var result: contracts.Operation = aes_gcm.seal(
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: (?nonce[0]):~*u8, len: 12},
        contracts.Bytes{data: (?aad[0]):~*u8, len: 20},
        contracts.SecretBytes{data: ?plaintext[0], len: 60},
        contracts.Buffer{data: ?output[0], capacity: 76});
    if (result.error != contracts.OK || result.written != 76 ||
        !public_equal(?output[0], (?expected[0]):~*u8, 76)) { ret 1; }
    var opened: [60]^u8;
    result = aes_gcm.open(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: (?nonce[0]):~*u8, len: 12},
        contracts.Bytes{data: (?aad[0]):~*u8, len: 20},
        contracts.Bytes{data: ?output[0], len: 76},
        contracts.SecretBuffer{data: ?opened[0], capacity: 60});
    if (result.error != contracts.OK || result.written != 60 ||
        !secrets_equal(?opened[0], ?plaintext[0], 60)) { ret 2; }
    ret 0;
}

test "aes-gcm: public input overlap and secret key overlap are safe" {
    var key: [16]^u8;
    fill_secret(?key[0], 0, 16);
    var nonce_output: [32]u8;
    var i: usize = 0;
    for (i < 12) { nonce_output[i] = 0; i = i + 1; }
    val empty_tag: [16]u8 = [16]u8{
        0x58, 0xe2, 0xfc, 0xce, 0xfa, 0x7e, 0x30, 0x61,
        0x36, 0x7f, 0x1d, 0x57, 0xa4, 0xe7, 0x45, 0x5a
    };
    var result: contracts.Operation = aes_gcm.seal(
        contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce_output[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBytes{data: nil, len: 0},
        contracts.Buffer{data: ?nonce_output[0], capacity: 32});
    if (result.error != contracts.OK || !public_equal(?nonce_output[0], (?empty_tag[0]):~*u8, 16)) { ret 1; }

    var aad_output: [32]u8;
    i = 0;
    for (i < 16) { key[i] = i::u8; i = i + 1; }
    i = 0;
    for (i < 12) { aad_output[i] = "boundary aad"[i]; i = i + 1; }
    var plaintext: [16]^u8;
    i = 0;
    for (i < 16) { plaintext[i] = i::u8; i = i + 1; }
    val boundary: [32]u8 = [32]u8{
        0x93, 0x6d, 0xa5, 0xcd, 0x62, 0x1e, 0xf1, 0x53,
        0x43, 0xdb, 0x6b, 0x81, 0x3a, 0xae, 0x7e, 0x07,
        0x29, 0x5f, 0x7a, 0xfd, 0xf1, 0xf7, 0x23, 0x7a,
        0xd9, 0x80, 0x51, 0x5a, 0x3f, 0x8a, 0xdf, 0xd8
    };
    var nonce: [12]u8;
    i = 0;
    for (i < 12) { nonce[i] = i::u8; i = i + 1; }
    result = aes_gcm.seal(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12},
        contracts.Bytes{data: ?aad_output[0], len: 12},
        contracts.SecretBytes{data: ?plaintext[0], len: 16},
        contracts.Buffer{data: ?aad_output[0], capacity: 32});
    if (result.error != contracts.OK || !public_equal(?aad_output[0], (?boundary[0]):~*u8, 32)) { ret 2; }

    var shared_key_output: [64]^u8;
    fill_secret(?shared_key_output[0], 0, 64);
    i = 0;
    for (i < 16) { shared_key_output[i] = i::u8; i = i + 1; }
    result = aes_gcm.open(contracts.SecretBytes{data: ?shared_key_output[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12},
        contracts.Bytes{data: "boundary aad"::*u8, len: 12},
        contracts.Bytes{data: (?boundary[0]):~*u8, len: 32},
        contracts.SecretBuffer{data: ?shared_key_output[0], capacity: 64});
    if (result.error != contracts.OK || result.written != 16 ||
        !secrets_equal(?shared_key_output[0], ?plaintext[0], 16)) { ret 3; }
    ret 0;
}

test "aes-gcm: authentication failures clear output before release" {
    var key: [16]^u8;
    fill_secret(?key[0], 0, 16);
    var nonce: [12]u8;
    var aad: [12]u8;
    var i: usize = 0;
    for (i < 12) { nonce[i] = i::u8; i = i + 1; }
    i = 0;
    for (i < 12) { aad[i] = "boundary aad"[i]; i = i + 1; }
    val valid: [32]u8 = [32]u8{
        0x93, 0x6d, 0xa5, 0xcd, 0x62, 0x1e, 0xf1, 0x53,
        0x43, 0xdb, 0x6b, 0x81, 0x3a, 0xae, 0x7e, 0x07,
        0x29, 0x5f, 0x7a, 0xfd, 0xf1, 0xf7, 0x23, 0x7a,
        0xd9, 0x80, 0x51, 0x5a, 0x3f, 0x8a, 0xdf, 0xd8
    };
    var tampered: [32]u8;
    var output: [32]^u8;
    var result: contracts.Operation;
    var case: usize = 0;
    for (case < 5) {
        i = 0;
        for (i < 32) { tampered[i] = valid[i]; output[i] = 0xA5; i = i + 1; }
        i = 0;
        for (i < 16) { key[i] = 0; i = i + 1; }
        i = 0;
        for (i < 12) { nonce[i] = i::u8; i = i + 1; }
        i = 0;
        for (i < 12) { aad[i] = "boundary aad"[i]; i = i + 1; }
        if (case == 0) { tampered[31] = tampered[31] ^ 1; }
        or (case == 1) { tampered[0] = tampered[0] ^ 1; }
        or (case == 2) { aad[0] = aad[0] ^ 1; }
        or (case == 3) { nonce[0] = nonce[0] ^ 1; }
        or { key[0] = 1; }
        result = aes_gcm.open(contracts.SecretBytes{data: ?key[0], len: 16},
            contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: ?aad[0], len: 12},
            contracts.Bytes{data: ?tampered[0], len: 32},
            contracts.SecretBuffer{data: ?output[0], capacity: 32});
        if (result.error != contracts.AUTH_FAILED || result.written != 0) { ret 1; }
        if (!secret_filled(?output[0], 0, 16) || !secret_filled(?output[16], 0xA5, 16)) { ret 2; }
        case = case + 1;
    }
    ret 0;
}

test "aes-gcm: validation and capacity failures leave output unchanged" {
    var key: [32]^u8;
    fill_secret(?key[0], 0, 32);
    var nonce: [12]u8;
    var public_output: [32]u8;
    var secret_output: [32]^u8;
    var public_byte: [1]u8;
    var secret_byte: [1]^u8;
    var i: usize = 0;
    for (i < 32) { public_output[i] = 0xA5; secret_output[i] = 0xA5; i = i + 1; }
    var result: contracts.Operation = aes_gcm.seal(
        contracts.SecretBytes{data: ?key[0], len: 15}, contracts.Bytes{data: ?nonce[0], len: 12},
        contracts.Bytes{data: nil, len: 0}, contracts.SecretBytes{data: nil, len: 0},
        contracts.Buffer{data: ?public_output[0], capacity: 32});
    if (result.error != contracts.INVALID_KEY || !public_filled(?public_output[0], 0xA5, 32)) { ret 1; }
    result = aes_gcm.seal(contracts.SecretBytes{data: nil, len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBytes{data: nil, len: 0}, contracts.Buffer{data: ?public_output[0], capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !public_filled(?public_output[0], 0xA5, 32)) { ret 2; }
    result = aes_gcm.seal(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 11}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBytes{data: nil, len: 0}, contracts.Buffer{data: ?public_output[0], capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !public_filled(?public_output[0], 0xA5, 32)) { ret 3; }
    result = aes_gcm.seal(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBytes{data: nil, len: 0}, contracts.Buffer{data: ?public_output[0], capacity: 15});
    if (result.error != contracts.OUTPUT_TOO_SMALL || !public_filled(?public_output[0], 0xA5, 32)) { ret 4; }
    result = aes_gcm.seal(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12},
        contracts.Bytes{data: ?public_byte[0], len: 0xFFFFFFFFFFFFFFFF},
        contracts.SecretBytes{data: nil, len: 0}, contracts.Buffer{data: ?public_output[0], capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !public_filled(?public_output[0], 0xA5, 32)) { ret 5; }
    result = aes_gcm.seal(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.SecretBytes{data: ?secret_byte[0], len: 68719476705},
        contracts.Buffer{data: ?public_output[0], capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !public_filled(?public_output[0], 0xA5, 32)) { ret 6; }

    result = aes_gcm.open(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.Bytes{data: ?public_output[0], len: 15},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !secret_filled(?secret_output[0], 0xA5, 32)) { ret 7; }
    result = aes_gcm.open(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.Bytes{data: ?public_output[0], len: 32},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 15});
    if (result.error != contracts.OUTPUT_TOO_SMALL || !secret_filled(?secret_output[0], 0xA5, 32)) { ret 8; }
    result = aes_gcm.open(contracts.SecretBytes{data: ?key[0], len: 16},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: nil, len: 0},
        contracts.Bytes{data: ?public_output[0], len: 68719476721},
        contracts.SecretBuffer{data: ?secret_output[0], capacity: 32});
    if (result.error != contracts.INVALID_INPUT || !secret_filled(?secret_output[0], 0xA5, 32)) { ret 9; }
    ret 0;
}

test "aes-gcm: independent counter-carry differential vector" {
    var key: [32]^u8;
    var nonce: [12]u8;
    var aad: [33]u8;
    var i: usize = 0;
    for (i < 32) { key[i] = i::u8; i = i + 1; }
    i = 0;
    for (i < 12) { nonce[i] = (0xA0 + i)::u8; i = i + 1; }
    i = 0;
    for (i < 33) { aad[i] = (0x55 ^ i)::u8; i = i + 1; }
    i = 0;
    for (i < 4097) { long_plaintext[i] = (i * 7 + 3)::u8; i = i + 1; }
    var result: contracts.Operation = aes_gcm.seal(
        contracts.SecretBytes{data: ?key[0], len: 32},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: ?aad[0], len: 33},
        contracts.SecretBytes{data: ?long_plaintext[0], len: 4097},
        contracts.Buffer{data: ?long_sealed[0], capacity: 4113});
    if (result.error != contracts.OK || result.written != 4113) { ret 1; }
    var digest: [32]u8;
    sha256.hash(?long_sealed[0], 4113, ?digest[0]);
    val expected_digest: [32]u8 = [32]u8{
        0x97, 0x68, 0x25, 0x40, 0xf2, 0x0d, 0x77, 0x22,
        0x0c, 0x25, 0xa8, 0xf6, 0xa8, 0x07, 0x94, 0xae,
        0x57, 0xba, 0x27, 0x19, 0xe7, 0xc1, 0x4d, 0xda,
        0xf5, 0xde, 0xe2, 0xee, 0x6b, 0xa1, 0xac, 0xab
    };
    if (!public_equal(?digest[0], (?expected_digest[0]):~*u8, 32)) { ret 2; }
    result = aes_gcm.open(contracts.SecretBytes{data: ?key[0], len: 32},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: ?aad[0], len: 33},
        contracts.Bytes{data: ?long_sealed[0], len: 4113},
        contracts.SecretBuffer{data: ?long_opened[0], capacity: 4097});
    if (result.error != contracts.OK || result.written != 4097) { ret 3; }
    i = 0;
    for (i < 4097) {
        if (long_opened[i]:>u8 != (i * 7 + 3)::u8) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

test "aes-gcm: independent record-length differential vectors" {
    var key:   [16]^u8;
    var nonce: [12]u8;
    val aad:   [5]u8 = [5]u8{0x17, 0x03, 0x03, 0x40, 0x11};
    var i:     usize = 0;
    for (i < 16) { key[i] = (i * 3 + 5)::u8; i = i + 1; }
    i = 0;
    for (i < 12) { nonce[i] = (0x30 + i)::u8; i = i + 1; }
    val lengths: [4]usize = [4]usize{63, 65, 16384, 16388};
    val expected: [128]u8 = [128]u8{
        0xf6, 0x04, 0xa1, 0xaa, 0xe4, 0x8b, 0xe8, 0xa1,
        0x01, 0x13, 0x09, 0x99, 0xed, 0x2e, 0xd1, 0x53,
        0x83, 0xf4, 0xf4, 0x67, 0xad, 0x8a, 0x0e, 0x6f,
        0x63, 0xcc, 0xeb, 0x82, 0x57, 0xcc, 0xce, 0x7c,
        0x28, 0xd8, 0xf4, 0x7d, 0xc1, 0x5a, 0x05, 0x35,
        0xda, 0x7e, 0x73, 0xe5, 0x62, 0x54, 0xc2, 0x8d,
        0x61, 0x63, 0x44, 0x17, 0x03, 0xfa, 0xc3, 0x84,
        0xc4, 0x5d, 0x4d, 0xb5, 0x5a, 0xeb, 0xde, 0x35,
        0x3c, 0xcc, 0x87, 0xf6, 0xe3, 0x90, 0xeb, 0x3f,
        0xca, 0x43, 0x3b, 0x7b, 0x49, 0x34, 0x68, 0x25,
        0xcf, 0xec, 0x5d, 0x77, 0xd1, 0x00, 0x7d, 0x3b,
        0x9e, 0x27, 0x22, 0xfd, 0x47, 0x6f, 0x47, 0x74,
        0x0a, 0x70, 0x43, 0x64, 0x08, 0x32, 0x0d, 0xf6,
        0x81, 0x19, 0x4b, 0x1a, 0x2d, 0x15, 0x12, 0xe1,
        0xa3, 0x32, 0x3f, 0xe5, 0xfe, 0x00, 0x9e, 0xc1,
        0x1c, 0xc5, 0x37, 0x9d, 0x9a, 0xdc, 0x80, 0x9d
    };
    var index: usize = 0;
    for (index < 4) {
        val length: usize = lengths[index];
        i = 0;
        for (i < length) { record_plaintext[i] = (i * 11 + 1)::u8; i = i + 1; }
        var result: contracts.Operation = aes_gcm.seal(
            contracts.SecretBytes{data: ?key[0], len: 16},
            contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: (?aad[0]):~*u8, len: 5},
            contracts.SecretBytes{data: ?record_plaintext[0], len: length},
            contracts.Buffer{data: ?record_sealed[0], capacity: length + 16});
        if (result.error != contracts.OK || result.written != length + 16) { ret 1; }
        var digest: [32]u8;
        sha256.hash(?record_sealed[0], length + 16, ?digest[0]);
        if (!public_equal(?digest[0], (?expected[index * 32]):~*u8, 32)) { ret 2; }
        result = aes_gcm.open(contracts.SecretBytes{data: ?key[0], len: 16},
            contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: (?aad[0]):~*u8, len: 5},
            contracts.Bytes{data: ?record_sealed[0], len: length + 16},
            contracts.SecretBuffer{data: ?record_opened[0], capacity: length});
        if (result.error != contracts.OK || result.written != length) { ret 3; }
        i = 0;
        for (i < length) {
            if (record_opened[i]:>u8 != (i * 11 + 1)::u8) { ret 4; }
            i = i + 1;
        }
        index = index + 1;
    }
    ret 0;
}

test "chacha20-poly1305: rfc 8439 aead vector seals and opens" {
    var key: [32]^u8;
    var nonce: [12]u8 = [12]u8{
        0x07, 0x00, 0x00, 0x00, 0x40, 0x41, 0x42, 0x43,
        0x44, 0x45, 0x46, 0x47
    };
    var aad: [12]u8 = [12]u8{
        0x50, 0x51, 0x52, 0x53, 0xc0, 0xc1, 0xc2, 0xc3,
        0xc4, 0xc5, 0xc6, 0xc7
    };
    var plaintext: [114]^u8;
    val message: *u8 = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."::*u8;
    var i: usize = 0;
    for (i < 32) { key[i] = (0x80 + i)::u8; i = i + 1; }
    i = 0;
    for (i < 114) { plaintext[i] = message[i]; i = i + 1; }
    val expected: [130]u8 = [130]u8{
        0xd3, 0x1a, 0x8d, 0x34, 0x64, 0x8e, 0x60, 0xdb,
        0x7b, 0x86, 0xaf, 0xbc, 0x53, 0xef, 0x7e, 0xc2,
        0xa4, 0xad, 0xed, 0x51, 0x29, 0x6e, 0x08, 0xfe,
        0xa9, 0xe2, 0xb5, 0xa7, 0x36, 0xee, 0x62, 0xd6,
        0x3d, 0xbe, 0xa4, 0x5e, 0x8c, 0xa9, 0x67, 0x12,
        0x82, 0xfa, 0xfb, 0x69, 0xda, 0x92, 0x72, 0x8b,
        0x1a, 0x71, 0xde, 0x0a, 0x9e, 0x06, 0x0b, 0x29,
        0x05, 0xd6, 0xa5, 0xb6, 0x7e, 0xcd, 0x3b, 0x36,
        0x92, 0xdd, 0xbd, 0x7f, 0x2d, 0x77, 0x8b, 0x8c,
        0x98, 0x03, 0xae, 0xe3, 0x28, 0x09, 0x1b, 0x58,
        0xfa, 0xb3, 0x24, 0xe4, 0xfa, 0xd6, 0x75, 0x94,
        0x55, 0x85, 0x80, 0x8b, 0x48, 0x31, 0xd7, 0xbc,
        0x3f, 0xf4, 0xde, 0xf0, 0x8e, 0x4b, 0x7a, 0x9d,
        0xe5, 0x76, 0xd2, 0x65, 0x86, 0xce, 0xc6, 0x4b,
        0x61, 0x16, 0x1a, 0xe1, 0x0b, 0x59, 0x4f, 0x09,
        0xe2, 0x6a, 0x7e, 0x90, 0x2e, 0xcb, 0xd0, 0x60,
        0x06, 0x91
    };
    var sealed: [130]u8;
    var result: contracts.Operation = chacha20_poly1305.seal(
        contracts.SecretBytes{data: ?key[0], len: 32},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: ?aad[0], len: 12},
        contracts.SecretBytes{data: ?plaintext[0], len: 114},
        contracts.Buffer{data: ?sealed[0], capacity: 130});
    if (result.error != contracts.OK || result.written != 130) { ret 1; }
    if (!public_equal(?sealed[0], (?expected[0]):~*u8, 114)) { ret 2; }
    if (!public_equal(?sealed[114], (?expected[114]):~*u8, 16)) { ret 3; }
    var opened: [114]^u8;
    result = chacha20_poly1305.open(contracts.SecretBytes{data: ?key[0], len: 32},
        contracts.Bytes{data: ?nonce[0], len: 12}, contracts.Bytes{data: ?aad[0], len: 12},
        contracts.Bytes{data: ?sealed[0], len: 130},
        contracts.SecretBuffer{data: ?opened[0], capacity: 114});
    if (result.error != contracts.OK || result.written != 114 ||
        !secrets_equal(?opened[0], ?plaintext[0], 114)) { ret 4; }
    ret 0;
}

test "chacha20-poly1305: empty independent vector" {
    var key: [32]^u8;
    var nonce: [12]u8;
    fill_secret(?key[0], 0, 32);
    val expected: [16]u8 = [16]u8{
        0x4e, 0xb9, 0x72, 0xc9, 0xa8, 0xfb, 0x3a, 0x1b,
        0x38, 0x2b, 0xb4, 0xd3, 0x6f, 0x5f, 0xfa, 0xd1
    };

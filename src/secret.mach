# owned secret storage

use crypto.contracts;
use std.crypto.ct;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def State: u8;

pub val EMPTY:  State = 0;
pub val ACTIVE: State = 1;
pub val WIPED:  State = 2;

pub def FillFun: fun(ptr, *^u8, *^u8, usize) i64;
pub def AllocateFun: fun(ptr, *^u8, usize, **^u8) i64;
pub def DeallocateFun: fun(ptr, *^u8, *^u8, usize) i64;

# allocator callbacks preserve secret-welded pointer types at the ownership
# boundary so no public alias to secret storage is ever created. allocate_fn
# always initializes out. a nonnil out transfers a len-byte allocation even
# when the callback reports failure, allowing the caller to wipe and release
# partial allocations deterministically. deallocate_fn retains ownership on
# failure and releases it only on success.
pub rec Allocator {
    context:        ptr;
    secret_context: *^u8;
    allocate_fn:    AllocateFun;
    deallocate_fn:  DeallocateFun;
    initialized:    bool;
}

# an entropy callback fills all requested bytes or returns a nonzero error
pub rec Entropy {
    context:        ptr;
    secret_context: *^u8;
    fill_fn:        FillFun;
    initialized:    bool;
}

# owning values are move-only by contract
#
# copying this record directly duplicates ownership and is invalid. use move to
# transfer ownership or clone to allocate an independent copy. the allocator
# and every borrowed view must outlive the owning value.
pub rec Secret {
    data:       *^u8;
    len:        usize;
    owner:      *Allocator;
    state:      State;
}

# allocator callbacks preserve the complete typed shape at the ownership
# boundary. a nonnil output transfers one count-element allocation even when
# allocation reports failure. returned storage must satisfy the supplied
# alignment. deallocation retains ownership on failure.
pub rec ArrayAllocator[T] {
    context:        ptr;
    secret_context: *^u8;
    allocate_fn:    fun(ptr, *^u8, usize, usize, usize, **T) i64;
    deallocate_fn:  fun(ptr, *^u8, *T, usize, usize, usize) i64;
    initialized:    bool;
}

# typed array owners are move-only by contract
#
# data preserves T's complete secrecy structure. copying this record directly
# duplicates ownership and is invalid. the allocator must outlive the owner.
pub rec SecretArray[T] {
    data:  *T;
    count: usize;
    bytes: usize;
    owner: *ArrayAllocator[T];
    state: State;
}

fun reset(secret: *Secret) {
    secret.data = nil;
    secret.len = 0;
    secret.owner = nil;
    secret.state = EMPTY;
}

fun valid_empty(secret: *Secret) bool {
    ret secret.state == EMPTY && secret.data == nil && secret.len == 0 && secret.owner == nil;
}

fun valid_owned(secret: *Secret) bool {
    if (secret.state != ACTIVE && secret.state != WIPED) { ret false; }
    if (secret.owner == nil) { ret false; }
    if (secret.len != 0 && secret.data == nil) { ret false; }
    ret true;
}

fun release_wiped(secret: *Secret) contracts.Error {
    if (secret.len == 0 && secret.data == nil) {
        reset(secret);
        ret contracts.OK;
    }
    if (secret.owner.deallocate_fn(secret.owner.context, secret.owner.secret_context,
        secret.data, secret.len) != 0) {
        ret contracts.DEALLOCATION_FAILED;
    }
    reset(secret);
    ret contracts.OK;
}

fun cleanup_failed_allocation(secret: *Secret, owner: *Allocator, data: *^u8, len: usize) {
    if (data == nil) { ret; }
    secret.data = data;
    secret.len = len;
    secret.owner = owner;
    secret.state = ACTIVE;
    ct.zeroize(secret.data, secret.len);
    secret.state = WIPED;
    release_wiped(secret);
}

fun reset_array[T](array: *SecretArray[T]) {
    array.data = nil;
    array.count = 0;
    array.bytes = 0;
    array.owner = nil;
    array.state = EMPTY;
}

fun valid_empty_array[T](array: *SecretArray[T]) bool {
    ret array.state == EMPTY && array.data == nil && array.count == 0 &&
        array.bytes == 0 && array.owner == nil;
}

fun valid_owned_array[T](array: *SecretArray[T]) bool {
    if (array.state != ACTIVE && array.state != WIPED) { ret false; }
    if (array.owner == nil) { ret false; }
    if ($size_of(T) == 0 && array.count != 0) { ret false; }
    if ($size_of(T) != 0 && array.count > ~(0::usize) / $size_of(T)) { ret false; }
    if (array.bytes != $size_of(T) * array.count) { ret false; }
    if (array.count != 0 && array.data == nil) { ret false; }
    if (array.count == 0 && array.data != nil) { ret false; }
    ret true;
}

#[oblivious]
fun wipe_array[T](data: *T, count: usize) {
    var zero: T;
    var i: usize = 0;
    for (i < count) {
        data[i] = zero;
        i = i + 1;
    }
}

fun release_wiped_array[T](array: *SecretArray[T]) contracts.Error {
    if (array.count == 0) {
        reset_array[T](array);
        ret contracts.OK;
    }
    if (array.owner.deallocate_fn(array.owner.context, array.owner.secret_context,
        array.data, array.count, array.bytes, $align_of(T)) != 0) {
        ret contracts.DEALLOCATION_FAILED;
    }
    reset_array[T](array);
    ret contracts.OK;
}

fun cleanup_failed_array_allocation[T](array: *SecretArray[T],
    owner: *ArrayAllocator[T], data: *T, count: usize, bytes: usize) {
    if (data == nil) { ret; }
    array.data = data;
    array.count = count;
    array.bytes = bytes;
    array.owner = owner;
    array.state = ACTIVE;
    wipe_array[T](array.data, array.count);
    array.state = WIPED;
    release_wiped_array[T](array);
}

fun system_fill(context: ptr, secret_context: *^u8, destination: *^u8, len: usize) i64 {
    ret os.secret_random_fill(destination, len);
}

fun system_allocate(context: ptr, secret_context: *^u8, len: usize, out: **^u8) i64 {
    if (out == nil) { ret -1; }
    @out = nil;
    if (len == 0) { ret 0; }
    val data: *^u8 = os.secret_allocate(len);
    if (data == nil) { ret -1; }
    @out = data;
    ret 0;
}

fun system_deallocate(context: ptr, secret_context: *^u8, data: *^u8, len: usize) i64 {
    ret os.secret_deallocate(data, len);
}

fun system_allocate_array[T](context: ptr, secret_context: *^u8, count: usize,
    bytes: usize, align: usize, out: **T) i64 {
    if (out == nil) { ret -1; }
    @out = nil;
    if (count == 0 || $size_of(T) == 0 ||
        count > ~(0::usize) / $size_of(T) ||
        bytes != $size_of(T) * count || align != $align_of(T)) { ret -1; }
    val data: *T = os.secret_allocate_typed[T](count);
    if (data == nil) { ret -1; }
    @out = data;
    ret 0;
}

fun system_deallocate_array[T](context: ptr, secret_context: *^u8, data: *T,
    count: usize, bytes: usize, align: usize) i64 {
    if (data == nil || count == 0 || $size_of(T) == 0 ||
        count > ~(0::usize) / $size_of(T) ||
        bytes != $size_of(T) * count || align != $align_of(T)) { ret -1; }
    ret os.secret_deallocate_typed[T](data, count);
}

# construct an empty owner before passing it to an initializer
pub fun empty() Secret {
    ret Secret{data: nil, len: 0, owner: nil, state: EMPTY};
}

# construct an empty typed array owner
pub fun empty_array[T]() SecretArray[T] {
    ret SecretArray[T]{data: nil, count: 0, bytes: 0, owner: nil, state: EMPTY};
}

# construct the operating-system entropy source
pub fun system_entropy() Entropy {
    ret Entropy{context: nil, secret_context: nil, fill_fn: system_fill, initialized: true};
}

# construct the native secret allocator
pub fun system_allocator() Allocator {
    ret Allocator{context: nil, secret_context: nil, allocate_fn: system_allocate,
        deallocate_fn: system_deallocate, initialized: true};
}

# construct the native typed secret allocator
pub fun system_array_allocator[T]() ArrayAllocator[T] {
    ret ArrayAllocator[T]{context: nil, secret_context: nil,
        allocate_fn: system_allocate_array[T],
        deallocate_fn: system_deallocate_array[T], initialized: true};
}

# report whether a value owns usable secret bytes
pub fun active(secret: *Secret) bool {
    if (secret == nil) { ret false; }
    ret valid_owned(secret) && secret.state == ACTIVE;
}

# report whether a failed deallocation retains wiped storage
pub fun cleanup_pending(secret: *Secret) bool {
    if (secret == nil) { ret false; }
    ret valid_owned(secret) && secret.state == WIPED;
}

# report whether a typed array owns usable values
pub fun array_active[T](array: *SecretArray[T]) bool {
    if (array == nil) { ret false; }
    ret valid_owned_array[T](array) && array.state == ACTIVE;
}

# report whether a failed typed deallocation retains wiped storage
pub fun array_cleanup_pending[T](array: *SecretArray[T]) bool {
    if (array == nil) { ret false; }
    ret valid_owned_array[T](array) && array.state == WIPED;
}

# return typed storage only while its owner is active
pub fun array_data[T](array: *SecretArray[T]) *T {
    if (!array_active[T](array)) { ret nil; }
    ret array.data;
}

# allocate and zero-initialize count typed values
pub fun init_array[T](array: *SecretArray[T], owner: *ArrayAllocator[T],
    count: usize) contracts.Error {
    if (array == nil || owner == nil || !owner.initialized) {
        ret contracts.INVALID_INPUT;
    }
    if (!valid_empty_array[T](array)) { ret contracts.INVALID_STATE; }
    if ($size_of(T) == 0 && count != 0) { ret contracts.INVALID_INPUT; }
    if ($size_of(T) != 0 && count > ~(0::usize) / $size_of(T)) {
        ret contracts.INVALID_INPUT;
    }

    val bytes: usize = $size_of(T) * count;
    if (count == 0) {
        array.data = nil;
        array.count = 0;
        array.bytes = 0;
        array.owner = owner;
        array.state = ACTIVE;
        ret contracts.OK;
    }

    var data: *T = nil;
    if (owner.allocate_fn(owner.context, owner.secret_context, count, bytes,
        $align_of(T), ?data) != 0) {
        cleanup_failed_array_allocation[T](array, owner, data, count, bytes);
        ret contracts.ALLOCATION_FAILED;
    }
    if (data == nil) { ret contracts.ALLOCATION_FAILED; }

    array.data = data;
    array.count = count;
    array.bytes = bytes;
    array.owner = owner;
    array.state = ACTIVE;
    wipe_array[T](array.data, array.count);
    ret contracts.OK;
}

# allocate an explicitly zero-initialized secret
pub fun init(secret: *Secret, owner: *Allocator, len: usize) contracts.Error {
    if (secret == nil || owner == nil || !owner.initialized) { ret contracts.INVALID_INPUT; }
    if (!valid_empty(secret)) { ret contracts.INVALID_STATE; }

    var data: *^u8 = nil;
    if (owner.allocate_fn(owner.context, owner.secret_context, len, ?data) != 0) {
        cleanup_failed_allocation(secret, owner, data, len);
        ret contracts.ALLOCATION_FAILED;
    }
    if (len != 0 && data == nil) { ret contracts.ALLOCATION_FAILED; }
    secret.data = data;
    secret.len = len;
    secret.owner = owner;
    secret.state = ACTIVE;
    ct.zeroize(secret.data, secret.len);
    ret contracts.OK;
}

# allocate a secret and initialize it directly from an entropy source
#
# an entropy failure wipes and releases any partially filled allocation. if the
# allocator cannot release it, the owner remains in WIPED state for destroy to
# retry while ENTROPY_UNAVAILABLE remains the primary result.
pub fun init_random(secret: *Secret, owner: *Allocator, len: usize, entropy: *Entropy) contracts.Error {
    if (secret == nil || owner == nil || !owner.initialized || entropy == nil || !entropy.initialized) {
        ret contracts.INVALID_INPUT;
    }
    if (!valid_empty(secret)) { ret contracts.INVALID_STATE; }

    var data: *^u8 = nil;
    if (owner.allocate_fn(owner.context, owner.secret_context, len, ?data) != 0) {
        cleanup_failed_allocation(secret, owner, data, len);
        ret contracts.ALLOCATION_FAILED;
    }
    if (len != 0 && data == nil) { ret contracts.ALLOCATION_FAILED; }
    secret.data = data;
    secret.len = len;
    secret.owner = owner;
    secret.state = ACTIVE;

    if (entropy.fill_fn(entropy.context, entropy.secret_context, data, len) != 0) {
        ct.zeroize(secret.data, secret.len);
        secret.state = WIPED;
        release_wiped(secret);
        ret contracts.ENTROPY_UNAVAILABLE;
    }
    ret contracts.OK;
}

# return a bounded immutable view
#
# the view is borrowed and must not outlive the owner or a move or destroy call.
pub fun bytes(secret: *Secret, offset: usize, len: usize, out: *contracts.SecretBytes) contracts.Error {
    if (out == nil || secret == nil) { ret contracts.INVALID_INPUT; }
    out.data = nil;
    out.len = 0;
    if (!valid_owned(secret) || secret.state != ACTIVE) { ret contracts.INVALID_STATE; }
    if (offset > secret.len) { ret contracts.INVALID_INPUT; }
    if (len > secret.len - offset) { ret contracts.OUTPUT_TOO_SMALL; }
    if (len != 0) { out.data = ?secret.data[offset]; }
    out.len = len;
    ret contracts.OK;
}

# return a bounded mutable view
#
# the view is borrowed and must not outlive the owner or a move or destroy call.
pub fun buffer(secret: *Secret, offset: usize, len: usize, out: *contracts.SecretBuffer) contracts.Error {
    if (out == nil || secret == nil) { ret contracts.INVALID_INPUT; }
    out.data = nil;
    out.capacity = 0;
    if (!valid_owned(secret) || secret.state != ACTIVE) { ret contracts.INVALID_STATE; }
    if (offset > secret.len) { ret contracts.INVALID_INPUT; }
    if (len > secret.len - offset) { ret contracts.OUTPUT_TOO_SMALL; }
    if (len != 0) { out.data = ?secret.data[offset]; }
    out.capacity = len;
    ret contracts.OK;
}

# transfer ownership and invalidate the source
pub fun move(destination: *Secret, source: *Secret) contracts.Error {
    if (destination == nil || source == nil || destination == source) { ret contracts.INVALID_INPUT; }
    if (!valid_empty(destination)) { ret contracts.INVALID_STATE; }
    if (!valid_empty(source) && !valid_owned(source)) { ret contracts.INVALID_STATE; }
    @destination = @source;
    reset(source);
    ret contracts.OK;
}

# allocate an independent copy
pub fun clone(destination: *Secret, source: *Secret, owner: *Allocator) contracts.Error {
    if (destination == nil || source == nil || owner == nil || !owner.initialized) { ret contracts.INVALID_INPUT; }
    if (!valid_empty(destination)) { ret contracts.INVALID_STATE; }
    if (!valid_owned(source) || source.state != ACTIVE) { ret contracts.INVALID_STATE; }

    val initialized: contracts.Error = init(destination, owner, source.len);
    if (initialized != contracts.OK) { ret initialized; }

    var i: usize = 0;
    for (i < source.len) {
        destination.data[i] = source.data[i];
        i = i + 1;
    }
    ret contracts.OK;
}

# destroy an owner, wiping once before its first deallocation attempt
#
# a failed deallocation keeps wiped ownership so a later call can retry without
# repeating the wipe. destroying an empty value is an idempotent success.
pub fun destroy(secret: *Secret) contracts.Error {
    if (secret == nil) { ret contracts.INVALID_INPUT; }
    if (valid_empty(secret)) { ret contracts.OK; }
    if (!valid_owned(secret)) { ret contracts.INVALID_STATE; }

    if (secret.state == ACTIVE) {
        ct.zeroize(secret.data, secret.len);
        secret.state = WIPED;
    }
    ret release_wiped(secret);
}

# destroy a typed owner, wiping once before its first deallocation attempt
pub fun destroy_array[T](array: *SecretArray[T]) contracts.Error {
    if (array == nil) { ret contracts.INVALID_INPUT; }
    if (valid_empty_array[T](array)) { ret contracts.OK; }
    if (!valid_owned_array[T](array)) { ret contracts.INVALID_STATE; }

    if (array.state == ACTIVE) {
        wipe_array[T](array.data, array.count);
        array.state = WIPED;
    }
    ret release_wiped_array[T](array);
}

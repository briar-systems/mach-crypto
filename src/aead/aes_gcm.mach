# aes-gcm authenticated encryption
#
# a Context holds one key expanded once: the aes schedule and the ghash key.
# `seal_with` and `open_with` run many records against it and never expand
# the key again. `seal` and `open` are the one-shot form over a temporary
# context. the context is welded, since every key-derived field is
# secret-typed, and `dnit` zeroizes it.

use crypto.contracts;
use core: crypto.internal.aes;
use crypto.internal.ghash;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.size.usize;

pub val AES128_KEY_SIZE: usize = 16;
pub val AES256_KEY_SIZE: usize = 32;
pub val NONCE_SIZE:      usize = 12;
pub val TAG_SIZE:        usize = 16;

pub val MAX_PLAINTEXT_SIZE: usize = 68719476704;
pub val MAX_AAD_SIZE:       usize = 2305843009213693951;

# keystream blocks produced per aes call, at most core.PARALLEL_BLOCKS
val STREAM_BLOCKS: usize = 4;
val STREAM_SIZE:   usize = 64;

# seal writes ciphertext followed by the complete tag
pub def SealFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Bytes,
    contracts.SecretBytes, contracts.Buffer) contracts.Operation;

# open authenticates the complete input before releasing secret plaintext
pub def OpenFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Bytes,
    contracts.Bytes, contracts.SecretBuffer) contracts.Operation;

pub def State: u8;

pub val EMPTY:  State = 0;
pub val ACTIVE: State = 1;

# one expanded key
#
# callers treat the record as opaque, construct it with `empty`, and never
# copy it directly. `dnit` zeroizes every key-derived field.
pub rec Context {
    cipher: core.Context;
    hash:   ghash.Key;
    state:  State;
}

fun failed(error: contracts.Error) contracts.Operation {
    ret contracts.Operation{error: error, written: 0};
}

fun valid_key(key: contracts.SecretBytes) bool {
    ret key.len == AES128_KEY_SIZE || key.len == AES256_KEY_SIZE;
}

fun wipe(context: *Context) {
    core.destroy(?context.cipher);
    ghash.destroy(?context.hash);
    context.state = EMPTY;
}

# an empty context holds no key, so a use before init is refused
pub fun empty() Context {
    var context: Context;
    wipe(?context);
    ret context;
}

# expand the key into an empty context
#
# the key may be released or overwritten once this returns. a failure leaves
# the context empty.
#[oblivious]
pub fun init(context: *Context, key: contracts.SecretBytes) contracts.Error {
    if (context == nil)         { ret contracts.INVALID_INPUT; }
    if (context.state != EMPTY) { ret contracts.INVALID_STATE; }
    if (!valid_key(key))        { ret contracts.INVALID_KEY; }
    if (key.data == nil)        { ret contracts.INVALID_INPUT; }

    ct.begin();
    val expanded: contracts.Error = core.init(?context.cipher, key);
    if (expanded != contracts.OK) {
        wipe(context);
        ct.end();
        ret expanded;
    }
    var subkey: [16]^u8;
    ct.zeroize(?subkey[0], 16);
    core.encrypt(?context.cipher, ?subkey[0], ?subkey[0]);
    val hashed: contracts.Error = ghash.init(?context.hash, ?subkey[0], ghash.preferred());
    ct.zeroize(?subkey[0], 16);
    if (hashed != contracts.OK) {
        wipe(context);
        ct.end();
        ret hashed;
    }
    context.state = ACTIVE;
    ct.end();
    ret contracts.OK;
}

# zeroize the context and return it to empty
#
# idempotent. a context in an unknown state is still wiped and reported.
pub fun dnit(context: *Context) contracts.Error {
    if (context == nil) { ret contracts.INVALID_INPUT; }
    val valid: bool = context.state == EMPTY || context.state == ACTIVE;
    wipe(context);
    if (!valid) { ret contracts.INVALID_STATE; }
    ret contracts.OK;
}

fun make_counter(nonce: contracts.Bytes, counter: *^u8) {
    ct.zeroize(counter, 16);
    var i: usize = 0;
    for (i < NONCE_SIZE) {
        counter[i] = nonce.data[i];
        i          = i + 1;
    }
    counter[15] = 1;
}

fun set_counter(counter: *^u8, value: u32) {
    counter[12] = (value >> 24)::u8;
    counter[13] = (value >> 16)::u8;
    counter[14] = (value >> 8)::u8;
    counter[15] = value::u8;
}

# keystream for up to STREAM_BLOCKS blocks from consecutive counters starting at `first`
#[oblivious]
fun keystream(context: *core.Context, counter: *^u8, first: u32, blocks: usize,
    stream: *^u8) {
    var block: usize = 0;
    for (block < blocks) {
        var i: usize = 0;
        for (i < 12) {
            stream[block * 16 + i] = counter[i];
            i                      = i + 1;
        }
        set_counter(?stream[block * 16], first + block::u32);
        block = block + 1;
    }
    core.encrypt_blocks(context, stream, stream, blocks);
}

#[oblivious]
fun finish_tag(context: *Context, counter: *^u8, state: *ghash.State, tag: *^u8) {
    var encrypted_counter: [16]^u8;
    ct.zeroize(?encrypted_counter[0], 16);
    core.encrypt(?context.cipher, counter, ?encrypted_counter[0]);
    ghash.finish(state, tag);
    var i: usize = 0;
    for (i < TAG_SIZE) {
        tag[i] = encrypted_counter[i] ^ tag[i];
        i      = i + 1;
    }
    ct.zeroize(?encrypted_counter[0], 16);
}

# encrypt and authenticate one tls or quic record payload under the context
#
# nonce must be exactly 12 bytes. output capacity must cover plaintext plus the
# 16-byte tag. aad and nonce may overlap output because both are consumed before
# the first output write. secret and public buffers cannot alias by contract.
#[oblivious]
pub fun seal_with(context: *Context, nonce: contracts.Bytes, aad: contracts.Bytes,
    plaintext: contracts.SecretBytes, output: contracts.Buffer) contracts.Operation {
    if (context == nil)                               { ret failed(contracts.INVALID_INPUT); }
    if (context.state != ACTIVE)                      { ret failed(contracts.INVALID_STATE); }
    if (nonce.len != NONCE_SIZE || nonce.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (aad.len != 0 && aad.data == nil)              { ret failed(contracts.INVALID_INPUT); }
    if (plaintext.len != 0 && plaintext.data == nil)  { ret failed(contracts.INVALID_INPUT); }
    if (aad.len > MAX_AAD_SIZE || plaintext.len > MAX_PLAINTEXT_SIZE) {
        ret failed(contracts.INVALID_INPUT);
    }
    val required: usize = plaintext.len + TAG_SIZE;
    if (output.capacity < required) { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (output.data == nil)         { ret failed(contracts.INVALID_INPUT); }

    ct.begin();
    var state:   ghash.State;
    var counter: [16]^u8;
    var tag:     [16]^u8;
    ct.zeroize(?tag[0], 16);
    ghash.start(?state);
    make_counter(nonce, ?counter[0]);
    ghash.update(?context.hash, ?state, aad.data, aad.len);

    var stream:        [64]^u8;
    var offset:        usize = 0;
    var counter_value: u32   = 2;
    for (offset < plaintext.len) {
        var take: usize = plaintext.len - offset;
        if (take > STREAM_SIZE) { take = STREAM_SIZE; }
        val blocks: usize = (take + 15) / 16;
        keystream(?context.cipher, ?counter[0], counter_value, blocks, ?stream[0]);
        var i: usize = 0;
        for (i < take) {
            output.data[offset + i] = (plaintext.data[offset + i] ^ stream[i]):>u8;
            i                       = i + 1;
        }
        offset = offset + take;
        if (offset < plaintext.len) { counter_value = counter_value + blocks::u32; }
    }
    ct.zeroize(?stream[0], 64);
    ghash.update(?context.hash, ?state, output.data, plaintext.len);

    ghash.lengths(?context.hash, ?state, aad.len, plaintext.len);
    set_counter(?counter[0], 1);
    finish_tag(context, ?counter[0], ?state, ?tag[0]);
    var i: usize = 0;
    for (i < TAG_SIZE) {
        output.data[plaintext.len + i] = tag[i]:>u8;
        i                              = i + 1;
    }
    ghash.wipe(?state);
    ct.zeroize(?counter[0], 16);
    ct.zeroize(?tag[0], 16);
    ct.end();
    ret contracts.Operation{error: contracts.OK, written: required};
}

# authenticate and decrypt one tls or quic record payload under the context
#
# input is ciphertext followed by a complete 16-byte tag. authentication occurs
# before any decryption. authentication failure writes no plaintext and clears
# exactly the ciphertext-length prefix of output.
#[oblivious]
pub fun open_with(context: *Context, nonce: contracts.Bytes, aad: contracts.Bytes,
    input: contracts.Bytes, output: contracts.SecretBuffer) contracts.Operation {
    if (context == nil)                               { ret failed(contracts.INVALID_INPUT); }
    if (context.state != ACTIVE)                      { ret failed(contracts.INVALID_STATE); }
    if (nonce.len != NONCE_SIZE || nonce.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (aad.len != 0 && aad.data == nil)              { ret failed(contracts.INVALID_INPUT); }
    if (input.len < TAG_SIZE || input.data == nil)    { ret failed(contracts.INVALID_INPUT); }
    val ciphertext_len: usize = input.len - TAG_SIZE;
    if (aad.len > MAX_AAD_SIZE || ciphertext_len > MAX_PLAINTEXT_SIZE) {
        ret failed(contracts.INVALID_INPUT);
    }
    if (output.capacity < ciphertext_len)          { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (ciphertext_len != 0 && output.data == nil) { ret failed(contracts.INVALID_INPUT); }

    ct.begin();
    var state:    ghash.State;
    var counter:  [16]^u8;
    var expected: [16]^u8;
    var provided: [16]^u8;
    ct.zeroize(?expected[0], 16);
    ct.zeroize(?provided[0], 16);
    ghash.start(?state);
    make_counter(nonce, ?counter[0]);
    ghash.update(?context.hash, ?state, aad.data, aad.len);
    ghash.update(?context.hash, ?state, input.data, ciphertext_len);
    ghash.lengths(?context.hash, ?state, aad.len, ciphertext_len);
    set_counter(?counter[0], 1);
    finish_tag(context, ?counter[0], ?state, ?expected[0]);
    ghash.wipe(?state);
    var i: usize = 0;
    for (i < TAG_SIZE) {
        provided[i] = input.data[ciphertext_len + i];
        i           = i + 1;
    }
    val authenticated: ^u8 = ct.eq_bytes(?expected[0], ?provided[0], TAG_SIZE);
    ct.zeroize(?provided[0], 16);
    ct.zeroize(?expected[0], 16);
    if (authenticated:>u8 != 1) {
        ct.zeroize(output.data, ciphertext_len);
        ct.zeroize(?counter[0], 16);
        ct.end();
        ret failed(contracts.AUTH_FAILED);
    }

    var stream:        [64]^u8;
    var offset:        usize = 0;
    var counter_value: u32   = 2;
    for (offset < ciphertext_len) {
        var take: usize = ciphertext_len - offset;
        if (take > STREAM_SIZE) { take = STREAM_SIZE; }
        val blocks: usize = (take + 15) / 16;
        keystream(?context.cipher, ?counter[0], counter_value, blocks, ?stream[0]);
        i = 0;
        for (i < take) {
            output.data[offset + i] = input.data[offset + i] ^ stream[i];
            i                       = i + 1;
        }
        offset = offset + take;
        if (offset < ciphertext_len) { counter_value = counter_value + blocks::u32; }
    }
    ct.zeroize(?stream[0], 64);
    ct.zeroize(?counter[0], 16);
    ct.end();
    ret contracts.Operation{error: contracts.OK, written: ciphertext_len};
}

# encrypt and authenticate one record under a key expanded for this call only
#
# the same contract as `seal_with`. a caller sealing more than one record under
# a key holds a Context instead, since this expands the key on every call.
#[oblivious]
pub fun seal(key: contracts.SecretBytes, nonce: contracts.Bytes, aad: contracts.Bytes,
    plaintext: contracts.SecretBytes, output: contracts.Buffer) contracts.Operation {
    var context:     Context         = empty();
    val initialized: contracts.Error = init(?context, key);
    if (initialized != contracts.OK) { ret failed(initialized); }
    val result: contracts.Operation = seal_with(?context, nonce, aad, plaintext, output);
    dnit(?context);
    ret result;
}

# authenticate and decrypt one record under a key expanded for this call only
#
# the same contract as `open_with`. successful output may overlap the secret
# key because the key is fully expanded before any output is written.
#[oblivious]
pub fun open(key: contracts.SecretBytes, nonce: contracts.Bytes, aad: contracts.Bytes,
    input: contracts.Bytes, output: contracts.SecretBuffer) contracts.Operation {
    var context:     Context         = empty();
    val initialized: contracts.Error = init(?context, key);
    if (initialized != contracts.OK) { ret failed(initialized); }
    val result: contracts.Operation = open_with(?context, nonce, aad, input, output);
    dnit(?context);
    ret result;
}

test "aes-gcm: tls and quic dimensions are fixed" {
    if (AES128_KEY_SIZE != 16 || AES256_KEY_SIZE != 32) { ret 1; }
    if (NONCE_SIZE != 12 || TAG_SIZE != 16)             { ret 1; }
    if (MAX_PLAINTEXT_SIZE != 68719476704)              { ret 1; }

    # the keystream buffer fits one call of the widest aes backend
    if (STREAM_BLOCKS > core.PARALLEL_BLOCKS || STREAM_SIZE != STREAM_BLOCKS * 16) { ret 2; }
    ret 0;
}

    0x20, 0x9f, 0xcc, 0x8d, 0x36, 0x75, 0xed, 0x93,
    0x8e, 0x9c, 0x71, 0x66, 0x70, 0x9d, 0xd9, 0x46
};

# seal and open one vector through a context on the named members
#
# returns 0 when the sealed record and the opened plaintext both match, and
# a record with one tag bit flipped is refused.
fun check_vector(cipher: core.Backend, hash: ghash.Backend, key: *u8, key_len: usize,
    nonce: *u8, aad: *u8, aad_len: usize, plaintext: *u8, text_len: usize, sealed: *u8) u32 {
    var secret_key:  [32]^u8;
    var secret_text: [64]^u8;
    var opened:      [64]^u8;
    var output:      [80]u8;
    var i:           usize = 0;
    for (i < key_len) {
        secret_key[i] = key[i];
        i             = i + 1;
    }
    i = 0;
    for (i < text_len) {
        secret_text[i] = plaintext[i];
        i              = i + 1;
    }
    var context: Context = empty();
    if (init_backends(?context, contracts.SecretBytes{data: ?secret_key[0], len: key_len}, cipher,
        hash) != contracts.OK) { ret 1; }
    if (context.cipher.backend != cipher || context.hash.backend != hash) { ret 1; }
    val nonce12: contracts.Bytes     = contracts.Bytes{data: nonce, len: NONCE_SIZE};
    val header:  contracts.Bytes     = contracts.Bytes{data: aad, len: aad_len};
    val size:    usize               = text_len + TAG_SIZE;
    var result:  contracts.Operation = seal_with(?context, nonce12, header,
        contracts.SecretBytes{data: ?secret_text[0], len: text_len},
        contracts.Buffer{data: ?output[0], capacity: 80});
    if (result.error != contracts.OK || result.written != size) { ret 1; }
    i = 0;
    for (i < size) {
        if (output[i] != sealed[i]) { ret 1; }
        i = i + 1;
    }
    result = open_with(?context, nonce12, header, contracts.Bytes{data: sealed, len: size},
        contracts.SecretBuffer{data: ?opened[0], capacity: 64});
    if (result.error != contracts.OK || result.written != text_len) { ret 1; }
    i = 0;
    for (i < text_len) {
        if (opened[i]:>u8 != plaintext[i]) { ret 1; }
        i = i + 1;
    }
    output[text_len] = output[text_len] ^ 1;
    result           = open_with(?context, nonce12, header, contracts.Bytes{data: ?output[0], len: size},
        contracts.SecretBuffer{data: ?opened[0], capacity: 64});
    if (result.error != contracts.AUTH_FAILED) { ret 1; }
    dnit(?context);
    ret 0;
}

# 0 when every vector passes on the named members
fun check_vectors(cipher: core.Backend, hash: ghash.Backend) u32 {
    var failures: u32 = 0;
    failures = failures + check_vector(cipher, hash, ?ZEROS_16[0], 16, ?ZEROS_12[0], nil, 0, nil, 0, ?TC1_SEALED[0]);
    failures = failures + check_vector(cipher, hash, ?ZEROS_16[0], 16, ?ZEROS_12[0], nil, 0, ?ZEROS_16[0], 16, ?TC2_SEALED[0]);
    failures = failures + check_vector(cipher, hash, ?TC3_KEY[0], 16, ?TC3_NONCE[0], nil, 0, ?TC3_PLAINTEXT[0], 64, ?TC3_SEALED[0]);
    failures = failures + check_vector(cipher, hash, ?TC3_KEY[0], 16, ?TC3_NONCE[0], ?TC4_AAD[0], 20, ?TC4_PLAINTEXT[0], 60, ?TC4_SEALED[0]);
    failures = failures + check_vector(cipher, hash, ?ZEROS_32[0], 32, ?ZEROS_12[0], nil, 0, nil, 0, ?TC13_SEALED[0]);
    failures = failures + check_vector(cipher, hash, ?ZEROS_32[0], 32, ?ZEROS_12[0], nil, 0, ?ZEROS_16[0], 16, ?TC14_SEALED[0]);
    failures = failures + check_vector(cipher, hash, ?TC15_KEY[0], 32, ?TC3_NONCE[0], nil, 0, ?TC3_PLAINTEXT[0], 64, ?TC15_SEALED[0]);
    failures = failures + check_vector(cipher, hash, ?TC15_KEY[0], 32, ?TC3_NONCE[0], ?TC4_AAD[0], 20, ?TC4_PLAINTEXT[0], 60, ?TC16_SEALED[0]);
    failures = failures + check_vector(cipher, hash, ?AAD_KEY[0], 16, ?AAD_NONCE[0], ?AAD_AAD[0], 16, nil, 0, ?AAD_SEALED[0]);
    ret failures;
}

val CIPHER_MEMBERS: [2]core.Backend  = [2]core.Backend{core.SOFTWARE, core.HARDWARE};
val HASH_MEMBERS:   [2]ghash.Backend = [2]ghash.Backend{ghash.SOFTWARE, ghash.HARDWARE};

test "aes-gcm: gcm spec vectors on every aes and ghash member this host runs" {
    var c: usize = 0;
    for (c < 2) {
        var h: usize = 0;
        for (h < 2) {
            val cipher: core.Backend  = CIPHER_MEMBERS[c];
            val hash:   ghash.Backend = HASH_MEMBERS[h];
            if (core.available(cipher) && ghash.available(hash)) {
                if (check_vectors(cipher, hash) != 0) { ret (1 + c * 2 + h)::i32; }
            }
            or {
                # a member the host lacks is refused, never run
                var key:     [16]^u8;
                var context: Context = empty();
                if (init_backends(?context, contracts.SecretBytes{data: ?key[0], len: 16}, cipher,
                    hash) != contracts.UNSUPPORTED) { ret 10; }
                if (context.state != EMPTY) { ret 11; }
            }
            h = h + 1;
        }
        c = c + 1;
    }
    ret 0;
}

test "aes-gcm: a context runs the fastest members this host has" {
    var key:     [16]^u8;
    var context: Context = empty();
    if (init(?context, contracts.SecretBytes{data: ?key[0], len: 16}) != contracts.OK) { ret 1; }
    if (context.cipher.backend != core.preferred() || context.hash.backend != ghash.preferred()) {
        ret 2;
    }
    if (core.available(core.HARDWARE) != (core.preferred() == core.HARDWARE))     { ret 3; }
    if (ghash.available(ghash.HARDWARE) != (ghash.preferred() == ghash.HARDWARE)) { ret 4; }
    dnit(?context);
    ret 0;
}

# splitmix64, a fixed stream so a failure reproduces
fun next_random(state: *u64) u64 {
    @state = @state + 0x9E3779B97F4A7C15;
    var z: u64 = @state;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    ret z ^ (z >> 31);
}

fun fill_random(state: *u64, output: *u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        output[i] = next_random(state)::u8;
        i         = i + 1;
    }
}

var differential_plaintext: [4096]^u8;
var differential_hardware:  [4112]u8;
var differential_software:  [4112]u8;
var differential_opened:    [4096]^u8;

# every record length from 0 to 300 bytes, then 1200 and 4096
fun differential_length(index: usize) usize {
    if (index <= 300) { ret index; }
    if (index == 301) { ret 1200; }
    ret 4096;
}

test "aes-gcm: hardware and software members agree over random keys, nonces and records" {
    if (!core.available(core.HARDWARE) || !ghash.available(ghash.HARDWARE)) { ret 0; }
    var state: u64   = 159;
    var index: usize = 0;
    for (index <= 302) {
        val text_len: usize = differential_length(index);
        var key_len:  usize = AES128_KEY_SIZE;
        if ((index & 1) == 1) { key_len = AES256_KEY_SIZE; }
        var key:    [32]u8;
        var secret: [32]^u8;
        var nonce:  [12]u8;
        var aad:    [48]u8;
        fill_random(?state, ?key[0], 32);
        fill_random(?state, ?nonce[0], 12);
        fill_random(?state, ?aad[0], 48);
        val aad_len: usize = (next_random(?state) % 49)::usize;
        var i:       usize = 0;
        for (i < 32) {
            secret[i] = key[i];
            i         = i + 1;
        }
        i = 0;
        for (i < text_len) {
            differential_plaintext[i] = next_random(?state)::u8;
            i                         = i + 1;
        }
        val secret_key: contracts.SecretBytes = contracts.SecretBytes{data: ?secret[0], len: key_len};
        var hardware:   Context               = empty();
        var software:   Context               = empty();
        if (init_backends(?hardware, secret_key, core.HARDWARE, ghash.HARDWARE) != contracts.OK) { ret 1; }
        if (init_backends(?software, secret_key, core.SOFTWARE, ghash.SOFTWARE) != contracts.OK) { ret 1; }
        val nonce12:   contracts.Bytes       = contracts.Bytes{data: ?nonce[0], len: NONCE_SIZE};
        val header:    contracts.Bytes       = contracts.Bytes{data: ?aad[0], len: aad_len};
        val plaintext: contracts.SecretBytes = contracts.SecretBytes{data: ?differential_plaintext[0], len: text_len};
        val size:      usize                 = text_len + TAG_SIZE;
        var result:    contracts.Operation   = seal_with(?hardware, nonce12, header, plaintext,
            contracts.Buffer{data: ?differential_hardware[0], capacity: 4112});
        if (result.error != contracts.OK || result.written != size) { ret 2; }
        result = seal_with(?software, nonce12, header, plaintext,
            contracts.Buffer{data: ?differential_software[0], capacity: 4112});
        if (result.error != contracts.OK || result.written != size) { ret 3; }
        i = 0;
        for (i < size) {
            if (differential_hardware[i] != differential_software[i]) { ret 4; }
            i = i + 1;
        }
        # each member opens the other's record
        result = open_with(?software, nonce12, header,
            contracts.Bytes{data: ?differential_hardware[0], len: size},
            contracts.SecretBuffer{data: ?differential_opened[0], capacity: 4096});
        if (result.error != contracts.OK || result.written != text_len) { ret 5; }
        i = 0;
        for (i < text_len) {
            if (differential_opened[i]:>u8 != differential_plaintext[i]:>u8) { ret 6; }
            i = i + 1;
        }
        result = open_with(?hardware, nonce12, header,
            contracts.Bytes{data: ?differential_software[0], len: size},
            contracts.SecretBuffer{data: ?differential_opened[0], capacity: 4096});
        if (result.error != contracts.OK || result.written != text_len) { ret 7; }
        i = 0;
        for (i < text_len) {
            if (differential_opened[i]:>u8 != differential_plaintext[i]:>u8) { ret 8; }
            i = i + 1;
        }
        dnit(?hardware);
        dnit(?software);
        index = index + 1;
    }
    ret 0;
}

# aes-gcm authenticated encryption

use crypto.contracts;
use core: crypto.internal.aes;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.size.usize;

pub val AES128_KEY_SIZE: usize = 16;
pub val AES256_KEY_SIZE: usize = 32;
pub val NONCE_SIZE:      usize = 12;
pub val TAG_SIZE:        usize = 16;

pub val MAX_PLAINTEXT_SIZE: usize = 68719476704;
pub val MAX_AAD_SIZE:       usize = 2305843009213693951;

# seal writes ciphertext followed by the complete tag
pub def SealFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Bytes,
    contracts.SecretBytes, contracts.Buffer) contracts.Operation;

# open authenticates the complete input before releasing secret plaintext
pub def OpenFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Bytes,
    contracts.Bytes, contracts.SecretBuffer) contracts.Operation;

fun failed(error: contracts.Error) contracts.Operation {
    ret contracts.Operation{error: error, written: 0};
}

fun valid_key(key: contracts.SecretBytes) bool {
    ret key.len == AES128_KEY_SIZE || key.len == AES256_KEY_SIZE;
}

# ghash state as big-endian 64-bit words, the key first and the accumulator second
rec Hash {
    key:         [2]^u64;
    accumulator: [2]^u64;
}

#[oblivious]
fun read_u64_be(input: *^u8, offset: usize) ^u64 {
    var value: ^u64  = 0;
    var i:     usize = 0;
    for (i < 8) {
        value = (value << 8) | input[offset + i]::^u64;
        i     = i + 1;
    }
    ret value;
}

#[oblivious]
fun write_secret_u64_be(output: *^u8, offset: usize, value: ^u64) {
    var i: usize = 0;
    for (i < 8) {
        output[offset + i] = (value >> ((7 - i) * 8)::u64)::^u8;
        i                  = i + 1;
    }
}

# multiply the accumulator by the hash key in gf(2^128) one bit at a time
#[oblivious]
fun multiply_hash(state: *Hash) {
    var product_high: ^u64  = 0;
    var product_low:  ^u64  = 0;
    var multiple_high: ^u64 = state.key[0];
    var multiple_low:  ^u64 = state.key[1];
    val value_high:   ^u64  = state.accumulator[0];
    val value_low:    ^u64  = state.accumulator[1];
    var bit:          u64   = 0;
    for (bit < 128) {
        var selected: ^u64 = 0;
        if (bit < 64) { selected = (value_high >> (63 - bit)) & 1; }
        or            { selected = (value_low >> (127 - bit)) & 1; }
        val mask: ^u64 = 0 - selected;
        product_high = product_high ^ (multiple_high & mask);
        product_low  = product_low ^ (multiple_low & mask);
        val reduce: ^u64 = 0 - (multiple_low & 1);
        multiple_low  = (multiple_low >> 1) | (multiple_high << 63);
        multiple_high = (multiple_high >> 1) ^ (0xE100000000000000 & reduce);
        bit           = bit + 1;
    }
    state.accumulator[0] = product_high;
    state.accumulator[1] = product_low;
    product_high  = 0;
    product_low   = 0;
    multiple_high = 0;
    multiple_low  = 0;
}

#[oblivious]
fun hash_block(state: *Hash, block: *^u8) {
    state.accumulator[0] = state.accumulator[0] ^ read_u64_be(block, 0);
    state.accumulator[1] = state.accumulator[1] ^ read_u64_be(block, 8);
    multiply_hash(state);
}

fun hash_public(state: *Hash, data: *u8, len: usize) {
    var block:  [16]^u8;
    var offset: usize = 0;
    for (offset < len) {
        ct.zeroize(?block[0], 16);
        var take: usize = len - offset;
        if (take > 16) { take = 16; }
        var i: usize = 0;
        for (i < take) {
            block[i] = data[offset + i];
            i        = i + 1;
        }
        hash_block(state, ?block[0]);
        offset = offset + take;
    }
    ct.zeroize(?block[0], 16);
}

#[oblivious]
fun hash_lengths(state: *Hash, aad_len: usize, text_len: usize) {
    state.accumulator[0] = state.accumulator[0] ^ (aad_len::u64 * 8);
    state.accumulator[1] = state.accumulator[1] ^ (text_len::u64 * 8);
    multiply_hash(state);
}

#[oblivious]
fun init_hash(state: *Hash, context: *core.Context) {
    var zero: [16]^u8;
    ct.zeroize(?zero[0], 16);
    core.encrypt(context, ?zero[0], ?zero[0]);
    state.key[0]         = read_u64_be(?zero[0], 0);
    state.key[1]         = read_u64_be(?zero[0], 8);
    state.accumulator[0] = 0;
    state.accumulator[1] = 0;
    ct.zeroize(?zero[0], 16);
}

fun destroy_hash(state: *Hash) {
    ct.zeroize((?state.key[0]):~*^u8, 32);
}

fun make_counter(nonce: contracts.Bytes, counter: *^u8) {
    ct.zeroize(counter, 16);
    var i: usize = 0;
    for (i < NONCE_SIZE) {
        counter[i] = nonce.data[i];
        i          = i + 1;
    }
    counter[15] = 1;
}

fun set_counter(counter: *^u8, value: u32) {
    counter[12] = (value >> 24)::u8;
    counter[13] = (value >> 16)::u8;
    counter[14] = (value >> 8)::u8;
    counter[15] = value::u8;
}

# keystream for up to four blocks from consecutive counters starting at `first`
#[oblivious]
fun keystream(context: *core.Context, counter: *^u8, first: u32, blocks: usize,
    stream: *^u8) {
    var block: usize = 0;
    for (block < blocks) {
        var i: usize = 0;
        for (i < 12) {
            stream[block * 16 + i] = counter[i];
            i                      = i + 1;
        }
        set_counter(?stream[block * 16], first + block::u32);
        block = block + 1;
    }
    core.encrypt_blocks(context, stream, stream, blocks);
}

#[oblivious]
fun finish_tag(context: *core.Context, counter: *^u8, state: *Hash, tag: *^u8) {
    var encrypted_counter: [16]^u8;
    ct.zeroize(?encrypted_counter[0], 16);
    core.encrypt(context, counter, ?encrypted_counter[0]);
    write_secret_u64_be(tag, 0, state.accumulator[0]);
    write_secret_u64_be(tag, 8, state.accumulator[1]);
    var i: usize = 0;
    for (i < TAG_SIZE) {
        tag[i] = encrypted_counter[i] ^ tag[i];
        i      = i + 1;
    }
    ct.zeroize(?encrypted_counter[0], 16);
}

fun wipe_common(context: *core.Context, state: *Hash, counter: *^u8, tag: *^u8) {
    core.destroy(context);
    destroy_hash(state);
    ct.zeroize(counter, 16);
    ct.zeroize(tag, 16);
}

# encrypt and authenticate one tls or quic record payload
#
# nonce must be exactly 12 bytes. output capacity must cover plaintext plus the
# 16-byte tag. aad and nonce may overlap output because both are consumed before
# the first output write. secret and public buffers cannot alias by contract.
#[oblivious]
pub fun seal(key: contracts.SecretBytes, nonce: contracts.Bytes, aad: contracts.Bytes,
    plaintext: contracts.SecretBytes, output: contracts.Buffer) contracts.Operation {
    if (!valid_key(key))                              { ret failed(contracts.INVALID_KEY); }
    if (key.data == nil)                              { ret failed(contracts.INVALID_INPUT); }
    if (nonce.len != NONCE_SIZE || nonce.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (aad.len != 0 && aad.data == nil)              { ret failed(contracts.INVALID_INPUT); }
    if (plaintext.len != 0 && plaintext.data == nil)  { ret failed(contracts.INVALID_INPUT); }
    if (aad.len > MAX_AAD_SIZE || plaintext.len > MAX_PLAINTEXT_SIZE) {
        ret failed(contracts.INVALID_INPUT);
    }
    val required: usize = plaintext.len + TAG_SIZE;
    if (output.capacity < required) { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (output.data == nil)         { ret failed(contracts.INVALID_INPUT); }

    ct.begin();
    var context:     core.Context;
    val initialized: contracts.Error = core.init(?context, key);
    if (initialized != contracts.OK) {
        ct.end();
        ret failed(initialized);
    }
    var state:   Hash;
    var counter: [16]^u8;
    var tag:     [16]^u8;
    ct.zeroize(?counter[0], 16);
    ct.zeroize(?tag[0], 16);
    init_hash(?state, ?context);
    make_counter(nonce, ?counter[0]);
    hash_public(?state, aad.data, aad.len);

    var stream:        [64]^u8;
    var offset:        usize = 0;
    var counter_value: u32   = 2;
    for (offset < plaintext.len) {
        var take: usize = plaintext.len - offset;
        if (take > 64) { take = 64; }
        val blocks: usize = (take + 15) / 16;
        keystream(?context, ?counter[0], counter_value, blocks, ?stream[0]);
        var i: usize = 0;
        for (i < take) {
            output.data[offset + i] = (plaintext.data[offset + i] ^ stream[i]):>u8;
            i                       = i + 1;
        }
        offset = offset + take;
        if (offset < plaintext.len) { counter_value = counter_value + blocks::u32; }
    }
    ct.zeroize(?stream[0], 64);
    hash_public(?state, output.data, plaintext.len);

    hash_lengths(?state, aad.len, plaintext.len);
    set_counter(?counter[0], 1);
    finish_tag(?context, ?counter[0], ?state, ?tag[0]);
    var i: usize = 0;
    for (i < TAG_SIZE) {
        output.data[plaintext.len + i] = tag[i]:>u8;
        i                              = i + 1;
    }
    wipe_common(?context, ?state, ?counter[0], ?tag[0]);
    ct.end();
    ret contracts.Operation{error: contracts.OK, written: required};
}

# authenticate and decrypt one tls or quic record payload
#
# input is ciphertext followed by a complete 16-byte tag. authentication occurs
# before any decryption. authentication failure writes no plaintext and clears
# exactly the ciphertext-length prefix of output. successful output may overlap
# the secret key because the expanded key schedule is snapshotted first.
#[oblivious]
pub fun open(key: contracts.SecretBytes, nonce: contracts.Bytes, aad: contracts.Bytes,
    input: contracts.Bytes, output: contracts.SecretBuffer) contracts.Operation {
    if (!valid_key(key))                              { ret failed(contracts.INVALID_KEY); }
    if (key.data == nil)                              { ret failed(contracts.INVALID_INPUT); }
    if (nonce.len != NONCE_SIZE || nonce.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (aad.len != 0 && aad.data == nil)              { ret failed(contracts.INVALID_INPUT); }
    if (input.len < TAG_SIZE || input.data == nil)    { ret failed(contracts.INVALID_INPUT); }
    val ciphertext_len: usize = input.len - TAG_SIZE;
    if (aad.len > MAX_AAD_SIZE || ciphertext_len > MAX_PLAINTEXT_SIZE) {
        ret failed(contracts.INVALID_INPUT);
    }
    if (output.capacity < ciphertext_len)          { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (ciphertext_len != 0 && output.data == nil) { ret failed(contracts.INVALID_INPUT); }

    ct.begin();
    var context:     core.Context;
    val initialized: contracts.Error = core.init(?context, key);
    if (initialized != contracts.OK) {
        ct.end();
        ret failed(initialized);
    }
    var state:    Hash;
    var counter:  [16]^u8;
    var expected: [16]^u8;
    var provided: [16]^u8;
    ct.zeroize(?counter[0], 16);
    ct.zeroize(?expected[0], 16);
    ct.zeroize(?provided[0], 16);
    init_hash(?state, ?context);
    make_counter(nonce, ?counter[0]);
    hash_public(?state, aad.data, aad.len);
    hash_public(?state, input.data, ciphertext_len);
    hash_lengths(?state, aad.len, ciphertext_len);
    set_counter(?counter[0], 1);
    finish_tag(?context, ?counter[0], ?state, ?expected[0]);
    var i: usize = 0;
    for (i < TAG_SIZE) {
        provided[i] = input.data[ciphertext_len + i];
        i           = i + 1;
    }
    val authenticated: ^u8 = ct.eq_bytes(?expected[0], ?provided[0], TAG_SIZE);
    ct.zeroize(?provided[0], 16);
    if (authenticated:>u8 != 1) {
        ct.zeroize(output.data, ciphertext_len);
        wipe_common(?context, ?state, ?counter[0], ?expected[0]);
        ct.end();
        ret failed(contracts.AUTH_FAILED);
    }
    destroy_hash(?state);
    ct.zeroize(?expected[0], 16);

    var stream:        [64]^u8;
    var offset:        usize = 0;
    var counter_value: u32   = 2;
    for (offset < ciphertext_len) {
        var take: usize = ciphertext_len - offset;
        if (take > 64) { take = 64; }
        val blocks: usize = (take + 15) / 16;
        keystream(?context, ?counter[0], counter_value, blocks, ?stream[0]);
        i = 0;
        for (i < take) {
            output.data[offset + i] = input.data[offset + i] ^ stream[i];
            i                       = i + 1;
        }
        offset = offset + take;
        if (offset < ciphertext_len) { counter_value = counter_value + blocks::u32; }
    }
    ct.zeroize(?stream[0], 64);
    core.destroy(?context);
    ct.zeroize(?counter[0], 16);
    ct.end();
    ret contracts.Operation{error: contracts.OK, written: ciphertext_len};
}

test "aes-gcm: tls and quic dimensions are fixed" {
    if (AES128_KEY_SIZE != 16 || AES256_KEY_SIZE != 32) { ret 1; }
    if (NONCE_SIZE != 12 || TAG_SIZE != 16)             { ret 1; }
    if (MAX_PLAINTEXT_SIZE != 68719476704)              { ret 1; }
    ret 0;
}

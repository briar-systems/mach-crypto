# aes-gcm authenticated encryption

use crypto.contracts;
use core: crypto.internal.aes;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.size.usize;

pub val AES128_KEY_SIZE: usize = 16;
pub val AES256_KEY_SIZE: usize = 32;
pub val NONCE_SIZE:      usize = 12;
pub val TAG_SIZE:        usize = 16;

pub val MAX_PLAINTEXT_SIZE: usize = 68719476704;
pub val MAX_AAD_SIZE: usize = 2305843009213693951;

# seal writes ciphertext followed by the complete tag
pub def SealFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Bytes,
    contracts.SecretBytes, contracts.Buffer) contracts.Operation;

# open authenticates the complete input before releasing secret plaintext
pub def OpenFun: fun(contracts.SecretBytes, contracts.Bytes, contracts.Bytes,
    contracts.Bytes, contracts.SecretBuffer) contracts.Operation;

fun failed(error: contracts.Error) contracts.Operation {
    ret contracts.Operation{error: error, written: 0};
}

fun valid_key(key: contracts.SecretBytes) bool {
    ret key.len == AES128_KEY_SIZE || key.len == AES256_KEY_SIZE;
}

#[oblivious]
fun multiply_hash(value: *^u8, hash_key: *^u8) {
    var product: [16]^u8;
    var multiple: [16]^u8;
    ct.zeroize(?product[0], 16);
    var i: usize = 0;
    for (i < 16) { multiple[i] = hash_key[i]; i = i + 1; }

    var bit: usize = 0;
    for (bit < 128) {
        val selected: ^u8 = (value[bit / 8] >> (7 - bit % 8)) & 1;
        val mask: ^u8 = 0 - selected;
        i = 0;
        for (i < 16) {
            product[i] = product[i] ^ (multiple[i] & mask);
            i = i + 1;
        }

        val reduce: ^u8 = 0 - (multiple[15] & 1);
        var carry: ^u8 = 0;
        i = 0;
        for (i < 16) {
            val next: ^u8 = multiple[i] & 1;
            multiple[i] = (multiple[i] >> 1) | (carry << 7);
            carry = next;
            i = i + 1;
        }
        multiple[0] = multiple[0] ^ (0xE1 & reduce);
        carry = 0;
        bit = bit + 1;
    }

    i = 0;
    for (i < 16) { value[i] = product[i]; i = i + 1; }
    ct.zeroize(?product[0], 16);
    ct.zeroize(?multiple[0], 16);
}

#[oblivious]
fun hash_block(accumulator: *^u8, hash_key: *^u8, block: *^u8) {
    var i: usize = 0;
    for (i < 16) {
        accumulator[i] = accumulator[i] ^ block[i];
        i = i + 1;
    }
    multiply_hash(accumulator, hash_key);
}

fun hash_public(accumulator: *^u8, hash_key: *^u8, data: *u8, len: usize) {
    var block: [16]^u8;
    ct.zeroize(?block[0], 16);
    var offset: usize = 0;
    for (offset < len) {
        ct.zeroize(?block[0], 16);
        var take: usize = len - offset;
        if (take > 16) { take = 16; }
        var i: usize = 0;
        for (i < take) {
            block[i] = data[offset + i];
            i = i + 1;
        }
        hash_block(accumulator, hash_key, ?block[0]);
        offset = offset + take;
    }
    ct.zeroize(?block[0], 16);
}

fun write_u64_be(output: *^u8, offset: usize, value: u64) {
    output[offset] = (value >> 56)::u8;
    output[offset + 1] = (value >> 48)::u8;
    output[offset + 2] = (value >> 40)::u8;
    output[offset + 3] = (value >> 32)::u8;
    output[offset + 4] = (value >> 24)::u8;
    output[offset + 5] = (value >> 16)::u8;
    output[offset + 6] = (value >> 8)::u8;
    output[offset + 7] = value::u8;
}

fun hash_lengths(accumulator: *^u8, hash_key: *^u8, aad_len: usize, text_len: usize) {
    var block: [16]^u8;
    ct.zeroize(?block[0], 16);
    write_u64_be(?block[0], 0, aad_len::u64 * 8);
    write_u64_be(?block[0], 8, text_len::u64 * 8);
    hash_block(accumulator, hash_key, ?block[0]);
    ct.zeroize(?block[0], 16);
}

fun make_counter(nonce: contracts.Bytes, counter: *^u8) {
    ct.zeroize(counter, 16);
    var i: usize = 0;
    for (i < NONCE_SIZE) {
        counter[i] = nonce.data[i];
        i = i + 1;
    }
    counter[15] = 1;
}

fun set_counter(counter: *^u8, value: u32) {
    counter[12] = (value >> 24)::u8;
    counter[13] = (value >> 16)::u8;
    counter[14] = (value >> 8)::u8;
    counter[15] = value::u8;
}

#[oblivious]
fun finish_tag(context: *core.Context, counter: *^u8, accumulator: *^u8, tag: *^u8) {
    var encrypted_counter: [16]^u8;
    ct.zeroize(?encrypted_counter[0], 16);
    core.encrypt(context, counter, ?encrypted_counter[0]);
    var i: usize = 0;
    for (i < TAG_SIZE) {
        tag[i] = encrypted_counter[i] ^ accumulator[i];
        i = i + 1;
    }
    ct.zeroize(?encrypted_counter[0], 16);
}

fun wipe_common(context: *core.Context, hash_key: *^u8, accumulator: *^u8,
    counter: *^u8, tag: *^u8) {
    core.destroy(context);
    ct.zeroize(hash_key, 16);
    ct.zeroize(accumulator, 16);
    ct.zeroize(counter, 16);
    ct.zeroize(tag, 16);
}

# encrypt and authenticate one tls or quic record payload
#
# nonce must be exactly 12 bytes. output capacity must cover plaintext plus the
# 16-byte tag. aad and nonce may overlap output because both are consumed before
# the first output write. secret and public buffers cannot alias by contract.
#[oblivious]
pub fun seal(key: contracts.SecretBytes, nonce: contracts.Bytes, aad: contracts.Bytes,
    plaintext: contracts.SecretBytes, output: contracts.Buffer) contracts.Operation {
    if (!valid_key(key)) { ret failed(contracts.INVALID_KEY); }
    if (key.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (nonce.len != NONCE_SIZE || nonce.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (aad.len != 0 && aad.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (plaintext.len != 0 && plaintext.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (aad.len > MAX_AAD_SIZE || plaintext.len > MAX_PLAINTEXT_SIZE) {
        ret failed(contracts.INVALID_INPUT);
    }
    val required: usize = plaintext.len + TAG_SIZE;
    if (output.capacity < required) { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (output.data == nil) { ret failed(contracts.INVALID_INPUT); }

    ct.begin();
    var context: core.Context;
    val initialized: contracts.Error = core.init(?context, key);
    if (initialized != contracts.OK) {
        ct.end();
        ret failed(initialized);
    }
    var hash_key: [16]^u8;
    var accumulator: [16]^u8;
    var counter: [16]^u8;
    var tag: [16]^u8;
    ct.zeroize(?hash_key[0], 16);
    ct.zeroize(?accumulator[0], 16);
    ct.zeroize(?counter[0], 16);
    ct.zeroize(?tag[0], 16);
    core.encrypt(?context, ?hash_key[0], ?hash_key[0]);
    make_counter(nonce, ?counter[0]);
    hash_public(?accumulator[0], ?hash_key[0], aad.data, aad.len);

    var stream: [16]^u8;
    var block: [16]^u8;
    ct.zeroize(?stream[0], 16);
    ct.zeroize(?block[0], 16);
    var offset: usize = 0;
    var counter_value: u32 = 2;
    for (offset < plaintext.len) {
        set_counter(?counter[0], counter_value);
        core.encrypt(?context, ?counter[0], ?stream[0]);
        ct.zeroize(?block[0], 16);
        var take: usize = plaintext.len - offset;
        if (take > 16) { take = 16; }
        var i: usize = 0;
        for (i < take) {
            block[i] = plaintext.data[offset + i] ^ stream[i];
            output.data[offset + i] = block[i]:^;
            i = i + 1;
        }
        hash_block(?accumulator[0], ?hash_key[0], ?block[0]);
        offset = offset + take;
        if (offset < plaintext.len) { counter_value = counter_value + 1; }
    }
    ct.zeroize(?stream[0], 16);
    ct.zeroize(?block[0], 16);

    hash_lengths(?accumulator[0], ?hash_key[0], aad.len, plaintext.len);
    set_counter(?counter[0], 1);
    finish_tag(?context, ?counter[0], ?accumulator[0], ?tag[0]);
    var i: usize = 0;
    for (i < TAG_SIZE) {
        output.data[plaintext.len + i] = tag[i]:^;
        i = i + 1;
    }
    wipe_common(?context, ?hash_key[0], ?accumulator[0], ?counter[0], ?tag[0]);
    ct.end();
    ret contracts.Operation{error: contracts.OK, written: required};
}

# authenticate and decrypt one tls or quic record payload
#
# input is ciphertext followed by a complete 16-byte tag. authentication occurs
# before any decryption. authentication failure writes no plaintext and clears
# exactly the ciphertext-length prefix of output. successful output may overlap
# the secret key because the expanded key schedule is snapshotted first.
#[oblivious]
pub fun open(key: contracts.SecretBytes, nonce: contracts.Bytes, aad: contracts.Bytes,
    input: contracts.Bytes, output: contracts.SecretBuffer) contracts.Operation {
    if (!valid_key(key)) { ret failed(contracts.INVALID_KEY); }
    if (key.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (nonce.len != NONCE_SIZE || nonce.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (aad.len != 0 && aad.data == nil) { ret failed(contracts.INVALID_INPUT); }
    if (input.len < TAG_SIZE || input.data == nil) { ret failed(contracts.INVALID_INPUT); }
    val ciphertext_len: usize = input.len - TAG_SIZE;
    if (aad.len > MAX_AAD_SIZE || ciphertext_len > MAX_PLAINTEXT_SIZE) {
        ret failed(contracts.INVALID_INPUT);
    }
    if (output.capacity < ciphertext_len) { ret failed(contracts.OUTPUT_TOO_SMALL); }
    if (ciphertext_len != 0 && output.data == nil) { ret failed(contracts.INVALID_INPUT); }

    ct.begin();
    var context: core.Context;
    val initialized: contracts.Error = core.init(?context, key);
    if (initialized != contracts.OK) {
        ct.end();
        ret failed(initialized);
    }
    var hash_key: [16]^u8;
    var accumulator: [16]^u8;
    var counter: [16]^u8;
    var expected: [16]^u8;
    var provided: [16]^u8;
    ct.zeroize(?hash_key[0], 16);
    ct.zeroize(?accumulator[0], 16);
    ct.zeroize(?counter[0], 16);
    ct.zeroize(?expected[0], 16);
    ct.zeroize(?provided[0], 16);
    core.encrypt(?context, ?hash_key[0], ?hash_key[0]);
    make_counter(nonce, ?counter[0]);
    hash_public(?accumulator[0], ?hash_key[0], aad.data, aad.len);
    hash_public(?accumulator[0], ?hash_key[0], input.data, ciphertext_len);
    hash_lengths(?accumulator[0], ?hash_key[0], aad.len, ciphertext_len);
    set_counter(?counter[0], 1);
    finish_tag(?context, ?counter[0], ?accumulator[0], ?expected[0]);
    var i: usize = 0;
    for (i < TAG_SIZE) {
        provided[i] = input.data[ciphertext_len + i];
        i = i + 1;
    }
    val authenticated: ^u8 = ct.eq_bytes(?expected[0], ?provided[0], TAG_SIZE);
    ct.zeroize(?provided[0], 16);
    if (authenticated:^ != 1) {
        ct.zeroize(output.data, ciphertext_len);
        wipe_common(?context, ?hash_key[0], ?accumulator[0], ?counter[0], ?expected[0]);
        ct.end();
        ret failed(contracts.AUTH_FAILED);
    }
    ct.zeroize(?hash_key[0], 16);
    ct.zeroize(?accumulator[0], 16);
    ct.zeroize(?expected[0], 16);

    var stream: [16]^u8;
    ct.zeroize(?stream[0], 16);
    var offset: usize = 0;
    var counter_value: u32 = 2;
    for (offset < ciphertext_len) {
        set_counter(?counter[0], counter_value);
        core.encrypt(?context, ?counter[0], ?stream[0]);
        var take: usize = ciphertext_len - offset;
        if (take > 16) { take = 16; }
        i = 0;
        for (i < take) {
            output.data[offset + i] = input.data[offset + i] ^ stream[i];
            i = i + 1;
        }
        offset = offset + take;
        if (offset < ciphertext_len) { counter_value = counter_value + 1; }
    }
    ct.zeroize(?stream[0], 16);
    core.destroy(?context);
    ct.zeroize(?counter[0], 16);
    ct.end();
    ret contracts.Operation{error: contracts.OK, written: ciphertext_len};
}

test "aes-gcm: tls and quic dimensions are fixed" {
    if (AES128_KEY_SIZE != 16 || AES256_KEY_SIZE != 32) { ret 1; }
    if (NONCE_SIZE != 12 || TAG_SIZE != 16) { ret 1; }
    if (MAX_PLAINTEXT_SIZE != 68719476704) { ret 1; }
    ret 0;
}

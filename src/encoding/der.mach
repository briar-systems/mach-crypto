# strict bounded distinguished encoding rules

use crypto.contracts;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def Tag: u8;

pub val BOOLEAN:      Tag = 0x01;
pub val INTEGER:      Tag = 0x02;
pub val BIT_STRING:   Tag = 0x03;
pub val OCTET_STRING: Tag = 0x04;
pub val NULL:         Tag = 0x05;
pub val OBJECT_ID:    Tag = 0x06;
pub val SEQUENCE:     Tag = 0x30;

pub val MAX_DEPTH: usize = 16;

pub rec Element {
    tag:     Tag;
    content: contracts.Bytes;
    encoded: contracts.Bytes;
}

pub rec SecretElement {
    tag:     Tag;
    content: contracts.SecretBytes;
    encoded: contracts.SecretBytes;
}

pub rec Cursor {
    input:  contracts.Bytes;
    offset: usize;
    depth:  usize;
}

pub rec SecretCursor {
    input:  contracts.SecretBytes;
    offset: usize;
    depth:  usize;
}

pub fun cursor(input: contracts.Bytes) Cursor {
    ret Cursor{input: input, offset: 0, depth: 0};
}

pub fun secret_cursor(input: contracts.SecretBytes) SecretCursor {
    ret SecretCursor{input: input, offset: 0, depth: 0};
}

pub fun complete(value: *Cursor) bool {
    ret value != nil && value.offset == value.input.len;
}

pub fun secret_complete(value: *SecretCursor) bool {
    ret value != nil && value.offset == value.input.len;
}

fun valid_tag(tag: Tag) bool {
    if (tag == 0 || (tag & 0x1f) == 0x1f) { ret false; }
    if ((tag & 0xc0) == 0) {
        val number: u8 = tag & 0x1f;
        if ((tag & 0x20) != 0) { ret tag == 0x30 || tag == 0x31; }
        if (number == 0x10 || number == 0x11) { ret false; }
    }
    ret true;
}

fun valid_public_content(tag: Tag, data: *u8, len: usize) bool {
    if (len > 0 && data == nil) { ret false; }
    if (tag == BOOLEAN) {
        ret len == 1 && (data[0] == 0 || data[0] == 0xff);
    }
    if (tag == INTEGER) {
        if (len == 0) { ret false; }
        if (len > 1 && data[0] == 0 && (data[1] & 0x80) == 0) { ret false; }
        if (len > 1 && data[0] == 0xff && (data[1] & 0x80) != 0) { ret false; }
        ret true;
    }
    if (tag == BIT_STRING) {
        if (len == 0 || data[0] > 7) { ret false; }
        if (len == 1) { ret data[0] == 0; }
        if (data[0] > 0) {
            val mask: u8 = ((1::u16 << data[0]) - 1)::u8;
            if ((data[len - 1] & mask) != 0) { ret false; }
        }
        ret true;
    }
    if (tag == NULL) { ret len == 0; }
    if (tag == OBJECT_ID) {
        if (len == 0) { ret false; }
        var start: bool = true;
        var i: usize = 0;
        for (i < len) {
            if (start && data[i] == 0x80) { ret false; }
            start = (data[i] & 0x80) == 0;
            i = i + 1;
        }
        ret start;
    }
    ret true;
}

#[oblivious]
fun valid_secret_content(tag: Tag, data: *^u8, len: usize) bool {
    if (len > 0 && data == nil) { ret false; }
    if (tag == BOOLEAN) {
        ret len == 1 && (data[0]:>u8 == 0 || data[0]:>u8 == 0xff);
    }
    if (tag == INTEGER) {
        if (len == 0) { ret false; }
        if (len > 1 && data[0]:>u8 == 0 && (data[1]:>u8 & 0x80) == 0) { ret false; }
        if (len > 1 && data[0]:>u8 == 0xff && (data[1]:>u8 & 0x80) != 0) { ret false; }
        ret true;
    }
    if (tag == BIT_STRING) {
        if (len == 0 || data[0]:>u8 > 7) { ret false; }
        if (len == 1) { ret data[0]:>u8 == 0; }
        if (data[0]:>u8 > 0) {
            val mask: u8 = ((1::u16 << data[0]:>u8) - 1)::u8;
            if ((data[len - 1]:>u8 & mask) != 0) { ret false; }
        }
        ret true;
    }
    if (tag == NULL) { ret len == 0; }
    if (tag == OBJECT_ID) {
        if (len == 0) { ret false; }
        var start: bool = true;
        var i: usize = 0;
        for (i < len) {
            if (start && data[i]:>u8 == 0x80) { ret false; }
            start = (data[i]:>u8 & 0x80) == 0;
            i = i + 1;
        }
        ret start;
    }
    ret true;
}

fun read_length(data: *u8, available: usize, length: *usize,
    width: *usize) contracts.Error {
    if (available == 0 || data == nil || length == nil || width == nil) {
        ret contracts.INVALID_INPUT;
    }
    val first: u8 = data[0];
    if ((first & 0x80) == 0) {
        @length = first::usize;
        @width = 1;
        ret contracts.OK;
    }
    val count: usize = (first & 0x7f)::usize;
    if (count == 0 || count > 8 || count > available - 1 || data[1] == 0) {
        ret contracts.INVALID_INPUT;
    }
    var result: usize = 0;
    var i: usize = 0;
    for (i < count) {
        val value: usize = data[1 + i]::usize;
        if (result > ((0 - 1) - value) >> 8) { ret contracts.INVALID_INPUT; }
        result = (result << 8) | value;
        i = i + 1;
    }
    if (result < 128) { ret contracts.INVALID_INPUT; }
    @length = result;
    @width = 1 + count;
    ret contracts.OK;
}

#[oblivious]
fun read_secret_length(data: *^u8, available: usize, length: *usize,
    width: *usize) contracts.Error {
    if (available == 0 || data == nil || length == nil || width == nil) {
        ret contracts.INVALID_INPUT;
    }
    val first: u8 = data[0]:>u8;
    if ((first & 0x80) == 0) {
        @length = first::usize;
        @width = 1;
        ret contracts.OK;
    }
    val count: usize = (first & 0x7f)::usize;
    if (count == 0 || count > 8 || count > available - 1 || data[1]:>u8 == 0) {
        ret contracts.INVALID_INPUT;
    }
    var result: usize = 0;
    var i: usize = 0;
    for (i < count) {
        val value: usize = (data[1 + i]:>u8)::usize;
        if (result > ((0 - 1) - value) >> 8) { ret contracts.INVALID_INPUT; }
        result = (result << 8) | value;
        i = i + 1;
    }
    if (result < 128) { ret contracts.INVALID_INPUT; }
    @length = result;
    @width = 1 + count;
    ret contracts.OK;
}

pub fun next(value: *Cursor, output: *Element) contracts.Error {
    if (value == nil || output == nil || value.offset > value.input.len ||
        value.depth > MAX_DEPTH) { ret contracts.INVALID_INPUT; }
    if (value.offset == value.input.len || value.input.data == nil) {
        ret contracts.INVALID_INPUT;
    }
    val start: usize = value.offset;
    val remaining: usize = value.input.len - start;
    if (remaining < 2) { ret contracts.INVALID_INPUT; }
    val tag: Tag = value.input.data[start];
    if (!valid_tag(tag)) { ret contracts.INVALID_INPUT; }
    var content_len: usize = 0;
    var length_width: usize = 0;
    val length_status: contracts.Error = read_length(?value.input.data[start + 1],
        remaining - 1, ?content_len, ?length_width);
    if (length_status != contracts.OK) { ret length_status; }
    val header_len: usize = 1 + length_width;
    if (header_len > remaining || content_len > remaining - header_len) {
        ret contracts.INVALID_INPUT;
    }
    var content: *u8 = nil;
    if (content_len > 0) { content = ?value.input.data[start + header_len]; }
    if (!valid_public_content(tag, content, content_len)) {
        ret contracts.INVALID_INPUT;
    }
    output.tag = tag;
    output.content = contracts.Bytes{data: content, len: content_len};
    output.encoded = contracts.Bytes{data: ?value.input.data[start],
        len: header_len + content_len};
    value.offset = start + header_len + content_len;
    ret contracts.OK;
}

#[oblivious]
pub fun next_secret(value: *SecretCursor, output: *SecretElement) contracts.Error {
    if (value == nil || output == nil || value.offset > value.input.len ||
        value.depth > MAX_DEPTH) { ret contracts.INVALID_INPUT; }
    if (value.offset == value.input.len || value.input.data == nil) {
        ret contracts.INVALID_INPUT;
    }
    val start: usize = value.offset;
    val remaining: usize = value.input.len - start;
    if (remaining < 2) { ret contracts.INVALID_INPUT; }
    val tag: Tag = value.input.data[start]:>u8;
    if (!valid_tag(tag)) { ret contracts.INVALID_INPUT; }
    var content_len: usize = 0;
    var length_width: usize = 0;
    val length_status: contracts.Error = read_secret_length(
        ?value.input.data[start + 1], remaining - 1, ?content_len, ?length_width);
    if (length_status != contracts.OK) { ret length_status; }
    val header_len: usize = 1 + length_width;
    if (header_len > remaining || content_len > remaining - header_len) {
        ret contracts.INVALID_INPUT;
    }
    var content: *^u8 = nil;
    if (content_len > 0) { content = ?value.input.data[start + header_len]; }
    if (!valid_secret_content(tag, content, content_len)) {
        ret contracts.INVALID_INPUT;
    }
    output.tag = tag;
    output.content = contracts.SecretBytes{data: content, len: content_len};
    output.encoded = contracts.SecretBytes{data: ?value.input.data[start],
        len: header_len + content_len};
    value.offset = start + header_len + content_len;
    ret contracts.OK;
}

fun validate_public_tree(input: contracts.Bytes, depth: usize) bool {
    if (depth > MAX_DEPTH) { ret false; }
    var value: Cursor = cursor(input);
    value.depth = depth;
    for (!complete(?value)) {
        var element: Element;
        if (next(?value, ?element) != contracts.OK) { ret false; }
        if ((element.tag & 0x20) != 0) {
            if (depth >= MAX_DEPTH ||
                !validate_public_tree(element.content, depth + 1)) { ret false; }
        }
    }
    ret true;
}

#[oblivious]
fun validate_secret_tree(input: contracts.SecretBytes, depth: usize) bool {
    if (depth > MAX_DEPTH) { ret false; }
    var value: SecretCursor = secret_cursor(input);
    value.depth = depth;
    for (!secret_complete(?value)) {
        var element: SecretElement;
        if (next_secret(?value, ?element) != contracts.OK) { ret false; }
        if ((element.tag & 0x20) != 0) {
            if (depth >= MAX_DEPTH ||
                !validate_secret_tree(element.content, depth + 1)) { ret false; }
        }
    }
    ret true;
}

pub fun exact(input: contracts.Bytes, output: *Element) contracts.Error {
    if (output == nil) { ret contracts.INVALID_INPUT; }
    var value: Cursor = cursor(input);
    var parsed: Element;
    val status: contracts.Error = next(?value, ?parsed);
    if (status != contracts.OK) { ret status; }
    if (!complete(?value)) { ret contracts.INVALID_INPUT; }
    if ((parsed.tag & 0x20) != 0 &&
        !validate_public_tree(parsed.content, 1)) { ret contracts.INVALID_INPUT; }
    @output = parsed;
    ret contracts.OK;
}

#[oblivious]
pub fun exact_secret(input: contracts.SecretBytes,
    output: *SecretElement) contracts.Error {
    if (output == nil) { ret contracts.INVALID_INPUT; }
    var value: SecretCursor = secret_cursor(input);
    var parsed: SecretElement;
    val status: contracts.Error = next_secret(?value, ?parsed);
    if (status != contracts.OK) { ret status; }
    if (!secret_complete(?value)) { ret contracts.INVALID_INPUT; }
    if ((parsed.tag & 0x20) != 0 &&
        !validate_secret_tree(parsed.content, 1)) { ret contracts.INVALID_INPUT; }
    @output = parsed;
    ret contracts.OK;
}

pub fun enter(parent: *Cursor, element: *Element,
    child: *Cursor) contracts.Error {
    if (parent == nil || element == nil || child == nil ||
        parent.depth >= MAX_DEPTH) { ret contracts.INVALID_INPUT; }
    child.input = element.content;
    child.offset = 0;
    child.depth = parent.depth + 1;
    ret contracts.OK;
}

pub fun enter_secret(parent: *SecretCursor, element: *SecretElement,
    child: *SecretCursor) contracts.Error {
    if (parent == nil || element == nil || child == nil ||
        parent.depth >= MAX_DEPTH) { ret contracts.INVALID_INPUT; }
    child.input = element.content;
    child.offset = 0;
    child.depth = parent.depth + 1;
    ret contracts.OK;
}

pub fun positive_integer(element: *Element, output: *contracts.Bytes) contracts.Error {
    if (element == nil || output == nil || element.tag != INTEGER ||
        element.content.len == 0) { ret contracts.INVALID_INPUT; }
    var offset: usize = 0;
    if (element.content.data[0] == 0) {
        offset = 1;
        if (offset == element.content.len) { ret contracts.INVALID_INPUT; }
    } or {
        if ((element.content.data[0] & 0x80) != 0) { ret contracts.INVALID_INPUT; }
    }
    @output = contracts.Bytes{data: ?element.content.data[offset],
        len: element.content.len - offset};
    ret contracts.OK;
}

#[oblivious]
pub fun positive_secret_integer(element: *SecretElement,
    output: *contracts.SecretBytes) contracts.Error {
    if (element == nil || output == nil || element.tag != INTEGER ||
        element.content.len == 0) { ret contracts.INVALID_INPUT; }
    var offset: usize = 0;
    if (element.content.data[0]:>u8 == 0) {
        offset = 1;
        if (offset == element.content.len) { ret contracts.INVALID_INPUT; }
    } or {
        if ((element.content.data[0]:>u8 & 0x80) != 0) {
            ret contracts.INVALID_INPUT;
        }
    }
    @output = contracts.SecretBytes{data: ?element.content.data[offset],
        len: element.content.len - offset};
    ret contracts.OK;
}

fun length_width(content_len: usize) usize {
    if (content_len < 128) { ret 1; }
    var value: usize = content_len;
    var bytes: usize = 0;
    for (value > 0) { bytes = bytes + 1; value = value >> 8; }
    ret 1 + bytes;
}

pub fun encoded_len(content_len: usize) usize {
    val header: usize = 1 + length_width(content_len);
    if (content_len > (0 - 1) - header) { ret 0; }
    ret header + content_len;
}

fun write_length(output: *u8, content_len: usize) usize {
    if (content_len < 128) {
        output[0] = content_len::u8;
        ret 1;
    }
    var value: usize = content_len;
    var bytes: usize = 0;
    for (value > 0) { bytes = bytes + 1; value = value >> 8; }
    output[0] = (0x80 | bytes)::u8;
    var i: usize = 0;
    for (i < bytes) {
        output[1 + i] = (content_len >> ((bytes - 1 - i) << 3))::u8;
        i = i + 1;
    }
    ret 1 + bytes;
}

pub fun write(tag: Tag, content: contracts.Bytes,
    output: contracts.Buffer) contracts.Operation {
    if (!valid_tag(tag) || !valid_public_content(tag, content.data, content.len)) {
        ret contracts.Operation{error: contracts.INVALID_INPUT, written: 0};
    }
    if ((tag & 0x20) != 0 && !validate_public_tree(content, 1)) {
        ret contracts.Operation{error: contracts.INVALID_INPUT, written: 0};
    }
    val required: usize = encoded_len(content.len);
    if (required == 0) {
        ret contracts.Operation{error: contracts.INVALID_INPUT, written: 0};
    }
    if (output.capacity < required) {
        ret contracts.Operation{error: contracts.OUTPUT_TOO_SMALL, written: 0};
    }
    if (output.data == nil) {
        ret contracts.Operation{error: contracts.INVALID_INPUT, written: 0};
    }
    val header_len: usize = required - content.len;
    if (content.len > 0) {
        memory.move[u8](?output.data[header_len], content.data, content.len);
    }
    output.data[0] = tag;
    val actual: usize = write_length(?output.data[1], content.len);
    if (actual + 1 != header_len) {
        ret contracts.Operation{error: contracts.INVALID_STATE, written: 0};
    }
    ret contracts.Operation{error: contracts.OK, written: required};
}

test "der: sequence is constructed and universal" {
    if (SEQUENCE != 0x30 || MAX_DEPTH < 8) { ret 1; }
    ret 0;
}

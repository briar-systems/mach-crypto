# strict tls key containers with owned private material

use crypto.contracts;
use crypto.encoding.der;
use crypto.encoding.pem;
use p256_group: crypto.group.p256;
use crypto.internal.p256;
use crypto.internal.p384;
use crypto.secret;
use std.crypto.ct;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def Algorithm: u8;
pub val ED25519: Algorithm = 1;
pub val X25519:  Algorithm = 2;
pub val P256:    Algorithm = 3;
pub val RSA:     Algorithm = 4;
pub val P384:    Algorithm = 5;

pub def Container: u8;
pub val PKCS8:       Container = 1;
pub val SEC1:        Container = 2;
pub val RSA_PRIVATE: Container = 3;
pub val SPKI:        Container = 4;

val OID_ED25519: [3]u8 = [3]u8{0x2b, 0x65, 0x70};
val OID_X25519:  [3]u8 = [3]u8{0x2b, 0x65, 0x6e};
val OID_EC:      [7]u8 = [7]u8{0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01};
val OID_P256:    [8]u8 = [8]u8{0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07};
val OID_P384:    [5]u8 = [5]u8{0x2b, 0x81, 0x04, 0x00, 0x22};
val OID_RSA:     [9]u8 = [9]u8{0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01};

pub rec PublicKey {
    algorithm: Algorithm;
    container: Container;
    encoded:   contracts.Bytes;
    first:     contracts.Bytes;
    second:    contracts.Bytes;
}

# copying this record duplicates ownership and is invalid
pub rec PrivateKey {
    algorithm:       Algorithm;
    container:       Container;
    material:        secret.Secret;
    encoded_len:     usize;
    private_offset:  usize;
    private_len:     usize;
    modulus_offset:  usize;
    modulus_len:     usize;
    exponent_offset: usize;
    exponent_len:    usize;
}

rec Descriptor {
    algorithm:       Algorithm;
    container:       Container;
    encoded_len:     usize;
    private_offset:  usize;
    private_len:     usize;
    modulus_offset:  usize;
    modulus_len:     usize;
    exponent_offset: usize;
    exponent_len:    usize;
}

pub fun empty_private() PrivateKey {
    ret PrivateKey{algorithm: 0, container: 0, material: secret.empty(),
        encoded_len: 0, private_offset: 0, private_len: 0, modulus_offset: 0,
        modulus_len: 0, exponent_offset: 0, exponent_len: 0};
}

fun private_empty(key: *PrivateKey) bool {
    ret key != nil && key.algorithm == 0 && key.container == 0 &&
        key.encoded_len == 0 && key.private_offset == 0 && key.private_len == 0 &&
        key.modulus_offset == 0 && key.modulus_len == 0 &&
        key.exponent_offset == 0 && key.exponent_len == 0 &&
        key.material.data == nil && key.material.len == 0 &&
        key.material.owner == nil && key.material.state == secret.EMPTY;
}

pub fun destroy_private(key: *PrivateKey) contracts.Error {
    if (key == nil) { ret contracts.INVALID_INPUT; }
    val status: contracts.Error = secret.destroy(?key.material);
    key.algorithm       = 0;
    key.container       = 0;
    key.encoded_len     = 0;
    key.private_offset  = 0;
    key.private_len     = 0;
    key.modulus_offset  = 0;
    key.modulus_len     = 0;
    key.exponent_offset = 0;
    key.exponent_len    = 0;
    ret status;
}

fun public_equal(value: contracts.Bytes, expected: *u8, len: usize) bool {
    if (value.len != len || value.data == nil) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (value.data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[oblivious]
fun secret_equal(value: contracts.SecretBytes, expected: *u8, len: usize) bool {
    if (value.len != len || value.data == nil) { ret false; }
    var difference: ^u8   = 0;
    var i:          usize = 0;
    for (i < len) {
        difference = difference | (value.data[i] ^ expected[i]);
        i          = i + 1;
    }
    ret ct.eq_u8(difference, 0):>u8 == 1;
}

fun version_public(element: *der.Element, expected: u8) bool {
    ret element.tag == der.INTEGER && element.content.len == 1 &&
        element.content.data[0] == expected;
}

#[oblivious]
fun version_secret(element: *der.SecretElement, expected: u8) bool {
    ret element.tag == der.INTEGER && element.content.len == 1 &&
        element.content.data[0]:>u8 == expected;
}

fun valid_rsa_public_parts(modulus: contracts.Bytes,
    exponent: contracts.Bytes) bool {
    if (modulus.len < 256 || modulus.len > 512 || modulus.len % 4 != 0 ||
        modulus.data == nil || (modulus.data[0] & 0x80) == 0 ||
        (modulus.data[modulus.len - 1] & 1) == 0) { ret false; }
    if (exponent.len == 0 || exponent.len > modulus.len || exponent.data == nil ||
        exponent.data[0] == 0 || (exponent.data[exponent.len - 1] & 1) == 0) {
        ret false;
    }
    if (exponent.len == 1 && exponent.data[0] < 3) { ret false; }
    if (exponent.len == modulus.len) {
        var i: usize = 0;
        for (i < modulus.len) {
            if (exponent.data[i] < modulus.data[i]) { ret true; }
            if (exponent.data[i] > modulus.data[i]) { ret false; }
            i = i + 1;
        }
        ret false;
    }
    ret true;
}

#[oblivious]
fun valid_rsa_secret_parts(modulus: contracts.SecretBytes,
    exponent: contracts.SecretBytes) bool {
    if (modulus.len < 256 || modulus.len > 512 || modulus.len % 4 != 0 ||
        modulus.data == nil || (modulus.data[0]:>u8 & 0x80) == 0 ||
        (modulus.data[modulus.len - 1]:>u8 & 1) == 0) { ret false; }
    if (exponent.len == 0 || exponent.len > modulus.len || exponent.data == nil ||
        exponent.data[0]:>u8 == 0 || (exponent.data[exponent.len - 1]:>u8 & 1) == 0) {
        ret false;
    }
    if (exponent.len == 1 && exponent.data[0]:>u8 < 3) { ret false; }
    if (exponent.len == modulus.len) {
        var i: usize = 0;
        for (i < modulus.len) {
            if (exponent.data[i]:>u8 < modulus.data[i]:>u8) { ret true; }
            if (exponent.data[i]:>u8 > modulus.data[i]:>u8) { ret false; }
            i = i + 1;
        }
        ret false;
    }
    ret true;
}

#[oblivious]
fun valid_p256_public(value: contracts.Bytes) bool {
    if (value.len != 65 || value.data == nil || value.data[0] != 4) { ret false; }
    var point: p256.Point;
    val valid: ^u8 = p256.parse_point(?point, value.data);
    p256.destroy_point(?point);
    ret valid:>u8 == 1;
}

#[oblivious]
fun valid_p384_public(value: contracts.Bytes) bool {
    ret p384.valid_public_point(value);
}

fun parse_public_algorithm(element: *der.Element,
    algorithm: *Algorithm) contracts.Error {
    if (element.tag != der.SEQUENCE) { ret contracts.INVALID_INPUT; }
    var parent: der.Cursor = der.cursor(element.encoded);
    var body:   der.Cursor;
    if (der.enter(?parent, element, ?body) != contracts.OK) {
        ret contracts.INVALID_INPUT;
    }
    var oid: der.Element;
    if (der.next(?body, ?oid) != contracts.OK || oid.tag != der.OBJECT_ID) {
        ret contracts.INVALID_INPUT;
    }
    if (public_equal(oid.content, (?OID_ED25519[0]):~*u8, 3)) {
        if (!der.complete(?body)) { ret contracts.INVALID_INPUT; }
        @algorithm = ED25519;
        ret contracts.OK;
    }
    if (public_equal(oid.content, (?OID_X25519[0]):~*u8, 3)) {
        if (!der.complete(?body)) { ret contracts.INVALID_INPUT; }
        @algorithm = X25519;
        ret contracts.OK;
    }
    if (public_equal(oid.content, (?OID_EC[0]):~*u8, 7)) {
        var curve: der.Element;
        if (der.next(?body, ?curve) != contracts.OK || curve.tag != der.OBJECT_ID ||
            !der.complete(?body)) { ret contracts.INVALID_INPUT; }
        if (public_equal(curve.content, (?OID_P256[0]):~*u8, 8)) {
            @algorithm = P256;
            ret contracts.OK;
        }
        if (public_equal(curve.content, (?OID_P384[0]):~*u8, 5)) {
            @algorithm = P384;
            ret contracts.OK;
        }
        ret contracts.UNSUPPORTED;
    }
    if (public_equal(oid.content, (?OID_RSA[0]):~*u8, 9)) {
        var parameter: der.Element;
        if (der.next(?body, ?parameter) != contracts.OK || parameter.tag != der.NULL ||
            parameter.content.len != 0 || !der.complete(?body)) {
            ret contracts.INVALID_INPUT;
        }
        @algorithm = RSA;
        ret contracts.OK;
    }
    ret contracts.UNSUPPORTED;
}

#[oblivious]
fun parse_secret_algorithm(element: *der.SecretElement,
    algorithm: *Algorithm) contracts.Error {
    if (element.tag != der.SEQUENCE) { ret contracts.INVALID_INPUT; }
    var parent: der.SecretCursor = der.secret_cursor(element.encoded);
    var body:   der.SecretCursor;
    if (der.enter_secret(?parent, element, ?body) != contracts.OK) {
        ret contracts.INVALID_INPUT;
    }
    var oid: der.SecretElement;
    if (der.next_secret(?body, ?oid) != contracts.OK || oid.tag != der.OBJECT_ID) {
        ret contracts.INVALID_INPUT;
    }
    if (secret_equal(oid.content, (?OID_ED25519[0]):~*u8, 3)) {
        if (!der.secret_complete(?body)) { ret contracts.INVALID_INPUT; }
        @algorithm = ED25519;
        ret contracts.OK;
    }
    if (secret_equal(oid.content, (?OID_X25519[0]):~*u8, 3)) {
        if (!der.secret_complete(?body)) { ret contracts.INVALID_INPUT; }
        @algorithm = X25519;
        ret contracts.OK;
    }
    if (secret_equal(oid.content, (?OID_EC[0]):~*u8, 7)) {
        var curve: der.SecretElement;
        if (der.next_secret(?body, ?curve) != contracts.OK ||
            curve.tag != der.OBJECT_ID ||
            !secret_equal(curve.content, (?OID_P256[0]):~*u8, 8) ||
            !der.secret_complete(?body)) { ret contracts.INVALID_INPUT; }
        @algorithm = P256;
        ret contracts.OK;
    }
    if (secret_equal(oid.content, (?OID_RSA[0]):~*u8, 9)) {
        var parameter: der.SecretElement;
        if (der.next_secret(?body, ?parameter) != contracts.OK ||
            parameter.tag != der.NULL || parameter.content.len != 0 ||
            !der.secret_complete(?body)) { ret contracts.INVALID_INPUT; }
        @algorithm = RSA;
        ret contracts.OK;
    }
    ret contracts.UNSUPPORTED;
}

pub fun decode_spki(input: contracts.Bytes, output: *PublicKey) contracts.Error {
    if (output == nil) { ret contracts.INVALID_INPUT; }
    var root: der.Element;
    if (der.exact(input, ?root) != contracts.OK || root.tag != der.SEQUENCE) {
        ret contracts.INVALID_INPUT;
    }
    var parent: der.Cursor = der.cursor(input);
    var body:   der.Cursor;
    if (der.enter(?parent, ?root, ?body) != contracts.OK) {
        ret contracts.INVALID_INPUT;
    }
    var algorithm_element: der.Element;
    var key_element:       der.Element;
    if (der.next(?body, ?algorithm_element) != contracts.OK ||
        der.next(?body, ?key_element) != contracts.OK || !der.complete(?body) ||
        key_element.tag != der.BIT_STRING || key_element.content.len < 2 ||
        key_element.content.data[0] != 0) { ret contracts.INVALID_INPUT; }
    var algorithm:        Algorithm       = 0;
    val algorithm_status: contracts.Error = parse_public_algorithm(
        ?algorithm_element, ?algorithm);
    if (algorithm_status != contracts.OK) { ret algorithm_status; }
    val raw: contracts.Bytes = contracts.Bytes{data: ?key_element.content.data[1],
        len: key_element.content.len - 1};
    var first:  contracts.Bytes = raw;
    var second: contracts.Bytes = contracts.Bytes{data: nil, len: 0};
    if ((algorithm == ED25519 || algorithm == X25519) && raw.len != 32) {
        ret contracts.INVALID_KEY;
    }
    if (algorithm == P256 && !valid_p256_public(raw)) { ret contracts.INVALID_KEY; }
    if (algorithm == P384 && !valid_p384_public(raw)) { ret contracts.INVALID_KEY; }
    if (algorithm == RSA) {
        var rsa_root: der.Element;
        if (der.exact(raw, ?rsa_root) != contracts.OK || rsa_root.tag != der.SEQUENCE) {
            ret contracts.INVALID_KEY;
        }
        var rsa_parent: der.Cursor = der.cursor(raw);
        var rsa_body:   der.Cursor;
        der.enter(?rsa_parent, ?rsa_root, ?rsa_body);
        var modulus_element:  der.Element;
        var exponent_element: der.Element;
        if (der.next(?rsa_body, ?modulus_element) != contracts.OK ||
            der.next(?rsa_body, ?exponent_element) != contracts.OK ||
            !der.complete(?rsa_body) ||
            der.positive_integer(?modulus_element, ?first) != contracts.OK ||
            der.positive_integer(?exponent_element, ?second) != contracts.OK ||
            !valid_rsa_public_parts(first, second)) { ret contracts.INVALID_KEY; }
    }
    output.algorithm = algorithm;
    output.container = SPKI;
    output.encoded   = input;
    output.first     = first;
    output.second    = second;
    ret contracts.OK;
}

#[oblivious]
fun parse_sec1(input: contracts.SecretBytes, base: usize, descriptor: *Descriptor,
    outer_curve: bool) contracts.Error {
    var root: der.SecretElement;
    if (der.exact_secret(input, ?root) != contracts.OK || root.tag != der.SEQUENCE) {
        ret contracts.INVALID_KEY;
    }
    val root_header: usize            = root.encoded.len - root.content.len;
    var parent:      der.SecretCursor = der.secret_cursor(input);
    var body:        der.SecretCursor;
    der.enter_secret(?parent, ?root, ?body);
    var version:         der.SecretElement;
    var private_element: der.SecretElement;
    if (der.next_secret(?body, ?version) != contracts.OK || !version_secret(?version, 1)) {
        ret contracts.INVALID_KEY;
    }
    val private_start: usize = body.offset;
    if (der.next_secret(?body, ?private_element) != contracts.OK ||
        private_element.tag != der.OCTET_STRING || private_element.content.len != 32) {
        ret contracts.INVALID_KEY;
    }
    val private_header:  usize = private_element.encoded.len - private_element.content.len;
    var curve_seen:      bool  = outer_curve;
    var parameter_seen:  bool  = false;
    var public_seen:     bool  = false;
    var embedded_public: *^u8  = nil;
    for (!der.secret_complete(?body)) {
        var optional: der.SecretElement;
        if (der.next_secret(?body, ?optional) != contracts.OK) { ret contracts.INVALID_KEY; }
        if (optional.tag == 0xa0 && !parameter_seen && !public_seen) {
            var curve: der.SecretElement;
            if (der.exact_secret(optional.content, ?curve) != contracts.OK ||
                curve.tag != der.OBJECT_ID ||
                !secret_equal(curve.content, (?OID_P256[0]):~*u8, 8)) {
                ret contracts.INVALID_KEY;
            }
            curve_seen     = true;
            parameter_seen = true;
        }
        or (optional.tag == 0xa1 && !public_seen) {
            var public_element: der.SecretElement;
            if (der.exact_secret(optional.content, ?public_element) != contracts.OK ||
                public_element.tag != der.BIT_STRING || public_element.content.len != 66 ||
                public_element.content.data[0]:>u8 != 0 ||
                public_element.content.data[1]:>u8 != 4) { ret contracts.INVALID_KEY; }
            public_seen     = true;
            embedded_public = ?public_element.content.data[1];
        }
        or { ret contracts.INVALID_KEY; }
    }
    if (!curve_seen) { ret contracts.INVALID_KEY; }
    var derived_public: [65]u8;
    val derived:        contracts.Operation = p256_group.derive_public(
        private_element.content,
        contracts.Buffer{data: ?derived_public[0], capacity: 65});
    if (derived.error != contracts.OK || derived.written != 65) {
        ret contracts.INVALID_KEY;
    }
    if (public_seen) {
        var difference: ^u8   = 0;
        var i:          usize = 0;
        for (i < 65) {
            difference = difference | (embedded_public[i] ^ derived_public[i]);
            i          = i + 1;
        }
        if (difference:>u8 != 0) { ret contracts.INVALID_KEY; }
    }
    descriptor.algorithm      = P256;
    descriptor.container      = SEC1;
    descriptor.encoded_len    = input.len;
    descriptor.private_offset = base + root_header + private_start + private_header;
    descriptor.private_len    = 32;
    ret contracts.OK;
}

#[oblivious]
fun parse_rsa_private(input: contracts.SecretBytes, base: usize,
    descriptor: *Descriptor) contracts.Error {
    var root: der.SecretElement;
    if (der.exact_secret(input, ?root) != contracts.OK || root.tag != der.SEQUENCE) {
        ret contracts.INVALID_KEY;
    }
    val root_header: usize            = root.encoded.len - root.content.len;
    var parent:      der.SecretCursor = der.secret_cursor(input);
    var body:        der.SecretCursor;
    der.enter_secret(?parent, ?root, ?body);
    var version: der.SecretElement;
    if (der.next_secret(?body, ?version) != contracts.OK || !version_secret(?version, 0)) {
        ret contracts.INVALID_KEY;
    }
    var values: [8]der.SecretElement;
    var starts: [8]usize;
    var i:      usize = 0;
    for (i < 8) {
        starts[i] = body.offset;
        if (der.next_secret(?body, ?values[i]) != contracts.OK) {
            ret contracts.INVALID_KEY;
        }
        i = i + 1;
    }
    if (!der.secret_complete(?body)) { ret contracts.INVALID_KEY; }
    var parts: [8]contracts.SecretBytes;
    i = 0;
    for (i < 8) {
        if (der.positive_secret_integer(?values[i], ?parts[i]) != contracts.OK) {
            ret contracts.INVALID_KEY;
        }
        i = i + 1;
    }
    if (!valid_rsa_secret_parts(parts[0], parts[1]) || parts[2].len == 0 ||
        parts[2].len > parts[0].len) { ret contracts.INVALID_KEY; }
    descriptor.algorithm   = RSA;
    descriptor.container   = RSA_PRIVATE;
    descriptor.encoded_len = input.len;
    val modulus_header:  usize = values[0].encoded.len - values[0].content.len;
    val exponent_header: usize = values[1].encoded.len - values[1].content.len;
    val private_header:  usize = values[2].encoded.len - values[2].content.len;
    descriptor.modulus_offset = base + root_header + starts[0] + modulus_header +
        (values[0].content.len - parts[0].len);
    descriptor.modulus_len     = parts[0].len;
    descriptor.exponent_offset = base + root_header + starts[1] + exponent_header +
        (values[1].content.len - parts[1].len);
    descriptor.exponent_len   = parts[1].len;
    descriptor.private_offset = base + root_header + starts[2] + private_header +
        (values[2].content.len - parts[2].len);
    descriptor.private_len = parts[2].len;
    ret contracts.OK;
}

#[oblivious]
fun parse_pkcs8(input: contracts.SecretBytes,
    descriptor: *Descriptor) contracts.Error {
    var root: der.SecretElement;
    if (der.exact_secret(input, ?root) != contracts.OK || root.tag != der.SEQUENCE) {
        ret contracts.INVALID_KEY;
    }
    val root_header: usize            = root.encoded.len - root.content.len;
    var parent:      der.SecretCursor = der.secret_cursor(input);
    var body:        der.SecretCursor;
    der.enter_secret(?parent, ?root, ?body);
    var version:           der.SecretElement;
    var algorithm_element: der.SecretElement;
    if (der.next_secret(?body, ?version) != contracts.OK || !version_secret(?version, 0) ||
        der.next_secret(?body, ?algorithm_element) != contracts.OK) {
        ret contracts.INVALID_KEY;
    }
    var algorithm:        Algorithm       = 0;
    val algorithm_status: contracts.Error = parse_secret_algorithm(
        ?algorithm_element, ?algorithm);
    if (algorithm_status != contracts.OK) { ret algorithm_status; }
    val private_start:   usize = body.offset;
    var private_element: der.SecretElement;
    if (der.next_secret(?body, ?private_element) != contracts.OK ||
        private_element.tag != der.OCTET_STRING || !der.secret_complete(?body)) {
        ret contracts.INVALID_KEY;
    }
    val private_header: usize = private_element.encoded.len - private_element.content.len;
    val private_base:   usize = root_header + private_start + private_header;
    if (algorithm == ED25519 || algorithm == X25519) {
        var inner: der.SecretElement;
        if (der.exact_secret(private_element.content, ?inner) != contracts.OK ||
            inner.tag != der.OCTET_STRING || inner.content.len != 32) {
            ret contracts.INVALID_KEY;
        }
        descriptor.algorithm      = algorithm;
        descriptor.container      = PKCS8;
        descriptor.encoded_len    = input.len;
        descriptor.private_offset = private_base +
            (inner.encoded.len - inner.content.len);
        descriptor.private_len = 32;
        ret contracts.OK;
    }
    if (algorithm == P256) {
        val status: contracts.Error = parse_sec1(private_element.content,
            private_base, descriptor, true);
        if (status == contracts.OK) {
            descriptor.container   = PKCS8;
            descriptor.encoded_len = input.len;
        }
        ret status;
    }
    if (algorithm == RSA) {
        val status: contracts.Error = parse_rsa_private(private_element.content,
            private_base, descriptor);
        if (status == contracts.OK) {
            descriptor.container   = PKCS8;
            descriptor.encoded_len = input.len;
        }
        ret status;
    }
    ret contracts.UNSUPPORTED;
}

#[oblivious]
fun install(input: contracts.SecretBytes, owner: *secret.Allocator,
    descriptor: *Descriptor, output: *PrivateKey) contracts.Error {
    if (output == nil || owner == nil || descriptor == nil) {
        ret contracts.INVALID_INPUT;
    }
    if (!private_empty(output))              { ret contracts.INVALID_STATE; }
    if (descriptor.encoded_len != input.len) { ret contracts.INVALID_STATE; }
    var material:    secret.Secret   = secret.empty();
    val initialized: contracts.Error = secret.init(?material, owner, input.len);
    if (initialized != contracts.OK) {
        if (secret.cleanup_pending(?material)) {
            secret.move(?output.material, ?material);
        }
        ret initialized;
    }
    var i: usize = 0;
    for (i < input.len) {
        material.data[i] = input.data[i];
        i                = i + 1;
    }
    val moved: contracts.Error = secret.move(?output.material, ?material);
    if (moved != contracts.OK) {
        secret.destroy(?material);
        ret moved;
    }
    output.algorithm       = descriptor.algorithm;
    output.container       = descriptor.container;
    output.encoded_len     = descriptor.encoded_len;
    output.private_offset  = descriptor.private_offset;
    output.private_len     = descriptor.private_len;
    output.modulus_offset  = descriptor.modulus_offset;
    output.modulus_len     = descriptor.modulus_len;
    output.exponent_offset = descriptor.exponent_offset;
    output.exponent_len    = descriptor.exponent_len;
    ret contracts.OK;
}

#[oblivious]
fun decode_private_with(input: contracts.SecretBytes, owner: *secret.Allocator,
    output: *PrivateKey, container: Container) contracts.Error {
    if (input.len == 0 || input.data == nil || output == nil || owner == nil) {
        ret contracts.INVALID_INPUT;
    }
    if (!private_empty(output)) { ret contracts.INVALID_STATE; }
    var descriptor: Descriptor;
    descriptor.algorithm       = 0;
    descriptor.container       = 0;
    descriptor.encoded_len     = 0;
    descriptor.private_offset  = 0;
    descriptor.private_len     = 0;
    descriptor.modulus_offset  = 0;
    descriptor.modulus_len     = 0;
    descriptor.exponent_offset = 0;
    descriptor.exponent_len    = 0;
    var status: contracts.Error = contracts.INVALID_INPUT;
    if (container == PKCS8)       { status = parse_pkcs8(input, ?descriptor); }
    or (container == SEC1)        { status = parse_sec1(input, 0, ?descriptor, false); }
    or (container == RSA_PRIVATE) { status = parse_rsa_private(input, 0, ?descriptor); }
    if (status != contracts.OK)   { ret status; }
    ret install(input, owner, ?descriptor, output);
}

pub fun decode_pkcs8(input: contracts.SecretBytes, owner: *secret.Allocator,
    output: *PrivateKey) contracts.Error {
    ret decode_private_with(input, owner, output, PKCS8);
}

pub fun decode_sec1(input: contracts.SecretBytes, owner: *secret.Allocator,
    output: *PrivateKey) contracts.Error {
    ret decode_private_with(input, owner, output, SEC1);
}

pub fun decode_rsa_private(input: contracts.SecretBytes, owner: *secret.Allocator,
    output: *PrivateKey) contracts.Error {
    ret decode_private_with(input, owner, output, RSA_PRIVATE);
}

pub fun private_bytes(key: *PrivateKey,
    output: *contracts.SecretBytes) contracts.Error {
    if (key == nil || output == nil || key.algorithm == RSA ||
        key.private_offset > key.encoded_len ||
        key.private_len > key.encoded_len - key.private_offset) {
        ret contracts.INVALID_INPUT;
    }
    ret secret.bytes(?key.material, key.private_offset, key.private_len, output);
}

fun public_regions_overlap(first: *u8, first_len: usize, second: *u8,
    second_len: usize) bool {
    if (first_len == 0 || second_len == 0) { ret false; }
    val first_start:  usize = first::usize;
    val second_start: usize = second::usize;
    val first_end:    usize = first_start + first_len;
    val second_end:   usize = second_start + second_len;
    if (first_end < first_start || second_end < second_start) { ret true; }
    ret first_start < second_end && second_start < first_end;
}

#[oblivious]
pub fun copy_rsa(key: *PrivateKey, modulus: contracts.Buffer,
    exponent: contracts.Buffer, private_exponent: contracts.SecretBuffer) contracts.Error {
    if (key == nil || key.algorithm != RSA || !secret.active(?key.material)) {
        ret contracts.INVALID_STATE;
    }
    if (modulus.capacity < key.modulus_len || exponent.capacity < key.exponent_len ||
        private_exponent.capacity < key.modulus_len) { ret contracts.OUTPUT_TOO_SMALL; }
    if (modulus.data == nil || exponent.data == nil || private_exponent.data == nil) {
        ret contracts.INVALID_INPUT;
    }
    if (key.encoded_len > key.material.len ||
        key.modulus_len < 256 || key.modulus_len > 512 ||
        key.private_len == 0 || key.private_len > key.modulus_len ||
        key.modulus_offset > key.encoded_len ||
        key.modulus_len > key.encoded_len - key.modulus_offset ||
        key.exponent_offset > key.encoded_len ||
        key.exponent_len > key.encoded_len - key.exponent_offset ||
        key.private_offset > key.encoded_len ||
        key.private_len > key.encoded_len - key.private_offset) {
        ret contracts.INVALID_STATE;
    }
    if (public_regions_overlap(modulus.data, key.modulus_len,
        exponent.data, key.exponent_len)) { ret contracts.INVALID_INPUT; }
    var saved_private: [512]^u8;
    var i:             usize = 0;
    for (i < key.private_len) {
        saved_private[i] = key.material.data[key.private_offset + i];
        i                = i + 1;
    }
    i = 0;
    for (i < key.modulus_len) {
        modulus.data[i] = key.material.data[key.modulus_offset + i]:>u8;
        i               = i + 1;
    }
    i = 0;
    for (i < key.exponent_len) {
        exponent.data[i] = key.material.data[key.exponent_offset + i]:>u8;
        i                = i + 1;
    }
    val padding: usize = key.modulus_len - key.private_len;
    i = 0;
    for (i < padding) {
        private_exponent.data[i] = 0;
        i                        = i + 1;
    }
    i = 0;
    for (i < key.private_len) {
        private_exponent.data[padding + i] = saved_private[i];
        i                                  = i + 1;
    }
    ct.zeroize((?saved_private[0]):~*^u8, 512);
    ret contracts.OK;
}

pub fun encode_public_der(key: *PublicKey,
    output: contracts.Buffer) contracts.Operation {
    if (key == nil || key.container != SPKI || key.encoded.len == 0 ||
        key.encoded.data == nil) {
        ret contracts.Operation{error: contracts.INVALID_STATE, written: 0};
    }
    if (output.capacity < key.encoded.len) {
        ret contracts.Operation{error: contracts.OUTPUT_TOO_SMALL, written: 0};
    }
    if (output.data == nil) {
        ret contracts.Operation{error: contracts.INVALID_INPUT, written: 0};
    }
    memory.move[u8](output.data, key.encoded.data, key.encoded.len);
    ret contracts.Operation{error: contracts.OK, written: key.encoded.len};
}

#[oblivious]
pub fun encode_private_der(key: *PrivateKey,
    output: contracts.SecretBuffer) contracts.Operation {
    if (key == nil || !secret.active(?key.material) || key.encoded_len == 0 ||
        key.encoded_len > key.material.len) {
        ret contracts.Operation{error: contracts.INVALID_STATE, written: 0};
    }
    if (output.capacity < key.encoded_len) {
        ret contracts.Operation{error: contracts.OUTPUT_TOO_SMALL, written: 0};
    }
    if (output.data == nil) {
        ret contracts.Operation{error: contracts.INVALID_INPUT, written: 0};
    }
    var i: usize = 0;
    for (i < key.encoded_len) {
        output.data[i] = key.material.data[i];
        i              = i + 1;
    }
    ret contracts.Operation{error: contracts.OK, written: key.encoded_len};
}

fun label_equals(label: *u8, label_len: usize, expected: *u8,
    expected_len: usize) bool {
    if (label_len != expected_len) { ret false; }
    var i: usize = 0;
    for (i < expected_len) {
        if (label[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[oblivious]
pub fun decode_private_pem(input: contracts.SecretBytes, owner: *secret.Allocator,
    output: *PrivateKey) contracts.Error {
    if (input.len == 0 || input.data == nil || owner == nil || output == nil) {
        ret contracts.INVALID_INPUT;
    }
    if (!private_empty(output)) { ret contracts.INVALID_STATE; }
    val required: contracts.Operation = pem.decoded_secret_len(input);
    if (required.error != contracts.OK) { ret required.error; }
    var decoded: secret.Secret   = secret.empty();
    var status:  contracts.Error = secret.init(?decoded, owner, required.written);
    if (status != contracts.OK) {
        if (secret.cleanup_pending(?decoded)) {
            secret.move(?output.material, ?decoded);
        }
        ret status;
    }
    var decoded_buffer: contracts.SecretBuffer;
    secret.buffer(?decoded, 0, decoded.len, ?decoded_buffer);
    var block: pem.SecretBlock;
    status = pem.decode_secret(input, decoded_buffer, ?block);
    var descriptor: Descriptor;
    descriptor.algorithm       = 0;
    descriptor.container       = 0;
    descriptor.encoded_len     = 0;
    descriptor.private_offset  = 0;
    descriptor.private_len     = 0;
    descriptor.modulus_offset  = 0;
    descriptor.modulus_len     = 0;
    descriptor.exponent_offset = 0;
    descriptor.exponent_len    = 0;
    if (status == contracts.OK) {
        if (label_equals(?block.label[0], block.label_len,
            "PRIVATE KEY"::*u8, 11)) {
            status = parse_pkcs8(block.der, ?descriptor);
        }
        or (label_equals(?block.label[0], block.label_len,
            "EC PRIVATE KEY"::*u8, 14)) {
            status = parse_sec1(block.der, 0, ?descriptor, false);
        }
        or (label_equals(?block.label[0], block.label_len,
            "RSA PRIVATE KEY"::*u8, 15)) {
            status = parse_rsa_private(block.der, 0, ?descriptor);
        }
        or { status = contracts.UNSUPPORTED; }
    }
    if (status == contracts.OK) {
        val moved: contracts.Error = secret.move(?output.material, ?decoded);
        if (moved != contracts.OK) {
            secret.destroy(?decoded);
            ret moved;
        }
        output.algorithm       = descriptor.algorithm;
        output.container       = descriptor.container;
        output.encoded_len     = descriptor.encoded_len;
        output.private_offset  = descriptor.private_offset;
        output.private_len     = descriptor.private_len;
        output.modulus_offset  = descriptor.modulus_offset;
        output.modulus_len     = descriptor.modulus_len;
        output.exponent_offset = descriptor.exponent_offset;
        output.exponent_len    = descriptor.exponent_len;
        ret contracts.OK;
    }
    secret.destroy(?decoded);
    if (secret.cleanup_pending(?decoded)) {
        secret.move(?output.material, ?decoded);
    }
    ret status;
}

pub fun decode_public_pem(input: contracts.Bytes, der_output: contracts.Buffer,
    output: *PublicKey) contracts.Error {
    if (output == nil) { ret contracts.INVALID_INPUT; }
    var block:  pem.Block;
    val status: contracts.Error = pem.decode(input, der_output, ?block);
    if (status != contracts.OK) { ret status; }
    if (!label_equals(block.label.data, block.label.len, "PUBLIC KEY"::*u8, 10)) {
        ret contracts.UNSUPPORTED;
    }
    ret decode_spki(block.der, output);
}

pub fun encode_public_pem(key: *PublicKey,
    output: contracts.Buffer) contracts.Operation {
    if (key == nil || key.container != SPKI) {
        ret contracts.Operation{error: contracts.INVALID_STATE, written: 0};
    }
    val label: contracts.Bytes = contracts.Bytes{data: "PUBLIC KEY"::*u8, len: 10};
    var block: pem.Block       = pem.Block{label: label, der: key.encoded};
    ret pem.encode(?block, output);
}

#[oblivious]
pub fun encode_private_pem(key: *PrivateKey,
    output: contracts.SecretBuffer) contracts.Operation {
    if (key == nil || !secret.active(?key.material)) {
        ret contracts.Operation{error: contracts.INVALID_STATE, written: 0};
    }
    var label: contracts.Bytes;
    if (key.container == PKCS8) {
        label = contracts.Bytes{data: "PRIVATE KEY"::*u8, len: 11};
    }
    or (key.container == SEC1) {
        label = contracts.Bytes{data: "EC PRIVATE KEY"::*u8, len: 14};
    }
    or (key.container == RSA_PRIVATE) {
        label = contracts.Bytes{data: "RSA PRIVATE KEY"::*u8, len: 15};
    }
    or {
        ret contracts.Operation{error: contracts.INVALID_STATE, written: 0};
    }
    if (key.encoded_len == 0 || key.encoded_len > key.material.len) {
        ret contracts.Operation{error: contracts.INVALID_STATE, written: 0};
    }
    val material: contracts.SecretBytes = contracts.SecretBytes{
        data: key.material.data, len: key.encoded_len
    };
    ret pem.encode_secret(label, material, output);
}

test "rsa-pkcs1: nist cavp sha-256 and sha-384 verification" {
    var modulus256: [256]u8;
    var message256: [128]u8;
    var encoded256: [256]u8;
    if (!decode_hex(
        ""::*u8,
        512, ?modulus256[0]) || !decode_hex(
        "95123c8d1b236540b86976a11cea31f8bd4e6c54c235147d20ce722b03a6ad756fbd918c27df8ea9ce3104444c0bbe877305bc02e35535a02a58dcda306e632ad30b3dc3ce0ba97fdf46ec192965dd9cd7f4a71b02b8cba3d442646eeec4af590824ca98d74fbca934d0b6867aa1991f3040b707e806de6e66b5934f05509bea"::*u8,
        256, ?message256[0]) || !decode_hex(
        ""::*u8,
        512, ?encoded256[0])) { ret 1; }
    val exponent256: [3]u8 = [3]u8{0x49, 0xd2, 0xa1};
    val key256: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus: contracts.Bytes{data: ?modulus256[0], len: 256},
        exponent: contracts.Bytes{data: (?exponent256[0]):~*u8, len: 3}
    };
    if (signature.verify_rsa_pkcs1_sha256(key256,
        contracts.Bytes{data: ?message256[0], len: 128},
        contracts.Bytes{data: ?encoded256[0], len: 256}) != contracts.OK) { ret 2; }

    var modulus384: [256]u8;
    var message384: [128]u8;
    var encoded384: [256]u8;
    if (!decode_hex(
        ""::*u8,
        512, ?modulus384[0]) || !decode_hex(
        "d6a169031049b0b3b582d22bf40b9fca45d2618457146c2b4ac6f6ed1f34291f6de8773955cd2e21b7944caca65794621a7ce181e5ddbb45e9252867877dc4e35b6914ff26ec18890bf31f60fff1df367bc6c59373e58a1d8cb607188a394a2907ede95f6bf096731867f44fe520aacece76b5c3ea75023c9d3f3c080eaee376"::*u8,
        256, ?message384[0]) || !decode_hex(
        ""::*u8,
        512, ?encoded384[0])) { ret 3; }
    val exponent384: [3]u8 = [3]u8{0x2a, 0x26, 0xdb};
    val key384: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus: contracts.Bytes{data: ?modulus384[0], len: 256},
        exponent: contracts.Bytes{data: (?exponent384[0]):~*u8, len: 3}
    };
    if (signature.verify_rsa_pkcs1_sha384(key384,
        contracts.Bytes{data: ?message384[0], len: 128},
        contracts.Bytes{data: ?encoded384[0], len: 256}) != contracts.OK) { ret 4; }
    ret 0;
}

test "rsa-pkcs1: openssl sha-256 and sha-384 vectors preserve inputs" {
    var modulus: [256]u8;
    var message: [33]u8;
    var encoded256: [256]u8;
    var encoded384: [256]u8;
    if (!decode_hex(
        ""::*u8,
        512, ?modulus[0]) || !decode_hex(
        "6d6163682072736120706b63733120636572746966696361746520766563746f72"::*u8,
        66, ?message[0]) || !decode_hex(
        ""::*u8,
        512, ?encoded256[0]) || !decode_hex(
        ""::*u8,
        512, ?encoded384[0])) { ret 1; }
    val exponent: [3]u8 = [3]u8{1, 0, 1};
    val public_key: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus: contracts.Bytes{data: ?modulus[0], len: 256},
        exponent: contracts.Bytes{data: (?exponent[0]):~*u8, len: 3}
    };
    var modulus_snapshot: [256]u8;
    var exponent_snapshot: [3]u8;
    var message_snapshot: [33]u8;
    var encoded256_snapshot: [256]u8;
    var encoded384_snapshot: [256]u8;
    copy_public(?modulus_snapshot[0], ?modulus[0], 256);
    copy_public(?exponent_snapshot[0], (?exponent[0]):~*u8, 3);
    copy_public(?message_snapshot[0], ?message[0], 33);
    copy_public(?encoded256_snapshot[0], ?encoded256[0], 256);
    copy_public(?encoded384_snapshot[0], ?encoded384[0], 256);
    if (signature.verify_rsa_pkcs1_sha256(public_key,
        contracts.Bytes{data: ?message[0], len: 33},
        contracts.Bytes{data: ?encoded256[0], len: 256}) != contracts.OK) { ret 2; }
    if (signature.verify_rsa_pkcs1_sha384(public_key,
        contracts.Bytes{data: ?message[0], len: 33},
        contracts.Bytes{data: ?encoded384[0], len: 256}) != contracts.OK) { ret 3; }
    if (!public_equal(?modulus[0], ?modulus_snapshot[0], 256) ||
        !public_equal((?exponent[0]):~*u8, ?exponent_snapshot[0], 3) ||
        !public_equal(?message[0], ?message_snapshot[0], 33) ||
        !public_equal(?encoded256[0], ?encoded256_snapshot[0], 256) ||
        !public_equal(?encoded384[0], ?encoded384_snapshot[0], 256)) { ret 4; }
    ret 0;
}

test "rsa-pkcs1: hostile padding and digestinfo encodings are rejected" {
    var modulus: [256]u8;
    var message: [33]u8;
    if (!decode_hex(
        ""::*u8,
        512, ?modulus[0]) || !decode_hex(
        "6d6163682072736120706b63733120636572746966696361746520766563746f72"::*u8,
        66, ?message[0])) { ret 1; }
    val exponent: [3]u8 = [3]u8{1, 0, 1};
    val public_key: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus: contracts.Bytes{data: ?modulus[0], len: 256},
        exponent: contracts.Bytes{data: (?exponent[0]):~*u8, len: 3}
    };
    val input: contracts.Bytes = contracts.Bytes{data: ?message[0], len: 33};
    if (!pkcs1_hostile_rejected(public_key, input,
        ""::*u8)) { ret 2; }
    if (!pkcs1_hostile_rejected(public_key, input,
        ""::*u8)) { ret 3; }
    if (!pkcs1_hostile_rejected(public_key, input,
        ""::*u8)) { ret 4; }
    if (!pkcs1_hostile_rejected(public_key, input,
        ""::*u8)) { ret 5; }
    if (!pkcs1_hostile_rejected(public_key, input,
        ""::*u8)) { ret 6; }
    if (!pkcs1_hostile_rejected(public_key, input,
        ""::*u8)) { ret 7; }
    if (!pkcs1_hostile_rejected(public_key, input,
        ""::*u8)) { ret 8; }
    if (!pkcs1_sha384_hostile_rejected(public_key, input,
        ""::*u8)) { ret 9; }
    if (!pkcs1_sha384_hostile_rejected(public_key, input,
        ""::*u8)) { ret 10; }
    ret 0;
}

test "rsa-pkcs1: validation and authentication errors are distinct" {
    var modulus: [260]u8;
    var message: [33]u8;
    var encoded: [256]u8;
    if (!decode_hex(
        ""::*u8,
        512, ?modulus[0]) || !decode_hex(
        "6d6163682072736120706b63733120636572746966696361746520766563746f72"::*u8,
        66, ?message[0]) || !decode_hex(
        ""::*u8,
        512, ?encoded[0])) { ret 1; }
    val exponent: [3]u8 = [3]u8{1, 0, 1};
    var public_key: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus: contracts.Bytes{data: ?modulus[0], len: 256},
        exponent: contracts.Bytes{data: (?exponent[0]):~*u8, len: 3}
    };
    val input: contracts.Bytes = contracts.Bytes{data: ?message[0], len: 33};
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 255}) != contracts.AUTH_FAILED) { ret 2; }
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: nil, len: 256}) != contracts.INVALID_INPUT) { ret 3; }
    if (signature.verify_rsa_pkcs1_sha256(public_key,
        contracts.Bytes{data: nil, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_INPUT) { ret 4; }
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        public_key.modulus) != contracts.AUTH_FAILED) { ret 5; }

    public_key.modulus.len = 255;
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 6; }
    public_key.modulus.len = 256;
    public_key.modulus.data = nil;
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 7; }
    public_key.modulus.data = ?modulus[0];
    modulus[255] = modulus[255] ^ 1;
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 8; }
    modulus[255] = modulus[255] ^ 1;
    modulus[0] = modulus[0] & 0x7f;
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 9; }
    modulus[0] = modulus[0] | 0x80;
    modulus[257] = 1;
    public_key.modulus.len = 258;
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 10; }
    public_key.modulus.len = 256;

    val leading_zero: [4]u8 = [4]u8{0, 1, 0, 1};
    public_key.exponent = contracts.Bytes{data: (?leading_zero[0]):~*u8, len: 4};
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 11; }
    val even_exponent: [3]u8 = [3]u8{1, 0, 0};
    public_key.exponent = contracts.Bytes{data: (?even_exponent[0]):~*u8, len: 3};
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 12; }
    val one: [1]u8 = [1]u8{1};
    public_key.exponent = contracts.Bytes{data: (?one[0]):~*u8, len: 1};
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 13; }
    public_key.exponent = contracts.Bytes{data: nil, len: 3};
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 14; }
    public_key.exponent = contracts.Bytes{data: ?modulus[0], len: 256};
    if (signature.verify_rsa_pkcs1_sha256(public_key, input,
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 15; }
    ret 0;
}

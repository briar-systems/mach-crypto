# ecdsa p-256 production contract tests

use crypto.contracts;
use crypto.group.p256;
use crypto.signature;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

fun public_equal(actual: *u8, expected: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun public_filled(actual: *u8, value: u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (actual[i] != value) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun nibble(byte: u8) u8 {
    if (byte >= '0' && byte <= '9') { ret byte - '0'; }
    if (byte >= 'a' && byte <= 'f') { ret byte - 'a' + 10; }
    if (byte >= 'A' && byte <= 'F') { ret byte - 'A' + 10; }
    ret 255;
}

fun decode_hex(text: *u8, text_len: usize, output: *u8) bool {
    if (text == nil || output == nil || text_len % 2 != 0) { ret false; }
    var i: usize = 0;
    for (i < text_len / 2) {
        val high: u8 = nibble(text[i * 2]);
        val low: u8 = nibble(text[i * 2 + 1]);
        if (high == 255 || low == 255) { ret false; }
        output[i] = (high << 4) | low;
        i = i + 1;
    }
    ret true;
}

fun copy_public(output: *u8, input: *u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        output[i] = input[i];
        i = i + 1;
    }
}

fun pkcs1_hostile_rejected(public_key: signature.RsaPublicKey,
    message: contracts.Bytes, encoded: *u8) bool {
    var signature_bytes: [256]u8;
    var snapshot: [256]u8;
    if (!decode_hex(encoded, 512, ?signature_bytes[0])) { ret false; }
    copy_public(?snapshot[0], ?signature_bytes[0], 256);
    val status: contracts.Error = signature.verify_rsa_pkcs1_sha256(public_key,
        message, contracts.Bytes{data: ?signature_bytes[0], len: 256});
    ret status == contracts.AUTH_FAILED &&
        public_equal(?signature_bytes[0], ?snapshot[0], 256);
}

fun pkcs1_sha384_hostile_rejected(public_key: signature.RsaPublicKey,
    message: contracts.Bytes, encoded: *u8) bool {
    var signature_bytes: [256]u8;
    var snapshot: [256]u8;
    if (!decode_hex(encoded, 512, ?signature_bytes[0])) { ret false; }
    copy_public(?snapshot[0], ?signature_bytes[0], 256);
    val status: contracts.Error = signature.verify_rsa_pkcs1_sha384(public_key,
        message, contracts.Bytes{data: ?signature_bytes[0], len: 256});
    ret status == contracts.AUTH_FAILED &&
        public_equal(?signature_bytes[0], ?snapshot[0], 256);
}

fun set_rfc_private(output: *^u8) {
    val value: [32]u8 = [32]u8{
        0xc9, 0xaf, 0xa9, 0xd8, 0x45, 0xba, 0x75, 0x16,
        0x6b, 0x5c, 0x21, 0x57, 0x67, 0xb1, 0xd6, 0x93,
        0x4e, 0x50, 0xc3, 0xdb, 0x36, 0xe8, 0x9b, 0x12,
        0x7b, 0x8a, 0x62, 0x2b, 0x12, 0x0f, 0x67, 0x21
    };
    var i: usize = 0;
    for (i < 32) {
        output[i] = value[i];
        i = i + 1;
    }
}

test "ecdsa p-256: rfc 6979 sha-256 sample" {
    var private_key: [32]^u8 = [32]^u8{
        0xc9, 0xaf, 0xa9, 0xd8, 0x45, 0xba, 0x75, 0x16,
        0x6b, 0x5c, 0x21, 0x57, 0x67, 0xb1, 0xd6, 0x93,
        0x4e, 0x50, 0xc3, 0xdb, 0x36, 0xe8, 0x9b, 0x12,
        0x7b, 0x8a, 0x62, 0x2b, 0x12, 0x0f, 0x67, 0x21
    };
    val public_key: [65]u8 = [65]u8{
        0x04,
        0x60, 0xfe, 0xd4, 0xba, 0x25, 0x5a, 0x9d, 0x31,
        0xc9, 0x61, 0xeb, 0x74, 0xc6, 0x35, 0x6d, 0x68,
        0xc0, 0x49, 0xb8, 0x92, 0x3b, 0x61, 0xfa, 0x6c,
        0xe6, 0x69, 0x62, 0x2e, 0x60, 0xf2, 0x9f, 0xb6,
        0x79, 0x03, 0xfe, 0x10, 0x08, 0xb8, 0xbc, 0x99,
        0xa4, 0x1a, 0xe9, 0xe9, 0x56, 0x28, 0xbc, 0x64,
        0xf2, 0xf1, 0xb2, 0x0c, 0x2d, 0x7e, 0x9f, 0x51,
        0x77, 0xa3, 0xc2, 0x94, 0xd4, 0x46, 0x22, 0x99
    };
    val expected: [72]u8 = [72]u8{
        0x30, 0x46, 0x02, 0x21, 0x00,
        0xef, 0xd4, 0x8b, 0x2a, 0xac, 0xb6, 0xa8, 0xfd,
        0x11, 0x40, 0xdd, 0x9c, 0xd4, 0x5e, 0x81, 0xd6,
        0x9d, 0x2c, 0x87, 0x7b, 0x56, 0xaa, 0xf9, 0x91,
        0xc3, 0x4d, 0x0e, 0xa8, 0x4e, 0xaf, 0x37, 0x16,
        0x02, 0x21, 0x00,
        0xf7, 0xcb, 0x1c, 0x94, 0x2d, 0x65, 0x7c, 0x41,
        0xd4, 0x36, 0xc7, 0xa1, 0xb6, 0xe2, 0x9f, 0x65,
        0xf3, 0xe9, 0x00, 0xdb, 0xb9, 0xaf, 0xf4, 0x06,
        0x4d, 0xc4, 0xab, 0x2f, 0x84, 0x3a, 0xcd, 0xa8
    };
    val message: [6]u8 = [6]u8{'s', 'a', 'm', 'p', 'l', 'e'};
    var derived: [65]u8;
    var operation: contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: ?derived[0], capacity: 65});
    if (operation.error != contracts.OK || operation.written != 65 ||
        !public_equal(?derived[0], (?public_key[0]):~*u8, 65)) { ret 1; }
    var encoded: [72]u8;
    operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 6},
        contracts.Buffer{data: ?encoded[0], capacity: 72});
    if (operation.error != contracts.OK || operation.written != 72 ||
        !public_equal(?encoded[0], (?expected[0]):~*u8, 72)) { ret 2; }
    val verified: contracts.Error = signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: (?public_key[0]):~*u8, len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 6},
        contracts.Bytes{data: ?encoded[0], len: operation.written});
    if (verified != contracts.OK) { ret 3; }
    ret 0;
}

test "ecdsa p-256: deterministic signing and failures preserve output" {
    var private_key: [32]^u8;
    set_rfc_private(?private_key[0]);
    val sample: [6]u8 = [6]u8{'s', 'a', 'm', 'p', 'l', 'e'};
    var first: [72]u8;
    var second: [72]u8;
    var i: usize = 0;
    for (i < 72) { first[i] = 0xa5; second[i] = 0x5a; i = i + 1; }
    var result: contracts.Operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?sample[0]):~*u8, len: 6},
        contracts.Buffer{data: ?first[0], capacity: 72});
    if (result.error != contracts.OK || result.written != 72) { ret 1; }
    val again: contracts.Operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?sample[0]):~*u8, len: 6},
        contracts.Buffer{data: ?second[0], capacity: 72});
    if (again.error != contracts.OK || again.written != result.written ||
        !public_equal(?first[0], ?second[0], result.written)) { ret 2; }

    i = 0;
    for (i < 72) { second[i] = 0x5a; i = i + 1; }
    result = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?sample[0]):~*u8, len: 6},
        contracts.Buffer{data: ?second[0], capacity: 71});
    if (result.error != contracts.OUTPUT_TOO_SMALL || result.written != 0 ||
        !public_filled(?second[0], 0x5a, 72)) { ret 3; }

    i = 0;
    for (i < 32) { private_key[i] = 0; i = i + 1; }
    result = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?sample[0]):~*u8, len: 6},
        contracts.Buffer{data: ?second[0], capacity: 72});
    if (result.error != contracts.INVALID_KEY || result.written != 0 ||
        !public_filled(?second[0], 0x5a, 72)) { ret 4; }

    set_rfc_private(?private_key[0]);
    result = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: nil, len: 1},
        contracts.Buffer{data: ?second[0], capacity: 72});
    if (result.error != contracts.INVALID_INPUT || result.written != 0 ||
        !public_filled(?second[0], 0x5a, 72)) { ret 5; }
    ret 0;
}

test "ecdsa p-256: empty messages and high-s signatures verify" {
    var private_key: [32]^u8;
    set_rfc_private(?private_key[0]);
    var public_key: [65]u8;
    var signature_bytes: [72]u8;
    var operation: contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: ?public_key[0], capacity: 65});
    if (operation.error != contracts.OK) { ret 1; }
    operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: nil, len: 0},
        contracts.Buffer{data: ?signature_bytes[0], capacity: 72});
    if (operation.error != contracts.OK) { ret 2; }
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: nil, len: 0},
        contracts.Bytes{data: ?signature_bytes[0], len: operation.written}) != contracts.OK) {
        ret 3;
    }
    ret 0;
}

test "ecdsa p-256: wycheproof-style tampering and strict der rejection" {
    var private_key: [32]^u8;
    var i: usize = 0;
    for (i < 32) { private_key[i] = 0; i = i + 1; }
    private_key[31] = 1;
    var public_key: [65]u8;
    val message: [4]u8 = [4]u8{'t', 'e', 's', 't'};
    var encoded: [73]u8;
    var operation: contracts.Operation = p256.derive_public(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Buffer{data: ?public_key[0], capacity: 65});
    if (operation.error != contracts.OK) { ret 1; }
    operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_key[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Buffer{data: ?encoded[0], capacity: 72});
    if (operation.error != contracts.OK) { ret 2; }
    val encoded_len: usize = operation.written;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 3},
        contracts.Bytes{data: ?encoded[0], len: encoded_len}) != contracts.AUTH_FAILED) {
        ret 3;
    }
    encoded[encoded_len - 1] = encoded[encoded_len - 1] ^ 1;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?encoded[0], len: encoded_len}) != contracts.AUTH_FAILED) {
        ret 4;
    }
    encoded[encoded_len - 1] = encoded[encoded_len - 1] ^ 1;
    encoded[encoded_len] = 0;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?encoded[0], len: encoded_len + 1}) != contracts.AUTH_FAILED) {
        ret 5;
    }
    encoded[1] = encoded[1] - 1;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?encoded[0], len: encoded_len}) != contracts.AUTH_FAILED) {
        ret 6;
    }
    encoded[1] = encoded[1] + 1;
    public_key[64] = public_key[64] ^ 1;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?encoded[0], len: encoded_len}) != contracts.INVALID_KEY) {
        ret 7;
    }
    public_key[64] = public_key[64] ^ 1;

    var malformed: [40]u8;
    i = 0;
    for (i < 40) { malformed[i] = 0; i = i + 1; }
    malformed[0] = 0x30;
    malformed[1] = 0x06;
    malformed[2] = 0x02;
    malformed[3] = 0x01;
    malformed[4] = 0x00;
    malformed[5] = 0x02;
    malformed[6] = 0x01;
    malformed[7] = 0x01;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?malformed[0], len: 8}) != contracts.AUTH_FAILED) {
        ret 8;
    }
    malformed[1] = 0x07;
    malformed[3] = 0x02;
    malformed[4] = 0x00;
    malformed[5] = 0x01;
    malformed[6] = 0x02;
    malformed[7] = 0x01;
    malformed[8] = 0x01;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?malformed[0], len: 9}) != contracts.AUTH_FAILED) {
        ret 9;
    }
    malformed[1] = 0x06;
    malformed[3] = 0x01;
    malformed[4] = 0x80;
    malformed[5] = 0x02;
    malformed[6] = 0x01;
    malformed[7] = 0x01;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?malformed[0], len: 8}) != contracts.AUTH_FAILED) {
        ret 10;
    }
    val order: [32]u8 = [32]u8{
        0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        0xbc, 0xe6, 0xfa, 0xad, 0xa7, 0x17, 0x9e, 0x84,
        0xf3, 0xb9, 0xca, 0xc2, 0xfc, 0x63, 0x25, 0x51
    };
    malformed[0] = 0x30;
    malformed[1] = 0x26;
    malformed[2] = 0x02;
    malformed[3] = 0x21;
    malformed[4] = 0;
    i = 0;
    for (i < 32) { malformed[5 + i] = order[i]; i = i + 1; }
    malformed[37] = 0x02;
    malformed[38] = 0x01;
    malformed[39] = 0x01;
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: ?malformed[0], len: 40}) != contracts.AUTH_FAILED) {
        ret 11;
    }
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_key[0], len: 65},
        contracts.Bytes{data: (?message[0]):~*u8, len: 4},
        contracts.Bytes{data: nil, len: 0}) != contracts.AUTH_FAILED) {
        ret 12;
    }
    ret 0;
}

test "ed25519: rfc 8032 vectors" {
    if (signature.algorithm_status(signature.ED25519) != contracts.OK ||
        signature.algorithm_status(0xffff) != contracts.UNSUPPORTED) { ret 15; }
    var first_seed: [32]^u8 = [32]^u8{
        0x9d, 0x61, 0xb1, 0x9d, 0xef, 0xfd, 0x5a, 0x60,
        0xba, 0x84, 0x4a, 0xf4, 0x92, 0xec, 0x2c, 0xc4,
        0x44, 0x49, 0xc5, 0x69, 0x7b, 0x32, 0x69, 0x19,
        0x70, 0x3b, 0xac, 0x03, 0x1c, 0xae, 0x7f, 0x60
    };
    val first_public: [32]u8 = [32]u8{
        0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7,
        0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a,
        0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25,
        0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a
    };
    val first_signature: [64]u8 = [64]u8{
        0xe5, 0x56, 0x43, 0x00, 0xc3, 0x60, 0xac, 0x72,
        0x90, 0x86, 0xe2, 0xcc, 0x80, 0x6e, 0x82, 0x8a,
        0x84, 0x87, 0x7f, 0x1e, 0xb8, 0xe5, 0xd9, 0x74,
        0xd8, 0x73, 0xe0, 0x65, 0x22, 0x49, 0x01, 0x55,
        0x5f, 0xb8, 0x82, 0x15, 0x90, 0xa3, 0x3b, 0xac,
        0xc6, 0x1e, 0x39, 0x70, 0x1c, 0xf9, 0xb4, 0x6b,
        0xd2, 0x5b, 0xf5, 0xf0, 0x59, 0x5b, 0xbe, 0x24,
        0x65, 0x51, 0x41, 0x43, 0x8e, 0x7a, 0x10, 0x0b
    };
    var derived: [32]u8;
    var encoded: [64]u8;
    var operation: contracts.Operation = signature.derive_ed25519_public(
        contracts.SecretBytes{data: ?first_seed[0], len: 32},
        contracts.Buffer{data: ?derived[0], capacity: 32});
    if (operation.error != contracts.OK || operation.written != 32 ||
        !public_equal(?derived[0], (?first_public[0]):~*u8, 32)) { ret 1; }
    operation = signature.sign_ed25519(
        contracts.SecretBytes{data: ?first_seed[0], len: 32},
        contracts.Bytes{data: nil, len: 0},
        contracts.Buffer{data: ?encoded[0], capacity: 64});
    if (operation.error != contracts.OK || operation.written != 64 ||
        !public_equal(?encoded[0], (?first_signature[0]):~*u8, 64)) { ret 2; }
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?first_public[0]):~*u8, len: 32},
        contracts.Bytes{data: nil, len: 0},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.OK) { ret 3; }

    var second_seed: [32]^u8 = [32]^u8{
        0x4c, 0xcd, 0x08, 0x9b, 0x28, 0xff, 0x96, 0xda,
        0x9d, 0xb6, 0xc3, 0x46, 0xec, 0x11, 0x4e, 0x0f,
        0x5b, 0x8a, 0x31, 0x9f, 0x35, 0xab, 0xa6, 0x24,
        0xda, 0x8c, 0xf6, 0xed, 0x4f, 0xb8, 0xa6, 0xfb
    };
    val second_public: [32]u8 = [32]u8{
        0x3d, 0x40, 0x17, 0xc3, 0xe8, 0x43, 0x89, 0x5a,
        0x92, 0xb7, 0x0a, 0xa7, 0x4d, 0x1b, 0x7e, 0xbc,
        0x9c, 0x98, 0x2c, 0xcf, 0x2e, 0xc4, 0x96, 0x8c,
        0xc0, 0xcd, 0x55, 0xf1, 0x2a, 0xf4, 0x66, 0x0c
    };
    val second_signature: [64]u8 = [64]u8{
        0x92, 0xa0, 0x09, 0xa9, 0xf0, 0xd4, 0xca, 0xb8,
        0x72, 0x0e, 0x82, 0x0b, 0x5f, 0x64, 0x25, 0x40,
        0xa2, 0xb2, 0x7b, 0x54, 0x16, 0x50, 0x3f, 0x8f,
        0xb3, 0x76, 0x22, 0x23, 0xeb, 0xdb, 0x69, 0xda,
        0x08, 0x5a, 0xc1, 0xe4, 0x3e, 0x15, 0x99, 0x6e,
        0x45, 0x8f, 0x36, 0x13, 0xd0, 0xf1, 0x1d, 0x8c,
        0x38, 0x7b, 0x2e, 0xae, 0xb4, 0x30, 0x2a, 0xee,
        0xb0, 0x0d, 0x29, 0x16, 0x12, 0xbb, 0x0c, 0x00
    };
    val message: [1]u8 = [1]u8{0x72};
    operation = signature.derive_ed25519_public(
        contracts.SecretBytes{data: ?second_seed[0], len: 32},
        contracts.Buffer{data: ?derived[0], capacity: 32});
    if (operation.error != contracts.OK ||
        !public_equal(?derived[0], (?second_public[0]):~*u8, 32)) { ret 4; }
    operation = signature.sign_ed25519(
        contracts.SecretBytes{data: ?second_seed[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Buffer{data: ?encoded[0], capacity: 64});
    if (operation.error != contracts.OK ||
        !public_equal(?encoded[0], (?second_signature[0]):~*u8, 64)) { ret 5; }
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?second_public[0]):~*u8, len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.OK) { ret 6; }
    encoded[63] = encoded[63] ^ 1;
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?second_public[0]):~*u8, len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.AUTH_FAILED) { ret 7; }
    encoded[63] = encoded[63] ^ 1;
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?second_public[0]):~*u8, len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 63}) != contracts.AUTH_FAILED) { ret 8; }
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?second_public[0]):~*u8, len: 31},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.INVALID_KEY) { ret 9; }
    var identity: [32]u8;
    var noncanonical: [32]u8;
    var i: usize = 0;
    for (i < 32) { identity[i] = 0; noncanonical[i] = 0xff; i = i + 1; }
    identity[0] = 1;
    noncanonical[0] = 0xed;
    noncanonical[31] = 0x7f;
    if (signature.verify_ed25519(
        contracts.Bytes{data: ?identity[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.INVALID_KEY) { ret 10; }
    if (signature.verify_ed25519(
        contracts.Bytes{data: ?noncanonical[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.INVALID_KEY) { ret 11; }
    val order: [32]u8 = [32]u8{
        0xed, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58,
        0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10
    };
    i = 0;
    for (i < 32) { encoded[32 + i] = order[i]; i = i + 1; }
    if (signature.verify_ed25519(
        contracts.Bytes{data: (?second_public[0]):~*u8, len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Bytes{data: ?encoded[0], len: 64}) != contracts.AUTH_FAILED) { ret 12; }
    i = 0;
    for (i < 64) { encoded[i] = 0xa5; i = i + 1; }
    operation = signature.sign_ed25519(
        contracts.SecretBytes{data: ?second_seed[0], len: 32},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Buffer{data: ?encoded[0], capacity: 63});
    if (operation.error != contracts.OUTPUT_TOO_SMALL || operation.written != 0 ||
        !public_filled(?encoded[0], 0xa5, 64)) { ret 13; }
    var overlap: [64]u8;
    overlap[0] = 0x72;
    operation = signature.sign_ed25519(
        contracts.SecretBytes{data: ?second_seed[0], len: 32},
        contracts.Bytes{data: ?overlap[0], len: 1},
        contracts.Buffer{data: ?overlap[0], capacity: 64});
    if (operation.error != contracts.OK ||
        !public_equal(?overlap[0], (?second_signature[0]):~*u8, 64)) { ret 14; }
    i = 0;
    for (i < 32) { derived[i] = 0x5a; i = i + 1; }
    operation = signature.derive_ed25519_public(
        contracts.SecretBytes{data: ?second_seed[0], len: 32},
        contracts.Buffer{data: ?derived[0], capacity: 31});
    if (operation.error != contracts.OUTPUT_TOO_SMALL || operation.written != 0 ||
        !public_filled(?derived[0], 0x5a, 32)) { ret 16; }
    operation = signature.sign_ed25519(
        contracts.SecretBytes{data: ?second_seed[0], len: 31},
        contracts.Bytes{data: (?message[0]):~*u8, len: 1},
        contracts.Buffer{data: ?encoded[0], capacity: 64});
    if (operation.error != contracts.INVALID_KEY || operation.written != 0) { ret 17; }
    ret 0;
}



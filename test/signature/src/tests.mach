        0x2c, 0x87, 0xe6, 0x13, 0xd8, 0xfa, 0xc9, 0x76
    };
    val exponent: [3]u8 = [3]u8{0x01, 0x00, 0x01};
    val message: [31]u8 = [31]u8{
        'm', 'a', 'c', 'h', ' ', 'r', 's', 'a', ' ', 'p', 's', 's', ' ', 'i', 'n',
        'd', 'e', 'p', 'e', 'n', 'd', 'e', 'n', 't', ' ', 'v', 'e', 'c', 't', 'o', 'r'
    };
    var salt256: [32]^u8;
    var salt384: [48]^u8;
    var encoded: [256]u8;
    var i: usize = 0;
    for (i < 32) { salt256[i] = i::u8; i = i + 1; }
    i = 0;
    for (i < 48) { salt384[i] = i::u8; i = i + 1; }
    val private_key: signature.RsaPrivateKey = signature.RsaPrivateKey{
        modulus: contracts.Bytes{data: (?rsa_modulus[0]):~*u8, len: 256},
        public_exponent: contracts.Bytes{data: (?exponent[0]):~*u8, len: 3},
        private_exponent: contracts.SecretBytes{data: ?rsa_private[0], len: 256}
    };
    val public_key: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus: contracts.Bytes{data: (?rsa_modulus[0]):~*u8, len: 256},
        exponent: contracts.Bytes{data: (?exponent[0]):~*u8, len: 3}
    };
    var operation: contracts.Operation = signature.sign_rsa_pss_sha256(private_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.SecretBytes{data: ?salt256[0], len: 32},
        contracts.Buffer{data: ?encoded[0], capacity: 256});
    if (operation.error != contracts.OK || operation.written != 256 ||
        !public_equal(?encoded[0], (?expected_sha256[0]):~*u8, 256)) { ret 1; }
    if (signature.verify_rsa_pss_sha256(public_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.OK) { ret 2; }
    operation = signature.sign_rsa_pss_sha384(private_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.SecretBytes{data: ?salt384[0], len: 48},
        contracts.Buffer{data: ?encoded[0], capacity: 256});
    if (operation.error != contracts.OK || operation.written != 256 ||
        !public_equal(?encoded[0], (?expected_sha384[0]):~*u8, 256)) { ret 3; }
    if (signature.verify_rsa_pss_sha384(public_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.OK) { ret 4; }
    encoded[255] = encoded[255] ^ 1;
    if (signature.verify_rsa_pss_sha384(public_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.AUTH_FAILED) { ret 5; }
    encoded[255] = encoded[255] ^ 1;
    if (signature.verify_rsa_pss_sha384(public_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 30},
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.AUTH_FAILED) { ret 6; }
    if (signature.verify_rsa_pss_sha384(public_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.Bytes{data: ?encoded[0], len: 255}) != contracts.AUTH_FAILED) { ret 7; }
    val short_key: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus: contracts.Bytes{data: (?rsa_modulus[0]):~*u8, len: 255},
        exponent: contracts.Bytes{data: (?exponent[0]):~*u8, len: 3}
    };
    if (signature.verify_rsa_pss_sha384(short_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 8; }
    val even_exponent: [1]u8 = [1]u8{2};
    val even_key: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus: contracts.Bytes{data: (?rsa_modulus[0]):~*u8, len: 256},
        exponent: contracts.Bytes{data: (?even_exponent[0]):~*u8, len: 1}
    };
    if (signature.verify_rsa_pss_sha384(even_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.Bytes{data: ?encoded[0], len: 256}) != contracts.INVALID_KEY) { ret 9; }
    i = 0;
    for (i < 256) { encoded[i] = 0xa5; i = i + 1; }
    operation = signature.sign_rsa_pss_sha256(private_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.SecretBytes{data: ?salt256[0], len: 32},
        contracts.Buffer{data: ?encoded[0], capacity: 255});
    if (operation.error != contracts.OUTPUT_TOO_SMALL || operation.written != 0 ||
        !public_filled(?encoded[0], 0xa5, 256)) { ret 10; }
    operation = signature.sign_rsa_pss_sha256(private_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.SecretBytes{data: ?salt256[0], len: 31},
        contracts.Buffer{data: ?encoded[0], capacity: 256});
    if (operation.error != contracts.INVALID_INPUT || operation.written != 0 ||
        !public_filled(?encoded[0], 0xa5, 256)) { ret 11; }
    rsa_private[255] = 0x70;
    operation = signature.sign_rsa_pss_sha256(private_key,
        contracts.Bytes{data: (?message[0]):~*u8, len: 31},
        contracts.SecretBytes{data: ?salt256[0], len: 32},
        contracts.Buffer{data: ?encoded[0], capacity: 256});
    rsa_private[255] = 0x71;
    if (operation.error != contracts.INVALID_KEY || operation.written != 0 ||
        !public_filled(?encoded[0], 0xa5, 256)) { ret 12; }
    var overlap: [256]u8;
    i = 0;
    for (i < 31) { overlap[i] = message[i]; i = i + 1; }
    operation = signature.sign_rsa_pss_sha256(private_key,
        contracts.Bytes{data: ?overlap[0], len: 31},
        contracts.SecretBytes{data: ?salt256[0], len: 32},
        contracts.Buffer{data: ?overlap[0], capacity: 256});
    if (operation.error != contracts.OK ||
        !public_equal(?overlap[0], (?expected_sha256[0]):~*u8, 256)) { ret 13; }
    ret 0;
}



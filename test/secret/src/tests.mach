# secret ownership and failure-path tests

use crypto.contracts;
use crypto.secret.Allocator;
use crypto.secret.Entropy;
use crypto.secret.Secret;
use crypto.secret.EMPTY;
use crypto.secret.active;
use crypto.secret.buffer;
use crypto.secret.bytes;
use crypto.secret.cleanup_pending;
use crypto.secret.clone;
use crypto.secret.destroy;
use crypto.secret.empty;
use crypto.secret.init;
use crypto.secret.init_random;
use crypto.secret.move;
use crypto.secret.system_allocator;
use crypto.secret.system_entropy;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

var probe_storage: [4096]^u8;

rec ProbeAllocator {
    capacity:             usize;
    offset:               usize;
    fail_allocate_at:     usize;
    fail_with_storage:    bool;
    fail_deallocate_at:   usize;
    allocation_attempts:  usize;
    allocations:          usize;
    deallocations:        usize;
    allocated_bytes:      usize;
    deallocated_bytes:    usize;
    zeroized_releases:    usize;
    nonzero_releases:     usize;
}

fun probe_allocate(context: ptr, secret_context: *^u8, len: usize, out: **^u8) i64 {
    val probe: *ProbeAllocator = context::*ProbeAllocator;
    @out = nil;
    probe.allocation_attempts = probe.allocation_attempts + 1;
    if (probe.fail_allocate_at != 0 && probe.allocation_attempts == probe.fail_allocate_at) {
        if (probe.fail_with_storage && len != 0 && probe.offset <= probe.capacity
            && len <= probe.capacity - probe.offset) {
            @out = ?probe_storage[probe.offset];
            probe.offset = probe.offset + len;
            probe.allocations = probe.allocations + 1;
            probe.allocated_bytes = probe.allocated_bytes + len;
        }
        ret -1;
    }
    if (len == 0) { ret 0; }
    if (probe.offset > probe.capacity || len > probe.capacity - probe.offset) { ret -1; }
    @out = ?probe_storage[probe.offset];
    probe.offset = probe.offset + len;
    probe.allocations = probe.allocations + 1;
    probe.allocated_bytes = probe.allocated_bytes + len;
    ret 0;
}

fun probe_deallocate(context: ptr, secret_context: *^u8, data: *^u8, len: usize) i64 {
    val probe: *ProbeAllocator = context::*ProbeAllocator;
    probe.deallocations = probe.deallocations + 1;
    var zero: bool = true;
    var i: usize = 0;
    for (i < len) {
        if (data[i]:^ != 0) { zero = false; }
        i = i + 1;
    }
    if (zero) {
        probe.zeroized_releases = probe.zeroized_releases + 1;
    } or {
        probe.nonzero_releases = probe.nonzero_releases + 1;
    }
    if (probe.fail_deallocate_at != 0 && probe.deallocations == probe.fail_deallocate_at) {
        if (len != 0) { data[0] = 0xCC; }
        ret -1;
    }
    probe.deallocated_bytes = probe.deallocated_bytes + len;
    ret 0;
}

fun probe_make(probe: *ProbeAllocator, capacity: usize) Allocator {
    probe.capacity = capacity;
    probe.offset = 0;
    probe.fail_allocate_at = 0;
    probe.fail_with_storage = false;
    probe.fail_deallocate_at = 0;
    probe.allocation_attempts = 0;
    probe.allocations = 0;
    probe.deallocations = 0;
    probe.allocated_bytes = 0;
    probe.deallocated_bytes = 0;
    probe.zeroized_releases = 0;
    probe.nonzero_releases = 0;
    var i: usize = 0;
    for (i < 4096) {
        probe_storage[i] = 0xA5;
        i = i + 1;
    }
    ret Allocator{context: probe::ptr, secret_context: nil, allocate_fn: probe_allocate,
        deallocate_fn: probe_deallocate, initialized: true};
}

rec EntropyProbe {
    calls: usize;
    fail:  bool;
}

fun probe_fill(context: ptr, secret_context: *^u8, destination: *^u8, len: usize) i64 {
    val probe: *EntropyProbe = context::*EntropyProbe;
    probe.calls = probe.calls + 1;
    var i: usize = 0;
    for (i < len) {
        destination[i] = (i + 1)::u8;
        i = i + 1;
    }
    if (probe.fail) { ret -1; }
    ret 0;
}

fun probe_entropy(probe: *EntropyProbe, fail: bool) Entropy {
    probe.calls = 0;
    probe.fail = fail;
    ret Entropy{context: probe::ptr, secret_context: nil, fill_fn: probe_fill, initialized: true};
}

test "secret: initialization and bounded views preserve capacity" {
    var probe: ProbeAllocator;
    var owner: Allocator = probe_make(?probe, 64);
    var secret: Secret = empty();
    if (init(?secret, ?owner, 16) != contracts.OK || !active(?secret)) { ret 1; }
    if (secret.len != 16 || probe.allocations != 1 || probe.allocated_bytes != 16) { ret 2; }

    var whole: contracts.SecretBuffer;
    if (buffer(?secret, 0, 16, ?whole) != contracts.OK || whole.capacity != 16) { ret 3; }
    var i: usize = 0;
    for (i < 16) {
        if (whole.data[i]:^ != 0) { ret 4; }
        whole.data[i] = (0x40 + i)::u8;
        i = i + 1;
    }

    var middle: contracts.SecretBytes;
    if (bytes(?secret, 4, 8, ?middle) != contracts.OK || middle.len != 8) { ret 5; }
    i = 0;
    for (i < 8) {
        if (middle.data[i]:^ != (0x44 + i)::u8) { ret 6; }
        i = i + 1;
    }

    if (bytes(?secret, 17, 0, ?middle) != contracts.INVALID_INPUT) { ret 7; }
    if (middle.data != nil || middle.len != 0) { ret 8; }
    if (bytes(?secret, 12, 5, ?middle) != contracts.OUTPUT_TOO_SMALL) { ret 9; }
    if (buffer(?secret, 16, 0, ?whole) != contracts.OK || whole.capacity != 0) { ret 10; }
    if (buffer(?secret, 16, 1, ?whole) != contracts.OUTPUT_TOO_SMALL) { ret 11; }
    if (bytes(?secret, 0xFFFFFFFFFFFFFFFF, 0, ?middle) != contracts.INVALID_INPUT) { ret 12; }
    if (bytes(?secret, 0, 0xFFFFFFFFFFFFFFFF, ?middle) != contracts.OUTPUT_TOO_SMALL) { ret 13; }

    if (destroy(?secret) != contracts.OK || active(?secret)) { ret 14; }
    if (probe.deallocations != 1 || probe.zeroized_releases != 1 || probe.nonzero_releases != 0) { ret 15; }
    if (destroy(?secret) != contracts.OK || probe.deallocations != 1) { ret 16; }
    ret 0;
}

test "secret: move transfers sole ownership and invalidates the source" {
    var probe: ProbeAllocator;
    var owner: Allocator = probe_make(?probe, 64);
    var source: Secret = empty();
    var destination: Secret = empty();
    if (init(?source, ?owner, 24) != contracts.OK) { ret 1; }
    val original: *^u8 = source.data;
    if (move(?destination, ?source) != contracts.OK) { ret 2; }
    if (!active(?destination) || active(?source) || source.state != EMPTY) { ret 3; }
    if (destination.data != original || destination.len != 24) { ret 4; }
    if (move(?destination, ?source) != contracts.INVALID_STATE) { ret 5; }
    if (move(?destination, ?destination) != contracts.INVALID_INPUT) { ret 6; }
    if (destroy(?source) != contracts.OK || destroy(?destination) != contracts.OK) { ret 7; }
    if (probe.deallocations != 1 || probe.zeroized_releases != 1) { ret 8; }
    ret 0;
}

test "secret: clone creates independent secret storage" {
    var probe: ProbeAllocator;
    var owner: Allocator = probe_make(?probe, 128);
    var source: Secret = empty();
    var copy: Secret = empty();
    if (init(?source, ?owner, 16) != contracts.OK) { ret 1; }
    var source_buffer: contracts.SecretBuffer;
    if (buffer(?source, 0, 16, ?source_buffer) != contracts.OK) { ret 2; }
    var i: usize = 0;
    for (i < 16) { source_buffer.data[i] = (i + 1)::u8; i = i + 1; }
    if (clone(?copy, ?source, ?owner) != contracts.OK) { ret 3; }
    if (copy.data == source.data || probe.allocations != 2) { ret 4; }
    var copy_buffer: contracts.SecretBuffer;
    if (buffer(?copy, 0, 16, ?copy_buffer) != contracts.OK) { ret 5; }
    i = 0;
    for (i < 16) {
        if (copy_buffer.data[i]:^ != source_buffer.data[i]:^) { ret 6; }
        i = i + 1;
    }
    copy_buffer.data[0] = 0xFF;
    if (source_buffer.data[0]:^ != 1 || copy_buffer.data[0]:^ != 0xFF) { ret 7; }
    if (destroy(?source) != contracts.OK || destroy(?copy) != contracts.OK) { ret 8; }
    if (probe.deallocations != 2 || probe.zeroized_releases != 2) { ret 9; }
    ret 0;
}

test "secret: allocation failure retains empty destination and source ownership" {
    var probe: ProbeAllocator;
    var owner: Allocator = probe_make(?probe, 64);
    probe.fail_allocate_at = 1;
    var secret: Secret = empty();
    if (init(?secret, ?owner, 16) != contracts.ALLOCATION_FAILED) { ret 1; }
    if (secret.state != EMPTY || active(?secret) || probe.deallocations != 0) { ret 2; }

    probe.fail_allocate_at = 0;
    if (init(?secret, ?owner, 16) != contracts.OK) { ret 3; }
    var copy: Secret = empty();
    probe.fail_allocate_at = 3;
    if (clone(?copy, ?secret, ?owner) != contracts.ALLOCATION_FAILED) { ret 4; }
    if (copy.state != EMPTY || !active(?secret) || probe.deallocations != 0) { ret 5; }
    if (destroy(?secret) != contracts.OK || probe.zeroized_releases != 1) { ret 6; }
    ret 0;
}

test "secret: partial allocation failure is wiped and cleanup ownership is retained" {
    var probe: ProbeAllocator;
    var owner: Allocator = probe_make(?probe, 64);
    probe.fail_allocate_at = 1;
    probe.fail_with_storage = true;
    var secret: Secret = empty();
    if (init(?secret, ?owner, 16) != contracts.ALLOCATION_FAILED) { ret 1; }
    if (secret.state != EMPTY || probe.deallocations != 1 || probe.zeroized_releases != 1) { ret 2; }

    owner = probe_make(?probe, 64);
    probe.fail_allocate_at = 1;
    probe.fail_with_storage = true;
    probe.fail_deallocate_at = 1;
    if (init_random(?secret, ?owner, 16, nil) != contracts.INVALID_INPUT) { ret 3; }
    var entropy_probe: EntropyProbe;
    var entropy: Entropy = probe_entropy(?entropy_probe, false);
    if (init_random(?secret, ?owner, 16, ?entropy) != contracts.ALLOCATION_FAILED) { ret 4; }
    if (!cleanup_pending(?secret) || probe.zeroized_releases != 1 || probe_storage[0]:^ != 0xCC) { ret 5; }
    if (entropy_probe.calls != 0) { ret 6; }
    if (destroy(?secret) != contracts.OK) { ret 7; }
    if (probe.zeroized_releases != 1 || probe.nonzero_releases != 1) { ret 8; }
    ret 0;
}

test "secret: entropy failure is distinct and wipes partial output" {
    var allocation_probe: ProbeAllocator;
    var owner: Allocator = probe_make(?allocation_probe, 64);
    var entropy_probe: EntropyProbe;
    var entropy: Entropy = probe_entropy(?entropy_probe, true);
    var secret: Secret = empty();
    if (init_random(?secret, ?owner, 32, ?entropy) != contracts.ENTROPY_UNAVAILABLE) { ret 1; }
    if (entropy_probe.calls != 1 || secret.state != EMPTY) { ret 2; }
    if (allocation_probe.deallocations != 1 || allocation_probe.zeroized_releases != 1) { ret 3; }

    var invalid_entropy: Entropy;
    invalid_entropy.initialized = false;
    if (init_random(?secret, ?owner, 8, ?invalid_entropy) != contracts.INVALID_INPUT) { ret 4; }
    if (allocation_probe.allocation_attempts != 1) { ret 5; }
    ret 0;
}

test "secret: failed cleanup retains wiped ownership without a second wipe" {
    var allocation_probe: ProbeAllocator;
    var owner: Allocator = probe_make(?allocation_probe, 64);
    allocation_probe.fail_deallocate_at = 1;
    var entropy_probe: EntropyProbe;
    var entropy: Entropy = probe_entropy(?entropy_probe, true);
    var secret: Secret = empty();
    if (init_random(?secret, ?owner, 32, ?entropy) != contracts.ENTROPY_UNAVAILABLE) { ret 1; }
    if (!cleanup_pending(?secret) || allocation_probe.zeroized_releases != 1) { ret 2; }
    if (probe_storage[0]:^ != 0xCC) { ret 3; }

    if (destroy(?secret) != contracts.OK || secret.state != EMPTY) { ret 4; }
    if (allocation_probe.deallocations != 2) { ret 5; }
    if (allocation_probe.zeroized_releases != 1 || allocation_probe.nonzero_releases != 1) { ret 6; }
    ret 0;
}

test "secret: destruction failure is retry-safe and zeroizes once" {
    var probe: ProbeAllocator;
    var owner: Allocator = probe_make(?probe, 64);
    probe.fail_deallocate_at = 1;
    var secret: Secret = empty();
    if (init(?secret, ?owner, 16) != contracts.OK) { ret 1; }
    var view: contracts.SecretBuffer;
    if (buffer(?secret, 0, 16, ?view) != contracts.OK) { ret 2; }
    var i: usize = 0;
    for (i < 16) { view.data[i] = 0x7B; i = i + 1; }
    if (destroy(?secret) != contracts.DEALLOCATION_FAILED || !cleanup_pending(?secret)) { ret 3; }
    if (probe.zeroized_releases != 1 || probe_storage[0]:^ != 0xCC) { ret 4; }
    if (bytes(?secret, 0, 1, nil) != contracts.INVALID_INPUT) { ret 5; }
    var blocked: contracts.SecretBytes;
    if (bytes(?secret, 0, 1, ?blocked) != contracts.INVALID_STATE) { ret 6; }
    if (destroy(?secret) != contracts.OK || probe.zeroized_releases != 1 || probe.nonzero_releases != 1) { ret 7; }
    ret 0;
}

test "secret: zero-length owners have explicit lifecycle" {
    var probe: ProbeAllocator;
    var owner: Allocator = probe_make(?probe, 0);
    var secret: Secret = empty();
    if (init(?secret, ?owner, 0) != contracts.OK || !active(?secret)) { ret 1; }
    var view: contracts.SecretBytes;
    if (bytes(?secret, 0, 0, ?view) != contracts.OK || view.data != nil || view.len != 0) { ret 2; }
    if (destroy(?secret) != contracts.OK || secret.state != EMPTY) { ret 3; }
    if (probe.allocations != 0 || probe.deallocations != 0) { ret 4; }

    var entropy_probe: EntropyProbe;
    var entropy: Entropy = probe_entropy(?entropy_probe, false);
    if (init_random(?secret, ?owner, 0, ?entropy) != contracts.OK) { ret 5; }
    if (entropy_probe.calls != 1 || destroy(?secret) != contracts.OK) { ret 6; }
    ret 0;
}

test "secret: invalid state and nil inputs never acquire ownership" {
    var probe: ProbeAllocator;
    var owner: Allocator = probe_make(?probe, 64);
    var invalid_owner: Allocator;
    invalid_owner.initialized = false;
    var secret: Secret = empty();
    if (init(nil, ?owner, 8) != contracts.INVALID_INPUT) { ret 1; }
    if (init(?secret, nil, 8) != contracts.INVALID_INPUT) { ret 2; }
    if (init(?secret, ?invalid_owner, 8) != contracts.INVALID_INPUT) { ret 3; }
    if (destroy(nil) != contracts.INVALID_INPUT) { ret 4; }
    if (probe.allocation_attempts != 0) { ret 5; }
    if (init(?secret, ?owner, 8) != contracts.OK) { ret 6; }
    if (init(?secret, ?owner, 8) != contracts.INVALID_STATE || probe.allocation_attempts != 1) { ret 7; }
    var destination: Secret = empty();
    if (clone(?destination, ?destination, ?owner) != contracts.INVALID_STATE) { ret 8; }
    if (destroy(?secret) != contracts.OK) { ret 9; }
    ret 0;
}

test "secret: native allocator and entropy initialize usable storage" {
    var owner: Allocator = system_allocator();
    var entropy: Entropy = system_entropy();
    var secret: Secret = empty();
    if (init_random(?secret, ?owner, 32, ?entropy) != contracts.OK) { ret 1; }
    var view: contracts.SecretBytes;
    if (bytes(?secret, 0, 32, ?view) != contracts.OK || view.data == nil || view.len != 32) {
        destroy(?secret);
        ret 2;
    }
    view.data[0] = 0xA5;
    view.data[31] = 0x5A;
    if (view.data[0]:^ != 0xA5 || view.data[31]:^ != 0x5A) {
        destroy(?secret);
        ret 3;
    }
    if (destroy(?secret) != contracts.OK) { ret 4; }
    ret 0;
}

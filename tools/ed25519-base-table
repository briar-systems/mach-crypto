#!/usr/bin/env python3
"""generate src/internal/ed25519_base.mach, the edwards25519 fixed-base comb table

entry (window, digit) is digit * 16^window * B for 64 windows and digits 1..15,
in niels form (y + x, y - x, 2 * d * x * y), each as 5 canonical 51-bit limbs.
the table is public data. crypto.internal.ed25519 recomputes every entry in its
tests, so a stale or edited table fails the suite.

usage: tools/ed25519-base-table [--check]
"""

import pathlib
import sys

P = 2**255 - 19
D = -121665 * pow(121666, -1, P) % P
L = 2**252 + 27742317777372353535851937790883648493
BY = 4 * pow(5, -1, P) % P
BX = 15112221349535400772501151409588531511454012693041857206046113283949847762202

WINDOWS = 64
DIGITS = 15
LIMBS = 5

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUTPUT = ROOT / 'src' / 'internal' / 'ed25519_base.mach'


def add(left, right):
    (x1, y1), (x2, y2) = left, right
    t = D * x1 * x2 * y1 * y2 % P
    x3 = (x1 * y2 + y1 * x2) * pow(1 + t, -1, P) % P
    y3 = (y1 * y2 + x1 * x2) * pow(1 - t, -1, P) % P
    return x3, y3


def limbs(value):
    return [(value >> (51 * i)) & (2**51 - 1) for i in range(LIMBS)]


def render():
    lines = [
        '# edwards25519 fixed-base comb table, generated by tools/ed25519-base-table',
        '#',
        '# entry (window, digit) is digit * 16^window * B for digits 1..15, in niels',
        '# form (y + x, y - x, 2 * d * x * y) as canonical 51-bit limbs. public data only.',
        '',
        f'pub val WINDOWS: u64 = {WINDOWS};',
        f'pub val DIGITS:  u64 = {DIGITS};',
        '',
        f'pub val TABLE: [{WINDOWS * DIGITS * 3 * LIMBS}]u64 = [{WINDOWS * DIGITS * 3 * LIMBS}]u64{{',
    ]
    rows = []
    base = (BX, BY)
    for window in range(WINDOWS):
        point = (0, 1)
        for digit in range(1, DIGITS + 1):
            point = add(point, base)
            x, y = point
            for value in ((y + x) % P, (y - x) % P, 2 * D * x * y % P):
                rows.append(', '.join(f'0x{w:013X}' for w in limbs(value)))
        for _ in range(4):
            base = add(base, base)
    lines.append(',\n'.join('    ' + row for row in rows))
    lines.append('};')
    return '\n'.join(lines) + '\n'


def main():
    assert (-BX * BX + BY * BY - 1 - D * BX * BX * BY * BY) % P == 0
    assert BX % 2 == 0
    order = (0, 1)
    point = (BX, BY)
    scalar = L
    while scalar:
        if scalar & 1:
            order = add(order, point)
        point = add(point, point)
        scalar >>= 1
    assert order == (0, 1)
    text = render()
    if sys.argv[1:] == ['--check']:
        if OUTPUT.read_text() != text:
            sys.exit('ed25519_base.mach is stale; run tools/ed25519-base-table')
        return
    if sys.argv[1:]:
        sys.exit(__doc__)
    OUTPUT.write_text(text)


if __name__ == '__main__':
    main()

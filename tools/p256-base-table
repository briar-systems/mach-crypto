#!/usr/bin/env python3
"""generate src/internal/p256_base.mach, the p-256 fixed-base comb table

entry (window, digit) is the affine point digit * 16^window * G for 64 windows
and digits 1..15, stored as 8 little-endian 32-bit words of x then of y. the
table is public data. crypto.internal.p256 recomputes every entry in its tests,
so a stale or edited table fails the suite.

usage: tools/p256-base-table [--check]
"""

import pathlib
import sys

P = 2**256 - 2**224 + 2**192 + 2**96 - 1
A = P - 3
N = 0xFFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551
G = (0x6B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296,
     0x4FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5)

WINDOWS = 64
DIGITS = 15
WORDS = 8

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUTPUT = ROOT / 'src' / 'internal' / 'p256_base.mach'


def add(left, right):
    if left is None:
        return right
    if right is None:
        return left
    (x1, y1), (x2, y2) = left, right
    if x1 == x2:
        if (y1 + y2) % P == 0:
            return None
        slope = (3 * x1 * x1 + A) * pow(2 * y1, -1, P) % P
    else:
        slope = (y2 - y1) * pow(x2 - x1, -1, P) % P
    x3 = (slope * slope - x1 - x2) % P
    return x3, (slope * (x1 - x3) - y1) % P


def words(value):
    return [(value >> (32 * i)) & 0xFFFFFFFF for i in range(WORDS)]


def render():
    lines = [
        '# p-256 fixed-base comb table, generated by tools/p256-base-table',
        '#',
        '# entry (window, digit) is digit * 16^window * G for digits 1..15, as 8',
        '# little-endian 32-bit words of affine x then of y. public data only.',
        '',
        f'pub val WINDOWS: u64 = {WINDOWS};',
        f'pub val DIGITS:  u64 = {DIGITS};',
        '',
        f'pub val TABLE: [{WINDOWS * DIGITS * 2 * WORDS}]u32 = [{WINDOWS * DIGITS * 2 * WORDS}]u32{{',
    ]
    rows = []
    base = G
    for window in range(WINDOWS):
        point = None
        for digit in range(1, DIGITS + 1):
            point = add(point, base)
            assert point is not None
            rows.append(', '.join(f'0x{w:08X}' for w in words(point[0])))
            rows.append(', '.join(f'0x{w:08X}' for w in words(point[1])))
        for _ in range(4):
            base = add(base, base)
    lines.append(',\n'.join('    ' + row for row in rows))
    lines.append('};')
    return '\n'.join(lines) + '\n'


def main():
    assert pow(2, N - 1, N) == 1
    assert (G[1] ** 2 - G[0] ** 3 - A * G[0]) % P == 0x5AC635D8AA3A93E7B3EBBD55769886BC651D06B0CC53B0F63BCE3C3E27D2604B
    text = render()
    if sys.argv[1:] == ['--check']:
        if OUTPUT.read_text() != text:
            sys.exit('p256_base.mach is stale; run tools/p256-base-table')
        return
    if sys.argv[1:]:
        sys.exit(__doc__)
    OUTPUT.write_text(text)


if __name__ == '__main__':
    main()

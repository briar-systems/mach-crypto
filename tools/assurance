#!/usr/bin/env bash

set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
command_name=${1:-run}
evidence_root="$root/out/assurance"
targets=(
    linux-x86_64
    linux-arm64
    linux-riscv64
    windows-x86_64
    darwin-x86_64
    darwin-aarch64
)
profiles=(debug release)
temporary=

die() {
    printf 'assurance: %s\n' "$*" >&2
    exit 1
}

# the logs are removed on exit, so a failure prints its non-passing tests and log tail first
report_failed_tests() {
    local log=$1
    grep '"event":"test"' "$log" | grep -v '"kind":"pass"' >&2 || true
    tail -n 20 -- "$log" >&2
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command is unavailable: $1"
}

require_file() {
    [[ -f "$1" ]] || die "required file is missing: ${1#"$root"/}"
}

sha256_file() {
    sha256sum "$1" | awk '{print $1}'
}

# the committed gitlinks under dep/ are the dependency pins; there is no lock file
dependency_pins_hash() {
    git -C "$root" ls-tree HEAD -- dep .gitmodules | sha256sum | cut -d ' ' -f 1
}

metadata_value() {
    local file=$1
    local key=$2
    awk -F '\t' -v key="$key" '$1 == key { print $2; found = 1; exit } END { if (!found) exit 1 }' "$file"
}

tree_is_clean() {
    [[ -z "$(git -C "$root" status --short --untracked-files=all)" ]]
}

leakage_projects() {
    awk -F '\t' 'NR > 1 { print $1 }' "$root/assurance/leakage.tsv"
}

manifest_hash() {
    (
        cd "$root"
        sha256sum \
            assurance/algorithms.tsv \
            assurance/projects.tsv \
            assurance/tests.tsv \
            assurance/zeroization.tsv \
            assurance/leakage.tsv \
            test/performance/mach.toml \
            test/performance/src/performance.mach \
            tools/assurance
        leakage_projects | while IFS= read -r project; do
            sha256sum "$project/mach.toml"
            find "$project/src" -type f -name '*.mach' -print0 | sort -z | xargs -0 sha256sum
        done
    ) | sha256sum | awk '{print $1}'
}

check_prerequisites() {
    require_command awk
    require_command cmp
    require_command diff
    require_command find
    require_command git
    require_command grep
    require_command mach
    require_command mktemp
    require_command realpath
    require_command sha256sum
    require_command sort
    require_command stat

    require_file "$root/mach.toml"
    require_file "$root/assurance/algorithms.tsv"
    require_file "$root/assurance/projects.tsv"
    require_file "$root/assurance/tests.tsv"
    require_file "$root/assurance/zeroization.tsv"
    require_file "$root/assurance/leakage.tsv"
    local project
    while IFS= read -r project; do
        require_file "$root/$project/mach.toml"
    done < <(leakage_projects)
    require_file "$root/test/performance/mach.toml"
    require_file "$root/test/performance/src/performance.mach"
}

assert_clean_source() {
    tree_is_clean || die "the source tree is dirty; commit the exact source before producing release evidence"
}

resolve_dependencies() {
    local project algorithm
    while IFS=$'\t' read -r project algorithm; do
        [[ "$project" == project ]] && continue
        (cd "$root" && mach dep pull "$project" --quiet) >/dev/null 2>&1 </dev/null || \
            die "dependency resolution failed for $project; run 'mach dep pull $project' for details"
    done < "$root/assurance/projects.tsv"
    while IFS= read -r project; do
        (cd "$root" && mach dep pull "$project" --quiet) >/dev/null 2>&1 </dev/null || \
            die "dependency resolution failed for $project; run 'mach dep pull $project' for details"
    done < <(leakage_projects)
    (cd "$root" && mach dep pull test/performance --quiet) >/dev/null 2>&1 || \
        die "dependency resolution failed for test/performance; run 'mach dep pull test/performance' for details"
    tree_is_clean || die "dependency resolution changed the source tree; commit the refreshed pins before producing release evidence"
}

assert_no_redundant_aliases() {
    local findings
    findings=$(rg --pcre2 -n \
        '^\s*use\s+([A-Za-z_][A-Za-z0-9_]*)\s*:\s*[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*\.\1\s*;' \
        "$root/src" "$root/test" --glob '*.mach' 2>/dev/null || true)
    [[ -z "$findings" ]] || die "redundant same-name use aliases remain:\n$findings"
}

validate_test_log() {
    local log=$1
    local expected=$2
    local summary failed total
    summary=$(grep '"event":"summary"' "$log" | tail -n 1 || true)
    [[ -n "$summary" ]] || die "test log has no summary: $log"
    failed=$(printf '%s\n' "$summary" | sed -n 's/.*"failed":\([0-9][0-9]*\).*/\1/p')
    total=$(printf '%s\n' "$summary" | sed -n 's/.*"total":\([0-9][0-9]*\).*/\1/p')
    [[ "$failed" == 0 ]] || die "test log reports failures: $log"
    if [[ "$expected" == one ]]; then
        [[ "$total" == 1 ]] || die "filtered evidence test did not select exactly one test: $log"
    else
        [[ -n "$total" && "$total" -gt 0 ]] || die "test project did not execute tests: $log"
    fi
}

record_result() {
    local category=$1
    local project=$2
    local algorithm=$3
    local source=$4
    local target=$5
    local profile=$6
    local artifact=$7
    local hash=$8
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\tPASS\t%s\n' \
        "$category" "$project" "$algorithm" "$source" "$target" "$profile" "$artifact" "$hash" \
        >> "$results"
}

# a project that declares a tests artifact is tested through it, since mach
# tests only the selected artifact's closure and the library does not reach
# the test modules
test_selection() {
    local project=$1
    if grep -qx '\[artifact\.tests\]' "$root/$project/mach.toml"; then
        printf '%s\n' --lib tests
    fi
}

run_functional_tests() {
    local project algorithm profile log relative hash
    local -a selection
    while IFS=$'\t' read -r project algorithm; do
        [[ "$project" == project ]] && continue
        mapfile -t selection < <(test_selection "$project")
        for profile in "${profiles[@]}"; do
            relative="logs/tests/functional/${algorithm}-${profile}.ndjson"
            log="$stage/$relative"
            mkdir -p "$(dirname -- "$log")"
            if ! (cd "$root" && mach test "$project" "${selection[@]}" --profile "$profile" --format json) > "$log" 2>&1; then
                report_failed_tests "$log"
                die "functional test failed for $project $profile"
            fi
            validate_test_log "$log" many
            hash=$(sha256_file "$log")
            record_result functional "$project" "$algorithm" "complete project test suite" \
                linux-x86_64 "$profile" "$relative" "$hash"
        done
    done < "$root/assurance/projects.tsv"
}

run_independent_tests() {
    local category project algorithm source filter profile log relative hash index
    local -a selection
    index=0
    while IFS=$'\t' read -r category project algorithm source filter; do
        [[ "$category" == category ]] && continue
        index=$((index + 1))
        mapfile -t selection < <(test_selection "$project")
        for profile in "${profiles[@]}"; do
            if [[ "$category" == performance && "$profile" != release ]]; then
                continue
            fi
            printf -v relative 'logs/tests/%s/%03d-%s.ndjson' "$category" "$index" "$profile"
            log="$stage/$relative"
            mkdir -p "$(dirname -- "$log")"
            if ! (cd "$root" && mach test "$project" "${selection[@]}" --profile "$profile" \
                --filter "$filter" --format json) > "$log" 2>&1; then
                report_failed_tests "$log"
                die "$category test failed for $project $profile: $filter"
            fi
            validate_test_log "$log" one
            hash=$(sha256_file "$log")
            record_result "$category" "$project" "$algorithm" "$source" \
                linux-x86_64 "$profile" "$relative" "$hash"
        done
    done < "$root/assurance/tests.tsv"
}

clean_build_projects() {
    local project algorithm log
    while IFS=$'\t' read -r project algorithm; do
        [[ "$project" == project ]] && continue
        log="$stage/logs/build/clean-${algorithm}.log"
        mkdir -p "$(dirname -- "$log")"
        if ! (cd "$root" && mach clean "$project") > "$log" 2>&1; then
            die "mach clean failed for $project; see $log"
        fi
    done < "$root/assurance/projects.tsv"
}

project_output() {
    local project=$1
    if [[ "$project" == . ]]; then
        printf '%s/out\n' "$root"
    else
        printf '%s/%s/out\n' "$root" "$project"
    fi
}

require_generated_tree() {
    local project=$1
    local target=$2
    local profile=$3
    local base directory kind
    base=$(project_output "$project")
    directory="$base/$target/$profile"
    [[ -d "$directory" ]] || die "build output is missing: ${directory#"$root"/}"
    for kind in ir asm obj; do
        [[ -d "$directory/$kind" ]] || die "$kind output is missing: ${directory#"$root"/}/$kind"
        find "$directory/$kind" -type f -print -quit | grep -q . || \
            die "$kind output is empty: ${directory#"$root"/}/$kind"
    done
}

run_build_pass() {
    local pass=$1
    local project algorithm profile log relative hash target
    clean_build_projects
    while IFS=$'\t' read -r project algorithm; do
        [[ "$project" == project ]] && continue
        for profile in "${profiles[@]}"; do
            relative="logs/build/${pass}-${algorithm}-${profile}.log"
            log="$stage/$relative"
            if ! (cd "$root" && mach build "$project" --all-targets --profile "$profile" \
                --emit-ir --emit-asm) > "$log" 2>&1; then
                die "verified build failed for $project $profile during $pass; see $log"
            fi
            hash=$(sha256_file "$log")
            for target in "${targets[@]}"; do
                require_generated_tree "$project" "$target" "$profile"
                record_result generated-code "$project" "$algorithm" \
                    "Mach IR verifier and code generator, $pass" "$target" "$profile" "$relative" "$hash"
            done
        done
    done < "$root/assurance/projects.tsv"
}

write_artifact_manifest() {
    local output=$1
    local project algorithm target profile base directory file relative kind hash size
    printf 'project\ttarget\tprofile\tkind\tpath\tsha256\tsize\n' > "$output"
    while IFS=$'\t' read -r project algorithm; do
        [[ "$project" == project ]] && continue
        base=$(project_output "$project")
        for target in "${targets[@]}"; do
            for profile in "${profiles[@]}"; do
                directory="$base/$target/$profile"
                while IFS= read -r -d '' file; do
                    relative=${file#"$root"/}
                    kind=${file#"$directory"/}
                    kind=${kind%%/*}
                    hash=$(sha256_file "$file")
                    size=$(stat -c '%s' "$file")
                    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                        "$project" "$target" "$profile" "$kind" "$relative" "$hash" "$size" \
                        >> "$output"
                done < <(find "$directory" -type f -print0 | sort -z)
            done
        done
    done < "$root/assurance/projects.tsv"
}

# every control in assurance/leakage.tsv must be refused for its stated reason on
# every target and profile, and must leave no generated code behind. a control
# that names admitted targets is the other way round there: the compiler must
# accept it and the IR must carry the secret multiply, which pins the target
# set that computes secret products in hardware
run_leakage_negative_controls() {
    local project artifact expected source admitted target profile log relative hash name ir
    while IFS=$'\t' read -r project artifact expected source admitted; do
        [[ "$project" == project ]] && continue
        name=${project##*/}
        for target in "${targets[@]}"; do
            for profile in "${profiles[@]}"; do
                relative="logs/leakage/${name}-${target}-${profile}.log"
                log="$stage/$relative"
                mkdir -p "$(dirname -- "$log")"
                (cd "$root" && mach clean "$project") >/dev/null 2>&1 </dev/null || \
                    die "could not clean the leakage control $project"
                if [[ ",$admitted," == *",$target,"* ]]; then
                    (cd "$root" && mach build "$project" --target "$target" \
                        --profile "$profile" --emit-ir) > "$log" 2>&1 </dev/null || \
                        die "compiler refused the control $project on the admitted target $target $profile: $log"
                    ir=$(find "$root/$project/out/$target/$profile" -type f -name '*.ir' -print -quit 2>/dev/null)
                    [[ -n "$ir" ]] || die "admitted control $project produced no IR for $target $profile"
                    grep -q 'mul\.secret' "$ir" || \
                        die "admitted control $project carries no secret multiply in its IR for $target $profile"
                    hash=$(sha256_file "$log")
                    record_result leakage "$project" all-secret-algorithms \
                        "$source, admitted in hardware" "$target" "$profile" "$relative" "$hash"
                    continue
                fi
                if (cd "$root" && mach build "$project" --target "$target" \
                    --profile "$profile" --emit-ir) > "$log" 2>&1 </dev/null; then
                    die "compiler accepted the leakage control $project for $target $profile"
                fi
                grep -qF -- "$expected" "$log" || \
                    die "leakage control $project failed for an unexpected reason: $log"
                if find "$root/$project/out" -type f \
                    \( -name '*.ir' -o -name '*.o' -o -name "$artifact" \) \
                    -print -quit 2>/dev/null | grep -q .; then
                    die "rejected leakage control $project left generated code behind for $target $profile"
                fi
                hash=$(sha256_file "$log")
                record_result leakage "$project" all-secret-algorithms \
                    "$source" "$target" "$profile" "$relative" "$hash"
            done
        done
    done < "$root/assurance/leakage.tsv"
}

record_positive_leakage_evidence() {
    local algorithm ct source hardware target profile log relative hash
    while IFS=$'\t' read -r algorithm ct source hardware; do
        [[ "$algorithm" == algorithm ]] && continue
        case "$hardware" in
            word|none) ;;
            *) die "algorithms.tsv: $algorithm has hardware_multiply '$hardware', expected word or none" ;;
        esac
        [[ "$ct" == yes ]] || continue
        for target in "${targets[@]}"; do
            for profile in "${profiles[@]}"; do
                relative="logs/build/pass-b-package-${profile}.log"
                log="$stage/$relative"
                require_file "$log"
                hash=$(sha256_file "$log")
                record_result leakage . "$algorithm" \
                    "Mach secret-flow checker plus verified IR" "$target" "$profile" "$relative" "$hash"
            done
        done
    done < "$root/assurance/algorithms.tsv"
}

inspect_zeroization() {
    local algorithm module assembly_required target profile ir asm ir_calls asm_calls
    local relative_ir relative_asm destination hash
    while IFS=$'\t' read -r algorithm module assembly_required; do
        [[ "$algorithm" == algorithm ]] && continue
        for target in "${targets[@]}"; do
            for profile in "${profiles[@]}"; do
                ir="$root/out/$target/$profile/ir/$module.ir"
                require_file "$ir"
                ir_calls=$(grep -cE 'call [^@]*@"?std\.crypto\.ct\.zeroize"?' "$ir" || true)
                [[ "$ir_calls" -gt 0 ]] || die "zeroization call is absent from ${ir#"$root"/}"
                relative_ir="generated/$target/$profile/$module.ir"
                destination="$stage/$relative_ir"
                mkdir -p "$(dirname -- "$destination")"
                cp "$ir" "$destination"
                hash=$(sha256_file "$destination")
                record_result zeroization . "$algorithm" \
                    "generated IR retains $ir_calls explicit zeroization call(s)" \
                    "$target" "$profile" "$relative_ir" "$hash"
            done
            if [[ "$assembly_required" == yes ]]; then
                asm="$root/out/$target/release/asm/$module.s"
                require_file "$asm"
                # 5.0 release builds inline small helpers across modules, so the wipe
                # reaches the assembly either as a call or as an expansion the release IR
                # records under inline_sites. the stores themselves survive by the
                # language's zeroizing-write guarantee (doc/language/secrecy.md)
                release_ir="$root/out/$target/release/ir/$module.ir"
                require_file "$release_ir"
                asm_calls=$(grep -c 'std.crypto.ct.zeroize' "$asm" || true)
                inlined=$(grep -c 'callee="std.crypto.ct.zeroize"' "$release_ir" || true)
                [[ "$asm_calls" -gt 0 || "$inlined" -gt 0 ]] || die "zeroization is absent from ${asm#"$root"/} and not inlined per ${release_ir#"$root"/}"
                relative_asm="generated/$target/release/$module.s"
                destination="$stage/$relative_asm"
                mkdir -p "$(dirname -- "$destination")"
                cp "$asm" "$destination"
                hash=$(sha256_file "$destination")
                record_result zeroization . "$algorithm" \
                    "release assembly retains $asm_calls zeroization call(s) and $inlined inline expansion(s)" \
                    "$target" release "$relative_asm" "$hash"
            fi
        done
    done < "$root/assurance/zeroization.tsv"
}

assert_complete_results() {
    local category
    for category in functional official-vector differential invalid-input performance \
        generated-code leakage zeroization reproducibility; do
        awk -F '\t' -v category="$category" '$1 == category && $8 == "PASS" { found = 1 } END { exit !found }' \
            "$results" || die "required evidence category did not pass: $category"
    done
    awk -F '\t' 'NR > 1 && $8 != "PASS" { exit 1 }' "$results" || \
        die "one or more evidence records did not pass"
}

write_integrity_manifest() {
    (
        cd "$stage"
        find . -type f ! -name evidence.sha256 -print0 | sort -z | \
            xargs -0 sha256sum
    ) > "$stage/evidence.sha256"
}

publish_evidence() {
    local run_id destination publishing link
    run_id="$(date -u '+%Y%m%dT%H%M%SZ')-${git_commit:0:12}-${compiler_sha:0:12}"
    mkdir -p "$evidence_root"
    destination="$evidence_root/$run_id"
    [[ ! -e "$destination" ]] || die "evidence destination already exists: $destination"
    publishing="$evidence_root/.publishing-$run_id-$$"
    [[ ! -e "$publishing" ]] || die "temporary publish destination already exists: $publishing"
    mkdir "$publishing"
    cp -R "$stage/." "$publishing/"
    mv "$publishing" "$destination"
    link="$evidence_root/.current-$$"
    ln -s "$run_id" "$link"
    mv -Tf "$link" "$evidence_root/current"
    printf '%s\n' "$destination"
}

run_gate() {
    local pass_a pass_b difference artifact_hash run_path alias_log_hash
    check_prerequisites
    require_command rg
    require_command sed
    require_command xargs
    assert_clean_source
    resolve_dependencies
    assert_no_redundant_aliases

    git_commit=$(git -C "$root" rev-parse HEAD)
    compiler_path=$(command -v mach)
    compiler_path=$(realpath "$compiler_path")
    compiler_sha=$(sha256_file "$compiler_path")
    compiler_version=$(mach info | sed -n '1p')
    pins_sha=$(dependency_pins_hash)
    evidence_manifest_sha=$(manifest_hash)

    temporary=$(mktemp -d "${TMPDIR:-/tmp}/mach-crypto-assurance.XXXXXX")
    stage="$temporary/evidence"
    mkdir -p "$stage/logs"
    trap 'rm -rf -- "$temporary"' EXIT

    results="$stage/results.tsv"
    printf 'category\tproject\talgorithm\tsource\ttarget\tprofile\tartifact\tstatus\tsha256\n' > "$results"
    printf 'key\tvalue\n' > "$stage/metadata.tsv"
    printf 'schema\t1\n' >> "$stage/metadata.tsv"
    printf 'git_commit\t%s\n' "$git_commit" >> "$stage/metadata.tsv"
    printf 'git_tree\tclean\n' >> "$stage/metadata.tsv"
    printf 'compiler_version\t%s\n' "$compiler_version" >> "$stage/metadata.tsv"
    printf 'compiler_path\t%s\n' "$compiler_path" >> "$stage/metadata.tsv"
    printf 'compiler_sha256\t%s\n' "$compiler_sha" >> "$stage/metadata.tsv"
    printf 'dependency_pins_sha256\t%s\n' "$pins_sha" >> "$stage/metadata.tsv"
    printf 'evidence_manifest_sha256\t%s\n' "$evidence_manifest_sha" >> "$stage/metadata.tsv"
    printf 'targets\t%s\n' "${targets[*]}" >> "$stage/metadata.tsv"
    printf 'profiles\t%s\n' "${profiles[*]}" >> "$stage/metadata.tsv"
    printf 'generated_at_utc\t%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$stage/metadata.tsv"

    run_functional_tests
    run_independent_tests
    run_leakage_negative_controls

    pass_a="$stage/artifacts-pass-a.tsv"
    pass_b="$stage/artifacts.tsv"
    run_build_pass pass-a
    write_artifact_manifest "$pass_a"
    run_build_pass pass-b
    write_artifact_manifest "$pass_b"

    difference="$stage/reproducibility.diff"
    if ! diff -u "$pass_a" "$pass_b" > "$difference"; then
        die "clean build passes were not byte-for-byte reproducible; see $difference"
    fi
    artifact_hash=$(sha256_file "$pass_b")
    record_result reproducibility . all \
        "two clean six-target debug/release build passes" all all artifacts.tsv "$artifact_hash"
    rm "$difference"

    record_positive_leakage_evidence
    inspect_zeroization

    alias_log_hash=$(printf 'no redundant same-name aliases\n' | sha256sum | awk '{print $1}')
    record_result generated-code . all "redundant same-name alias scan" all all source-tree "$alias_log_hash"

    printf 'scope\tavailability\tautomated_level\tfunctional\tofficial_vectors\tdifferential\tinvalid_input\tgenerated_code\tleakage\tzeroization\tindependent_review\n' \
        > "$stage/state.tsv"
    printf 'package\tFUNCTIONAL\tLEAKAGE_TESTED\tPASS\tPASS\tPASS\tPASS\tPASS\tPASS\tPASS\tNOT_RECORDED\n' \
        >> "$stage/state.tsv"

    assert_complete_results
    write_integrity_manifest
    run_path=$(publish_evidence)
    "$root/tools/assurance" verify "$run_path"
    printf 'assurance: PASS\n'
    printf 'evidence: %s\n' "$run_path"
}

verify_artifacts() {
    local manifest=$1
    local project target profile kind path expected size file actual actual_size
    while IFS=$'\t' read -r project target profile kind path expected size; do
        [[ "$project" == project ]] && continue
        [[ "$path" != /* && "$path" != *'../'* && "$path" != '../'* ]] || \
            die "unsafe artifact path in evidence: $path"
        file="$root/$path"
        require_file "$file"
        actual=$(sha256_file "$file")
        [[ "$actual" == "$expected" ]] || die "artifact is stale: $path"
        actual_size=$(stat -c '%s' "$file")
        [[ "$actual_size" == "$size" ]] || die "artifact size is stale: $path"
    done < "$manifest"
}

verify_gate() {
    local requested=${1:-"$evidence_root/current"}
    local evidence metadata resolved expected current
    check_prerequisites
    assert_clean_source
    evidence=$(realpath "$requested")
    resolved=$(realpath "$evidence_root")
    [[ "$evidence" == "$resolved"/* ]] || die "evidence path is outside the repository output: $evidence"
    require_file "$evidence/metadata.tsv"
    require_file "$evidence/results.tsv"
    require_file "$evidence/state.tsv"
    require_file "$evidence/artifacts.tsv"
    require_file "$evidence/evidence.sha256"
    metadata="$evidence/metadata.tsv"

    (cd "$evidence" && sha256sum -c evidence.sha256 >/dev/null) || \
        die "evidence integrity check failed: $evidence"

    current=$(git -C "$root" rev-parse HEAD)
    expected=$(metadata_value "$metadata" git_commit)
    [[ "$current" == "$expected" ]] || die "evidence is stale for git commit $current"
    [[ "$(metadata_value "$metadata" git_tree)" == clean ]] || die "evidence was not produced from a clean tree"

    compiler_path=$(command -v mach)
    compiler_path=$(realpath "$compiler_path")
    expected=$(metadata_value "$metadata" compiler_sha256)
    [[ "$(sha256_file "$compiler_path")" == "$expected" ]] || die "evidence compiler does not match the active compiler"
    expected=$(metadata_value "$metadata" dependency_pins_sha256)
    [[ "$(dependency_pins_hash)" == "$expected" ]] || die "evidence dependency pins are stale"
    expected=$(metadata_value "$metadata" evidence_manifest_sha256)
    [[ "$(manifest_hash)" == "$expected" ]] || die "evidence policy or gate is stale"

    awk -F '\t' 'NR > 1 && $8 != "PASS" { exit 1 }' "$evidence/results.tsv" || \
        die "evidence contains a non-passing result"
    awk -F '\t' 'NR == 2 && $2 == "FUNCTIONAL" && $3 == "LEAKAGE_TESTED" && \
        $4 == "PASS" && $5 == "PASS" && $6 == "PASS" && $7 == "PASS" && \
        $8 == "PASS" && $9 == "PASS" && $10 == "PASS" && $11 == "NOT_RECORDED" { ok = 1 } \
        END { exit !ok }' "$evidence/state.tsv" || die "assurance state is incomplete or review status was conflated"

    verify_artifacts "$evidence/artifacts.tsv"
    printf 'assurance: verified %s\n' "$evidence"
}

case "$command_name" in
    run)
        [[ $# -eq 0 || $# -eq 1 ]] || die "usage: tools/assurance [run|verify [evidence-path]]"
        run_gate
        ;;
    verify)
        [[ $# -le 2 ]] || die "usage: tools/assurance verify [evidence-path]"
        verify_gate "${2:-}"
        ;;
    *)
